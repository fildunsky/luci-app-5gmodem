#!/bin/sh
# Первичная настройка слушателя URC после установки пакета.
#
# Служба включена в procd, но реально стартует, лишь когда автовыбор нашёл
# запасной порт. Если модем УЖЕ поднят на момент установки, события ifup не
# будет - поэтому оцениваем порт здесь один раз. На свежей системе без модема
# автовыбор просто ничего не включит (штатно).
/etc/init.d/5gmodem-atd enable >/dev/null 2>&1
[ -x /usr/share/5gmodem/atd-autoport.sh ] && \
	/usr/share/5gmodem/atd-autoport.sh >/dev/null 2>&1
exit 0
