#!/bin/sh
# Переоценить запасной AT-порт слушателя URC, когда модемный интерфейс поднялся
# или упал: активный модем мог смениться, номера ttyUSB - сдвинуться. Автовыбор
# сам решит, включать демон и на каком порту (или выключить, если модем ушёл).
#
# Фильтр - только интерфейс АКТИВНОГО модема, чтобы не гонять зонд портов на
# каждый ifup домашней сети. Фон с отвязкой дескрипторов: hotplug не ждёт.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifdown ] || exit 0
[ -x /usr/share/5gmodem/atd-autoport.sh ] || exit 0

CFG=5gmodem
IF=$(uci -q get $CFG.@5gmodem[0].network)
[ -n "$IF" ] && [ "$INTERFACE" = "$IF" ] || exit 0

( /usr/share/5gmodem/atd-autoport.sh ) >/dev/null 2>&1 </dev/null &
exit 0
