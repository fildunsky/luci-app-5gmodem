+/* buffer[] is a PERSISTENT receive accumulator (at_rxlen valid bytes); leftover
+ * bytes carry across calls, so multi-line responses split over reads are handled
+ * correctly. Reads are byte-level with a wall-clock deadline (poll+read), so a
+ * silent or newline-less port can never block forever (the fgets() approach did).
+ * Backport of the robustness in upstream lpac PR #442, for Fibocom FM350-GL. */
+static size_t at_rxlen = 0;
+
+static long at_now_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (long)ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
+}
+
+static int at_expect_dl(char **response, const char *expected, int deadline_ms) {
+    int fd = fileno(fuart);
+    long start = at_now_ms();
+    char *found = NULL;
+    int result = -1;
+    char line[AT_BUFFER_SIZE];
 
     if (response)
         *response = NULL;
 
     while (1) {
-        fgets(buffer, AT_BUFFER_SIZE, fuart);
-        buffer[strcspn(buffer, "\r\n")] = 0;
+        char *nl = memchr(buffer, '\n', at_rxlen);
+        if (!nl) {
+            if (at_rxlen >= (size_t)AT_BUFFER_SIZE) {
+                at_rxlen = 0;
+                break;
+            }
+            long elapsed = at_now_ms() - start;
+            if (elapsed >= deadline_ms)
+                break;
+            struct pollfd pfd = {.fd = fd, .events = POLLIN};
+            int remain = deadline_ms - (int)elapsed;
+            int slice = remain > 500 ? 500 : remain;
+            if (poll(&pfd, 1, slice) <= 0)
+                continue;
+            ssize_t n = read(fd, buffer + at_rxlen, AT_BUFFER_SIZE - at_rxlen);
+            if (n <= 0)
+                break;
+            at_rxlen += (size_t)n;
+            continue;
+        }
+        size_t off = (size_t)(nl - buffer);
+        size_t copy = off < sizeof(line) ? off : sizeof(line) - 1;
+        memcpy(line, buffer, copy);
+        line[copy] = 0;
+        size_t rest = at_rxlen - off - 1;
+        memmove(buffer, buffer + off + 1, rest);
+        at_rxlen = rest;
+        line[strcspn(line, "\r")] = 0;
+        if (line[0] == 0)
+            continue;
         if (getenv_or_default(ENV_AT_DEBUG, false))
-            printf("AT_DEBUG: %s\n", buffer);
-        if (strcmp(buffer, "ERROR") == 0) {
-            return -1;
-        } else if (strcmp(buffer, "OK") == 0) {
-            return 0;
-        } else if (expected && strncmp(buffer, expected, strlen(expected)) == 0) {
-            if (response)
-                *response = strdup(buffer + strlen(expected));
+            printf("AT_DEBUG: %s\n", line);
+        if (strcmp(line, "ERROR") == 0) {
+            break;
+        } else if (strcmp(line, "OK") == 0) {
+            result = 0;
+            break;
+        } else if (expected && strncmp(line, expected, strlen(expected)) == 0) {
+            free(found);
+            found = strdup(line + strlen(expected));
+            while (found && *found == ' ')
+                memmove(found, found + 1, strlen(found));
+        } else if (expected && strstr(expected, "CCHO") != NULL && line[0] != '\0' &&
+                   strspn(line, "0123456789") == strlen(line)) {
+            /* bare channel number (Fibocom FM350) instead of "+CCHO: <n>" */
+            free(found);
+            found = strdup(line);
         }
     }
-    return 0;
+    if (result == 0 && response) {
+        *response = found;
+        found = NULL;
+    }
+    free(found);
+    return result;
+}
+
+static int at_expect(char **response, const char *expected) {
+    return at_expect_dl(response, expected, 20000);
 }
 
