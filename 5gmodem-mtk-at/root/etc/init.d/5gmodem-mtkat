#!/bin/sh /etc/rc.common

START=19
USE_PROCD=1

start_service() {
	. /usr/share/5gmodem/mtk/env.sh
	[ -d /sys/kernel/ccci ] && [ -x "$MTK_USOCK" ] || return 0
	mkdir -p /tmp/5gmodem
	if [ "$MTK_MODE" = mux ]; then
		procd_open_instance urc
		procd_set_param command /usr/share/5gmodem/mtk/urc-read.sh
		procd_set_param respawn 3600 5 0
		procd_close_instance
	else
		if [ ! -e /dev/pts/ptmx ]; then
			mkdir -p /dev/pts
			mount -t devpts devpts /dev/pts 2>/dev/null
		fi
		procd_open_instance
		procd_set_param command "$MTK_USOCK" -b "$MTK_SOCK" /dev/ttyMTK0
		procd_set_param env USOCK_URC="$MTK_URC"
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi
	(
		for i in $(seq 1 60); do
			if [ "$MTK_MODE" = mux ]; then
				pidof cmux >/dev/null && [ -c "$MTK_SOCK" ] && break
			else
				[ -e "$MTK_SOCK" ] && break
			fi
			sleep 2
		done
		[ "$MTK_MODE" = mux ] && ln -sf "$MTK_AT" /dev/ttyMTK0
		sleep 10
		rm -f /tmp/5gmodem/listmodems.cache /tmp/5gmodem/listmodems.stamp
		/usr/share/5gmodem/modemswitch.sh autosetup >/dev/null 2>&1
	) </dev/null >/dev/null 2>&1 &
}

stop_service() {
	. /usr/share/5gmodem/mtk/env.sh
	[ "$MTK_MODE" = mux ] && [ -L /dev/ttyMTK0 ] && rm -f /dev/ttyMTK0
}
