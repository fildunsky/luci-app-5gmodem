#!/bin/sh
#
# ПРОТОТИП: отдача метрик мимо LuCI, напрямую через uhttpd.
#
# Смысл затеи - скорость открытия страницы на слабом роутере. Задержка у нас
# НЕ в бэкенде (обвязка rpcd измерена: 0.01 c, это 0.3% времени), а в загрузке
# и разборе фреймворка LuCI: luci.js, form.js, ui.js плюс сама вьюха - около
# 80 КБ одного только JS вьюхи на каждое открытие, и всё это разбирается
# процессором роутера. Здесь фреймворка нет: страница ~4 КБ и один запрос.
#
# --- АВТОРИЗАЦИЯ И ПОЧЕМУ ОНА ОТДЕЛЬНАЯ --------------------------------------
#
# Файлы в /www uhttpd отдаёт БЕЗ какой-либо проверки, а через эту страницу
# доступны метрики, а в будущем SMS и AT - то есть контроль над модемом.
# Проверка обязательна.
#
# Переиспользовать сессию LuCI НЕЛЬЗЯ, хотя сначала мы пробовали именно так.
# Проверено по её исходнику (dispatcher.uc): кука ставится как
#     sysauth_http=<sid>; path=<SCRIPT_NAME>; SameSite=strict; HttpOnly
# где SCRIPT_NAME = /cgi-bin/luci. Из этого следует ДВА запрета сразу:
#   - path ограничивает куку каталогом LuCI, и браузер не пошлёт её на
#     /cgi-bin/5g-api (по правилам cookie-path это не подпуть);
#   - HttpOnly не даёт прочитать её из JS и переслать самим.
# Обойти это можно было бы, только разместив точку входа ВНУТРИ /cgi-bin/luci -
# то есть вернувшись в LuCI, ради ухода от которой всё и затевалось.
#
# Поэтому вход свой, но БЕЗ своего пароля: логин и пароль проверяет сам роутер
# через 'ubus call session login' - те же учётные данные, что у LuCI и ssh.
# Мы ничего не храним и не сверяем сами.
#
# ЧЕМ ПРОВЕРЯЕМ СЕССИЮ. Опытом установлено (на живом роутере):
#   session access с неверным токеном -> ошибка "Not found";
#   session get    с неверным токеном -> ОТВЕЧАЕТ объектом, но БЕЗ username.
# Значит единственный надёжный признак - непустой username.

RES=/usr/share/5gmodem
COOKIE=sysauth5g

hdr() {   # $1 - статус, $2 - дополнительный заголовок (может быть пуст)
	printf 'Status: %s\r\n' "$1"
	printf 'Content-Type: application/json\r\n'
	printf 'Cache-Control: no-store\r\n'
	[ -n "$2" ] && printf '%s\r\n' "$2"
	printf '\r\n'
}

# Раскодировать значение поля формы (%XX и '+'). Пароль может содержать что
# угодно, поэтому без этого вход ломался бы на части паролей.
urldecode() {
	_s=$(printf '%s' "$1" | sed 's/+/ /g; s/%\(..\)/\\x\1/g')
	printf '%b' "$_s"
}

session_user() {   # $1 - токен; печатает имя пользователя или ничего
	[ -n "$1" ] || return 1
	ubus call session get "{\"ubus_rpc_session\":\"$1\"}" 2>/dev/null \
		| jsonfilter -e '@.values.username' 2>/dev/null
}

# --- вход --------------------------------------------------------------------
case "$QUERY_STRING" in
*login*)
	# Тело POST: user=...&pass=...
	_len=${CONTENT_LENGTH:-0}
	case "$_len" in ''|*[!0-9]*) _len=0 ;; esac
	[ "$_len" -gt 4096 ] && _len=4096
	_body=$(dd bs=1 count="$_len" 2>/dev/null)

	_u=$(urldecode "$(printf '%s' "$_body" | sed -n 's/.*\buser=\([^&]*\).*/\1/p')")
	_p=$(urldecode "$(printf '%s' "$_body" | sed -n 's/.*\bpass=\([^&]*\).*/\1/p')")
	[ -n "$_u" ] || _u=root

	# Пароль уходит в ubus и НИКУДА не пишется - ни в лог, ни в файл.
	_sid=$(ubus call session login \
		"{\"username\":\"$_u\",\"password\":\"$_p\"}" 2>/dev/null \
		| jsonfilter -e '@.ubus_rpc_session' 2>/dev/null)

	if [ -z "$_sid" ]; then
		hdr "403 Forbidden"
		printf '{"error":"bad credentials"}\n'
		exit 0
	fi
	# path=/ - иначе получим ровно ту же беду, что у куки LuCI. HttpOnly, чтобы
	# токен не читался из JS; SameSite=strict против отправки с чужих страниц.
	hdr "200 OK" "Set-Cookie: $COOKIE=$_sid; path=/; SameSite=strict; HttpOnly"
	printf '{"ok":1}\n'
	exit 0
	;;
esac

# --- всё остальное требует сессии --------------------------------------------
TOKEN=$(printf '%s' "$HTTP_COOKIE" | tr ';' '\n' \
	| sed -n "s/^[[:space:]]*$COOKIE=\([A-Za-z0-9]\{32\}\).*/\1/p" | head -1)

USER=$(session_user "$TOKEN")
if [ -z "$USER" ]; then
	hdr "401 Unauthorized"
	printf '{"error":"login required"}\n'
	exit 0
fi

case "$QUERY_STRING" in
*metrics*|'')
	hdr "200 OK"
	# cached, а не полный опрос: в порт ходит один процесс (блокировка в
	# 5gmodem.sh), остальные читают снимок - см. пояснение там же.
	"$RES/5gmodem.sh" cached 5 2>/dev/null
	;;
*logout*)
	[ -n "$TOKEN" ] && ubus call session destroy "{\"ubus_rpc_session\":\"$TOKEN\"}" >/dev/null 2>&1
	hdr "200 OK" "Set-Cookie: $COOKIE=; path=/; Max-Age=0"
	printf '{"ok":1}\n'
	;;
*)
	hdr "400 Bad Request"
	printf '{"error":"unknown query"}\n'
	;;
esac
exit 0
