#!/bin/sh /etc/rc.common
# Привязывает usb-serial драйвер (option1/generic) к композициям, которых нет в
# статической таблице ядра, на КАЖДОМ буте: new_id не переживает перезагрузку, а
# hotplug 'add' для модема, воткнутого до загрузки (coldplug), в procd не
# приходит. Без этого у 05c6:9025 / 90d5 / 90d6 после ребута не было ни одного
# ttyUSB - ни метрик, ни SMS, только IP через qmi_wwan. См. usbports.sh coldplug.

START=50

start() {
	# В фоне и с ретраями: модем может доэнумерироваться уже после старта init,
	# а драйвер usb-serial - подгрузиться на пару секунд позже. Идемпотентно
	# (new_id можно писать повторно), поэтому лишние проходы безвредны.
	(
		_i=1
		while [ "$_i" -le 6 ]; do
			/usr/share/5gmodem/usbports.sh coldplug
			sleep 5
			_i=$((_i + 1))
		done
	) >/dev/null 2>&1 &
}
