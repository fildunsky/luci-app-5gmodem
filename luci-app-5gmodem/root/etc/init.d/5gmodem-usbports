#!/bin/sh /etc/rc.common
# Привязывает usb-serial драйвер (option1/generic) к композициям, которых нет в
# статической таблице ядра, на КАЖДОМ буте: new_id не переживает перезагрузку, а
# hotplug 'add' для модема, воткнутого до загрузки (coldplug), в procd не
# приходит. Без этого у 05c6:9025 / 90d5 / 90d6 после ребута не было ни одного
# ttyUSB - ни метрик, ни SMS, только IP через qmi_wwan. См. usbports.sh coldplug.

START=50

start() {
	# В фоне и с ретраями: модем может доэнумерироваться уже после старта init,
	# а драйвер usb-serial - подгрузиться на пару секунд позже. Идемпотентно
	# (new_id можно писать повторно), поэтому лишние проходы безвредны.
	(
		# ВРЕДНОЕ ПРАВИЛО usb_modeswitch СНИМАЕМ ДО ПЕРВОГО ПРОХОДА. На буте
		# hotplug-события для уже воткнутого модема не приходит (см. ниже), и
		# обработчик 71-5gmodem-resolve, который обычно зовёт этот фикс, не
		# отрабатывает - а вот у самого usbmode свой сканер шины на старте есть.
		# То есть «config 0» модему выставят, а снять правило будет некому:
		# HP lt4120 после каждой перезагрузки оставался без единого интерфейса.
		# Служебные порты, роняющие модем от AT (noatports.sh), - первым делом:
		# событие bind для модема, воткнутого до загрузки, в хотплаг не приходит.
		. /usr/share/5gmodem/noatports.sh
		noat_unbind
		/usr/share/5gmodem/usbmode-fix.sh
		_i=1
		while [ "$_i" -le 6 ]; do
			noat_unbind
			/usr/share/5gmodem/usbports.sh coldplug
			sleep 5
			_i=$((_i + 1))
		done
	) >/dev/null 2>&1 &
}
