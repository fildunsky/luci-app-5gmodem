#!/bin/sh /etc/rc.common
#
# Индикатор уровня сигнала на светодиодах корпуса. Сам опрос модема не делает -
# читает готовый снимок метрик (см. signal-leds.sh).

START=99
STOP=10
USE_PROCD=1

start_service() {
	# Поднимаемся, если НЕ выключено явно: на устройствах со светодиодами
	# индикатор включён по умолчанию (пустое значение = «не настраивали»).
	[ "$(uci -q get 5gmodem.@5gmodem[0].signal_leds)" = "0" ] && return 0
	# Нет светодиодов (не то устройство) - тоже.
	/usr/share/5gmodem/signal-leds.sh detect 2>/dev/null | grep -q '"available":1' || return 0

	procd_open_instance
	# Цикл ЖИВЁТ В САМОМ СКРИПТЕ, а не в 'sh -c while true': так procd следит за
	# одним процессом, а не за оболочкой-обёрткой, и respawn работает осмысленно.
	procd_set_param command /usr/share/5gmodem/signal-leds.sh run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	# Гасим, иначе останутся гореть в последнем состоянии и будут врать.
	/usr/share/5gmodem/signal-leds.sh off 2>/dev/null
}

service_triggers() {
	procd_add_reload_trigger "5gmodem"
}
