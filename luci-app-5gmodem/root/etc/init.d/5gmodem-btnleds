#!/bin/sh /etc/rc.common
#
# Восстановить светодиоды, привязанные к железным кнопкам, после загрузки роутера.
#
# ЗАЧЕМ. Диоды условной кнопки («тумблер сервиса») выставляет только обработчик
# нажатия. После перезагрузки их никто не трогал: роутер стартовал с тёмными
# диодами, и они загорались лишь после первого физического нажатия - хотя сервис
# (напр. ssclash) уже работал. Здесь один раз при старте приводим диоды к
# ФАКТИЧЕСКОМУ состоянию сервиса (см. buttons.sh syncleds).
#
# ПОРЯДОК ЗАПУСКА. Позже, чем:
#   - /etc/init.d/led (START=96) - иначе триггеры OpenWrt перезапишут яркость;
#   - сами сервисы (ssclash - START=21), иначе прочитаем «остановлен» у ещё не
#     поднявшегося сервиса и зажжём неверный цвет.
START=98
# STOP не нужен: диоды отражают состояние СЕРВИСА, а не нашего процесса, и гасить
# их при остановке init-скрипта (в т.ч. при выключении роутера) незачем.

start() {
	/usr/share/5gmodem/buttons.sh syncleds >/dev/null 2>&1
}

stop() {
	:
}
