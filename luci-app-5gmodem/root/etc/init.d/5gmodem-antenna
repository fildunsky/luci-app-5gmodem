#!/bin/sh /etc/rc.common
#
# Режим антенн корпуса Notion R281 / Yota C300-1 (см. antenna.sh). На других
# платах служба ничего не делает.

START=96
STOP=10
USE_PROCD=1

start_service() {
	/usr/share/5gmodem/antenna.sh detect 2>/dev/null | grep -q '"available":1' || return 0
	/usr/share/5gmodem/antenna.sh apply 2>/dev/null
	case "$(uci -q get 5gmodem.@5gmodem[0].antenna_mode)" in
		auto|mix) ;;
		*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/share/5gmodem/antenna.sh run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
