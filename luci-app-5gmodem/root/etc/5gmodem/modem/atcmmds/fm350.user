# AT templates — '## group' начинает раздел, строка '# описание' описывает
# команду под ней. Сама команда отправляется в модем без изменений.
# Строки с символом '#' никогда не отправляются. Редактируйте свободно.

## Режимы сети и частотные диапазоны (Bands)

# Текущий режим сети и активные диапазоны частот
AT+GTACT?

# Поддерживаемые модемом режимы и диапазоны частот
AT+GTACT=?

# Только LTE (4G), все доступные диапазоны
AT+GTACT=2,3,3,0

# Только LTE (4G), принудительно только B3 (1800 МГц) и B7 (2600 МГц)
AT+GTACT=2,3,3,103,107

# Режим LTE + UMTS (приоритет LTE, все диапазоны)
AT+GTACT=4,3,2,0

# Режим LTE + UMTS (приоритет LTE, фиксация LTE на B3+B7, 3G авто)
AT+GTACT=4,3,2,103,107

# Только UMTS (3G), все диапазоны
AT+GTACT=1,2,0

# Проверить текущий тип доступа (RAT) и статус GPRS/EDGE
AT+ERAT?

## Агрегация частот и параметры вышки (Cell Info)

# Подробная информация об обслуживающей соте и соседях
AT+GTCCINFO?

# Статус агрегации частот (основная полоса PCC, вторичные SCC, ширина канала, MIMO, модуляция)
AT+GTCAINFO?

# Расширенные параметры качества сигнала (точные RSRP, RSRQ, RSSI)
AT+CESQ

# Базовый уровень сигнала и количество ошибок (RSSI, BER)
AT+CSQ

## Регистрация в сети и оператор

# Текущий подключенный оператор и режим выбора сети
AT+COPS?

# Поиск всех доступных операторов вокруг (может выполняться до 3 минут)
AT+COPS=?

# Статус регистрации в сети LTE/EPS (домашняя сеть, роуминг или отказ)
AT+CEREG?

# Статус сигнального соединения с вышкой (RRC Connected / Idle)
AT+CSCON?

## Точки доступа (APN) и IP-соединение

# Список сохранённых профилей APN и тип протокола (IPv4/IPv6)
AT+CGDCONT?

# Получить динамические параметры соединения для профиля 1 (IP-адрес, шлюз, DNS, MTU)
AT+CGCONTRDP=1

# Показать текущие IP-адреса для всех активных сессий
AT+CGPADDR

# Запросить текущие DNS-сервера для профиля 1
AT+GTDNS=1

# Статус активации контекстов передачи данных (включена ли сессия данных)
AT+CGACT?

## SIM-карта и идентификация устройства

# Статус SIM-карты (готова к работе, требует PIN или заблокирована PUK)
AT+CPIN?

# Информация о слотах SIM-карт и активном слоте (Dual SIM)
AT+GTDUALSIM?

# Считать номер SIM-карты (ICCID)
AT+ICCID

# Считать идентификатор абонента (IMSI)
AT+CIMI

# Показать серийный номер модема (IMEI)
AT+CGSN

# Номер телефона, записанный на SIM-карте (если поддерживается/записан оператором)
AT+CNUM

## Оборудование и температура

# Текущая температура внутренних датчиков модема
AT+ETHERMAL?

# Конфигурация USB-интерфейса (режим сетевой карты / портов)
AT+GTUSBMODE?

# Статус задействованных антенных трактов на приём (Main / AUX / MIMO)
AT+GTRXPATHEN?

## Управление питанием и перезагрузка

# Программная перезагрузка модема (софт-ребут)
AT+CFUN=15

# Режим "В самолёте" (отключение радиомодуля)
AT+CFUN=4

# Обычный рабочий режим (включение радиомодуля на полную мощность)
AT+CFUN=1

## Прошивка и системные сведения

# Полная версия сборки прошивки (Package Version)
AT+GTPKGVER?

# Ревизия программного обеспечения
AT+CGMR

# Текущий профиль настроек оператора (Operator ID и название из прошивки)
AT+GTCURCAR?

# Вывести полный список всех поддерживаемых AT-команд
AT+CLAC
