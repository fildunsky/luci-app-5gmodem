# AT templates — '## group' starts a section, a '# description' line describes
# the command below it, and the command line is sent to the modem as-is.
# '#' lines are never sent. Full help is in generic.user. Edit freely.

## Bands and modes

# Network mode and bands
AT+GTACT?

# Supported modes and bands
AT+GTACT=?

## Cell

# Serving cell and neighbours
AT+GTCCINFO?

# Carrier aggregation: PCC/SCC, bandwidth, MIMO, modulation
AT+GTCAINFO?

# Signal quality (RSRP, RSRQ, RSSI)
AT+CESQ

# Radio connection state (RRC connected / idle)
AT+CSCON?

## Network and data

# Operator and selection mode
AT+COPS?

# LTE registration state
AT+CEREG?

# APN profiles
AT+CGDCONT?

# Connection parameters of profile 1 (IP, gateway, DNS, MTU)
AT+CGCONTRDP=1

# DNS servers of profile 1
AT+GTDNS=1

# Data context state
AT+CGACT?

## Temperature

# Temperature
AT+ETHERMAL?

## USB and SIM

# USB composition
AT+GTUSBMODE?

# Receive paths in use (main / AUX / MIMO)
AT+GTRXPATHEN?

# SIM slots
AT+GTDUALSIM?

# ICCID
AT+ICCID

# SIM state (ready, PIN, PUK)
AT+CPIN?

# IMSI
AT+CIMI

## Firmware

# Firmware package version
AT+GTPKGVER?
