# AT templates — '## group' starts a section, a '# description' line describes
# the command below it, and the command line is sent to the modem as-is.
# '#' lines are never sent. Full help is in generic.user. Edit freely.

## Bands and modes

# Network mode and bands
AT+XACT?

## Cell and signal

# Aggregation (CA)
AT+XLEC?

# Cells
AT+XMCI=1

# RSRP per branch
AT+RSRP?

# RSRQ per branch
AT+RSRQ?

# Antenna branches (first ACM port only)
at@errc:pcell_scell_measurement_info()

## USB and SIM

# USB composition (NVM)
at@nvm:cal_usbmode.num?

# SIM slots
AT+GTDUALSIM?

## Firmware

# Firmware package version
AT+GTPKGVER?
