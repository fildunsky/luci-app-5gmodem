# AT templates — '## group' starts a section, a '# description' line describes
# the command below it, and the command line is sent to the modem as-is.
# '#' lines are never sent. Full help is in generic.user. Edit freely.

## Cell and signal

# Serving cell
AT+QENG="servingcell"

# Network and band
AT+QNWINFO

# Aggregation (CA)
AT+QCAINFO

# Cells
AT+QENG="neighbourcell"

# RSRP per branch
AT+QRSRP

# Temperature
AT+QTEMP

## Network and bands

# USB mode
AT+QCFG="usbnet"

# Bands (masks)
AT+QCFG="band"

# Cell lock
AT+QNWLOCK="common/4g"

## SIM

# SIM slot
AT+QUIMSLOT?

# SIM status
AT+QSIMSTAT?

# MBN profiles
AT+QMBNCFG="List"
