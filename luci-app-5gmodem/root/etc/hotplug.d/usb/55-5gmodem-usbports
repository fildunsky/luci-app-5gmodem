#!/bin/sh
[ "$ACTION" = add ] || exit 0
case "$DEVTYPE:$DEVPATH" in
	usb_interface:*:*.0|usb_device:*) ;;
	usb_interface:*) exit 0 ;;
esac
case "$PRODUCT" in
	5c6/*|05c6/*|3f0/*|03f0/*|413c/81d8/*|1bc7/1911/*|2c7c/6004/*|1bbb/196/*|2cb7/110/*|19d2/581/*|19d2/536/*) /etc/init.d/5gmodem-usbports start >/dev/null 2>&1 & ;;
esac
exit 0
