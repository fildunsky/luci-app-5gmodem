#!/bin/sh
[ -d /tmp/5gmodem ] || mkdir -p /tmp/5gmodem 2>/dev/null

[ "$ACTION" = "add" ] || [ "$ACTION" = "remove" ] || exit 0
[ "$DEVTYPE" = "usb_device" ] || exit 0

[ -f /etc/config/5gmodem ] || exit 0

mkdir -p /tmp/5gmodem 2>/dev/null

rm -f /tmp/5gmodem/listmodems.cache /tmp/5gmodem/listmodems.stamp 2>/dev/null

touch /tmp/5gmodem/resolve.pending

(
	flock -n 9 || exit 0
	while [ -f /tmp/5gmodem/resolve.pending ]; do
		rm -f /tmp/5gmodem/resolve.pending
		sleep 5
		/usr/share/5gmodem/usbmode-fix.sh >/dev/null 2>&1
		/usr/share/5gmodem/listmodems.sh --refresh >/dev/null 2>&1
		/usr/share/5gmodem/modemswitch.sh resolve >/dev/null 2>&1
		/usr/share/5gmodem/modemswitch.sh autosetup >/dev/null 2>&1
		/usr/share/5gmodem/ensureports.sh >/dev/null 2>&1
	done
) 9>/tmp/5gmodem/resolve.lock >/dev/null 2>&1 </dev/null &

exit 0
