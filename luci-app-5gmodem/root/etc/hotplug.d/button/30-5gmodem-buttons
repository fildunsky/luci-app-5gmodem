#!/bin/sh
# Выполнить команду, привязанную к железной кнопке (вкладка «Кнопки»).
# События доставляет kmod-gpio-button-hotplug сюда, в /etc/hotplug.d/button/:
#   $BUTTON - имя input-кода (BTN_0/reset/wps/...),
#   $ACTION - pressed | released,
#   $SEEN   - сколько секунд кнопку держали.
[ -n "$BUTTON" ] || exit 0
case "$ACTION" in pressed|released) ;; *) exit 0 ;; esac

# Заводской СБРОС (reset) не трогаем никогда - у него своё критичное поведение
# (в UI он не предлагается). Остальные кнопки (wps и пр.) назначаемы; их заводской
# обработчик в чистом OpenWrt на деле ничего не делает, поэтому просто выполняем
# привязку. run сам молча выйдет, если её нет.
[ "$BUTTON" = "reset" ] && exit 0

# В фоне с отвязкой дескрипторов: hotplug не должен ждать команду пользователя.
( /usr/share/5gmodem/buttons.sh run "$BUTTON" "$ACTION" "$SEEN" ) >/dev/null 2>&1 </dev/null &
