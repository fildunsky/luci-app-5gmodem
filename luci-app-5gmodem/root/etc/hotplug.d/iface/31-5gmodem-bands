#!/bin/sh
# Восстановить сохранённый выбор диапазонов ПОСЛЕ того, как модемный интерфейс
# поднялся.
#
# ЗАЧЕМ. Часть модемов сбрасывает маску диапазонов на заводскую при каждой
# перезагрузке (проверено на Fibocom FM350: GTACT-набор переживает reboot только
# по RAT, сами бенды - нет). Пользователь выбрал, скажем, только B7, роутер
# перезагрузился - и модем снова на всех диапазонах. bands.sh запоминает выбор в
# секции модема (save_band*), а здесь мы его переприменяем.
#
# ПОЧЕМУ НЕ ВСЕМ ПОДРЯД. restorebands сравнивает сохранённое с текущим и трогает
# модем ТОЛЬКО когда они разошлись - модемы, что держат маску в NV, не дёргаются
# (сохранённое == текущее). Так «лишний» CFUN не случается на ровном месте.
[ "$ACTION" = ifup ] || exit 0

CFG=5gmodem

# Тумблер (по умолчанию включён): переприменяем, пока не выключено ЯВНО.
[ "$(uci -q get $CFG.@5gmodem[0].save_bands)" = 0 ] && exit 0

# Интерфейс -> секция модема -> его usb-путь. Секции названы m_<путь>, но искать
# надёжнее по полю network: у модема оно и есть имя интерфейса из события.
SEC=""
for _s in $(uci -q show $CFG 2>/dev/null | sed -n 's/^\('$CFG'\.m_[0-9A-Za-z_]*\)\.network=.*/\1/p'); do
	[ "$(uci -q get "$_s.network")" = "$INTERFACE" ] || continue
	SEC="$_s"; break
done
[ -n "$SEC" ] || exit 0

MPATH=$(uci -q get "$SEC.path")
[ -n "$MPATH" ] || exit 0

# Есть ли вообще что восстанавливать - иначе не гоняем bands.sh (он лез бы в порт).
S=$(uci -q get "$SEC.save_band")$(uci -q get "$SEC.save_band5gnsa")$(uci -q get "$SEC.save_band5gsa")
[ -n "$S" ] || exit 0

# НЕ БОЛЬШЕ ОДНОЙ попытки на интерфейс за загрузку. Маркер в /tmp живёт до
# перезагрузки. Без него был бы риск петли: restore -> CFUN -> _reconnect_iface
# делает ubus down/up -> снова ifup -> снова restore. Маркер ставим ДО запуска.
M="/tmp/5gmodem_bandrestore_$INTERFACE"
[ -e "$M" ] && exit 0
: > "$M"

# В фоне с отвязкой дескрипторов: hotplug не должен ждать CFUN-цикл и реконнект
# (это десятки секунд). BANDS_ACTIVE_MODEM прицеливает bands.sh на ИМЕННО этот
# модем - важно на двухмодемном роутере.
( BANDS_ACTIVE_MODEM="$MPATH" /usr/share/5gmodem/bands.sh restorebands ) >/dev/null 2>&1 </dev/null &
