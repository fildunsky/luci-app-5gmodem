#!/bin/sh
# Перепривязать фиксацию TTL ПОСЛЕ того, как модемный интерфейс поднялся.
#
# ЗАЧЕМ. Правило TTL - это nft-инклюд по l3-устройству модема. У «поздних»
# модемов (FM350 в RNDIS/xmm: интерфейс eth2 регистрируется через ~20 c после
# старта, а дозвон - отдельным netifd-прото) устройство появляется ПОЗЖЕ, чем
# фаервол первый раз грузит правила. На холодном старте правило легло бы мимо
# ещё не существующего интерфейса, и связь через модем поднималась бы без фикса
# (а сторонние TTL-тулзы, вешающие iptables -o eth2 на несуществующий eth2,
# вообще ломали путь - ровно эту жалобу и разбирали).
#
# netifd шлёт ifup для ЛЮБОГО прото (в логе виден тот же путь, что и у штатного
# fw4 reload-on-ifup), поэтому пересобираем инклюд именно тогда, когда l3-devices
# уже есть - ttl.sh apply считает актуальное устройство и перегружает fw4.
[ "$ACTION" = ifup ] || exit 0

CFG=5gmodem

# Только для интерфейса, на который наш TTL и вешается (см. modem_iface в ttl.sh).
IF=$(uci -q get $CFG.@5gmodem[0].network)
[ -n "$IF" ] && [ "$INTERFACE" = "$IF" ] || exit 0

# И только если TTL реально задан - иначе зря дёргали бы fw4 reload на каждый ifup.
T=$(uci -q get $CFG.@5gmodem[0].ttl4in)$(uci -q get $CFG.@5gmodem[0].ttl4out)
T=$T$(uci -q get $CFG.@5gmodem[0].ttl6in)$(uci -q get $CFG.@5gmodem[0].ttl6out)
[ -n "$T" ] || exit 0

# В фоне с отвязкой дескрипторов: hotplug не должен ждать fw4 reload.
( /usr/share/5gmodem/ttl.sh apply ) >/dev/null 2>&1 </dev/null &
