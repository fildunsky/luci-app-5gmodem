#!/bin/sh
# Внеочередной круг сторожа интернета при подъёме/падении аплинка: без него
# вердикт (и карточка на странице) обновляется только 30-секундными кругами
# цикла sessionwatch, и поднявшийся модем до минуты выглядел пропавшим.
# Фильтр «интерфейс из wan-зоны» и замок от параллельных кругов - внутри
# health.sh (verb event). Фон с отвязкой дескрипторов - hotplug не ждёт.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifdown ] || exit 0
[ -x /usr/share/5gmodem/health.sh ] || exit 0
( /usr/share/5gmodem/health.sh event "$INTERFACE" ) >/dev/null 2>&1 </dev/null &
exit 0
