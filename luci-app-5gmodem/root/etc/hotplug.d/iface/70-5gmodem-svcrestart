#!/bin/sh
# Перезапустить выбранные сервисы, КОГДА аплинк реально понёс трафик.
#
# ЗАЧЕМ. Туннели и обходилки (ZeroBlock, passwall2, ssclash, podkop, zapret)
# стартуют по procd на START=99 и при старте проверяют интернет: резолвят домен
# подписки, пингуют, поднимают tun. На роутере с модемом интернета в этот момент
# ЕЩЁ НЕТ - модем в это время только перечисляется по USB, ищет сеть и звонит,
# и от включения до первого пакета проходит десятки секунд. Сервис стартует «в
# пустоту»: подписка не скачалась, DNS не поднялся, tun есть, а трафика нет.
# Сам он это заметит только на своём круге здоровья - у ZeroBlock, например,
# health_interval по умолчанию 600 c, то есть до десяти минут без интернета
# после каждой перезагрузки (живой отчёт владельца FM350, 28.08.2026).
#
# ПОЧЕМУ ЭТО НАША РАБОТА. Мы единственные на роутере знаем, когда аплинк стал
# рабочим: netifd шлёт ifup, а мы умеем проверить, что пакеты и правда ходят.
# Сервису достаточно рестарта в этот момент - он повторит ровно ту же
# инициализацию, но уже с интернетом.
#
# ЛЮБОЙ АПЛИНК, А НЕ ТОЛЬКО МОДЕМ. Первая версия срабатывала лишь на интерфейсах
# модемных секций - но беда не модемная: точно так же поздно поднимается Wi-Fi
# STA и проводной WAN по DHCP, и туннель точно так же стартует в пустоту.
# Поэтому берём ТОТ ЖЕ состав аплинков, что показывает «Приоритет интернета»:
# сети зоны wan плюс те, что несут default мимо зоны (extra_uplink_nets).
#
# ПРОВЕРЯЕМ ТРАФИК, А НЕ ФАКТ ifup. ifup приходит, когда интерфейс получил
# адрес, - до первого работающего пакета может быть ещё десяток секунд, а у
# «дырявого» аплинка их может не быть вовсе. Пингуем ЧЕРЕЗ УСТРОЙСТВО (-I): так
# проверка не зависит от того, что сейчас творится с маршрутом по умолчанию и с
# tun-ом самого сервиса, который мы и собираемся чинить.
#
# КОГО ПЕРЕЗАПУСКАТЬ - решает человек: галочка у карточки сервиса в «Виджетах»
# (config svcwidget, option restart_on_uplink). Список сервисов там уже есть -
# это те же карточки, по которым видно «работает/остановлен».
[ "$ACTION" = ifup ] || exit 0
[ -n "$INTERFACE" ] || exit 0

CFG=5gmodem

# Аплинк ли это. Состав тот же, что у «Приоритета интернета» и у сторожа
# (netpri.sh / health.sh): сети зоны wan плюс аплинки вне зоны, которые реально
# несут маршрут по умолчанию - на однопортовых роутерах WAN живёт в LAN-DHCP.
# Помощник общий, из lib.sh, чтобы состав не разошёлся с панелью приоритета.
. /usr/share/5gmodem/lib.sh 2>/dev/null
_z=$(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\([^.]*\)\.name='wan'\$/\1/p" | head -1)
_ups=""
[ -n "$_z" ] && _ups=$(uci -q get "firewall.$_z.network")
_ups="$_ups $(extra_uplink_nets "$_ups" 2>/dev/null | tr '\n' ' ')"
case " $_ups " in
	*" $INTERFACE "*) ;;
	*) exit 0 ;;
esac

# Кого перезапускать. Пустой список - выходим ДО фонового процесса и до пингов.
SVCS=""
for _w in $(uci -q show $CFG 2>/dev/null | sed -n "s/^\($CFG\.[^.]*\)\.restart_on_uplink='\{0,1\}1'\{0,1\}\$/\1/p"); do
	[ "$(uci -q get "$_w")" = svcwidget ] || continue
	_n=$(uci -q get "$_w.service")
	# Имя уходит в путь /etc/init.d/<имя> - проверяем ФОРМУ, а не доверяем uci.
	case "$_n" in ''|*[!A-Za-z0-9_.-]*) continue ;; esac
	[ -x "/etc/init.d/$_n" ] || continue
	SVCS="${SVCS:+$SVCS }$_n"
done
[ -n "$SVCS" ] || exit 0

(
	# Отвязка дескрипторов: hotplug не должен ждать ни пингов, ни рестартов.
	exec >/dev/null 2>&1 </dev/null

	DEV=$(ubus call network.interface."$INTERFACE" status 2>/dev/null \
		| jsonfilter -e '@["l3_device"]' 2>/dev/null)
	[ -n "$DEV" ] || exit 0

	# Ждём ПЕРВЫЙ прошедший пакет, до полутора минут. Не дождались - молча
	# уходим: аплинк поднялся, но не везёт, и рестарт сервиса тут ничего не
	# исправит.
	#
	# ПРОБУ СТРОГО ЧЕРЕЗ САМО УСТРОЙСТВО ТРЕБОВАТЬ НЕЛЬЗЯ. Первая версия ждала
	# именно `ping -I <l3-устройство>` - и не дожидалась НИКОГДА: -I задаёт лишь
	# адрес источника, а маршрут пакет выбирает по таблице. На роутере, где модем
	# не главный аплинк (стенд 29.08.2026: default via Wi-Fi metric 100, модем -
	# 110), device-bound проба не проходит в принципе, и хук молча не
	# перезапускал ничего. Выглядел он при этом рабочим только потому, что ни
	# один сервис не был помечен галочкой.
	#
	# Поэтому проба через устройство - ЖЕЛАТЕЛЬНЫЙ, но не обязательный сигнал:
	# сервису нужен ИНТЕРНЕТ, а не интернет строго через модем. Если роутер уже
	# в сети другим путём, лишний перезапуск придавит окно покоя ниже.
	_ok=0; _via=""
	_i=0
	while [ "$_i" -lt 30 ]; do
		if ping -c 1 -W 2 -I "$DEV" 77.88.8.8 >/dev/null 2>&1; then
			_ok=1; _via="через $DEV"; break
		fi
		if ping -c 1 -W 2 77.88.8.8 >/dev/null 2>&1; then
			_ok=1; _via="общим маршрутом"; break
		fi
		_i=$((_i + 1))
		sleep 3
	done
	[ "$_ok" = 1 ] || exit 0

	for _n in $SVCS; do
		# ЗАЩИТА ОТ ЧАСТЫХ КРУГОВ. Флап аплинка (или ifup сразу за ifup при
		# смене адреса) иначе перезапускал бы туннель раз в несколько секунд -
		# это хуже, чем один поздний старт. Две минуты покоя на сервис.
		_st="/tmp/5gmodem_svcup.$_n"
		if [ -f "$_st" ]; then
			_age=$(( $(date +%s) - $(date -r "$_st" +%s 2>/dev/null || echo 0) ))
			[ "$_age" -lt 120 ] && continue
		fi
		: > "$_st"
		logger -t 5gmodem "аплинк $INTERFACE ($DEV) понёс трафик $_via - перезапускаю $_n"
		/etc/init.d/"$_n" restart
	done
) &

exit 0
