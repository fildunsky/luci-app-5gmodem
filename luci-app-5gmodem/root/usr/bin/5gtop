		T_DL_LC="приём";            T_UL_LC="отдача"
		T_ONLINE="в сети";          T_ROAM="(роум.)"
		T_NOREG="нет рег.";         T_RUNNING="идёт"
		T_PRESS_S="нажмите t";      T_PRESS_S_LONG="нажмите t для запуска"
		T_AGO_H="ч назад";          T_AGO_M="м назад";    T_AGO_S="с назад"
		T_D="д"
		T_K_QUIT="выход";           T_K_REFRESH="обновить"
		T_K_TEST="тест";            T_K_PRI="приоритет";  T_K_MODEM="модем"
		T_ERR_NOSRC="не найден";    T_ERR_NOJF="нужен jsonfilter"
		T_TAB_NET="Сеть";           T_TAB_CELL="Сота"
		T_TAB_MODEM="Модем";        T_TAB_SMS="SMS"
		T_TAB_ESIM="eSIM";          T_ESIM_NA="eSIM на этом модеме недоступна"
		T_TAB_USSD="USSD";          T_TAB_AT="AT-консоль"
		T_SLOT="Слот SIM";          T_K_SLOT="слот SIM"
