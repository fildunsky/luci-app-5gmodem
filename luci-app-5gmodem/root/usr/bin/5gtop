T_NOCA="no aggregation";    T_NETPRI="Internet priority"
T_STATUS="Status";          T_COUNTRY="Country"
T_SERVICE="Service";        T_TEST="Test"
T_TESTING="Testing";        T_TRAFFIC="Traffic"
T_COLLECTING="collecting data...";  T_MBPS="Mbps"
T_DL_LC="download";         T_UL_LC="upload"
T_ONLINE="online";          T_ROAM="(roam.)"
T_NOREG="no reg.";          T_RUNNING="running"
T_PRESS_S="press t";        T_PRESS_S_LONG="press t to start"
T_AGO_H="h ago";            T_AGO_M="m ago";      T_AGO_S="s ago"
T_D="d"
T_K_QUIT="quit";            T_K_REFRESH="refresh"
T_K_TEST="test";            T_K_PRI="priority";   T_K_MODEM="modem"
T_ERR_NOSRC="not found";    T_ERR_NOJF="jsonfilter required"
T_TAB_NET="Network";        T_TAB_CELL="Cell info"
T_TAB_MODEM="Modem";        T_TAB_SMS="SMS"
T_TAB_ESIM="eSIM";          T_ESIM_NA="eSIM not available on this modem"
T_TAB_USSD="USSD";          T_TAB_AT="AT console"
