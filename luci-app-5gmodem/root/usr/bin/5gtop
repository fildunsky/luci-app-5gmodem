		T_ENTER_USSD="USSD-код";    T_ENTER_AT="AT-команда"
		T_SENDING="отправляю...";   T_K_INPUT="ввод"
		T_NOPORT="порт не задан";   T_USSD_NA="USSD на этом модеме не работает (проверено)"
		T_ESIM_LOAD="читаю профили...";    T_ESIM_ON="активен"
