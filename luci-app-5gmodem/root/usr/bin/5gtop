		T_PORTS="Порты";            T_STORAGE="Хранилище"
		T_K_TAB="вкладка";          T_SIM="SIM"
		T_K_WIDTH="ширина"
		T_IMEI="IMEI";              T_IMSI="IMSI";        T_ICCID="ICCID"
		T_FW="Прошивка";            T_PROTO="Протокол";   T_LOC="Страна"
		T_LAC="LAC";                T_TAC="TAC";          T_CID="CID"
		T_PATHLOSS="Потери";        T_TXPOWER="Мощн. TX"
		T_CQI="CQI";                T_UECAT="Кат. UE";    T_VOLTE="VoLTE"
		T_CSQ="CSQ";                T_ANT="Антенны";      T_PORT="Порт"
		T_RXDIV="Разнесение";       T_THROTTLE="Троттлинг";
		T_TH0="В норме"; T_TH1="Тёплый"; T_TH2="Горячий"; T_TH3="Критично"
		T_REGCS="Рег. CS"
		T_KIB="КиБ"; T_MIB="МиБ"; T_GIB="ГиБ"; T_TIB="ТиБ"
		T_RXDIV_4="вкл, 4RX";       T_RXDIV_2="вкл (2RX)";  T_RXDIV_OFF="выкл"
		;;
esac

SRC="/usr/share/5gmodem/5gmodem.sh"
[ -x "$SRC" ] || { echo "$T_ERR_NOSRC $SRC" >&2; exit 1; }
command -v jsonfilter >/dev/null 2>&1 || { echo "$T_ERR_NOJF" >&2; exit 1; }

ESC=$(printf '\033')
TABCH=$(printf '\t')
BSCH=$(printf '\010')
C_RST="${ESC}[0m";  C_DIM="${ESC}[2m";   C_B="${ESC}[1m"
C_GRN="${ESC}[32m"; C_YEL="${ESC}[33m";  C_RED="${ESC}[31m"
C_CYA="${ESC}[36m"; C_BLU="${ESC}[34m"

DATA="/tmp/5gtop.$$"
# файл, куда пишет ход теста speedtest.sh (тот же, что читает веб-страница)
STFILE="/tmp/5gmodem_speedtest.json"
NPFILE="$DATA.np"

# Индекс АКТИВНОГО аплинка в списке приоритетов.
#
# Здесь сравнивали метрику с единицей - а единицу интерфейс получает только
# после того, как пользователь САМ нажал выбор. На свежем роутере метрика у всех
# нулевая, и маркер не показывался ни у кого: список выглядел так, будто
# приоритета нет вовсе. Правило берём то же, что в веб-версии: наименьшая
# метрика, при равной - тот, у кого есть IP (поднятый Wi-Fi с адресом важнее
# неподнятого wan с той же метрикой).
np_active_idx() {   # $1 - JSON списка; печатает индекс (0..) или пусто
	_ai_best=""; _ai_bm=""; _ai_bip=0; _ai_n=0
	while [ "$_ai_n" -lt 8 ]; do
		_ai_if=$(printf '%s' "$1" | jsonfilter -e "@[$_ai_n].iface" 2>/dev/null)
		[ -n "$_ai_if" ] || break
		_ai_m=$(printf '%s' "$1" | jsonfilter -e "@[$_ai_n].metric" 2>/dev/null)
		case "$_ai_m" in ''|*[!0-9]*) _ai_m=0 ;; esac
		_ai_ip=$(printf '%s' "$1" | jsonfilter -e "@[$_ai_n].ip" 2>/dev/null)
		_ai_hip=0; [ -n "$_ai_ip" ] && _ai_hip=1
		if [ -z "$_ai_bm" ] || [ "$_ai_m" -lt "$_ai_bm" ] \
		   || { [ "$_ai_m" -eq "$_ai_bm" ] && [ "$_ai_hip" = 1 ] && [ "$_ai_bip" = 0 ]; }; then
			_ai_bm="$_ai_m"; _ai_best="$_ai_n"; _ai_bip="$_ai_hip"
		fi
		_ai_n=$((_ai_n + 1))
	done
	printf '%s' "$_ai_best"
}
SMSFILE="$DATA.sms"
ESFILE="$DATA.esim"
# Вывод у КАЖДОЙ консоли свой. Общий файл давал живую путаницу: ответ на
# AT-команду показывался и на вкладке USSD.
OUTFILE="$DATA.out"
DLBUSY="$DATA.dlbusy"
OUTBUSY="$DATA.outbusy"
ESBUSY="$DATA.esbusy"
SMSBUSY="$DATA.smsbusy"
FETCHING="$DATA.busy"
W=78            # ширина рамок
ROW_END=39
STTY_SAVE=$(stty -g 2>/dev/null)
cleanup() {
	rm -f "$DATA" "$FETCHING" "$DATA.tmp" "$NPFILE" "$NPFILE.tmp" \
		"$SMSFILE" "$SMSFILE.tmp" "$SMSFILE.raw" "$SMSBUSY" \
		"$ESFILE" "$ESFILE.tmp" "$ESBUSY" "$DATA.wrap" "$DATA.hint" \
		"$DATA.out.ussd" "$DATA.out.at" "$DATA.outbusy.ussd" "$DATA.outbusy.at" \
		"$DATA.owrap" "$DLBUSY" "$DATA.dlog"
	printf '%s[%d;1H%s[?25h%s\n' "$ESC" "$ROW_END" "$ESC" "$C_RST"
	stty "$STTY_SAVE" 2>/dev/null
	exit 0
}
trap cleanup INT TERM HUP

_spin=0
J=""
g() { printf '%s' "$J" | jsonfilter -e "@.$1" 2>/dev/null; }
# Профили пишут значения ДЛЯ ВЕБА и вставляют HTML-сущности (напр. "56.0 &deg;C").
# В терминале их надо раскодировать, иначе пользователь видит "&deg;" как текст.
v() {
	_x=$(g "$1")
	[ -n "$_x" ] && [ "$_x" != "-" ] || { printf '%s' "-"; return; }
	# Пробел ПЕРЕД знаком градуса убираем: "56°C" вместо "56 °C" - так плотнее и
	# не разрывается при обрезке строки по ширине терминала.
	printf '%s' "$_x" | sed -e 's/ *&deg;/°/g' -e 's/&deg;/°/g' -e 's/&nbsp;/ /g' -e 's/&amp;/\&/g' -e 's/&lt;/</g' -e 's/&gt;/>/g'
}

# УРОВЕНЬ ТЕПЛОВОГО ТРОТТЛИНГА - приписка к температуре, а не отдельная строка:
# сам по себе он ничего не значит, а рядом с градусами сразу отвечает на вопрос
# «модем греется - он уже режет скорость или ещё нет». Ноль (ограничения нет) НЕ
# показываем: это норма, и строка про норму только отвлекает.
_therm_suffix() {
	_th=$(g mtherm)
	case "$_th" in
		''|0|-) return ;;
	esac
	printf ' %s' "[$T_THROTTLE $_th]"
}

# Уровень троттлинга СЛОВОМ. Нужен там, где градусов нет вовсе: у части прошивок
# (Compal RXM-G1) их не отдаёт ни одна AT-команда - единственная тепловая
# +CEITHERM даёт только уровень 0-3. Раньше в графе стоял голый прочерк, хотя
# тепловое состояние модем сообщает. Слова те же, что в вебе, чтобы CLI и
# страница не расходились в формулировках.
_therm_word() {
	case "$(g mtherm)" in
		0) printf '%s' "$T_TH0" ;;
		1) printf '%s' "$T_TH1" ;;
		2) printf '%s' "$T_TH2" ;;
		3) printf '%s' "$T_TH3" ;;
		*) printf '%s' "-" ;;
	esac
}

# Содержимое графы «Темп.»: градусы, если прошивка их отдаёт, иначе - уровень
# троттлинга словом. $1 - уже собранное значение температуры.
# Вариант с припиской [Троттлинг N] - для широких раскладок; когда вместо
# градусов подставлено слово, приписка НЕ добавляется, иначе выходило бы
# «Горячий [Троттлинг 2]», то есть одно и то же дважды.
_temp_cell() {
	case "$1" in
		''|-) _therm_word ;;
		*)    printf '%s%s' "$1" "$(_therm_suffix)" ;;
	esac
}

# То же, но без приписки - для узкой колонки, где она не помещается.
_temp_cell_plain() {
	case "$1" in
		''|-) _therm_word ;;
		*)    printf '%s' "$1" ;;
	esac
}

# Номер абонента, а если его нет - страна сети. Правило то же, что в вебе:
# показывать «-» там, где место можно занять осмысленным значением, незачем.
_phone_or_loc() {
	_ph=$(g phone)
	if [ -n "$_ph" ] && [ "$_ph" != "-" ]; then v phone; return; fi
	_lc=$(g location)
	if [ -n "$_lc" ] && [ "$_lc" != "-" ]; then v location; return; fi
	printf '%s' "-"
}

# Оператор + КОД СЕТИ (MCC-MNC). Код нужен рядом с именем: у MVNO имя своё, а
# сеть чужая (Т-Мобайл работает на Tele2), и без кода непонятно, в чьей сети
# модем на самом деле.
_operator_plmn() {
	_op=$(v operator_name)
	_mc=$(g operator_mcc); _mn=$(g operator_mnc)
	case "$_mc$_mn" in
		''|*-*) printf '%s' "$_op"; return ;;
	esac
	printf '%s (%s-%s)' "$_op" "$_mc" "$_mn"
}

# ЕДИНИЦЫ ОБЪЁМА - НА ЯЗЫК ИНТЕРФЕЙСА. Значение приходит готовой строкой
# ("96.5 MiB") от ifconfig или hilink.sh, поэтому меняем только суффикс.
# Двоичные приставки по ГОСТ 8.417: КиБ, МиБ, ГиБ.
_bytes_l10n() {
	printf '%s' "$1" | sed -e "s/\bKiB\b/$T_KIB/" -e "s/\bMiB\b/$T_MIB/" \
		-e "s/\bGiB\b/$T_GIB/" -e "s/\bTiB\b/$T_TIB/"
}

# Длина в СИМВОЛАХ: wc -m в busybox считает байты (без locale), а кириллица и
# псевдографика в UTF-8 занимают по 2-3 байта - подписи и рамки разъезжались.
clen() { printf '%s' "$1" | tr -d '\200-\277' | wc -c; }
# pad <строка> <ширина> - вывести строку и ДОБРАТЬ ширину, НЕ рисуя пробелов.
# Пробел - это закрашенная ячейка (см. box_mid): в терминалах со своей темой
# такие «хвосты» после каждого значения выглядели чёрными прямоугольниками.
# Вместо них: ESC[<n>X стирает n ячеек (фоном ПО УМОЛЧАНИЮ, то есть темой) и
# НЕ двигает курсор, ESC[<n>C переставляет курсор за них. Пара нужна целиком:
# стирание убирает остаток прежнего, более длинного значения, а перевод курсора
# сохраняет раскладку колонок.
pad() {
	_l=$(clen "$1"); printf '%s' "$1"
	_n=$(( $2 - _l ))
	[ "$_n" -gt 0 ] && printf '%s[%dX%s[%dC' "$ESC" "$_n" "$ESC" "$_n"
	return 0
}
rep() { _i=0; while [ "$_i" -lt "$2" ]; do printf '%s' "$1"; _i=$((_i+1)); done; }

# clr <n> - стереть n ячеек справа от курсора, НЕ рисуя пробелов (ESC[<n>X).
# Нужно там, где значение стало короче прежнего: пробелы закрашивали бы фон
# (см. box_mid), а ECH стирает "прозрачно" - ячейка получает фон терминала.
clr() { [ "$1" -gt 0 ] 2>/dev/null && printf '%s[%dX' "$ESC" "$1"; }

# wrap <строка> <ширина> - разбить ПО СЛОВАМ, по строке на выход.
# fit() обрезает и ставит "~" - для подписи это правильно, колонка не должна
# разъезжаться. Но текст сообщения обрезать нельзя: на узком экране от него
# оставался огрызок. Слово шире строки рвём принудительно, иначе разбор зациклится.
wrap() {
	printf '%s' "$1" | awk -v w="$2" '
	{
		line = ""
		n = split($0, word, " ")
		for (i = 1; i <= n; i++) {
			t = word[i]
			if (t == "") continue
			while (length(t) > w) {
				if (line != "") { print line; line = "" }
				print substr(t, 1, w)
				t = substr(t, w + 1)
			}
			if (line == "") { line = t }
			else if (length(line) + 1 + length(t) <= w) { line = line " " t }
			else { print line; line = t }
		}
		if (line != "") print line
	}'
}

# fit <строка> <ширина> - ОБРЕЗАТЬ до ширины и добить пробелами.
# pad умеет только добивать, поэтому длинное значение вылезало за рамку: при
# агрегации режим принимает вид "LTE-A | B3 (1800 MHz) @20 MHz / B7 (2600 MHz)"
# и разносил блок «Сота» вправо. Обрезанное помечаем "~", чтобы было видно, что
# значение неполное.
# Подавать сюда ТОЛЬКО чистый текст: обрезка посреди цветовой последовательности
# испортила бы всю строку, поэтому цвет навешиваем уже на результат.
fit() {
	_s="$1"; _w="$2"; _l=$(clen "$_s")
	if [ "$_l" -gt "$_w" ]; then
		_s=$(printf '%s' "$_s" | cut -c1-$((_w - 1)))
		printf '%s~' "$_s"; _l=$(clen "$_s~")
	else
		printf '%s' "$_s"
	fi
	# добор ширины - тем же приёмом, что в pad: стереть и перескочить, не рисуя
	_n=$(( _w - _l ))
	[ "$_n" -gt 0 ] && printf '%s[%dX%s[%dC' "$ESC" "$_n" "$ESC" "$_n"
	return 0
}

qcolor() {
	_n=$(printf '%s' "$2" | tr -d '+' | cut -d. -f1)
	case "$_n" in ''|*[!0-9-]*|-) printf '%s' "$C_DIM"; return ;; esac
	case "$_n" in *[0-9]*) : ;; *) printf '%s' "$C_DIM"; return ;; esac
	case "$1" in
		rsrp) [ "$_n" -ge -90 ] && printf '%s' "$C_GRN" || { [ "$_n" -ge -105 ] && printf '%s' "$C_YEL" || printf '%s' "$C_RED"; } ;;
		rsrq) [ "$_n" -ge -10 ] && printf '%s' "$C_GRN" || { [ "$_n" -ge -15 ] && printf '%s' "$C_YEL" || printf '%s' "$C_RED"; } ;;
		sinr) [ "$_n" -ge 13 ]  && printf '%s' "$C_GRN" || { [ "$_n" -ge 0 ]   && printf '%s' "$C_YEL" || printf '%s' "$C_RED"; } ;;
		rssi) [ "$_n" -ge -65 ] && printf '%s' "$C_GRN" || { [ "$_n" -ge -85 ] && printf '%s' "$C_YEL" || printf '%s' "$C_RED"; } ;;
		*) printf '%s' "$C_RST" ;;
	esac
}

# Полоска уровня - аналог цветной шкалы под процентами в вебе.
bar() {
	_p=$(printf '%s' "$1" | tr -cd '0-9'); [ -n "$_p" ] || _p=0
	[ "$_p" -gt 100 ] && _p=100
	_w=${2:-14}; _f=$((_p * _w / 100))
	if   [ "$_p" -ge 60 ]; then _c="$C_GRN"
	elif [ "$_p" -ge 30 ]; then _c="$C_YEL"
	else _c="$C_RED"; fi
	printf '%s' "$_c"; rep '#' "$_f"
	printf '%s' "$C_DIM"; rep '.' "$((_w - _f))"
	printf '%s' "$C_RST"
}

# Мини-шкала метрики: где значение лежит внутри рабочего диапазона.
mbar() {
	_n=$(printf '%s' "$2" | tr -d '+' | cut -d. -f1)
	case "$_n" in ''|*[!0-9-]*|-) printf '%s' "$C_DIM"; rep '.' 8; printf '%s' "$C_RST"; return ;; esac
	case "$_n" in *[0-9]*) : ;; *) printf '%s' "$C_DIM"; rep '.' 8; printf '%s' "$C_RST"; return ;; esac
	case "$1" in
		rsrp) _lo=-125; _hi=-70 ;;
		rsrq) _lo=-20;  _hi=-3  ;;
		sinr) _lo=-10;  _hi=30  ;;
		rssi) _lo=-110; _hi=-50 ;;
		*) return ;;
	esac
	_p=$(( (_n - _lo) * 100 / (_hi - _lo) ))
	[ "$_p" -lt 0 ] && _p=0; [ "$_p" -gt 100 ] && _p=100
	_f=$((_p * 8 / 100))
	printf '%s' "$(qcolor "$1" "$2")"; rep '#' "$_f"
	printf '%s' "$C_DIM"; rep '.' "$((8 - _f))"
	printf '%s' "$C_RST"
}

# ВРЕМЯ СОЕДИНЕНИЯ, ИДУЩЕЕ ЖИВО. Опрос приходит раз в несколько секунд (на слабом
# роутере и вовсе раз в 10-15), поэтому значение из JSON прыгало бы рывками.
# Берём conn_time_sec как основу и досчитываем по возрасту файла с данными -
# секунды бегут ровно, а каждый опрос переустанавливает базу, так что расхождение
# не накапливается. Тот же приём, что на странице в LuCI.
uptime_str() {
	_b=$(g conn_time_sec)
	case "$_b" in ''|*[!0-9]*) printf '%s' "$(v conn_time)"; return ;; esac
	_age=0
	if [ -f "$DATA" ]; then
		_now=$(date +%s); _mt=$(date -r "$DATA" +%s 2>/dev/null || echo "$_now")
		_age=$((_now - _mt)); [ "$_age" -lt 0 ] && _age=0
	fi
	_s=$((_b + _age))
	_d=$((_s / 86400)); _h=$(((_s % 86400) / 3600))
	_m=$(((_s % 3600) / 60)); _x=$((_s % 60))
	if   [ "$_d" -gt 0 ]; then printf "%d$T_D %d:%02d:%02d" "$_d" "$_h" "$_m" "$_x"
	elif [ "$_h" -gt 0 ]; then printf '%d:%02d:%02d' "$_h" "$_m" "$_x"
	else printf '%d:%02d' "$_m" "$_x"; fi
}

# ── Рамки. Три блока в том же порядке, что секции веб-страницы.
# БЕЗ РАМОК. Раньше блоки обводились +---+ и боковыми |. Каждый такой символ -
# ЗАКРАШЕННАЯ ячейка: терминал заливает её фоном по умолчанию, а он совпадает с
# фоном окна далеко не всегда (тема со своим фоном, прозрачность, фоновая
# картинка). В Tabby на сером фоне рамки и их заливка лезли чёрными полосами
# поверх темы. Теперь заголовок блока - просто подпись, а «рамка» - воздух:
# ячеек не трогаем вовсе, под ними остаётся фон терминала.
#
# ЧИСЛО СТРОК СОХРАНЕНО НАМЕРЕННО (по одной на вызов): draw_* пишет значения по
# АБСОЛЮТНЫМ координатам строк, и убери мы хоть одну - разъехался бы весь экран.
# Цвет заголовка - ТОТ ЖЕ, которым подсвечены буквы клавиш (см. hl_name):
# жёлтый жирный. Одна акцентная краска на весь экран, а не своя у каждого блока.
box_top()  { printf '%s- %s -%s\n' "$C_B$C_YEL" "$1" "$C_RST"; }
box_mid()  { printf '\n'; }
box_end()  { printf '\n'; }

# Подсказка клавиш - ОДНОЙ функцией на все разделы. Раньше строка была
# продублирована в каждой рамке: при смене привязок их пришлось бы править
# поштучно, и подсказка неизбежно разошлась бы с действительностью.
# Клавиши подсвечены, подписи приглушены.
# Аргумент: строки "клавиша<TAB>подпись", по паре на строку.
keyhint() {
	# Клавиша подсвечивается ВНУТРИ слова - тем же приёмом, что в полосе вкладок:
	# "quit" с ярким q вместо "q quit". Если буквы в слове нет (русские подписи
	# против латинских клавиш, а также Tab/BkSp/Enter/1-3/+/-), hl_name сама
	# покажет клавишу перед словом - иначе её негде было бы увидеть.
	_kh() { printf '%s   ' "$(hl_name "$2" "$1" "$C_DIM")"; }
	printf '\n '
	_kh "q" "$T_K_QUIT"
	_kh "r" "$T_K_REFRESH"
	if [ -n "$1" ]; then
		printf '%s\n' "$1" | while IFS="$(printf '\t')" read -r _kk _kl; do
			[ -n "$_kk" ] || continue
			printf '%s   ' "$(hl_name "$_kl" "$_kk" "$C_DIM")"
		done
	fi
	# Переключение модема показываем, только если модемов больше одного.
	[ "$MCOUNT" -gt 1 ] && _kh "Tab" "$T_K_MODEM"
	printf '%s\n' "$(hl_name "$T_K_TAB" "BkSp" "$C_DIM")"
}

frame() {
	printf '%s[2J%s[H' "$ESC" "$ESC"
	[ "$NARROW" = 1 ] && { frame_narrow; return; }
	printf ' %s%s5gtop%s  %s%s\n' "$C_B" "$C_CYA" "$C_RST" "$C_DIM" "$C_RST"
	bar_modems
	bar_tabs
	# --- блок «Модем»: горизонтальный, как шапка в вебе ---
	box_top "$T_MODEM"
	box_mid; box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	# --- блок «Сота / Сигнал»: как одноимённая секция страницы ---
	box_top "$T_CELLSIG"
	box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_SPEED"
	box_mid; box_mid
	box_end
	box_top "$T_NETPRI"
	box_mid; box_mid; box_mid
	box_end
	# Блок агрегации рисуем ВСЕГДА, а наполняем по факту: появление и исчезновение
	# рамки на каждом опросе дёргало бы всю нижнюю часть экрана.
	box_top "$T_CA"
	box_mid; box_mid
	box_end
	# Без stty терминал остаётся в каноническом режиме: клавиша срабатывает
	# только после Enter. Честно предупреждаем, а не оставляем гадать.
	_ent=""
	[ "$HAS_STTY" = 1 ] || _ent=" ${C_DIM}(+Enter)${C_RST}"
	_kslot=""
	[ "$SLOT_CNT" -gt 1 ] && _kslot="\nk	$T_K_SLOT"
	keyhint "t	$T_K_TEST
1-3	$T_K_PRI$_kslot
+/-	$T_K_WIDTH"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=37
}

# ── ВКЛАДКИ ──────────────────────────────────────────────────────────────────
#
# Терминальный аналог веб-интерфейса: сверху та же навигация, что в браузере.
# Две полосы, как на странице:
#   1) вкладки МОДЕМОВ  - какой модем показываем (аналог .modembar);
#   2) вкладки РАЗДЕЛОВ - что именно показываем (аналог меню приложения).
#
# Раздел хранится в TAB (индекс в TAB_IDS). Отрисовка разведена по функциям
# frame_<id> / draw_<id>, поэтому добавить новый раздел - это добавить id в
# список и написать две функции; ни цикл, ни обработка клавиш не меняются.
# СОСТАВ ВКЛАДОК ЗАВИСИТ ОТ МОДЕМА. eSIM показываем только там, где eUICC
# действительно есть: на модеме без неё вкладка вела бы на пустой экран и
# только путала. Проверяем ОДИН раз при запуске - esim.sh status кэширует
# ответ, но сам вызов может уйти в порт, а делать это на каждом кадре нельзя.
TAB_IDS="net cell modem sms ussd at"
if [ -x /usr/share/5gmodem/esim.sh ]; then
	# СНАЧАЛА ГОТОВЫЙ ОТВЕТ. esim.sh сам кэширует состояние по USB-пути модема;
	# если файл есть, читаем его мгновенно. Опрос лезет в порт и занимает
	# секунды - платить их на КАЖДОМ запуске утилиты только ради состава
	# вкладок неправильно, это было заметно на глаз.
	_esc="/tmp/5gmodem_esimstat_$(uci -q get 5gmodem.@5gmodem[0].active_modem 2>/dev/null)"
	if [ -s "$_esc" ]; then
		grep -q '"available":1' "$_esc" 2>/dev/null && TAB_IDS="net cell modem sms esim ussd at"
	else
		( /usr/share/5gmodem/esim.sh status > /tmp/5gtop.es.$$ 2>/dev/null ) &
		_esp=$!; _esn=0
		while kill -0 "$_esp" 2>/dev/null; do
			_esn=$((_esn + 1))
			[ "$_esn" -ge 3 ] && { kill "$_esp" 2>/dev/null; break; }
			sleep 1
		done
		grep -q '"available":1' "/tmp/5gtop.es.$$" 2>/dev/null && TAB_IDS="net cell modem sms esim ussd at"
		rm -f "/tmp/5gtop.es.$$"
	fi
fi
# Стартовый раздел можно задать переменной: TAB=2 5gtop. Нужно и для проверки
# вёрстки без нажатий, и просто чтобы открывать сразу нужный экран.
case "${TAB:-1}" in
	''|*[!0-9]*) TAB=1 ;;
esac
[ "$TAB" -lt 1 ] 2>/dev/null && TAB=1

tab_name() {
	case "$1" in
		net)   printf '%s' "$T_TAB_NET" ;;
		cell)  printf '%s' "$T_TAB_CELL" ;;
		modem) printf '%s' "$T_TAB_MODEM" ;;
		sms)   printf '%s' "$T_TAB_SMS" ;;
		esim)  printf '%s' "$T_TAB_ESIM" ;;
		ussd)  printf '%s' "$T_TAB_USSD" ;;
		at)    printf '%s' "$T_TAB_AT" ;;
		*)    printf '%s' "$1" ;;
	esac
}

# Клавиша прямого перехода на вкладку - БУКВА ИЗ САМОГО НАЗВАНИЯ, она же
# подсвечивается в полосе (Network, Cell, Modem, SMS, eSIM). Ради этого
# переехали занятые ранее: модемы теперь на Tab, тест скорости - на t.
# Цифры не берём: они контекстные (приоритет на «Сети», профиль на eSIM).
tab_key() {
	case "$1" in
		net)   printf 'n' ;;
		cell)  printf 'c' ;;
		modem) printf 'm' ;;
		sms)   printf 's' ;;
		esim)  printf 'e' ;;
		ussd)  printf 'u' ;;
		at)    printf 'a' ;;
	esac
}

# Номер вкладки по её id - для прямого перехода клавишей.
tab_num() {
	_i=0
	for _t in $TAB_IDS; do
		_i=$((_i + 1))
		[ "$_t" = "$1" ] && { printf '%s' "$_i"; return; }
	done
}

tab_id() {   # id раздела по номеру
	_i=0
	for _t in $TAB_IDS; do
		_i=$((_i + 1))
		[ "$_i" = "$1" ] && { printf '%s' "$_t"; return; }
	done
}

tab_count() { printf '%s' "$(printf '%s\n' $TAB_IDS | grep -c .)"; }

# Подсветить в названии ту букву, которой раздел открывается. Ищем без учёта
# регистра; если буквы в названии нет (русские «Сеть»/«Сота» против латинских
# n/c), показываем клавишу ПЕРЕД названием - иначе её негде было бы увидеть.
hl_name() {   # $1 название, $2 клавиша, $3 цвет названия
	awk -v s="$1" -v k="$2" -v cn="$3" -v ck="$C_B$C_YEL" -v cr="$C_RST" 'BEGIN {
		p = index(s, toupper(k)); if (p == 0) p = index(s, tolower(k))
		if (p == 0) { printf "%s%s%s %s%s%s", ck, k, cr, cn, s, cr; exit }
		printf "%s%s%s%s%s%s%s%s", cn, substr(s, 1, p-1), cr, ck, substr(s, p, 1), cr, cn, substr(s, p+1)
		printf "%s", cr
	}'
}

# Полоса разделов: активный - ярко, остальные приглушены.
bar_tabs() {
	printf ' '
	_i=0
	for _t in $TAB_IDS; do
		_i=$((_i + 1))
		if [ "$_i" = "$TAB" ]; then
			printf '%s  ' "$(hl_name "$(tab_name "$_t")" "$(tab_key "$_t")" "$C_CYA$C_B")"
		else
			printf '%s  ' "$(hl_name "$(tab_name "$_t")" "$(tab_key "$_t")" "$C_DIM")"
		fi
	done
	printf '\n'
	printf '\n'   # воздух между полосой вкладок и первым блоком
}

# Полоса модемов: активный отмечен маркером. Список берём из конфига (он же
# источник для веб-вкладок), поэтому порядок и имена совпадают с браузером.
bar_modems() {
	[ "$MCOUNT" -gt 0 ] || { printf '\n'; return; }
	_cur=$(uci -q get 5gmodem.@5gmodem[0].active_modem)
	printf ' '
	# Два ОДИНАКОВЫХ модема дают одинаковое имя модели, и в полосе получались
	# два неотличимых ярлыка. К повторяющимся дописываем USB-путь: он привязан к
	# физическому разъёму и не меняется при перезагрузке.
	_dups=$(for _m in $MODEMS; do uci -q get "5gmodem.$_m.model"; done | sort | uniq -d)

	for _m in $MODEMS; do
		_p=$(uci -q get "5gmodem.$_m.path")
		_n=$(uci -q get "5gmodem.$_m.model")
		[ -n "$_n" ] || _n=$(uci -q get "5gmodem.$_m.product")
		[ -n "$_n" ] || _n="$_p"
		if [ -n "$_n" ] && [ -n "$_dups" ] && printf '%s\n' "$_dups" | grep -qxF "$_n"; then
			_n="$_n ($_p)"
		fi
		if [ "$_p" = "$_cur" ]; then
			printf '%s* %s%s  ' "$C_GRN$C_B" "$_n" "$C_RST"
		else
			printf '%s  %s%s  ' "$C_DIM" "$_n" "$C_RST"
		fi
	done
	printf '\n'
	printf '\n'   # воздух под полосой модемов
}

# at <строка> <колонка> <текст> - переписать только значение. [K не используем:
# в строке несколько колонок, и стирание до конца снесло бы соседние.
at() { printf '%s[%d;%dH%s' "$ESC" "$1" "$2" "$3"; }
# lab <строка> <колонка> <подпись> <ширина_подписи> <значение> <ширина_значения>
lab() { at "$1" "$2" "${C_DIM}$(pad "$3" "$4")${C_RST}$(pad "$5" "$6")"; }

# ── УЗКИЙ РЕЖИМ. На мобильном терминале три колонки не помещаются, поэтому
#    складываем всё в один столбец, сохраняя тот же порядок блоков.
frame_narrow() {
	printf ' %s%s5gtop%s\n' "$C_B" "$C_CYA" "$C_RST"
	# Полосы модемов и разделов нужны и на узком экране - это навигация, а не
	# украшение. Они переносятся сами: имена короткие.
	bar_modems
	bar_tabs
	box_top "$T_MODEM"
	box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_SIGNAL"
	box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_CELL"
	box_mid; box_mid; box_mid
	box_end
	box_top "$T_SPEED"
	box_mid; box_mid
	box_end
	box_top "$T_UPLINK"
	box_mid; box_mid
	box_end
	box_top "$T_CA"
	box_mid; box_mid
	box_end
	_ent=""
	[ "$HAS_STTY" = 1 ] || _ent=" ${C_DIM}+Enter${C_RST}"
	printf '\n %sq r s 1-3%s%s%s\n' "$C_DIM" "$MKEY" "$C_RST" "$_ent"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=36
}

# ── РАЗДЕЛ «СОТА». Полный набор строк, как в блоке «Информация о соте» веба,
#    плюс таблицы агрегации и антенных портов - в том же порядке.
frame_cell() {
	printf '%s[2J%s[H' "$ESC" "$ESC"
	printf ' %s%s5gtop%s\n' "$C_B" "$C_CYA" "$C_RST"
	bar_modems
	bar_tabs
	box_top "$T_CELL"
	box_mid; box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_SIGNAL"
	box_mid; box_mid; box_mid
	box_end
	box_top "$T_CA"
	box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_ANT"
	box_mid; box_mid; box_mid; box_mid
	box_end
	keyhint "t	$T_K_TEST
+/-	$T_K_WIDTH"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=32
}

draw_cell() {
	_r=$(( 6 + $(bar_modems >/dev/null; echo 0) ))   # строки шапки фиксированы
	_row=7
	# две колонки, как в вебе: слева идентификаторы соты, справа - её параметры
	lab $((_row))   2  "$T_LAC"      10 "$(fit "$(v lac_hex) / $(v lac_dec)" 26)" 26
	lab $((_row))   40 "$T_CID"      10 "$(fit "$(v cid_hex) / $(v cid_dec)" 26)" 26
	lab $((_row+1)) 2  "$T_TAC"      10 "$(fit "$(v tac_hex) / $(v tac_dec)" 26)" 26
	lab $((_row+1)) 40 "$T_ENB"      10 "$(fit "$(v enbid)" 26)" 26
	lab $((_row+2)) 2  'PCI'         10 "$(fit "$(v pci)" 26)" 26
	lab $((_row+2)) 40 'EARFCN'      10 "$(fit "$(v earfcn)" 26)" 26
	lab $((_row+3)) 2  "$T_BAND"     10 "$(fit "$(v pband)" 26)" 26
	lab $((_row+3)) 40 "$T_BW"       10 "$(fit "$(v bandwidth)" 26)" 26
	lab $((_row+4)) 2  "$T_PATHLOSS" 10 "$(fit "$(v pathloss)" 26)" 26
	lab $((_row+4)) 40 "$T_TXPOWER"  10 "$(fit "$(v txpower)" 26)" 26
	lab $((_row+5)) 2  "$T_CQI"      10 "$(fit "$(v cqi)" 26)" 26
	lab $((_row+5)) 40 "$T_UECAT"    10 "$(fit "$(v uecat)" 26)" 26

	_row=$((_row + 8))
	_a=$(v rsrp); _b=$(v rsrq); _c=$(v sinr); _e=$(v rssi)
	lab $((_row))   2  'RSRP' 8 "$(qcolor rsrp "$_a")$(pad "$_a" 8)${C_RST}$(mbar rsrp "$_a")" 28
	lab $((_row))   40 'RSRQ' 8 "$(qcolor rsrq "$_b")$(pad "$_b" 8)${C_RST}$(mbar rsrq "$_b")" 28
	lab $((_row+1)) 2  'SINR' 8 "$(qcolor sinr "$_c")$(pad "$_c" 8)${C_RST}$(mbar sinr "$_c")" 28
	lab $((_row+1)) 40 'RSSI' 8 "$(qcolor rssi "$_e")$(pad "$_e" 8)${C_RST}$(mbar rssi "$_e")" 28
	lab $((_row+2)) 2  "$T_CSQ"   8 "$(fit "$(v csq)" 20)" 20
	lab $((_row+2)) 40 "$T_VOLTE" 8 "$(fit "$(v volte)" 20)" 20
	# МЕТРИКИ 3G. Показываем ТОЛЬКО когда модем реально на 3G: на LTE они пусты,
	# и строка с прочерком занимала бы место, ничего не сообщая. RSCP - уровень
	# принимаемого кода, EcIo - отношение сигнал/помеха, аналоги RSRP и RSRQ.
	_rc=$(g rscp); _ei=$(g ecio)
	if { [ -n "$_rc" ] && [ "$_rc" != "-" ]; } || { [ -n "$_ei" ] && [ "$_ei" != "-" ]; }; then
		lab $((_row+3)) 2  'RSCP' 8 "$(fit "$(v rscp)" 20)" 20
		lab $((_row+3)) 40 'EcIo' 8 "$(fit "$(v ecio)" 20)" 20
	fi
	# Регистрация в голосовой сети - отдельно от пакетной: они расходятся, и
	# именно расхождение объясняет «звонки идут, интернета нет».
	_rg=$(g registration_cs)
	if [ -n "$_rg" ] && [ "$_rg" != "-" ]; then
		lab $((_row+4)) 2 "$T_REGCS" 8 "$(fit "$(v registration_cs)" 20)" 20
	fi

	# --- агрегация: PCC + до четырёх SCC, столбцами как в таблице веба ---
	_row=$((_row + 5))
	lab $((_row)) 2 '' 0 "${C_DIM}$(pad 'CC' 6)$(pad "$T_BAND" 20)$(pad 'PCI' 8)$(pad 'EARFCN' 10)$(pad 'RSRP' 8)$(pad 'MIMO' 6)$(pad 'MOD' 8)${C_RST}" 68
	at $((_row+1)) 2 "$(pad 'PCC' 6)$(pad "$(v pband)" 20)$(pad "$(v pci)" 8)$(pad "$(v earfcn)" 10)$(pad "$(v rsrp)" 8)$(pad "$(v pmimo)" 6)$(pad "$(v pmod)" 8)"
	_i=1
	while [ "$_i" -le 3 ]; do
		_b=$(v "s${_i}band")
		if [ -n "$_b" ] && [ "$_b" != "-" ]; then
			at $((_row+1+_i)) 2 "$(pad "SCC$_i" 6)$(pad "$_b" 20)$(pad "$(v "s${_i}pci")" 8)$(pad "$(v "s${_i}earfcn")" 10)$(pad "$(v "s${_i}rsrp")" 8)$(pad "$(v "s${_i}mimo")" 6)$(pad "$(v "s${_i}mod")" 8)"
		else
			at $((_row+1+_i)) 2 "$(pad '' 68)"
		fi
		_i=$((_i + 1))
	done

	# --- антенные порты: "0:-108:-13 1:-106:-11" ---
	_row=$((_row + 7))
	lab $((_row)) 2 '' 0 "${C_DIM}$(pad "$T_PORT" 8)$(pad 'RSRP' 10)$(pad 'RSRQ' 10)${C_RST}" 40
	_i=0
	for _ap in $(v antports); do
		[ "$_i" -ge 3 ] && break
		_pn=$(printf '%s' "$_ap" | cut -d: -f1)
		_pr=$(printf '%s' "$_ap" | cut -d: -f2)
		_pq=$(printf '%s' "$_ap" | cut -d: -f3)
		at $((_row+1+_i)) 2 "$(pad "$_pn" 8)$(pad "$_pr" 10)$(pad "$_pq" 10)"
		_i=$((_i + 1))
	done
	# РАЗНЕСЁННЫЙ ПРИЁМ - прямо под таблицей портов, как в вебе. Без него
	# таблица выше неполна: одинаковые уровни на портах означают «обе антенны
	# работают» ТОЛЬКО если разнесение включено, иначе второй приёмник просто
	# не задействован, и отличить одно от другого по уровням нельзя.
	_rd=$(g rxdiv)
	if [ -n "$_rd" ]; then
		case "$_rd" in
			4rx) _rdt="$T_RXDIV_4"; _rdc="$C_GRN" ;;
			2rx) _rdt="$T_RXDIV_2"; _rdc="$C_GRN" ;;
			off) _rdt="$T_RXDIV_OFF"; _rdc="$C_RED" ;;
			*)   _rdt="$_rd"; _rdc="" ;;
		esac
		lab $((_row + 4)) 2 "$T_RXDIV" 14 "${_rdc}$(fit "$_rdt" 20)${C_RST}" 20
	fi
	while [ "$_i" -lt 3 ]; do
		at $((_row+1+_i)) 2 "$(pad '' 40)"
		_i=$((_i + 1))
	done
}

# ── РАЗДЕЛ «МОДЕМ». Всё, что описывает САМ модуль и его подключение: то, что в
#    вебе разбросано по шапке и подсказкам. Данные берём из того же снимка, что
#    и остальные вкладки, - лишних обращений к порту нет.
# ── «СОТА» В УЗКОМ РЕЖИМЕ. Широкий вид кладёт значения в две колонки (вторая с
#    40-й позиции) и на телефоне разъезжается. Раньше вкладка в этом случае
#    ОТКАТЫВАЛАСЬ на «Сеть» - то есть по клавише c показывался не тот раздел.
#    Здесь тот же набор данных, но одним столбцом.
frame_cell_narrow() {
	printf '%s[2J%s[H' "$ESC" "$ESC"
	printf ' %s%s5gtop%s\n' "$C_B" "$C_CYA" "$C_RST"
	bar_modems
	bar_tabs
	box_top "$T_CELL"
	box_mid; box_mid; box_mid; box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_SIGNAL"
	box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_CA"
	box_mid; box_mid; box_mid
	box_end
	keyhint "+/-	$T_K_WIDTH"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=28
}

draw_cell_narrow() {
	_w=$((W - 14))
	_n() { printf '%s[%d;2H%s%s%s%s' "$ESC" "$1" "$C_DIM" "$(pad "$2" 11)" "$C_RST" "$3"; }
	_n 5  "$T_LAC"      "$(fit "$(v lac_hex) / $(v lac_dec)" $_w)"
	_n 6  "$T_CID"      "$(fit "$(v cid_hex) / $(v cid_dec)" $_w)"
	_n 7  "$T_TAC"      "$(fit "$(v tac_hex) / $(v tac_dec)" $_w)"
	_n 8  "$T_ENB"      "$(fit "$(v enbid)" $_w)"
	_n 9  'PCI/EARFCN'  "$(fit "$(v pci) / $(v earfcn)" $_w)"
	_n 10 "$T_BAND"     "$(fit "$(v pband)" $_w)"
	_n 11 "$T_BW"       "$(fit "$(v bandwidth)" $_w)"
	_n 12 "$T_CQI"      "$(fit "$(v cqi)  $T_UECAT $(v uecat)" $_w)"

	_a=$(v rsrp); _b=$(v rsrq); _c=$(v sinr); _e=$(v rssi)
	_n 15 'RSRP' "$(qcolor rsrp "$_a")$(pad "$_a" 8)${C_RST}$(mbar rsrp "$_a")"
	_n 16 'RSRQ' "$(qcolor rsrq "$_b")$(pad "$_b" 8)${C_RST}$(mbar rsrq "$_b")"
	_n 17 'SINR' "$(qcolor sinr "$_c")$(pad "$_c" 8)${C_RST}$(mbar sinr "$_c")"
	_n 18 'RSSI' "$(qcolor rssi "$_e")$(pad "$_e" 8)${C_RST}$(mbar rssi "$_e")"
	_n 19 "$T_TXPOWER" "$(fit "$(v txpower)" $_w)"

	# Агрегация: в узком режиме только диапазоны, без PCI/EARFCN - иначе строка
	# не помещается, а сам факт агрегации важнее её подробностей.
	_r=22; _any=0
	for _i in 1 2 3; do
		_sb=$(v "s${_i}band")
		[ "$_sb" = "-" ] && continue
		[ "$_r" -gt 24 ] && break
		_n "$_r" "SCC$_i" "$(fit "$_sb" $_w)"
		_r=$((_r + 1)); _any=1
	done
	[ "$_any" = 0 ] && { _n 22 '' "${C_DIM}$(fit "$T_NOCA" $_w)${C_RST}"; _r=23; }
	while [ "$_r" -le 24 ]; do _n "$_r" '' "$(fit '' $_w)"; _r=$((_r + 1)); done
}

frame_modem() {
	printf '%s[2J%s[H' "$ESC" "$ESC"
	printf ' %s%s5gtop%s\n' "$C_B" "$C_CYA" "$C_RST"
	bar_modems
	bar_tabs
	box_top "$T_MODEM"
	box_mid; box_mid; box_mid; box_mid; box_mid
	box_end
	box_top "$T_SIM"
	box_mid; box_mid; box_mid
	box_end
	box_top "$T_PORTS"
	box_mid; box_mid; box_mid
	box_end
	keyhint "+/-	$T_K_WIDTH"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=23
}

draw_modem() {
	_w=$((W - 26))
	lab 7  2 "$T_MODEL"  14 "$(fit "$(v modem)" $_w)" $_w
	lab 8  2 "$T_FW"     14 "$(fit "$(v firmware)" $_w)" $_w
	lab 9  2 "$T_IMEI"   14 "$(fit "$(v imei)" $_w)" $_w
	lab 10  2 "$T_TEMP"   14 "$(fit "$(_temp_cell "$(v mtemp)")" $_w)" $_w
	lab 11  2 "$T_PROTO"  14 "$(fit "$(v protocol)" $_w)" $_w

	lab 14 2 "$T_SIM"    14 "$(fit "$(v simslot)" $_w)" $_w
	lab 15 2 "$T_IMSI"   14 "$(fit "$(v imsi)" $_w)" $_w
	lab 16 2 "$T_ICCID"  14 "$(fit "$(v iccid)" $_w)" $_w

	# Порты и хранилище живут в конфиге, а не в снимке: читаем uci напрямую -
	# это дёшево и не трогает модем.
	lab 19 2 'AT'          14 "$(fit "$(v cport)" $_w)" $_w
	lab 20 2 'SMS'         14 "$(fit "$(uci -q get 5gmodem.sms.readport)" $_w)" $_w
	lab 21 2 "$T_STORAGE"  14 "$(fit "$(uci -q get 5gmodem.sms.storage)" $_w)" $_w
}

# ── РАЗДЕЛ «SMS». Список входящих, как на вкладке «Входящие» в вебе: отправитель
#    и время в строке-заголовке, текст под ней. Только чтение - ввод текста в
#    этом цикле сделать нельзя, для отправки есть веб-страница.
# Высота блока и сколько строк отводим тексту. При 9 строках и трёх строках на
# сообщение на экран влезало ВСЕГО ДВА сообщения, хотя в вебе их было четыре.
# Теперь блок выше, а тексту - две строки: список остаётся списком, а не
# читалкой, зато сообщений видно вчетверо больше.
SMS_ROWS=24
SMS_TEXT_LINES=2

frame_sms() {
	printf '%s[2J%s[H' "$ESC" "$ESC"
	printf ' %s%s5gtop%s\n' "$C_B" "$C_CYA" "$C_RST"
	bar_modems
	bar_tabs
	box_top "$T_TAB_SMS"
	_i=0
	while [ "$_i" -lt "$SMS_ROWS" ]; do box_mid; _i=$((_i + 1)); done
	box_end
	keyhint "+/-	$T_K_WIDTH"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=32
}

draw_sms() {
	_r=5
	# СУЩЕСТВОВАНИЕ файла, а не его размер: пустой файл означает «прочитали,
	# сообщений нет», и раньше он был неотличим от «ещё не читали» - обе ветки
	# давали -s = ложь, и надпись «читаю сообщения…» не сменялась никогда.
	if [ ! -e "$SMSFILE" ]; then
		at $_r 4 "${C_DIM}$(fit "$T_SMSLOAD" $((W - 6)))${C_RST}"
		_r=$((_r + 1))
	elif [ ! -s "$SMSFILE" ]; then
		at $_r 4 "${C_DIM}$(fit "$T_NOSMS" $((W - 6)))${C_RST}"
		_r=$((_r + 1))
	else
		_n=0
		# Готовые строки "отправитель<TAB>время<TAB>текст" от sms_merge.
		# IFS задаём ПРЕФИКСОМ команды - он действует только на этот read и не
		# протекает в остальной скрипт.
		while IFS="$(printf '\t')" read -r _sn _ts _tx; do
			[ -n "$_sn" ] || continue
			[ "$_r" -gt $((4 + SMS_ROWS - 1)) ] && break
			at $_r 4 "${C_B}$(fit "$_sn" 24)${C_RST}${C_DIM}$(fit "$_ts" $((W - 32)))${C_RST}"
			_r=$((_r + 1))
			# ТЕКСТ ПЕРЕНОСИМ, а не обрезаем: на узком экране от сообщения
			# оставался огрызок с "~". Строк на сообщение не больше трёх, иначе
			# одна длинная SMS вытеснила бы все остальные.
			_ln=0
			wrap "$_tx" $((W - 6)) | while read -r _wl; do
				[ "$_ln" -ge "$SMS_TEXT_LINES" ] && break
				printf '%s\n' "$_wl"
				_ln=$((_ln + 1))
			done > "$DATA.wrap"
			while read -r _wl; do
				[ "$_r" -gt $((4 + SMS_ROWS)) ] && break
				at $_r 4 "$(fit "$_wl" $((W - 6)))"
				_r=$((_r + 1))
			done < "$DATA.wrap"
			_r=$((_r + 1))
			_n=$((_n + 1))
		done < "$SMSFILE"
		[ "$_n" = 0 ] && { at 7 4 "${C_DIM}$(fit "$T_NOSMS" $((W - 6)))${C_RST}"; _r=6; }
	fi
	# гасим остаток блока, иначе от прошлого кадра останутся хвосты
	while [ "$_r" -le $((4 + SMS_ROWS)) ]; do
		at $_r 4 "$(fit '' $((W - 6)))"
		_r=$((_r + 1))
	done
}

# ── РАЗДЕЛ «eSIM». Список профилей eUICC и переключение активного цифрой.
#    Загрузка новых профилей сюда не вынесена: она требует ввода кода
#    активации, а в этом цикле ввода строки нет - для неё есть веб-страница.
ESIM_ROWS=8

frame_esim() {
	printf '%s[2J%s[H' "$ESC" "$ESC"
	printf ' %s%s5gtop%s\n' "$C_B" "$C_CYA" "$C_RST"
	bar_modems
	bar_tabs
	box_top "$T_TAB_ESIM"
	_i=0
	while [ "$_i" -lt "$ESIM_ROWS" ]; do box_mid; _i=$((_i + 1)); done
	box_end
	keyhint "1-6	$T_ESIM_HINT
Enter	$T_ESIM_ADD
+/-	$T_K_WIDTH"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=16
}

draw_esim() {
	_r=5
	# Идёт загрузка - показываем ход вместо списка: список сейчас всё равно
	# неактуален, а человеку важно видеть, что процесс не завис.
	if [ -f "$DLBUSY" ]; then
		at $_r 4 "${C_YEL}$(fit "$T_ESIM_DL" $((W - 6)))${C_RST}"
		_r=$((_r + 1))
		# последние шаги из живого лога lpac (тот же, что показывает веб)
		/usr/share/5gmodem/esim.sh progress 2>/dev/null \
			| sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
			| tail -6 > "$DATA.dlog" 2>/dev/null
		while read -r _dl; do
			[ "$_r" -gt $((4 + ESIM_ROWS)) ] && break
			at $_r 4 "${C_DIM}$(fit "$_dl" $((W - 6)))${C_RST}"
			_r=$((_r + 1))
		done < "$DATA.dlog"
		while [ "$_r" -le $((4 + ESIM_ROWS)) ]; do
			at $_r 4 "$(fit '' $((W - 6)))"
			_r=$((_r + 1))
		done
		return
	fi
	if [ ! -s "$ESFILE" ]; then
		at $_r 4 "${C_DIM}$(fit "$T_ESIM_LOAD" $((W - 6)))${C_RST}"
		_r=$((_r + 1))
	elif [ "$(jsonfilter -i "$ESFILE" -e '@.unavailable' 2>/dev/null)" = "1" ]; then
		at $_r 4 "${C_DIM}$(fit "$T_ESIM_NA" $((W - 6)))${C_RST}"
		_r=$((_r + 1))
	else
		_n=0
		while [ "$_n" -lt 6 ]; do
			_ic=$(jsonfilter -i "$ESFILE" -e "@.profiles.payload.data[$_n].iccid" 2>/dev/null)
			[ -n "$_ic" ] || break
			_st=$(jsonfilter -i "$ESFILE" -e "@.profiles.payload.data[$_n].profileState" 2>/dev/null)
			_nk=$(jsonfilter -i "$ESFILE" -e "@.profiles.payload.data[$_n].profileNickname" 2>/dev/null)
			[ -n "$_nk" ] && [ "$_nk" != "null" ] || \
				_nk=$(jsonfilter -i "$ESFILE" -e "@.profiles.payload.data[$_n].serviceProviderName" 2>/dev/null)
			[ -n "$_nk" ] && [ "$_nk" != "null" ] || _nk="$_ic"
			[ "$_r" -gt $((4 + ESIM_ROWS)) ] && break
			if [ "$_st" = "enabled" ]; then
				_mk="${C_GRN}*${C_RST}"; _nm="${C_B}${_nk}${C_RST}"; _sf="${C_GRN}${T_ESIM_ON}${C_RST}"
			else
				_mk="${C_DIM} ${C_RST}"; _nm="${C_DIM}${_nk}${C_RST}"; _sf=""
			fi
			at $_r 4 "$_mk ${C_YEL}$((_n + 1))${C_RST} $(pad "$_nm" 28)${C_DIM}$(pad "$_ic" $((W - 46)))${C_RST}$_sf"
			_r=$((_r + 1)); _n=$((_n + 1))
		done
		[ "$_n" = 0 ] && { at 7 4 "${C_DIM}$(fit "$T_ESIM_NA" $((W - 6)))${C_RST}"; _r=6; }
	fi
	while [ "$_r" -le $((4 + ESIM_ROWS)) ]; do
		at $_r 4 "$(fit '' $((W - 6)))"
		_r=$((_r + 1))
	done
}

# Загрузка нового профиля по коду активации. Долгая (обмен с сервером
# оператора занимает до нескольких минут), поэтому в фоне; ход показываем из
# того же живого лога, что читает веб-страница - esim.sh progress.
esim_download() {
	[ -n "$1" ] || return
	: > "$DLBUSY"
	( /usr/share/5gmodem/esim.sh progress reset >/dev/null 2>&1
	  /usr/share/5gmodem/esim.sh download "$1" > "$OUTFILE" 2>&1
	  # список профилей заведомо устарел - заставляем перечитать
	  rm -f "$ESFILE"
	  rm -f "$DLBUSY" ) >/dev/null 2>&1 </dev/null &
}

# Переключение профиля цифрой. Действие ДОЛГОЕ (lpac + переподнятие
# интерфейса), поэтому в фоне и с пометкой на экране.
esim_switch() {
	[ -s "$ESFILE" ] || return
	_i=$(( $1 - 1 ))
	_ic=$(jsonfilter -i "$ESFILE" -e "@.profiles.payload.data[$_i].iccid" 2>/dev/null)
	[ -n "$_ic" ] || return
	_st=$(jsonfilter -i "$ESFILE" -e "@.profiles.payload.data[$_i].profileState" 2>/dev/null)
	[ "$_st" = "enabled" ] && return
	at 6 4 "${C_YEL}$(fit "$T_ESIM_LOAD" $((W - 6)))${C_RST}"
	( /usr/share/5gmodem/esim.sh enable "$_ic" >/dev/null 2>&1
	  /usr/share/5gmodem/esim.sh reapply >/dev/null 2>&1
	  rm -f "$ESFILE" ) >/dev/null 2>&1 </dev/null &
}

# ── РАЗДЕЛЫ «USSD» и «AT-КОНСОЛЬ». Единственные, где нужен ВВОД СТРОКИ, а не
#    одиночная клавиша. Ради них цикл на время набора выходит из raw-режима
#    (см. read_line) - иначе набранное не отображалось бы и не работал бы забой.
CON_ROWS=12

frame_console() {   # $1 - заголовок, $2 - подсказка ввода
	printf '%s[2J%s[H' "$ESC" "$ESC"
	printf ' %s%s5gtop%s\n' "$C_B" "$C_CYA" "$C_RST"
	bar_modems
	bar_tabs
	box_top "$1"
	_i=0
	while [ "$_i" -lt "$CON_ROWS" ]; do box_mid; _i=$((_i + 1)); done
	box_end
	keyhint "Enter	$2"
	# Курсор паркуется ПОД этой рамкой. Значение своё у каждой: общее
	# ROW_END оставляло его то ниже экрана, то посреди данных.
	ROW_END=20
}

frame_ussd() { frame_console "$T_TAB_USSD" "$T_ENTER_USSD"; }
frame_at()   { frame_console "$T_TAB_AT"   "$T_ENTER_AT"; }

# Показать ответ модема из OUTFILE, перенося длинные строки.
draw_console() {
	_r=5
	if [ -f "$OUTBUSY" ]; then
		at $_r 4 "${C_YEL}$(fit "$T_SENDING" $((W - 6)))${C_RST}"
		_r=$((_r + 1))
	elif [ -s "$OUTFILE" ]; then
		# tr - убираем \r от модема: без этого курсор прыгает в начало строки
		tr -d '\r' < "$OUTFILE" | while read -r _ol; do
			printf '%s\n' "$_ol"
		done | while read -r _ol; do
			wrap "$_ol" $((W - 6))
		done > "$DATA.owrap"
		while read -r _ol; do
			[ "$_r" -gt $((4 + CON_ROWS)) ] && break
			at $_r 4 "$(fit "$_ol" $((W - 6)))"
			_r=$((_r + 1))
		done < "$DATA.owrap"
	fi
	while [ "$_r" -le $((4 + CON_ROWS)) ]; do
		at $_r 4 "$(fit '' $((W - 6)))"
		_r=$((_r + 1))
	done
}

draw_ussd() { OUTFILE="$DATA.out.ussd"; OUTBUSY="$DATA.outbusy.ussd"; draw_console; }
draw_at()   { OUTFILE="$DATA.out.at";   OUTBUSY="$DATA.outbusy.at";   draw_console; }

# ВВОД СТРОКИ. Единственное место, где чтение БЕЗ таймаута допустимо и нужно:
# оно происходит по явному нажатию Enter, человек в этот момент набирает текст,
# и ждать его - правильно. Во всех остальных местах файла таймаут обязателен
# (цикл отрисовки уже трижды из-за этого зависал).
# Результат кладём в ГЛОБАЛЬНУЮ _RL, а не печатаем.
# Раньше функция печатала введённое, и вызывали её через $( ) - а подстановка
# захватывает stdout ЦЕЛИКОМ, включая приглашение и управление курсором. Из-за
# этого: приглашение не доходило до экрана (курсор не переезжал на строку
# ввода, а сами коды попадали в результат и уходили модему как часть команды),
# и на экране потом виднелось "[20;1H[K...AT command:" текстом.
read_line() {   # $1 - подсказка; результат в $_RL
	_RL=""
	[ "$TTY" = 1 ] || return 1
	# Возврат в НОРМАЛЬНЫЙ режим: нужны эхо, забой и построчная сборка - всё то,
	# что raw-режим как раз выключает.
	[ "$HAS_STTY" = 1 ] && stty "$STTY_SAVE" 2>/dev/null
	printf '%s[%d;1H%s[K%s%s:%s ' "$ESC" "$ROW_END" "$ESC" "$C_B$C_YEL" "$1" "$C_RST"
	printf '%s[?25h' "$ESC"          # курсор на время набора виден
	IFS= read -r _rl
	printf '%s[?25l' "$ESC"
	[ "$HAS_STTY" = 1 ] && stty -echo -icanon min 0 time 1 2>/dev/null
	_RL="$_rl"
}

# Отправка в модем - в ФОНЕ: USSD ждёт ответа сети до полуминуты, и держать
# этим цикл отрисовки нельзя.
send_console() {   # $1 - тип (ussd|at), $2 - текст
	[ -n "$2" ] || return
	OUTFILE="$DATA.out.$1"; OUTBUSY="$DATA.outbusy.$1"
	: > "$OUTBUSY"
	( _p=""
	  case "$1" in
	  	ussd) _p=$(uci -q get 5gmodem.sms.ussdport) ;;
	  	at)   _p=$(uci -q get 5gmodem.sms.atport) ;;
	  esac
	  [ -n "$_p" ] || _p=$(uci -q get 5gmodem.@5gmodem[0].at_port)
	  if [ -z "$_p" ] || [ ! -e "$_p" ]; then
	  	printf '%s\n' "$T_NOPORT" > "$OUTFILE"
	  else
	  	case "$1" in
	  	ussd)
	  		# Ключи -R (сырой текст) и -r (PDU) берём из того же конфига, что
	  		# и веб-страница: у модемов это различается, и подбирать их заново
	  		# здесь значило бы разойтись с ней в поведении.
	  		set -- -d "$_p"
	  		[ "$(uci -q get 5gmodem.sms.ussd)" = "1" ] && set -- "$@" -R
	  		[ "$(uci -q get 5gmodem.sms.pdu)" = "1" ] && set -- "$@" -r
	  		sms_tool "$@" ussd "$2" > "$OUTFILE" 2>&1
	  		;;
	  	at) sms_tool -d "$_p" at "$2" > "$OUTFILE" 2>&1 ;;
	  	esac
	  fi
	  rm -f "$OUTBUSY" ) >/dev/null 2>&1 </dev/null &
}

draw_narrow() {
	_vc=13
	_l() { printf '%s[%d;2H%s%s%s%s' "$ESC" "$1" "$C_DIM" "$(pad "$2" 10)" "$C_RST" "$3"; }
	_l 5  "$T_MODEL"   "$(fit "$(v modem)" $((W - 12)))"
	_l 6  "$T_OPERATOR" "$(fit "$(_operator_plmn)" $((W - 12)))"
	_sg=$(v signal)
	_l 7  "$T_LEVEL"  "$(bar "$_sg" 10) ${C_B}${_sg}%${C_RST}  "
	_l 8  "$T_PHONE"  "$(pad "${C_DIM}$(_phone_or_loc)${C_RST}" $((W - 12)))"
	_t=$(v mtemp)
	case "$_t" in *C|-) : ;; *) _t="$_t °C" ;; esac
	_l 9  "$T_TEMP"    "$(pad "$(_temp_cell "$_t")" $((W - 12)))"

	_a=$(v rsrp); _b=$(v rsrq); _c=$(v sinr); _e=$(v rssi)
	_l 12 'RSRP'     "$(qcolor rsrp "$_a")$(pad "$_a" 8)${C_RST}$(mbar rsrp "$_a")"
	_l 13 'RSRQ'     "$(qcolor rsrq "$_b")$(pad "$_b" 8)${C_RST}$(mbar rsrq "$_b")"
	_l 14 'SINR'     "$(qcolor sinr "$_c")$(pad "$_c" 8)${C_RST}$(mbar sinr "$_c")"
	_l 15 'RSSI'     "$(qcolor rssi "$_e")$(pad "$_e" 8)${C_RST}$(mbar rssi "$_e")"

	# Режим и диапазон - самая длинная строка блока: при агрегации в MODE попадает
	# перечень всех компонентов. Собираем ЧИСТЫЙ текст, обрезаем, и только потом
	# красим - иначе обрезка попала бы в середину escape-кода.
	_md=$(v mode); _md=${_md%% | *}
	_mb=$(fit "${_md}  $(v pband)" $((W - 12)))
	_l 18 "$T_MODE"    "${C_CYA}${_mb}${C_RST}"
	_l 19 'PCI/EARF' "$(fit "$(v pci) / $(v earfcn)" $((W - 12)))"
	_l 20 'IP'       "${C_GRN}$(fit "$(v ipaddr)" 16)${C_RST}$(fit "$(uptime_str)" $((W - 29)))"

	if [ -f "$STFILE" ]; then
		_sj=$(cat "$STFILE" 2>/dev/null)
		_run=$(printf '%s' "$_sj" | jsonfilter -e '@.running' 2>/dev/null)
		if [ "$_run" = "1" ]; then
			_fr=$((_spin % 8)); _anim=""; _i=0
			while [ "$_i" -lt 8 ]; do
				[ "$_i" = "$_fr" ] && _anim="$_anim#" || _anim="$_anim."
				_i=$((_i + 1))
			done
			_l 23 "$T_TEST"  "$(pad "${C_YEL}${_anim}${C_RST} ${T_RUNNING}" $((W - 12)))"
			_l 24 ''      "$(pad '' $((W - 12)))"
		else
			_l 23 "$T_DL" "$(pad "${C_GRN}$(printf '%s' "$_sj" | jsonfilter -e '@.down_mbps' 2>/dev/null)${C_RST} ${T_MBPS}" $((W - 12)))"
			_l 24 "$T_UL" "$(pad "${C_BLU}$(printf '%s' "$_sj" | jsonfilter -e '@.up_mbps' 2>/dev/null)${C_RST} ${T_MBPS}" $((W - 12)))"
		fi
	else
		_l 23 "$T_TEST" "$(pad "$(hl_name "$T_PRESS_S" t "$C_DIM")" $((W - 12)))"
	fi

	# агрегация: в узком режиме только диапазоны, PCI и EARFCN не влезают
	_ar=29; _any=0
	for _i in 1 2 3 4; do
		_sb=$(v "s${_i}band")
		[ "$_sb" = "-" ] && continue
		[ "$_ar" -gt 30 ] && break
		printf '%s[%d;2H%sSCC%s%s %s' "$ESC" "$_ar" "$C_DIM" "$_i" "$C_RST" "$(fit "$_sb" $((W - 8)))"
		_ar=$((_ar + 1)); _any=1
	done
	while [ "$_ar" -le 30 ]; do
		printf '%s[%d;2H%s' "$ESC" "$_ar" "$(pad '' $((W - 2)))"
		_ar=$((_ar + 1))
	done
	[ "$_any" = 0 ] && printf '%s[29;2H%s%s%s' "$ESC" "$C_DIM" "$(pad "$T_NOCA" $((W - 2)))" "$C_RST"

	if [ -s "$NPFILE" ]; then
		_np=$(cat "$NPFILE" 2>/dev/null); _n=0; _rw=25
		_act=$(np_active_idx "$_np")
		while [ "$_n" -lt 2 ]; do
			_if=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].iface" 2>/dev/null)
			[ -n "$_if" ] || break
			_lb=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].label" 2>/dev/null)
			_mt=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].metric" 2>/dev/null)
			[ "$_n" = "$_act" ] && _mk="${C_GRN}>${C_RST}" || _mk=" "
			printf '%s[%d;2H%s %s%d%s %s' "$ESC" "$_rw" "$_mk" "$C_DIM" "$((_n + 1))" "$C_RST" "$(pad "$_lb" $((W - 8)))"
			_rw=$((_rw + 1)); _n=$((_n + 1))
		done
	fi
	printf '%s[%d;1H' "$ESC" "$ROW_END"
}

draw() {
	_spin=$((_spin + 1))
	if [ "$NARROW" = 1 ]; then
		_st=" "; [ -f "$FETCHING" ] && _st="${C_YEL}*${C_RST}"
		printf '%s[1;%dH%s%s%s' "$ESC" "$((W - 8))" "$C_DIM" "$(date '+%H:%M')" "$C_RST$_st"
		draw_narrow
		return
	fi
	_st=" "
	[ -f "$FETCHING" ] && _st="${C_YEL}*${C_RST}"
	at 1 62 "${C_DIM}$(date '+%H:%M:%S')${C_RST} $_st"

	# ── Блок «Модем». Три колонки, как горизонтальная шапка в вебе.
	#    Номера строк учитывают ДВЕ полосы навигации над рамками (модемы и
	#    разделы): всё сдвинуто на 2 относительно старой раскладки.
	_sg=$(v signal)
	at 7  4  "$(bar "$_sg" 14)"
	at 8  4  "$(pad "${C_B}${_sg}%${C_RST}" 22)"
	at 9  4  "${C_DIM}$(pad "$(v modem)" 22)${C_RST}"

	lab 7  28 "$T_OPERATOR" 11 "$(fit "$(_operator_plmn)" 16)" 16
	_r=$(v registration)
	case "$_r" in
		1) _rs="${C_GRN}${T_ONLINE}${C_RST}" ;;
		5) _rs="${C_GRN}${T_ONLINE}${C_RST} ${C_DIM}${T_ROAM}${C_RST}" ;;
		-) _rs="${C_DIM}-${C_RST}" ;;
		*) _rs="${C_YEL}${T_NOREG}${C_RST}" ;;
	esac
	lab 8  28 "$T_STATUS"   11 "$_rs" 16
	lab 9  28 "$T_PHONE"  11 "${C_DIM}$(_phone_or_loc)${C_RST}" 16
	# Слот SIM: у модемов с двумя слотами показываем ещё и то, что переключение
	# доступно клавишей - иначе о нём никак не догадаться.
	_sl=$(v simslot)
	[ "$SLOT_CNT" -gt 1 ] && _sl="$_sl ${C_DIM}(k)${C_RST}"
	lab 10  28 'SIM'      11 "$_sl" 16

	# Режим БЕЗ диапазона: профиль дописывает его в MODE ради веба, где отдельной
	# строки нет, а здесь она есть - иначе значение вылезает за рамку.
	_md=$(v mode); _md=${_md%% | *}
	lab 7  56 "$T_MODE"    9 "${C_CYA}${_md}${C_RST}" 12
	lab 8  56 'IP'       9 "${C_GRN}$(v ipaddr)${C_RST}" 12
	# IPv6 - только если оператор его выдал: у большинства российских сетей его
	# нет, и пустая строка была бы про отсутствующее.
	_v6=$(g ipaddr6)
	[ -n "$_v6" ] && [ "$_v6" != "-" ] && lab 9 56 'IPv6' 9 "${C_GRN}$(fit "$_v6" 12)${C_RST}" 12
	lab 9  56 "$T_TIME"    9 "$(uptime_str)" 12
	# Единицу дописываем ТОЛЬКО если её нет: часть профилей уже отдаёт "56.0 °C",
	# и без этой проверки получалось "56.0 °C C".
	_t=$(v mtemp)
	case "$_t" in *C|-) : ;; *) _t="$_t °C" ;; esac
	lab 10  56 "$T_TEMP"    9 "$(_temp_cell_plain "$_t")" 12
	lab 11  56 "$T_TRAFFIC"   9 "${C_DIM}v $(_bytes_l10n "$(v rx)")${C_RST}" 12
	at 12  56 "${C_DIM}$(pad "  ^ $(_bytes_l10n "$(v tx)")" 20)${C_RST}"

	# ── Блок «Сота / Сигнал» (строки 10-14). Тоже три колонки.
	_a=$(v rsrp); _b=$(v rsrq); _c=$(v sinr)
	at 16 4  "${C_DIM}RSRP${C_RST} $(qcolor rsrp "$_a")$(pad "$_a" 7)${C_RST}$(mbar rsrp "$_a")"
	at 17 4  "${C_DIM}RSRQ${C_RST} $(qcolor rsrq "$_b")$(pad "$_b" 7)${C_RST}$(mbar rsrq "$_b")"
	at 18 4  "${C_DIM}SINR${C_RST} $(qcolor sinr "$_c")$(pad "$_c" 7)${C_RST}$(mbar sinr "$_c")"
	_e=$(v rssi)
	at 19 4  "${C_DIM}RSSI${C_RST} $(qcolor rssi "$_e")$(pad "$_e" 7)${C_RST}$(mbar rssi "$_e")"

	lab 16 28 "$T_BAND" 11 "$(v pband)" 16
	lab 17 28 "$T_BW"   11 "$(v bandwidth)" 16
	lab 18 28 'PCI'      11 "$(v pci)" 16
	lab 19 28 'EARFCN'   11 "$(v earfcn)" 16

	lab 16 56 "$T_ENB"  10 "$(v enbid)" 11
	lab 17 56 'TAC'      10 "$(v tac_dec)" 11
	lab 18 56 'MIMO'     10 "$(v pmimo)" 11
	lab 19 56 'VoLTE'    10 "$(v volte)" 11

	# ── Блок «Скорость». Тот же speedtest.sh, что и кнопка в вебе: он пишет ход
	#    теста в JSON-файл, а мы его читаем - своего замера нет, значит и цифры
	#    совпадут со страницей. Сам тест НЕ запускается: только по клавише s.
	if [ -f "$STFILE" ]; then
		_sj=$(cat "$STFILE" 2>/dev/null)
		_srv=$(printf '%s' "$_sj" | jsonfilter -e '@.service' 2>/dev/null)
		_run=$(printf '%s' "$_sj" | jsonfilter -e '@.running' 2>/dev/null)
		_dn=$(printf '%s' "$_sj" | jsonfilter -e '@.down_mbps' 2>/dev/null)
		_up=$(printf '%s' "$_sj" | jsonfilter -e '@.up_mbps' 2>/dev/null)
		_ld=$(printf '%s' "$_sj" | jsonfilter -e '@.live_down' 2>/dev/null)
		_lu=$(printf '%s' "$_sj" | jsonfilter -e '@.live_up' 2>/dev/null)
		_ip=$(printf '%s' "$_sj" | jsonfilter -e '@.pub_ip' 2>/dev/null)
		_cc=$(printf '%s' "$_sj" | jsonfilter -e '@.cc' 2>/dev/null)

		if [ "$_run" = "1" ]; then
			# АНИМАЦИЯ. draw() вызывается раз в секунду, поэтому кадр можно просто
			# брать по счётчику: бегущий блок показывает, что процесс жив, даже
			# когда цифра live не меняется (а она подолгу стоит на месте, пока
			# curl разгоняет TCP).
			_fr=$((_spin % 8))
			_anim=""
			_i=0
			while [ "$_i" -lt 8 ]; do
				if [ "$_i" = "$_fr" ]; then _anim="$_anim#"; else _anim="$_anim."; fi
				_i=$((_i + 1))
			done
			if [ -n "$_lu" ] && [ "$_lu" != "0" ]; then
				_ph="${C_BLU}${T_UL_LC}${C_RST}"; _val="$_lu"; _c="$C_BLU"
			else
				_ph="${C_GRN}${T_DL_LC}${C_RST}";  _val="${_ld:-0}"; _c="$C_GRN"
			fi
			lab 22 4 "$T_TESTING" 12 "${_c}${_anim}${C_RST}  $_ph ${C_B}${_val}${C_RST} ${C_DIM}${T_MBPS}${C_RST}" 34
			lab 23 4 "$T_SERVICE"    12 "${C_DIM}${_srv}${C_RST}" 34
		else
			# Возраст результата: без него прошлый тест выглядит так, будто он
			# только что прошёл - именно это сбивало с толку при запуске.
			_ago=""
			_now=$(date +%s); _mt=$(date -r "$STFILE" +%s 2>/dev/null || echo "$_now")
			_sec=$((_now - _mt)); [ "$_sec" -lt 0 ] && _sec=0
			if   [ "$_sec" -lt 60 ];   then _ago="${_sec}$T_AGO_S"
			elif [ "$_sec" -lt 3600 ]; then _ago="$((_sec / 60))$T_AGO_M"
			else _ago="$((_sec / 3600))$T_AGO_H"; fi
			lab 22 4 "$T_DL"  12 "${C_GRN}$(pad "${_dn:--}" 8)${C_RST}${C_DIM}${T_MBPS}   ${_ago}${C_RST}" 34
			lab 23 4 "$T_UL" 12 "${C_BLU}$(pad "${_up:--}" 8)${C_RST}${C_DIM}${T_MBPS}   ${_srv}${C_RST}" 34
		fi
		lab 22 48 "$T_EXTIP" 12 "${C_DIM}${_ip:--}${C_RST}" 16
		lab 23 48 "$T_COUNTRY"     12 "${C_DIM}${_cc:--}${C_RST}" 16
	else
		lab 22 4 "$T_TEST" 12 "$(hl_name "$T_PRESS_S_LONG" t "$C_DIM")" 40
		lab 23 4 ''     12 "$(pad '' 40)" 40
	fi

	# ── Приоритет интернета. Тот же netpri.sh, что и полоса кнопок в вебе:
	#    метрика 1 = активный аплинк, остальные 20+. Переключение - цифрой.
	#
	# КАРТА СТРОК широкой раскладки (её задаёт frame(); при правке рамок эти
	# номера обязаны меняться вместе с ней):
	#    1 заголовок · 2 модемы · 3 вкладки
	#    4 рамка Модем        · 5-10 содержимое · 11 низ
	#   12 рамка Сота/Сигнал  · 13-17          · 18 низ
	#   19 рамка Скорость     · 20-21          · 22 низ
	#   23 рамка Аплинк       · 24-26          · 27 низ
	#   28 рамка Агрегация    · 29-30          · 31 низ
	#   33 подсказка клавиш
	_row=26; _idx=0
	if [ -s "$NPFILE" ]; then
		_np=$(cat "$NPFILE" 2>/dev/null)
		_n=0
		_act=$(np_active_idx "$_np")
		while [ "$_n" -lt 3 ]; do
			_if=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].iface" 2>/dev/null)
			[ -n "$_if" ] || break
			_lb=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].label" 2>/dev/null)
			_sb=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].sub" 2>/dev/null)
			_ipa=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].ip" 2>/dev/null)
			_mt=$(printf '%s' "$_np" | jsonfilter -e "@[$_n].metric" 2>/dev/null)
			_idx=$((_n + 1))
			if [ "$_n" = "$_act" ]; then
				_mk="${C_GRN}>${C_RST}"; _nm="${C_B}${_lb}${C_RST}"
			else
				_mk="${C_DIM} ${C_RST}"; _nm="${C_DIM}${_lb}${C_RST}"
			fi
			at "$_row" 4 "$_mk ${C_DIM}${_idx}${C_RST} $(pad "$_nm" 22)${C_DIM}$(pad "$_sb" 22)${C_RST}$(pad "${_ipa:--}" 18)"
			_row=$((_row + 1)); _n=$((_n + 1))
		done
	else
		at 26 4 "${C_DIM}$(pad "$T_COLLECTING" 60)${C_RST}"
	fi

	# ── Агрегация. Компоненты SCC1..4 отдаются теми же ключами, что читает
	#    веб-страница. Показываем только те, по которым есть данные: на модеме без
	#    агрегации строки просто остаются пустыми, а рамка не прыгает.
	_ar=29; _any=0
	for _i in 1 2 3 4; do
		_sb=$(v "s${_i}band")
		[ "$_sb" = "-" ] && continue
		[ "$_ar" -gt 30 ] && break
		at "$_ar" 4 "${C_DIM}SCC${_i}${C_RST} $(pad "$_sb" 26)${C_DIM}PCI${C_RST} $(pad "$(v s${_i}pci)" 8)${C_DIM}EARFCN${C_RST} $(pad "$(v s${_i}earfcn)" 10)"
		_ar=$((_ar + 1)); _any=1
	done
	while [ "$_ar" -le 30 ]; do
		at "$_ar" 4 "$(pad '' 60)"
		_ar=$((_ar + 1))
	done
	[ "$_any" = 0 ] && at 31 4 "${C_DIM}$(pad "$T_NOCA" 60)${C_RST}"

	printf '%s[%d;1H' "$ESC" "$ROW_END"
}

TTY=0
[ -t 0 ] && [ -t 1 ] && TTY=1

# ШИРИНА ТЕРМИНАЛА. Ни stty size, ни tput cols, ни $COLUMNS на этом busybox не
# работают (проверено), поэтому спрашиваем у САМОГО ТЕРМИНАЛА: ставим курсор в
# заведомо дальний угол и запрашиваем его позицию (ESC[6n). Терминал отвечает
# "ESC[строка;колонкаR" - колонка и есть ширина. Приём универсальный и не
# требует ни terminfo, ни расширений shell.
# Есть ли stty. На части сборок OpenWrt его НЕТ ВООБЩЕ (проверено: busybox на
# MT7628 отвечает "stty: not found"). Без него нельзя ни выключить эхо, ни снять
# канонический режим - а значит запрос ширины у терминала не сработает: ответ
# уйдёт на экран, а в переменную не попадёт. Все прошлые странности - висящий
# dd, блокирующийся read, "^[[42;147R" поверх интерфейса - следствия ровно этого.
HAS_STTY=0
command -v stty >/dev/null 2>&1 && HAS_STTY=1

term_width() {
	_w=""
	# ПЕРВЫЙ источник - stty size: размер окна хранит ЯДРО (ioctl на pty; ssh
	# передаёт его при каждом изменении окна), терминал спрашивать не нужно и
	# ждать ответа тоже. CPR-запрос ниже остаётся фолбэком: он требует, чтобы
	# терминал ОТВЕТИЛ, а отвечают не все - у пользователя на широком экране
	# ширина не определялась и раскладка падала в узкую (60 колонок).
	if [ "$HAS_STTY" = 1 ]; then
		_w=$(stty size 2>/dev/null | cut -d' ' -f2)
		case "$_w" in ''|*[!0-9]*|0) _w="" ;; esac
		[ -n "$_w" ] && { printf '%s' "$_w"; return; }
	fi
	# Без stty спрашивать бессмысленно - сразу отдаём безопасное умолчание.
	if [ "$TTY" = 1 ] && [ "$HAS_STTY" = 1 ]; then
		stty -echo -icanon min 0 time 1 2>/dev/null
		printf '%s[999;999H%s[6n' "$ESC" "$ESC"
		_r=""; _i=0
		while [ "$_i" -lt 12 ]; do
			_ch=""
			# -t обязателен: read без таймаута виснет навсегда. В этом файле такое
			# случалось трижды, правило простое - никакого чтения без таймаута.
			read -t 1 -r -n 1 _ch 2>/dev/null
			[ -n "$_ch" ] || break
			case "$_ch" in R) break ;; esac
			_r="$_r$_ch"
			_i=$((_i + 1))
		done
		_w=${_r##*;}
	fi
	# УМОЛЧАНИЕ 60, А НЕ 80. Когда ширину узнать нельзя, выбираем то, что влезает
	# и на телефон, и на десктоп: широкая раскладка требует 78 колонок и на
	# мобильном экране разъезжается, а узкая на большом экране просто не
	# растягивается на всю ширину - это не мешает.
	case "$_w" in ''|*[!0-9]*) _w=60 ;; esac
	[ "$_w" -lt 30 ] 2>/dev/null && _w=30
	printf '%s' "$_w"
}

# Ширину можно задать явно: 5gtop 5 46  или  COLS=46 5gtop
# Нужно и для узких терминалов, где автоопределение не срабатывает (не всякий
# терминал отвечает на запрос позиции курсора), и просто чтобы посмотреть, как
# всё ляжет на мобильном экране, не подключаясь с телефона.
# Ширина, ЗАДАННАЯ ЯВНО (аргументом или COLS), - осознанный выбор пользователя:
# на изменение окна такую не пересчитываем (см. _on_winch).
TW_FIXED=0
case "$TWARG" in ''|*[!0-9]*) ;; *) TW_FIXED=1 ;; esac
[ "$TW_FIXED" = 1 ] || case "$COLS" in ''|*[!0-9]*) ;; *) TW_FIXED=1 ;; esac

TW="$TWARG"
[ -n "$TW" ] || TW="$COLS"
case "$TW" in ''|*[!0-9]*) TW=$(term_width) ;; esac
# term_width всегда возвращает число, но подстрахуемся: любое НЕ-число здесь
# уронило бы арифметику ниже (именно так скрипт и падал на живом терминале).
case "$TW" in ''|*[!0-9]*) TW=80 ;; esac
[ "$TW" -lt 30 ] && TW=30
# Узкий режим - когда три колонки уже не помещаются. Тогда всё в один столбец.
# Вынесено в функцию: ширину можно менять НА ХОДУ клавишами +/- (не всякий
# терминал сообщает размер, а перезапускать ради подгонки неудобно). В широком
# режиме рамки тянутся за TW (W=TW-2), колонки значений остаются на месте -
# лишняя ширина просто остаётся полем справа.
apply_width() {
	[ "$TW" -lt 30 ]  && TW=30
	[ "$TW" -gt 220 ] && TW=220
	if [ "$TW" -ge 80 ]; then
		NARROW=0; W=$((TW - 2)); ROW_END=37
	else
		NARROW=1; W=$((TW - 2)); ROW_END=36
	fi
}
apply_width
[ "$W" -lt 28 ] && W=28

# СКЛЕЙКА МНОГОЧАСТНЫХ SMS. Длинное сообщение приходит кусками, и по
# отдельности они бесполезны. Части одного сообщения несут ОДИН И ТОТ ЖЕ
# UDH-reference, но приходят с чуть разными метками времени (расходятся на
# секунды), поэтому группировать по времени нельзя - именно так сообщение и
# рассыпалось на вкладке. Группируем по reference, склеиваем по номеру части.
# Та же логика, что на веб-странице.
#
# Делаем это в ФОНОВОМ проходе и отдаём отрисовке готовые строки
# "отправитель<TAB>время<TAB>текст": в цикле отрисовки разбирать JSON заново
# было бы дорого, а jsonfilter - это форк на каждое поле.
sms_merge() {
	_raw="$1"

	# ЧИНИМ КОДИРОВЩИК sms_tool ПЕРЕД РАЗБОРОМ.
	# У sms_tool 2025.08.x в JSON-выводе (-j) кодпойнты с МЛАДШИМ байтом >= 0x80
	# (U+00A0 неразрывный пробел, кавычки «» U+00AB/BB и прочие) знакорасширяются:
	# вместо "\u00a0" печатается "\u00ffffffa0". Дальше это доходит до экрана как
	# "сÿffffa0симки" вместо "с симки". Веб-страница чинит это тем же шаблоном
	# (см. readsms.js) - переносим сюда, иначе один и тот же текст выглядит
	# по-разному в браузере и в терминале.
	# Настоящее место исправления - сам sms_tool.
	_fix="$_raw.fix"
	sed 's/\\u\([0-9a-fA-F]\{2\}\)f\{6\}\([0-9a-fA-F]\{2\}\)/\\u\1\2/g' \
		"$_raw" > "$_fix" 2>/dev/null && [ -s "$_fix" ] && _raw="$_fix"

	_n=0
	# 40 сообщений с запасом: в SIM их обычно 15-30
	while [ "$_n" -lt 40 ]; do
		# ОДИН ВЫЗОВ НА СООБЩЕНИЕ, А НЕ ШЕСТЬ. jsonfilter принимает несколько -e
		# и печатает значения по порядку, по строке на каждое. Раньше на каждое
		# поле шёл свой запуск: 6 форков x 15 сообщений = 90, и на MT7628 под
		# нагрузкой это растягивалось на десятки секунд - список сообщений
		# появлялся почти через минуту. Текст запрашиваем ПОСЛЕДНИМ: если внутри
		# него есть переводы строк, они просто добавятся в хвост, и мы соберём
		# всё, что после пятой строки.
		_all=$(jsonfilter -i "$_raw" \
			-e "@.msg[$_n].sender" -e "@.msg[$_n].timestamp" \
			-e "@.msg[$_n].reference" -e "@.msg[$_n].part" \
			-e "@.msg[$_n].total" -e "@.msg[$_n].content" 2>/dev/null)
		_sn=$(printf '%s\n' "$_all" | sed -n 1p)
		[ -n "$_sn" ] || break
		_ts=$(printf '%s\n' "$_all" | sed -n 2p)
		_rf=$(printf '%s\n' "$_all" | sed -n 3p)
		_pt=$(printf '%s\n' "$_all" | sed -n 4p)
		_tt=$(printf '%s\n' "$_all" | sed -n 5p)
		# Хвост (6-я строка и дальше) - текст. Переводы строк внутри него
		# заменяем пробелами; завершающий уже снят подстановкой $( ).
		_tx=$(printf '%s\n' "$_all" | sed -n '6,$p' | tr '\n\t' '  ')
		# Декодер sms_tool заменяет U+0080..U+00FF на «замещающий символ» (U+FFFD).
		# Операторы ставят там в основном пробелы, поэтому меняем на пробел -
		# ровно как веб-страница, чтобы текст читался одинаково.
		_tx=$(printf '%s' "$_tx" | sed 's/\xef\xbf\xbd/ /g; s/[[:space:]]*$//')
		case "$_tt" in ''|*[!0-9]*) _tt=1 ;; esac
		case "$_pt" in ''|*[!0-9]*) _pt=1 ;; esac
		# одиночные держим порознь по индексу, иначе два разных сообщения от
		# одного отправителя слиплись бы в одно
		if [ "$_tt" -gt 1 ] && [ -n "$_rf" ]; then
			_key="r|$_sn|$_rf|$_tt"
		else
			_key="s|$_n"
		fi
		printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$_key" "$_pt" "$_sn" "$_ts" "$_tx" "$_tt"
		_n=$((_n + 1))
	done | awk -F'\t' '
		{
			key = $1; part = $2 + 0
			if (!(key in seen)) { seen[key] = 1; order[++cnt] = key; snd[key] = $3; tim[key] = $4 }
			txt[key SUBSEP part] = $5
			if (part > maxp[key]) maxp[key] = part
			if ($6 + 0 > tot[key]) tot[key] = $6 + 0
		}
		END {
			# порядок сообщений сохраняем ПО ПЕРВОМУ ПОЯВЛЕНИЮ: sms_tool отдаёт
			# их в нужном порядке, и пересортировка сломала бы его
			for (i = 1; i <= cnt; i++) {
				k = order[i]; out = ""; have = 0
				for (p = 1; p <= maxp[k]; p++) {
					if ((k SUBSEP p) in txt) { out = out txt[k SUBSEP p]; have++ }
				}
				# ЧАСТЕЙ МЕНЬШЕ, ЧЕМ ЗАЯВЛЕНО. Такое бывает не по нашей вине:
				# на ПЕРЕПОЛНЕННОЙ SIM хвост длинного сообщения просто не
				# помещается (наблюдалось: 3 части из 5 при 15/15). Молча
				# показать обрывок нельзя - человек решит, что это мы обрезали.
				if (tot[k] > 0 && have < tot[k]) out = out sprintf(" [%d/%d]", have, tot[k])
				printf "%s\t%s\t%s\n", snd[k], tim[k], out
			}
		}'
}

# Чтение профилей eSIM. Как и SMS - в фоне и только при открытой вкладке:
# lpac держит логический канал eUICC и отвечает секунды.
fetch_esim() {
	[ -f "$ESBUSY" ] && return
	( : > "$ESBUSY"
	  _st=$(/usr/share/5gmodem/esim.sh status 2>/dev/null)
	  if [ "$(printf '%s' "$_st" | jsonfilter -e '@.available' 2>/dev/null)" = "1" ]; then
	  	/usr/share/5gmodem/esim.sh dump > "$ESFILE.tmp" 2>/dev/null
	  	[ -s "$ESFILE.tmp" ] && mv "$ESFILE.tmp" "$ESFILE"
	  else
	  	printf '{"unavailable":1}\n' > "$ESFILE"
	  fi
	  rm -f "$ESBUSY" ) >/dev/null 2>&1 </dev/null &
}

# Чтение входящих. ОТДЕЛЬНО от fetch(): sms_tool на части модемов отвечает
# секунды, и держать этим секундный цикл отрисовки нельзя. Зовём только когда
# открыта вкладка SMS - на других она не стоит ни одного обращения к порту.
fetch_sms() {
	[ -f "$SMSBUSY" ] && return
	( : > "$SMSBUSY"
	  _p=$(uci -q get 5gmodem.sms.readport)
	  _s=$(uci -q get 5gmodem.sms.storage)
	  if [ -n "$_p" ] && [ -e "$_p" ]; then
	  	# ЧЕРЕЗ smsbridge.sh, а не напрямую sms_tool: мост встаёт в общую очередь
	  	# к AT-порту (atlock.sh) и умеет HiLink-модемы, у которых SMS читаются по
	  	# HTTP. Прямой вызов лез в порт мимо очереди и сталкивался с опросом
	  	# метрик - чтение подвисало.
	  	/usr/share/5gmodem/smsbridge.sh recv "${_s:-ME}" "$_p" > "$SMSFILE.raw" 2>/dev/null
	  	[ -s "$SMSFILE.raw" ] && sms_merge "$SMSFILE.raw" > "$SMSFILE.tmp" 2>/dev/null
	  	# ФАЙЛ ПУБЛИКУЕМ ВСЕГДА, в том числе ПУСТОЙ. Раньше mv стоял под
	  	# проверкой -s, и при отсутствии сообщений файл не создавался вовсе - а
	  	# отрисовка считает несуществующий файл признаком «ещё читаю» и вечно
	  	# показывала «читаю сообщения…». Пустой файл = «прочитали, сообщений нет».
	  	[ -f "$SMSFILE.tmp" ] || : > "$SMSFILE.tmp"
	  	mv "$SMSFILE.tmp" "$SMSFILE"
	  	rm -f "$SMSFILE.raw"
	  fi
	  rm -f "$SMSBUSY" ) >/dev/null 2>&1 </dev/null &
}

fetch() {
	[ -f "$FETCHING" ] && return
	( : > "$FETCHING"
	  # cached, а не json: в порт ходит один процесс (блокировка в 5gmodem.sh),
	  # остальные читают снимок. Открытая рядом веб-страница больше не удваивает
	  # нагрузку на AT-порт - раньше вдвоём они замедляли опрос втрое.
	  $SRC cached "$INTERVAL" > "$DATA.tmp" 2>/dev/null
	  [ -s "$DATA.tmp" ] && mv "$DATA.tmp" "$DATA"
	  # Приоритеты тянем ТЕМ ЖЕ фоновым проходом: netpri.sh list стоит ~1.7 c,
	  # в секундном цикле отрисовки это заметно подвесило бы экран.
	  /usr/share/5gmodem/netpri.sh list > "$NPFILE.tmp" 2>/dev/null
	  [ -s "$NPFILE.tmp" ] && mv "$NPFILE.tmp" "$NPFILE"
	  rm -f "$FETCHING" ) >/dev/null 2>&1 </dev/null &
}

# СЛОТЫ SIM. Есть не у всех модемов: simslot.sh отдаёт пустой список там, где
# слот один или переключение не поддерживается. Читаем при запуске - список
# слотов не меняется, пока модем тот же.
# ОДИН вызов, а не два: simslot.sh может обращаться к модему, и делать это
# дважды подряд ради двух полей - лишняя задержка при запуске.
_slj=$(/usr/share/5gmodem/simslot.sh status 2>/dev/null)
SLOTS=$(printf '%s' "$_slj" | jsonfilter -e '@.slots[*].id' 2>/dev/null | tr '\n' ' ')
SLOT_ACTIVE=$(printf '%s' "$_slj" | jsonfilter -e '@.active' 2>/dev/null)
SLOT_CNT=$(printf '%s' "$SLOTS" | wc -w)

# Переключить на СЛЕДУЮЩИЙ слот. Действие долгое (модем перезапускается), поэтому
# в фоне и с пометкой на экране.
switch_slot() {
	[ "$SLOT_CNT" -gt 1 ] || return
	_next=""; _first=""; _take=0
	for _s in $SLOTS; do
		[ -z "$_first" ] && _first="$_s"
		[ "$_take" = 1 ] && { _next="$_s"; _take=0; }
		[ "$_s" = "$SLOT_ACTIVE" ] && _take=1
	done
	[ -n "$_next" ] || _next="$_first"
	at 6 4 "${C_YEL}$(fit "$T_SLOT_SW" $((W - 6)))${C_RST}"
	( /usr/share/5gmodem/simslot.sh set "$_next" >/dev/null 2>&1
	  rm -f "$DATA" ) >/dev/null 2>&1 </dev/null &
	SLOT_ACTIVE="$_next"
}

# Модемы, КОТОРЫЕ СЕЙЧАС НА ШИНЕ, а не все, что когда-либо подключались.
#
# Секции 5gmodem.m_* переживают отключение модема НАМЕРЕННО: в них хранятся его
# настройки (порт, интерфейс, привязка, выбор диодов), и терять их при каждом
# вынимании нельзя. Но список вкладок строился прямо по секциям - и показывал
# давно вынутые модемы наравне с подключённым (наблюдалось: три вкладки при
# одном модеме). Веб-интерфейс такого не делает, он берёт список у listmodems.sh.
#
# Сверяемся с тем же источником: он уже кэширован в /tmp, лишней работы нет.
# Разбираем ИМЕННО jsonfilter'ом. sed здесь не годится: listmodems.sh отдаёт
# весь массив ОДНОЙ строкой, и жадный шаблон вытаскивал только ПОСЛЕДНИЙ путь -
# при двух модемах в полосе оставался один (наблюдалось: подключены FM350 и
# Compal, показывался только Compal).
_present=$(/usr/share/5gmodem/listmodems.sh 2>/dev/null \
	| jsonfilter -e '@[*].path' 2>/dev/null | tr '\n' ' ')
[ -n "$_present" ] || _present=$(jsonfilter -i /tmp/5gmodem_listmodems.cache -e '@[*].path' 2>/dev/null | tr '\n' ' ')
MODEMS=""
for _sec in $(uci -q show 5gmodem 2>/dev/null | sed -n 's/^5gmodem\.\(m_[^.]*\)\.path=.*/\1/p'); do
	_sp=$(uci -q get "5gmodem.$_sec.path")
	[ -n "$_sp" ] || continue
	# Список путей пустой (listmodems не отработал) - НЕ прячем ничего: пустая
	# полоса вкладок хуже лишней, пользователь решил бы, что модемов нет вовсе.
	if [ -z "$_present" ]; then
		MODEMS="$MODEMS $_sec"
		continue
	fi
	case " $_present " in *" $_sp "*) MODEMS="$MODEMS $_sec" ;; esac
done
MODEMS=$(printf '%s\n' $MODEMS)
MCOUNT=$(printf '%s\n' "$MODEMS" | grep -c . 2>/dev/null)
[ -n "$MCOUNT" ] || MCOUNT=0
MKEY=""
[ "$MCOUNT" -gt 1 ] && MKEY="   m $T_K_MODEM"

# Переключение приоритета цифрой. netpri.sh set меняет метрику маршрута НА ЛЕТУ,
# без переподнятия интерфейса - модем не передоговаривается и IP не теряется.
set_pri() {
	[ -s "$NPFILE" ] || return
	_i=$(( $1 - 1 ))
	_if=$(jsonfilter -i "$NPFILE" -e "@[$_i].iface" 2>/dev/null)
	[ -n "$_if" ] || return
	/usr/share/5gmodem/netpri.sh set "$_if" >/dev/null 2>&1
	rm -f "$NPFILE"; fetch
}

switch_modem() {
	[ "$MCOUNT" -gt 1 ] || return
	_cur=$(uci -q get 5gmodem.@5gmodem[0].active_modem | tr -c 'A-Za-z0-9' '_')
	_cur="m_${_cur%_}"
	_next=""; _first=""; _take=0
	for _m in $MODEMS; do
		[ -z "$_first" ] && _first="$_m"
		[ "$_take" = 1 ] && { _next="$_m"; _take=0; }
		[ "$_m" = "$_cur" ] && _take=1
	done
	[ -n "$_next" ] || _next="$_first"
	_path=$(uci -q get "5gmodem.$_next.path")
	[ -n "$_path" ] || return
	# Переключение системное - его видит и LuCI, поэтому идём штатным путём.
	# Команда называется switch. Раньше здесь стояло "set" - такой ветки в
	# modemswitch.sh нет, скрипт молча завершался, и клавиша m не делала НИЧЕГО.
	/usr/share/5gmodem/modemswitch.sh switch "$_path" >/dev/null 2>&1
	rm -f "$DATA"; J=""; fetch
}

if [ "$TTY" = 1 ]; then
	printf '%s[?25l' "$ESC"
	stty -echo 2>/dev/null
fi

# Рамка и наполнение выбираются по активному разделу. Раньше вызывались
# frame/draw напрямую; теперь между ними и циклом стоит диспетчер, поэтому новый
# раздел добавляется без правки цикла.
render_frame() {
	case "$(tab_id "$TAB")" in
		cell)  [ "$NARROW" = 1 ] && frame_cell_narrow || frame_cell ;;
		modem) frame_modem ;;
		sms)   frame_sms; fetch_sms ;;
		esim)  frame_esim; fetch_esim ;;
		ussd)  frame_ussd ;;
		at)    frame_at ;;
		*)     frame ;;
	esac
}
render_draw() {
	case "$(tab_id "$TAB")" in
		cell)  [ "$NARROW" = 1 ] && draw_cell_narrow || draw_cell ;;
		modem) draw_modem ;;
		sms)   draw_sms ;;
		esim)  draw_esim ;;
		ussd)  draw_ussd ;;
		at)    draw_at ;;
		*)     draw ;;
	esac
}

# ИЗМЕНЕНИЕ РАЗМЕРА ОКНА. Ширину брали ОДИН РАЗ при старте, а SIGWINCH не ловили
# вовсе. Растянул окно - раскладка осталась узкой и половина экрана пустует;
# сузил - справа висят обрывки прежнего кадра: терминал их не стирает, а мы туда
# больше не пишем. Плюс подключение, когда окно ещё не приняло финальный размер:
# 5gtop запоминал промежуточную ширину и жил с ней до перезапуска.
# Перерисовываем ЦЕЛИКОМ и с явной очисткой: не все каркасы чистят экран сами
# (frame_ussd/frame_at рисуют поверх), а после сужения мусор остаётся именно там.
_on_winch() {
	[ "$TW_FIXED" = 1 ] && return 0
	_ww=$(term_width)
	case "$_ww" in ''|*[!0-9]*) return 0 ;; esac
	[ "$_ww" = "$TW" ] && return 0
	TW="$_ww"; apply_width
	printf '%s[2J%s[H' "$ESC" "$ESC"
	render_frame
	render_draw
	return 0
}
trap _on_winch WINCH

render_frame
fetch
# Если стартовали сразу на вкладке с фоновым чтением - запускаем его немедленно,
# не дожидаясь первого тика: иначе на экране висело "читаю сообщения..." дольше,
# чем нужно.
case "$(tab_id "$TAB")" in
	sms)  fetch_sms ;;
	esim) fetch_esim ;;
esac
_since=0
_tick=0
while :; do
	[ -f "$DATA" ] && J=$(cat "$DATA" 2>/dev/null)
	render_draw

	if [ "$TTY" = 1 ]; then
		# ЗАЩИТА ОТ ХОЛОСТОГО ЦИКЛА. read -t 1 задуман и как пауза, и как чтение
		# клавиши. Но если ввод закрыт или stty не применился, read возвращается
		# МГНОВЕННО и всегда - цикл начинает крутиться на полной скорости, съедая
		# процессор. На слабом роутере это вешает и сессию, и сам роутер (у
		# пользователя терминал просто закрывался). Поэтому засекаем время: если
		# итерация уложилась в ту же секунду, досыпаем сами.
		_t0=$(date +%s)
		_k=""
		# IFS= обязателен: без него read СЪЕДАЕТ табуляцию как разделитель,
		# и клавиша Tab приходила бы пустой.
		# КОД ВОЗВРАТА ОБЯЗАТЕЛЕН. Пустая строка в _k означает ДВА разных
		# события: нажат Enter (read вернул 0) и истёк таймаут (read вернул
		# не 0). Без этой проверки ввод команды открывался бы сам каждую
		# секунду простоя.
		if IFS= read -t 1 -r -n 1 _k 2>/dev/null; then _got=1; else _got=0; fi
		[ "$_got" = 1 ] || _k="__timeout__"
		case "$_k" in
			q|Q) cleanup ;;
			r|R)
				fetch
				case "$(tab_id "$TAB")" in
					sms)  fetch_sms ;;
					esim) rm -f "$ESFILE"; fetch_esim ;;
				esac
				_since=0
				;;
			t|T) /usr/share/5gmodem/speedtest.sh start >/dev/null 2>&1 ;;
			# Слот SIM - только там, где их больше одного (см. switch_slot).
			k|K) switch_slot ;;
			# ПРЯМОЙ ПЕРЕХОД НА ВКЛАДКУ буквой из её названия - она подсвечена в
			# полосе, поэтому запоминать нечего.
			n|N|c|C|m|M|s|S|e|E|u|U|a|A)
				_want=""
				for _t in $TAB_IDS; do
					case "$_k" in
						[Nn]) [ "$(tab_key "$_t")" = 'n' ] && _want="$_t" ;;
						[Cc]) [ "$(tab_key "$_t")" = 'c' ] && _want="$_t" ;;
						[Mm]) [ "$(tab_key "$_t")" = 'm' ] && _want="$_t" ;;
						[Ss]) [ "$(tab_key "$_t")" = 's' ] && _want="$_t" ;;
						[Ee]) [ "$(tab_key "$_t")" = 'e' ] && _want="$_t" ;;
						[Uu]) [ "$(tab_key "$_t")" = 'u' ] && _want="$_t" ;;
						[Aa]) [ "$(tab_key "$_t")" = 'a' ] && _want="$_t" ;;
					esac
				done
				[ -n "$_want" ] && { TAB=$(tab_num "$_want"); render_frame; }
				;;
			# ЦИФРЫ КОНТЕКСТНЫЕ: на «Сети» это приоритет интернета, на eSIM - выбор
			# профиля. Так один и тот же ряд клавиш обслуживает оба экрана, и ничего
			# не пришлось переназначать.
			1|2|3|4|5|6)
				case "$(tab_id "$TAB")" in
					esim) esim_switch "$_k" ;;
					net)  case "$_k" in 1|2|3) set_pri "$_k" ;; esac ;;
				esac
				;;
			# Tab - следующий МОДЕМ. Прежняя m ушла под вкладку «Modem»; Tab по
			# смыслу подходит - переключение между равноправными объектами.
			"$TABCH") switch_modem; render_frame; _since=0 ;;
			# Enter - ввод строки, но ТОЛЬКО на консольных вкладках: на остальных
			# вводить нечего, и перехват Enter там только сбивал бы с толку.
			"" | "$(printf '\015')")
				case "$(tab_id "$TAB")" in
				ussd)
					read_line "$T_ENTER_USSD"
					render_frame; send_console ussd "$_RL"
					;;
				esim)
					read_line "$T_ESIM_ADD"
					render_frame; esim_download "$_RL"
					;;
				at)
					read_line "$T_ENTER_AT"
					render_frame; send_console at "$_RL"
					;;
				esac
				;;
			# Backspace - следующая ВКЛАДКА по кругу. Терминалы шлют на этой клавише
			# то 0x08, то 0x7f (DEL), в зависимости от настройки erase - принимаем оба.
			"$BSCH"|$(printf '\177'))
				TAB=$((TAB + 1))
				[ "$TAB" -gt "$(tab_count)" ] && TAB=1
				render_frame
				;;
			# Подгонка ширины на ходу. Шаг 4: заметно, но не скачками. '=' принимаем
			# как '+', чтобы не требовать Shift.
			+|=) TW=$((TW + 4)); apply_width; render_frame ;;
			-|_) TW=$((TW - 4)); apply_width; render_frame ;;
		esac
		[ "$(date +%s)" = "$_t0" ] && sleep 1
	else
		sleep 1
	fi

	_since=$((_since + 1))
	if [ "$_since" -ge "$INTERVAL" ]; then
		fetch
		# SMS перечитываем реже: чтение дороже опроса метрик и новые сообщения
		# приходят не каждую секунду.
		[ "$(tab_id "$TAB")" = "sms" ] && [ "$((_tick % 6))" = 0 ] && fetch_sms
		[ "$(tab_id "$TAB")" = "esim" ] && [ "$((_tick % 12))" = 0 ] && fetch_esim
		_since=0
	fi
	_tick=$((_tick + 1))
done
