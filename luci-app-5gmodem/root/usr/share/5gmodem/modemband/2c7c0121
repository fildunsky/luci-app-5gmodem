# Quectel EC21 (2c7c:0121)
#
# Профиля не было вовсе - bands.sh не находил его и отвечал "Unsupported", из-за
# чего казалось, что модем "ничего не умеет в QMI". К протоколу это отношения не
# имеет: управление идёт по AT (at+qcfg="band"), а он работает и на qmi, и на
# mbim, и под ModemManager.
#
# Диапазоны сверены с живым EC21-E (ревизия EC21EFAR06A03M4G) двумя способами:
#   at+qcfg="band"  -> +QCFG: "band",0xd3,0x800d5,0x0
#                      LTE-маска 0x800d5 = биты 0,2,4,6,7,19 -> B1 B3 B5 B7 B8 B20
#   qmicli --nas-get-system-selection-preference
#                   -> LTE band preference: '1, 3, 5, 7, 8, 20'
# Оба источника сходятся. Это набор ЕВРОПЕЙСКОГО варианта (EC21-E); у EC21-A/AU/J
# набор другой (B2/B4/B12/B13 и т.п.) - у них своя маска, и при необходимости под
# них заводится отдельный профиль с моделью в имени.
#
# _DEVICE - лишь запасной вариант: bands.sh всё равно подменяет его AT-портом,
# который приложение определило для АКТИВНОГО модема.
_DEVICE=/dev/ttyUSB2
_DEFAULT_LTE_BANDS="1 3 5 7 8 20"

getinfo() {
	echo "Quectel EC21"
}

# Семейство: at+qcfg="band" на чтение/запись + hextobands/bandstohex.
# EC21 - LTE Cat 1 без 5G, поэтому 5G-функций семейства здесь не касаемся.
. $RES/_quectel_common
