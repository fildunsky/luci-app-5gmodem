# Идентификатор 05c6:90d5 делят Foxconn T99W175 / Thales MV31-W и ранний
# прототип Compal RXM-G1 (тот же ID). У прошивки Compal НЕТ AT-команд бенд-лока
# (AT^BAND_PREF не отвечает), бенды доступны только через mmcli. Поэтому, если
# по USB-дескриптору это Compal (Tri Cascade / VOS_5G), передаём управление
# профилю 05c690d6 (mmcli), как это делает скрипт метрик modem/usb/05c690d5.
# Без этого bands.sh отдавал бы захардкоженный список бендов Thales, рисуя в UI
# нерабочие кнопки (текущие бенды через AT^BAND_PREF не читались -> ничего не
# подсвечено), вместо честного "управление невозможно в режиме mbim".
# Проверяем ДВА источника: debugfs (может быть не смонтирована на части сборок)
# и sysfs (есть всегда). Если Compal не опознан, мы уходим в Thales-ветку - а это
# AT-профиль БЕЗ _BAND_VIA=mmcli, т.е. гейт в bands.sh не сработает и UI покажет
# нерабочие кнопки бендов/режимов вместо честной надписи (см. 05c690d6).
if grep -qiE "Product=VOS_5G|Manufacturer=Tri Cascade" /sys/kernel/debug/usb/devices 2>/dev/null \
	|| grep -qiE "VOS_5G|RXMG1" /sys/bus/usb/devices/*/product 2>/dev/null; then
	. "$RES/05c690d6"
	return 0 2>/dev/null || exit 0
fi

# Дальше - общая логика всех композиций этого модема (см. _qualcomm_sdx55_common).
. $RES/_qualcomm_sdx55_common
