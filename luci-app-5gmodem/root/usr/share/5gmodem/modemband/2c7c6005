_DEVICE=""   # порт задаёт bands.sh (uci at_port / detect.sh); в профиле НЕ прибиваем — на мультимодеме это порт другого модема

# Quectel EC200A-EL (2c7c:6005). БОЛВАНКА по офлайн-дампу (модуля на руках нет).
# Диалект стандартный Quectel: чтение/запись диапазонов через AT+QCFG="band" -
# как у EC25 (_quectel_common). Список поддерживаемых выведен из маски в дампе:
#   AT+QCFG="band" -> +QCFG: "band",0xd0,0x1a0080800d5
#   0x1a0080800d5 -> B1 B3 B5 B7 B8 B20 B28 B38 B40 B41 (проверено декодером).
# Запись (setbands из _quectel_common шлёт at+qcfg="band",0,<hex>,0,1) на живом
# EC200A НЕ проверена; чтение (getbands, поле $4) дампу соответствует.
_DEFAULT_LTE_BANDS="1 3 5 7 8 20 28 38 40 41"

getinfo() {
	echo "Quectel EC200A"
}

. $RES/_quectel_common
