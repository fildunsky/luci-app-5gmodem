# Unified for NSA/SA
_DEFAULT_5G_BANDS="1 2 3 5 7 8 20 25 28 30 38 40 41 48 66 71 77 78 79"
# ПРИМЕНЯЕТСЯ ВЖИВУЮ, НО КОНТЕКСТ РВЁТСЯ - нужен реконнект, а не ребут модема.
# Измерено на живом FM350-GL (Tele2, 30.07): `setbands 3` переписал GTACT за 4 c,
# модем остался зарегистрирован (COPS ...,7) и адрес на eth2 не изменился - а пинг
# 0 из 3. То есть интерфейс с адресом, который никуда не ведёт: снаружи всё
# «выглядит рабочим», и это худший вид поломки. Реконнект интерфейса возвращает
# связь и стоит в разы меньше программного ребута модема.
_BANDS_APPLY_LIVE=reconnect

# Смена диапазонов у FM350 идёт через AT+GTACT, а он рвёт активный PDP-контекст:
# после применения IP пропадает на ~15-20 c, пока fibocom proto не переподнимет
# сессию (release-first re-dial). Просим UI показать об этом постоянную подсказку
# над кнопкой «Применить», чтобы кратковременный обрыв не пугал (см. bands.sh json
# -> bandwarn, и 5gdetail.js).
_BAND_RECONNECT_WARN=1
# Запасной LTE-список - только если AT+GTACT=? не ответил. Реальные возможности
# берём у самого модема (см. _fm350_caps): у разных ревизий/прошивок FM350 набор
# диапазонов отличается, и захардкоженный список у кого-то показывал бы лишние
# кнопки (или прятал существующие).
_DEFAULT_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 34 38 39 40 41 42 43 46 48 66 71"

# Возможности модема из AT+GTACT=? - ТЕСТ-команда, отдаёт допустимые значения.
# Формат: +GTACT: (rat),(pref),(pref),(),(UMTS),(LTE),(),(),(NR)
#   6-я группа в скобках = LTE, значения с префиксом 1xx (101=B1 … 171=B71)
#   9-я группа           = NR,  префикс 5xx/5xxx (501=n1, 5071=n71, 5079=n79)
# Кэшируем в /tmp: за один опрос страницы функции supported зовутся трижды
# (LTE + 5G SA + 5G NSA), а лишний AT-запрос конкурирует за общий порт.
_fm350_caps() {   # $1 = lte | nr ; печатает список диапазонов или пусто
    _cf="/tmp/5gmodem_fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    if [ ! -s "$_cf" ]; then
        sms_tool -d $_DEVICE at "AT+GTACT=?" 2>/dev/null | tr -d '\r' \
            | grep -o '([^)]*)' > "$_cf.$$" 2>/dev/null
        # только если реально пришли группы (иначе не кэшируем пустое - вдруг
        # был транзитный сбой порта, в следующий раз попробуем снова)
        [ -s "$_cf.$$" ] && [ "$(wc -l < "$_cf.$$")" -ge 6 ] \
            && mv "$_cf.$$" "$_cf" || rm -f "$_cf.$$"
    fi
    [ -s "$_cf" ] || return 1
    case "$1" in
        umts)
            # 5-я группа GTACT? = UMTS, значения 1..10 (BAND_UMTS_I..X) БЕЗ префикса.
            for v in $(sed -n '5p' "$_cf" | tr -d '()' | tr ',' ' '); do
                case "$v" in [1-9]|10) echo "$v" ;; esac
            done | sort -n | xargs
            ;;
        lte)
            for v in $(sed -n '6p' "$_cf" | tr -d '()' | tr ',' ' '); do
                case "$v" in 1[0-9][0-9]) echo "$((v - 100))" ;; esac
            done | sort -n | xargs
            ;;
        nr)
            for v in $(sed -n '9p' "$_cf" | tr -d '()' | tr ',' ' '); do
                case "$v" in
                    5[0-9][0-9][0-9]) echo "$((v - 5000))" ;;
                    5[0-9][0-9])      echo "$((v - 500))" ;;
                esac
            done | sort -n | xargs
            ;;
    esac
}

# --- Режим сети через AT+GTACT (первый параметр <rat>) --------------------
# По мануалу FM350 (AT Commands V2.10, 11.1.14): 1=UMTS, 2=LTE, 4=LTE/UMTS,
# 10=Automatic, 14=NR, 16=NR/WCDMA, 17=NR/LTE, 20=NR/WCDMA/LTE.
# PreferredAct (2-й/3-й параметры): 2=WCDMA, 3=LTE, 6=NR - должны входить в
# выбранный <rat>, поэтому подбираются под него. Список бендов (хвост GTACT?)
# при смене режима сохраняем как есть.
# МОДУЛЬ БЕЗ 5G. FM350-GL-16 и RW350-GL-16 - 4G-версии того же модуля (по
# даташиту GL-16: LTE + WCDMA, NR нет), но с тем же 0e8d:7127. Отличаем по
# AT+GTACT=?: у них пуста группа NR-диапазонов (режимы с NR общая прошивка может
# и перечислять - на них не смотрим), без списка моделей. Раньше пустой NR-список подменялся запасным _DEFAULT_5G_BANDS, и
# страница рисовала строки 5G и режимы «4G+5G»/«5G», которых у модуля нет
# (владелец RW350-GL-16, 18.09.2026: «setbands5gnsa - rejected» в журнале).
# Пока возможности не прочитаны (порт молчит) - ведём себя по-старому.
_fm350_no_nr() {   # 0 = модуль точно без 5G
    _fm350_caps lte >/dev/null 2>&1 || return 1
    _nn_cf="/tmp/5gmodem_fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    [ -s "$_nn_cf" ] || return 1
    [ -z "$(_fm350_caps nr)" ]
}

getsupportedmodes() {
    if _fm350_no_nr; then
        # Список - из тех режимов, что модуль сам назвал в AT+GTACT=?. «Авто»
        # у 4G-версии - 10 (у пятиджишной его показывает 20, см. мануал Note 6).
        _sm_r=" $(sed -n '1p' "$_nn_cf" | tr -d '()' | tr ',' ' ') "
        _sm_o=""
        case "$_sm_r" in *" 10 "*) _sm_o="10:Auto" ;; *" 20 "*) _sm_o="20:Auto" ;; esac
        case "$_sm_r" in *" 1 "*) _sm_o="$_sm_o 1:3G" ;; esac
        case "$_sm_r" in *" 4 "*) _sm_o="$_sm_o 4:3G+4G" ;; esac
        case "$_sm_r" in *" 2 "*) _sm_o="$_sm_o 2:4G" ;; esac
        echo ${_sm_o:-2:4G}
        return
    fi
    echo "20:Auto 1:3G 4:3G+4G 2:4G 17:4G+5G 14:5G"
}

getmode() {
    O=$(sms_tool -d $_DEVICE at "AT+GTACT?")
    _gm=$(echo "$O" | awk -F[:,] '/^\+GTACT:/{gsub(/ /,"",$2); print $2; exit}')
    # Режим 10 модуль показывает как 20 (мануал, Note 6); у 4G-версии в списке
    # только 10 - сводим к нему, иначе «Авто» не подсветится.
    [ "$_gm" = 20 ] && _fm350_no_nr && _gm=10
    echo "$_gm"
}

setmode() {
    M="$1"
    case "$M" in
        ''|*[!0-9]*) return ;;
    esac
    # Шлём ТОЛЬКО rat (+преференции для мульти-RAT). Список бендов НЕ передаём:
    # модем сам подставляет разрешённые бенды под включённые RAT (проверено:
    # GTACT=2 убирает UMTS-бенды, GTACT=20,6,3 возвращает полный список), а
    # команда с явным списком чужих для rat бендов отвергается (CME).
    case "$M" in
        20|17) A="$M,6,3" ;;   # NR приоритетнее, затем LTE
        16)    A="$M,6,2" ;;
        4)     A="$M,3,2" ;;
        *)     A="$M" ;;
    esac
    sms_tool -d $_DEVICE at "AT+GTACT=$A"
}

getinfo() {
  O=$(sms_tool -d $_DEVICE at "AT+CGMM?")
  _NAME="Fibocom $(echo "$O" | awk -F[:,] '/^\+CGMM:/{gsub("\"","");print $2}' | xargs)"
  echo "$_NAME"
}

getsupportedbands() {
    _b=$(_fm350_caps lte)
    [ -n "$_b" ] && echo "$_b" || echo "$_DEFAULT_LTE_BANDS"
}

getbands() {
    # +GTACT: 20,6,3,101,102,103,104,105,107,108,112,113,114,117,118,119,120,125,126,128,129,130,132,134,138,139,140,141,142,143,146,148,166,171

    O=$(sms_tool -d $_DEVICE at "AT+GTACT?")
    BANDS=$(echo "$O" | awk -F: '/^\+GTACT:/{gsub(","," ");print $2}')
    for BAND in $BANDS; do
        if [ $BAND -gt 100 ] && [ $BAND -lt 200 ]; then
            echo -n "$((BAND - 100)) "
        fi
    done
    echo ""
}

# ЗАПИСЬ ДИАПАЗОНОВ С ПРОВЕРКОЙ И ЗАПАСНЫМИ ФОРМАМИ КОМАНДЫ.
#
# Писали всегда «AT+GTACT=<rat>,<pref1>,<pref2>,<диапазоны>», повторяя начало
# ответа GTACT?. В режиме 20,6,3 это работает, а в режиме «только LTE» модем
# отвечает «2,3,,...», и запись «AT+GTACT=2,3,,107» прошивка молча игнорирует:
# ни ошибки, ни изменений (Rolling RW350-GL-16, 18.09.2026, проверено руками).
# Мануал (FM350 AT Commands, +GTACT, Note 1-2) разрешает задать ТОЛЬКО
# диапазоны, опустив режим: «AT+GTACT=,,,<диапазоны>». Поэтому пишем прежней
# формой (у FM350 она проверена), перечитываем и при расхождении пробуем
# остальные. Рабочей для RW350-GL-16 оказалась «AT+GTACT=2,3,3,<диапазоны>» -
# второе предпочтение обязано быть заполненным, хотя GTACT? отдаёт его пустым;
# форму «,,,» эта прошивка отвергает ERROR, а сброс принимает как «AT+GTACT=2»
# (подобрано владельцем модема 18.09.2026, применяется без режима полёта).
#   $1 - список через запятую или 0 (заводской набор)
#   $2 - регэксп «своих» значений: они и сверяются (Note 5: чужие RAT не трогаются)
#   $3 - строки кэша AT+GTACT=? с полным набором для 0 (sed-скрипт: 6p, 9p, 5p;6p;9p)
_fm350_gtact_tail() {   # $1 - регэксп; печатает текущие значения по порядку
    sms_tool -d $_DEVICE at "AT+GTACT?" 2>/dev/null | tr -d '\r ' \
        | sed -n 's/^+GTACT://p' | head -1 | cut -d, -f4- \
        | tr ',' '\n' | grep -E "$1" | sort -n | xargs
}

_fm350_gtact_set() {
    _gs_line=$(sms_tool -d $_DEVICE at "AT+GTACT?" 2>/dev/null | tr -d '\r ' \
        | sed -n 's/^+GTACT://p' | head -1)
    [ -n "$_gs_line" ] || return 1
    _gs_rat=$(echo "$_gs_line" | cut -d, -f1)
    _gs_p1=$(echo "$_gs_line" | cut -d, -f2)
    _gs_mode=$(echo "$_gs_line" | cut -d, -f1-3)
    _gs_dup=""
    [ -n "$_gs_p1" ] && [ -z "$(echo "$_gs_line" | cut -d, -f3)" ] && _gs_dup="$_gs_rat,$_gs_p1,$_gs_p1"
    if [ "$1" = "0" ]; then
        _fm350_caps lte >/dev/null 2>&1
        _gs_cf="/tmp/5gmodem_fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
        _gs_want=""
        [ -s "$_gs_cf" ] && _gs_want=$(sed -n "$3" "$_gs_cf" | tr -d '()' \
            | tr ',' '\n' | grep -E "$2" | sort -n | xargs)
    else
        _gs_want=$(echo "$1" | tr ',' '\n' | grep -E "$2" | sort -n | xargs)
    fi
    _gs_new=""
    for _gs_f in "$_gs_mode" $_gs_dup ",," "$_gs_rat,," "$_gs_rat"; do
        if [ "$_gs_f" = "$_gs_rat" ]; then
            # голый режим - только как сброс к заводскому набору
            [ "$1" = "0" ] || continue
            sms_tool -d $_DEVICE at "AT+GTACT=$_gs_rat" >/dev/null 2>&1
        else
            sms_tool -d $_DEVICE at "AT+GTACT=$_gs_f,$1" >/dev/null 2>&1
        fi
        [ -n "$_gs_want" ] || return 0
        _gs_new=$(_fm350_gtact_tail "$2")
        if [ "$_gs_new" = "$_gs_want" ]; then
            [ "$_gs_f" = "$_gs_mode" ] || \
                logger -t 5gmodem "bands: applied as AT+GTACT=$_gs_f,... (the modem ignored AT+GTACT=$_gs_mode,...)"
            return 0
        fi
    done
    logger -t 5gmodem "bands: the modem kept ($_gs_new) instead of the requested ($_gs_want) - AT+GTACT did not apply in any form"
    return 1
}

# Пересобрать выбор диапазонов заново - тем же способом, что кнопка «Применить».
#
# ЗАЧЕМ. Цикл режима полёта (AT+CFUN=4), через который применяется привязка к
# соте и включение 5G, оставляет модем на ОДНОМ диапазоне: вторичные несущие
# уходят в состояние 0 и сами не оживают, а в наблюдавшемся случае пропал и
# интернет целиком - до ручного нажатия «Все диапазоны».
#
# ПОЧЕМУ ИМЕННО ТАК. Обратная запись того же СПИСКА диапазонов не помогает -
# проверено на живом FM350: для модема явное перечисление остаётся
# ограничением, пусть и широким, и пересбора несущих не вызывает. Помогает
# только AT+GTACT=<режим>,0, где 0 - «сброс к заводскому набору».
#
# НО слать 0 вслепую нельзя: если пользователь осознанно ограничил диапазоны,
# сброс молча сотрёт его выбор. Поэтому сравниваем текущий набор с полным
# списком возможностей модема: совпал - значит не ограничивал ничего, и 0
# безопасен; не совпал - возвращаем ЕГО набор, ничего не додумывая.
#
# СНАЧАЛА - ВЫБОР ПОЛЬЗОВАТЕЛЯ, А НЕ ТО, ЧТО ОСТАЛОСЬ В МОДЕМЕ. Цикл CFUN сам
# сбрасывает маску к заводской, и чтение «текущего» набора после него давало
# полный список: код считал, что человек ничего не ограничивал, и закреплял
# сброс командой GTACT=<режим>,0. Со стороны это выглядело так: привязал модем
# к соте, снял лишние диапазоны - а после обновления страницы снова включены все
# (жалоба владельца RW350-GL-16 на Radxa, 17.09.2026). Сохранённый выбор лежит в
# секции модема (save_band, пишет _persist_bands в bands.sh) - он и есть намерение.
_fm350_reapply_bands() {
    _rab_sv=""
    if command -v active_modem >/dev/null 2>&1; then
        _rab_sec="m_$(active_modem | sed 's/[^A-Za-z0-9]/_/g')"
        [ "$_rab_sec" != "m_" ] && _rab_sv=$(uci -q get "5gmodem.$_rab_sec.save_band")
    fi
    case "$_rab_sv" in
        ''|default) : ;;
        *) setbands "$_rab_sv" >/dev/null 2>&1; return ;;
    esac
    LINE=$(sms_tool -d $_DEVICE at "AT+GTACT?" 2>/dev/null | tr -d '\r' \
        | sed -n 's/^+GTACT: *//p' | head -1)
    [ -n "$LINE" ] || return
    # Пробелы вычищаем: часть прошивок отвечает «+GTACT: 20, 6, 3, ...», и
    # «AT+GTACT=20, 6, 3,...» уходил в ERROR - «Применить» молча не работало
    # (ревью 12.09.2026 по форуму: формат менялся между прошивками).
    MODE=$(echo "$LINE" | cut -d, -f1-3 | tr -d ' \r')
    CUR=$(echo "$LINE" | cut -d, -f4- | tr ',' '\n' | grep -E '^[0-9]+$' | sort -n | xargs)
    [ -n "$CUR" ] || return

    _fm350_caps lte >/dev/null 2>&1   # заодно наполнит кэш возможностей
    _cf="/tmp/5gmodem_fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    ALL=""
    # группы теста: 5 - UMTS, 6 - LTE, 9 - NR (см. _fm350_caps)
    [ -s "$_cf" ] && ALL=$(sed -n '5p;6p;9p' "$_cf" | tr -d '()' | tr ',' '\n' \
        | grep -E '^[0-9]+$' | sort -n | xargs)

    if [ -n "$ALL" ] && [ "$CUR" = "$ALL" ]; then
        _fm350_gtact_set 0 '^[0-9]+$' '5p;6p;9p'
    else
        _fm350_gtact_set "$(echo $CUR | tr ' ' ',')" '^[0-9]+$'
    fi
}

setbands() {
    BANDS="$1"

    T=""
    if [ "$BANDS" = "default" ]; then
        T="0"
    else
        for BAND in $BANDS; do
            case $BAND in
                ''|*[!0-9]*) continue ;;
            esac
            [ -n "$T" ] && T="${T},"
            T="${T}$((BAND + 100))"
        done
    fi

    [ -n "$T" ] && _fm350_gtact_set "$T" '^1[0-9][0-9]$' '6p'
}

# --- Диапазоны 3G (UMTS/WCDMA) через GTACT --------------------------------
# UMTS-бенды в GTACT кодируются значениями 1..10 (BAND_UMTS_I..X), БЕЗ префикса
# (LTE=1xx, NR=5xx). FM350 поддерживает B1/2/4/5/8. Note 5 мануала: смена бендов
# одного RAT не трогает другие. Отдаём МАСКОЙ (галочки, как LTE/NR - GTACT
# принимает произвольный набор), а НЕ готовыми комбинациями (то для Telit).
# Показываем ТОЛЬКО когда активный режим включает WCDMA (rat 1/4/16/20; Auto=>20),
# иначе GTACT отвергнет UMTS-бенды (CME - «чужой для rat бенд», см. setmode).

# Текущая строка GTACT? с кэшем НА ПРОЦЕСС: за одну json-сборку 3G-функции
# (supported/enabled/rat-check) звались бы по разу каждая, и лишние AT-запросы
# конкурировали бы за общий порт с остальным опросом (enabled3g терялся). Одна
# команда на процесс. Set-операции идут ОТДЕЛЬНЫМ вызовом => кэш им не мешает.
_fm350_act() {
    if [ -z "$_ACT_CACHE" ]; then
        _ACT_CACHE=$(sms_tool -d $_DEVICE at "AT+GTACT?" 2>/dev/null | tr -d '\r' \
            | sed -n 's/^+GTACT: *//p' | head -1)
        [ -n "$_ACT_CACHE" ] || _ACT_CACHE="_none_"
    fi
    [ "$_ACT_CACHE" = "_none_" ] && return 1
    echo "$_ACT_CACHE"
}

_fm350_rat_has_umts() {
    case "$(_fm350_act | cut -d, -f1)" in 1|4|16|20) return 0 ;; *) return 1 ;; esac
}

# Стиль 3G: mask = галочки (произвольный набор), combo = готовые комбинации
# (Telit). json-билдер по этому флагу выбирает поля (supported3g/enabled3g либо
# combos3g/current3g).
bands3g_style() { echo "mask"; }

getsupportedbands3g() {
    _fm350_rat_has_umts || return       # пусто -> строку 3G скрыть
    _fm350_caps umts
}

getbands3g() {
    _fm350_rat_has_umts || return
    LINE=$(_fm350_act) || return
    # UMTS-бенды - в ХВОСТЕ (после rat,pref1,pref2); значения 1..10. Первые три
    # поля пропускаем: там rat/pref могут совпасть по числу с номером бенда.
    for b in $(echo "$LINE" | cut -d, -f4- | tr ',' ' '); do
        case "$b" in [1-9]|10) printf '%s ' "$b" ;; esac
    done
    echo ""
}

setbands3g() {
    _fm350_rat_has_umts || return
    BANDS="$1"
    T=""
    if [ "$BANDS" = "default" ]; then
        T=$(_fm350_caps umts | tr ' ' ',')     # все поддерживаемые UMTS-бенды
    else
        for b in $BANDS; do
            case "$b" in ''|*[!0-9]*) continue ;; esac
            [ -n "$T" ] && T="${T},"
            T="${T}${b}"
        done
    fi
    case "$T" in ''|*[!0-9,]*) return ;; esac
    _fm350_gtact_set "$T" '^([1-9]|10)$' '5p'
}

getsupportedbands5gsa() {
    _fm350_no_nr && { echo "Unsupported"; return; }
    _b=$(_fm350_caps nr)
    [ -n "$_b" ] && echo "$_b" || echo "$_DEFAULT_5G_BANDS"
}

getsupportedbands5gnsa() {
    _fm350_no_nr && { echo "Unsupported"; return; }
    _b=$(_fm350_caps nr)
    [ -n "$_b" ] && echo "$_b" || echo "$_DEFAULT_5G_BANDS"
}

getbands5gsa() {
    _fm350_no_nr && { echo "Unsupported"; return; }
    # +GTACT: 20,6,3,501,502,503,505,507,508,5020,5025,5028,5030,5038,5040,5041,5048,5066,5071,5077,5078,5079

    O=$(sms_tool -d $_DEVICE at "AT+GTACT?")
