# Unified for NSA/SA
_DEFAULT_5G_BANDS="1 2 3 5 7 8 20 25 28 30 38 40 41 48 66 71 77 78 79"
# Смена диапазонов у FM350 идёт через AT+GTACT, а он рвёт активный PDP-контекст:
# после применения IP пропадает на ~15-20 c, пока fibocom proto не переподнимет
# сессию (release-first re-dial). Просим UI показать об этом постоянную подсказку
# над кнопкой «Применить», чтобы кратковременный обрыв не пугал (см. bands.sh json
# -> bandwarn, и 5gdetail.js).
_BAND_RECONNECT_WARN=1
# Запасной LTE-список - только если AT+GTACT=? не ответил. Реальные возможности
# берём у самого модема (см. _fm350_caps): у разных ревизий/прошивок FM350 набор
# диапазонов отличается, и захардкоженный список у кого-то показывал бы лишние
# кнопки (или прятал существующие).
_DEFAULT_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 34 38 39 40 41 42 43 46 48 66 71"

# Возможности модема из AT+GTACT=? - ТЕСТ-команда, отдаёт допустимые значения.
# Формат: +GTACT: (rat),(pref),(pref),(),(UMTS),(LTE),(),(),(NR)
#   6-я группа в скобках = LTE, значения с префиксом 1xx (101=B1 … 171=B71)
#   9-я группа           = NR,  префикс 5xx/5xxx (501=n1, 5071=n71, 5079=n79)
# Кэшируем в /tmp: за один опрос страницы функции supported зовутся трижды
# (LTE + 5G SA + 5G NSA), а лишний AT-запрос конкурирует за общий порт.
_fm350_caps() {   # $1 = lte | nr ; печатает список диапазонов или пусто
    _cf="/tmp/5gmodem_fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    if [ ! -s "$_cf" ]; then
        sms_tool -d $_DEVICE at "AT+GTACT=?" 2>/dev/null | tr -d '\r' \
            | grep -o '([^)]*)' > "$_cf.$$" 2>/dev/null
        # только если реально пришли группы (иначе не кэшируем пустое - вдруг
        # был транзитный сбой порта, в следующий раз попробуем снова)
        [ -s "$_cf.$$" ] && [ "$(wc -l < "$_cf.$$")" -ge 6 ] \
            && mv "$_cf.$$" "$_cf" || rm -f "$_cf.$$"
    fi
    [ -s "$_cf" ] || return 1
    case "$1" in
        umts)
            # 5-я группа GTACT? = UMTS, значения 1..10 (BAND_UMTS_I..X) БЕЗ префикса.
            for v in $(sed -n '5p' "$_cf" | tr -d '()' | tr ',' ' '); do
                case "$v" in [1-9]|10) echo "$v" ;; esac
            done | sort -n | xargs
            ;;
        lte)
            for v in $(sed -n '6p' "$_cf" | tr -d '()' | tr ',' ' '); do
                case "$v" in 1[0-9][0-9]) echo "$((v - 100))" ;; esac
            done | sort -n | xargs
            ;;
        nr)
            for v in $(sed -n '9p' "$_cf" | tr -d '()' | tr ',' ' '); do
                case "$v" in
                    5[0-9][0-9][0-9]) echo "$((v - 5000))" ;;
                    5[0-9][0-9])      echo "$((v - 500))" ;;
                esac
            done | sort -n | xargs
            ;;
    esac
}

# --- Режим сети через AT+GTACT (первый параметр <rat>) --------------------
# По мануалу FM350 (AT Commands V2.10, 11.1.14): 1=UMTS, 2=LTE, 4=LTE/UMTS,
# 10=Automatic, 14=NR, 16=NR/WCDMA, 17=NR/LTE, 20=NR/WCDMA/LTE.
# PreferredAct (2-й/3-й параметры): 2=WCDMA, 3=LTE, 6=NR - должны входить в
# выбранный <rat>, поэтому подбираются под него. Список бендов (хвост GTACT?)
# при смене режима сохраняем как есть.
getsupportedmodes() {
    echo "20:Auto 1:3G 4:3G+4G 2:4G 17:4G+5G 14:5G"
}

getmode() {
    O=$(sms_tool -d $_DEVICE at "AT+GTACT?")
    echo "$O" | awk -F[:,] '/^\+GTACT:/{gsub(/ /,"",$2); print $2; exit}'
}

setmode() {
    M="$1"
    case "$M" in
        ''|*[!0-9]*) return ;;
    esac
    # Шлём ТОЛЬКО rat (+преференции для мульти-RAT). Список бендов НЕ передаём:
    # модем сам подставляет разрешённые бенды под включённые RAT (проверено:
    # GTACT=2 убирает UMTS-бенды, GTACT=20,6,3 возвращает полный список), а
    # команда с явным списком чужих для rat бендов отвергается (CME).
    case "$M" in
        20|17) A="$M,6,3" ;;   # NR приоритетнее, затем LTE
        16)    A="$M,6,2" ;;
        4)     A="$M,3,2" ;;
        *)     A="$M" ;;
    esac
    sms_tool -d $_DEVICE at "AT+GTACT=$A"
}

getinfo() {
  O=$(sms_tool -d $_DEVICE at "AT+CGMM?")
  _NAME="Fibocom $(echo "$O" | awk -F[:,] '/^\+CGMM:/{gsub("\"","");print $2}' | xargs)"
  echo "$_NAME"
}

getsupportedbands() {
    _b=$(_fm350_caps lte)
    [ -n "$_b" ] && echo "$_b" || echo "$_DEFAULT_LTE_BANDS"
}

getbands() {
    # +GTACT: 20,6,3,101,102,103,104,105,107,108,112,113,114,117,118,119,120,125,126,128,129,130,132,134,138,139,140,141,142,143,146,148,166,171

    O=$(sms_tool -d $_DEVICE at "AT+GTACT?")
    BANDS=$(echo "$O" | awk -F: '/^\+GTACT:/{gsub(","," ");print $2}')
    for BAND in $BANDS; do
        if [ $BAND -gt 100 ] && [ $BAND -lt 200 ]; then
            echo -n "$((BAND - 100)) "
        fi
    done
    echo ""
}

# Пересобрать выбор диапазонов заново - тем же способом, что кнопка «Применить».
#
# ЗАЧЕМ. Цикл режима полёта (AT+CFUN=4), через который применяется привязка к
# соте и включение 5G, оставляет модем на ОДНОМ диапазоне: вторичные несущие
# уходят в состояние 0 и сами не оживают, а в наблюдавшемся случае пропал и
# интернет целиком - до ручного нажатия «Все диапазоны».
#
# ПОЧЕМУ ИМЕННО ТАК. Обратная запись того же СПИСКА диапазонов не помогает -
# проверено на живом FM350: для модема явное перечисление остаётся
# ограничением, пусть и широким, и пересбора несущих не вызывает. Помогает
# только AT+GTACT=<режим>,0, где 0 - «сброс к заводскому набору».
#
# НО слать 0 вслепую нельзя: если пользователь осознанно ограничил диапазоны,
# сброс молча сотрёт его выбор. Поэтому сравниваем текущий набор с полным
# списком возможностей модема: совпал - значит не ограничивал ничего, и 0
# безопасен; не совпал - возвращаем ЕГО набор, ничего не додумывая.
_fm350_reapply_bands() {
    LINE=$(sms_tool -d $_DEVICE at "AT+GTACT?" 2>/dev/null | tr -d '\r' \
        | sed -n 's/^+GTACT: *//p' | head -1)
    [ -n "$LINE" ] || return
    MODE=$(echo "$LINE" | cut -d, -f1-3)
    CUR=$(echo "$LINE" | cut -d, -f4- | tr ',' '\n' | grep -E '^[0-9]+$' | sort -n | xargs)
    [ -n "$CUR" ] || return

    _fm350_caps lte >/dev/null 2>&1   # заодно наполнит кэш возможностей
    _cf="/tmp/5gmodem_fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    ALL=""
    # группы теста: 5 - UMTS, 6 - LTE, 9 - NR (см. _fm350_caps)
    [ -s "$_cf" ] && ALL=$(sed -n '5p;6p;9p' "$_cf" | tr -d '()' | tr ',' '\n' \
        | grep -E '^[0-9]+$' | sort -n | xargs)

    if [ -n "$ALL" ] && [ "$CUR" = "$ALL" ]; then
        sms_tool -d $_DEVICE at "AT+GTACT=$MODE,0" >/dev/null 2>&1
    else
        sms_tool -d $_DEVICE at "AT+GTACT=$MODE,$(echo $CUR | tr ' ' ',')" >/dev/null 2>&1
    fi
}

setbands() {
    BANDS="$1"

    T=""
    if [ "$BANDS" = "default" ]; then
        T="0"
    else
        for BAND in $BANDS; do
            case $BAND in
                ''|*[!0-9]*) continue ;;
            esac
            [ -n "$T" ] && T="${T},"
            T="${T}$((BAND + 100))"
        done
    fi

    if [ -n "$T" ]; then
        O=$(sms_tool -d $_DEVICE at "AT+GTACT?")
        MODE=$(echo "$O" | awk -F[:,] '/\+GTACT:/{print $2","$3","$4}'| xargs)
        sms_tool -d $_DEVICE at "AT+GTACT=$MODE,$T"
    fi
}

# --- Диапазоны 3G (UMTS/WCDMA) через GTACT --------------------------------
# UMTS-бенды в GTACT кодируются значениями 1..10 (BAND_UMTS_I..X), БЕЗ префикса
# (LTE=1xx, NR=5xx). FM350 поддерживает B1/2/4/5/8. Note 5 мануала: смена бендов
# одного RAT не трогает другие. Отдаём МАСКОЙ (галочки, как LTE/NR - GTACT
# принимает произвольный набор), а НЕ готовыми комбинациями (то для Telit).
# Показываем ТОЛЬКО когда активный режим включает WCDMA (rat 1/4/16/20; Auto=>20),
# иначе GTACT отвергнет UMTS-бенды (CME - «чужой для rat бенд», см. setmode).

# Текущая строка GTACT? с кэшем НА ПРОЦЕСС: за одну json-сборку 3G-функции
# (supported/enabled/rat-check) звались бы по разу каждая, и лишние AT-запросы
# конкурировали бы за общий порт с остальным опросом (enabled3g терялся). Одна
# команда на процесс. Set-операции идут ОТДЕЛЬНЫМ вызовом => кэш им не мешает.
_fm350_act() {
    if [ -z "$_ACT_CACHE" ]; then
        _ACT_CACHE=$(sms_tool -d $_DEVICE at "AT+GTACT?" 2>/dev/null | tr -d '\r' \
            | sed -n 's/^+GTACT: *//p' | head -1)
        [ -n "$_ACT_CACHE" ] || _ACT_CACHE="_none_"
    fi
    [ "$_ACT_CACHE" = "_none_" ] && return 1
    echo "$_ACT_CACHE"
}

_fm350_rat_has_umts() {
    case "$(_fm350_act | cut -d, -f1)" in 1|4|16|20) return 0 ;; *) return 1 ;; esac
}

# Стиль 3G: mask = галочки (произвольный набор), combo = готовые комбинации
# (Telit). json-билдер по этому флагу выбирает поля (supported3g/enabled3g либо
# combos3g/current3g).
bands3g_style() { echo "mask"; }

getsupportedbands3g() {
    _fm350_rat_has_umts || return       # пусто -> строку 3G скрыть
    _fm350_caps umts
}

getbands3g() {
    _fm350_rat_has_umts || return
    LINE=$(_fm350_act) || return
    # UMTS-бенды - в ХВОСТЕ (после rat,pref1,pref2); значения 1..10. Первые три
    # поля пропускаем: там rat/pref могут совпасть по числу с номером бенда.
    for b in $(echo "$LINE" | cut -d, -f4- | tr ',' ' '); do
        case "$b" in [1-9]|10) printf '%s ' "$b" ;; esac
    done
    echo ""
}

setbands3g() {
    _fm350_rat_has_umts || return
    BANDS="$1"
    T=""
    if [ "$BANDS" = "default" ]; then
        T=$(_fm350_caps umts | tr ' ' ',')     # все поддерживаемые UMTS-бенды
    else
        for b in $BANDS; do
            case "$b" in ''|*[!0-9]*) continue ;; esac
            [ -n "$T" ] && T="${T},"
            T="${T}${b}"
        done
    fi
    case "$T" in ''|*[!0-9,]*) return ;; esac
    O=$(sms_tool -d $_DEVICE at "AT+GTACT?")
    MODE=$(echo "$O" | awk -F[:,] '/\+GTACT:/{print $2","$3","$4}' | xargs)
    sms_tool -d $_DEVICE at "AT+GTACT=$MODE,$T"
}

getsupportedbands5gsa() {
    _b=$(_fm350_caps nr)
    [ -n "$_b" ] && echo "$_b" || echo "$_DEFAULT_5G_BANDS"
}

getsupportedbands5gnsa() {
