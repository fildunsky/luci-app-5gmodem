# Marvell PXA1826 (ASR) - 1286:4e28: Notion R281 / R291, МегаФон C300-1, Yota C300-1.
#
# Диапазоны - той же командой, что у ZTE: AT+ZNLOCKBAND=1,0,<маска>,0, маска -
# шестнадцатеричная, бит N-1 = бенд N. Совпадение с ZTE подтверждено примерами
# владельцев R281: «1,0,5,0» = B1+B3, «1,0,8000001,0» = B1+B28.
#
# КОМПЛЕКТАЦИИ РАЗНЫЕ. Российские C300-1 - 800/1800/2100/2300/2600 (B20, B3, B1,
# B40, B7/B38), филиппинская R281 (PLDT) - ещё B5, B8, B28, B41. Паспортного
# списка на всех нет, поэтому «что умеет» = базовый набор плюс всё, что модем
# хоть раз показывал включённым (запоминается в band_full, как у Altair): первое
# чтение заводской маски приносит бенды своей комплектации, и выключенный бенд
# потом не пропадает из списка.
_DEVICE=""
_DEFAULT_LTE_BANDS="1 3 7 20 38 40"

getinfo() {
	echo "Notion R2x1 / C300-1"
}

. $RES/_zte_common

# Ответ «+ZNLOCKBAND: 40,480000» (живой Yota C300-1, 11.09.2026): первое поле -
# маска LTE, 0x40 = B7, ровно на нём модем и сидел. Что во втором поле, не
# знаем - не читаем его. Строку берём по подписи: эхо команды и коды ошибок в
# разбор не попадают.
getbands() {
	HEX=$(sms_tool -d $_DEVICE at "at+znlockband?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^+ZNLOCKBAND:[[:space:]]*\([0-9A-Fa-f]*\).*/\1/p' | head -1)
	[ -n "$HEX" ] || return 0
	hextobands "0x$HEX"
}

getsupportedbands() {
	_zb_mem=""
	[ -n "$_bs_sec" ] && _zb_mem=$(uci -q get "5gmodem.$_bs_sec.band_full")
	_zb_all=$(printf '%s %s %s\n' "$_DEFAULT_LTE_BANDS" "$_zb_mem" "$(getbands)" \
		| tr ' ' '\n' | grep -E '^[0-9]+$' | awk '$1 >= 1 && $1 <= 88' \
		| sort -nu | tr '\n' ' ' | sed 's/ *$//')
	if [ -n "$_bs_sec" ] && [ -n "$_zb_all" ] && [ "$_zb_all" != "$_zb_mem" ]; then
		uci -q set "5gmodem.$_bs_sec.band_full=$_zb_all" && uci -q commit 5gmodem
	fi
	echo "$_zb_all"
}

# «Все диапазоны» - это всё, что модем умеет, а не базовый набор: иначе на R281
# кнопка сброса выключала бы B5, B8, B28 и B41.
setbands() {
	BANDS="$1"
	[ "$BANDS" = "default" ] && BANDS=$(getsupportedbands)

	HEX=$(bandstohex "$BANDS")
	[ "$HEX" != "0" ] && sms_tool -d $_DEVICE at "at+znlockband=1,0,$HEX,0"
}

# --- Привязка к соте / частоте: AT*CELL --------------------------------------
#
# Проверено владельцем Yota/МегаФон C300-1 (18.09.2026):
#   AT*CELL=2,3,0,2850,174  -> AT*CELL?  «*CELL: 2,3,0,2850,174»  (соту держит)
#   AT*CELL=0               -> AT*CELL?  «*CELL: 0,4,255,4294967295,-1»
# Формат: <mode>,<act>,<band>,<earfcn>,<pci>; mode 0 - выкл, 1 - частота,
# 2 - сота; act 3 = LTE. Для соты band=0 модем принимает (проверено); для
# частоты справка к модему показывает номер диапазона («1,3,3,1850,0»), его и
# вычисляем по EARFCN. Применяется сразу, без режима полёта.
# Агрегация при привязке пропадает: вторичные несущие на других частотах модему
# запрещены - это ожидаемо, не сбой.
_c300_band() {   # $1 - EARFCN LTE; номер диапазона или 0
	case "$1" in ''|*[!0-9]*) echo 0; return ;; esac
	if   [ "$1" -le 599 ];                          then echo 1
	elif [ "$1" -ge 1200 ]  && [ "$1" -le 1949 ];   then echo 3
	elif [ "$1" -ge 2400 ]  && [ "$1" -le 2649 ];   then echo 5
	elif [ "$1" -ge 2750 ]  && [ "$1" -le 3449 ];   then echo 7
	elif [ "$1" -ge 3450 ]  && [ "$1" -le 3799 ];   then echo 8
	elif [ "$1" -ge 6150 ]  && [ "$1" -le 6449 ];   then echo 20
	elif [ "$1" -ge 9210 ]  && [ "$1" -le 9659 ];   then echo 28
	elif [ "$1" -ge 37750 ] && [ "$1" -le 38249 ];  then echo 38
	else echo 0; fi
}

getcelllock() {
	O=$(sms_tool -d $_DEVICE at "AT*CELL?" 2>/dev/null | tr -d '\r ' \
		| sed -n 's/^\*CELL:\(.*\)/\1/p' | head -1)
	[ -n "$O" ] || { echo "Unsupported"; return; }
	_cl_m=$(echo "$O" | cut -d, -f1)
	_cl_f=$(echo "$O" | cut -d, -f4)
	_cl_p=$(echo "$O" | cut -d, -f5)
	case "$_cl_m" in
		1) echo "arfcn $_cl_f" ;;
		2) echo "cell $_cl_f $_cl_p" ;;
		*) echo "off" ;;
	esac
}

setcelllock() {
	case "$1" in
		off)
			sms_tool -d $_DEVICE at "AT*CELL=0" >/dev/null 2>&1 ;;
		arfcn)
			[ -n "$2" ] || return
			sms_tool -d $_DEVICE at "AT*CELL=1,3,$(_c300_band "$2"),$2,0" >/dev/null 2>&1 ;;
		cell)
			[ -n "$2" ] && [ -n "$3" ] || return
			sms_tool -d $_DEVICE at "AT*CELL=2,3,0,$2,$3" >/dev/null 2>&1 ;;
	esac
}
