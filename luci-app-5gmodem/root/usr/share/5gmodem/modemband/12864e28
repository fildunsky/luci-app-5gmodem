_DEVICE=""
_DEFAULT_LTE_BANDS="1 3 7 20 38 40"

getinfo() {
	echo "Notion R2x1 / C300-1"
}

. $RES/_zte_common

getbands() {
	HEX=$(sms_tool -d $_DEVICE at "at+znlockband?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^+ZNLOCKBAND:[[:space:]]*\([0-9A-Fa-f]*\).*/\1/p' | head -1)
	[ -n "$HEX" ] || return 0
	hextobands "0x$HEX"
}

getsupportedbands() {
	_zb_mem=""
	[ -n "$_bs_sec" ] && _zb_mem=$(uci -q get "5gmodem.$_bs_sec.band_full")
	_zb_all=$(printf '%s %s %s\n' "$_DEFAULT_LTE_BANDS" "$_zb_mem" "$(getbands)" \
		| tr ' ' '\n' | grep -E '^[0-9]+$' | awk '$1 >= 1 && $1 <= 88' \
		| sort -nu | tr '\n' ' ' | sed 's/ *$//')
	if [ -n "$_bs_sec" ] && [ -n "$_zb_all" ] && [ "$_zb_all" != "$_zb_mem" ]; then
		uci -q set "5gmodem.$_bs_sec.band_full=$_zb_all" && uci -q commit 5gmodem
	fi
	echo "$_zb_all"
}

setbands() {
	BANDS="$1"
	[ "$BANDS" = "default" ] && BANDS=$(getsupportedbands)

	HEX=$(bandstohex "$BANDS")
	[ "$HEX" != "0" ] && sms_tool -d $_DEVICE at "at+znlockband=1,0,$HEX,0"
}

_c300_band() {
	case "$1" in ''|*[!0-9]*) echo 0; return ;; esac
	if   [ "$1" -le 599 ];                          then echo 1
	elif [ "$1" -ge 1200 ]  && [ "$1" -le 1949 ];   then echo 3
	elif [ "$1" -ge 2400 ]  && [ "$1" -le 2649 ];   then echo 5
	elif [ "$1" -ge 2750 ]  && [ "$1" -le 3449 ];   then echo 7
	elif [ "$1" -ge 3450 ]  && [ "$1" -le 3799 ];   then echo 8
	elif [ "$1" -ge 6150 ]  && [ "$1" -le 6449 ];   then echo 20
	elif [ "$1" -ge 9210 ]  && [ "$1" -le 9659 ];   then echo 28
	elif [ "$1" -ge 37750 ] && [ "$1" -le 38249 ];  then echo 38
	else echo 0; fi
}

getcelllock() {
	O=$(sms_tool -d $_DEVICE at "AT*CELL?" 2>/dev/null | tr -d '\r ' \
		| sed -n 's/^\*CELL:\(.*\)/\1/p' | head -1)
	[ -n "$O" ] || { echo "Unsupported"; return; }
	_cl_m=$(echo "$O" | cut -d, -f1)
	_cl_f=$(echo "$O" | cut -d, -f4)
	_cl_p=$(echo "$O" | cut -d, -f5)
	case "$_cl_m" in
		1) echo "arfcn $_cl_f" ;;
		2) echo "cell $_cl_f $_cl_p" ;;
		*) echo "off" ;;
	esac
}

setcelllock() {
	case "$1" in
		off)
			sms_tool -d $_DEVICE at "AT*CELL=0" >/dev/null 2>&1 ;;
		arfcn)
			[ -n "$2" ] || return
			sms_tool -d $_DEVICE at "AT*CELL=1,3,$(_c300_band "$2"),$2,0" >/dev/null 2>&1 ;;
		cell)
			[ -n "$2" ] && [ -n "$3" ] || return
			sms_tool -d $_DEVICE at "AT*CELL=2,3,0,$2,$3" >/dev/null 2>&1 ;;
	esac
}
