# Marvell PXA1826 (ASR) - 1286:4e28: Notion R281 / R291, МегаФон C300-1, Yota C300-1.
#
# Диапазоны - той же командой, что у ZTE: AT+ZNLOCKBAND=1,0,<маска>,0, маска -
# шестнадцатеричная, бит N-1 = бенд N. Совпадение с ZTE подтверждено примерами
# владельцев R281: «1,0,5,0» = B1+B3, «1,0,8000001,0» = B1+B28.
#
# КОМПЛЕКТАЦИИ РАЗНЫЕ. Российские C300-1 - 800/1800/2100/2300/2600 (B20, B3, B1,
# B40, B7/B38), филиппинская R281 (PLDT) - ещё B5, B8, B28, B41. Паспортного
# списка на всех нет, поэтому «что умеет» = базовый набор плюс всё, что модем
# хоть раз показывал включённым (запоминается в band_full, как у Altair): первое
# чтение заводской маски приносит бенды своей комплектации, и выключенный бенд
# потом не пропадает из списка.
_DEVICE=""
_DEFAULT_LTE_BANDS="1 3 7 20 38 40"

getinfo() {
	echo "Notion R2x1 / C300-1"
}

. $RES/_zte_common

# Ответ «+ZNLOCKBAND: 40,480000» (живой Yota C300-1, 11.09.2026): первое поле -
# маска LTE, 0x40 = B7, ровно на нём модем и сидел. Что во втором поле, не
# знаем - не читаем его. Строку берём по подписи: эхо команды и коды ошибок в
# разбор не попадают.
getbands() {
	HEX=$(sms_tool -d $_DEVICE at "at+znlockband?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^+ZNLOCKBAND:[[:space:]]*\([0-9A-Fa-f]*\).*/\1/p' | head -1)
	[ -n "$HEX" ] || return 0
	hextobands "0x$HEX"
}

getsupportedbands() {
	_zb_mem=""
	[ -n "$_bs_sec" ] && _zb_mem=$(uci -q get "5gmodem.$_bs_sec.band_full")
	_zb_all=$(printf '%s %s %s\n' "$_DEFAULT_LTE_BANDS" "$_zb_mem" "$(getbands)" \
		| tr ' ' '\n' | grep -E '^[0-9]+$' | awk '$1 >= 1 && $1 <= 88' \
		| sort -nu | tr '\n' ' ' | sed 's/ *$//')
	if [ -n "$_bs_sec" ] && [ -n "$_zb_all" ] && [ "$_zb_all" != "$_zb_mem" ]; then
		uci -q set "5gmodem.$_bs_sec.band_full=$_zb_all" && uci -q commit 5gmodem
	fi
	echo "$_zb_all"
}

# «Все диапазоны» - это всё, что модем умеет, а не базовый набор: иначе на R281
# кнопка сброса выключала бы B5, B8, B28 и B41.
setbands() {
	BANDS="$1"
	[ "$BANDS" = "default" ] && BANDS=$(getsupportedbands)

	HEX=$(bandstohex "$BANDS")
	[ "$HEX" != "0" ] && sms_tool -d $_DEVICE at "at+znlockband=1,0,$HEX,0"
}
