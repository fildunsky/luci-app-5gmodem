getsupportedbands() {
	echo "$_DEFAULT_LTE_BANDS"
}

getbands() {
# ^SLBAND: WCDMA,Enabled,1,2,4,5,6,8,9,19
# ^SLBAND: LTE,Enabled,1,2,3,4,5,7,8,12,13,14,17,18,19,20,25,26,28,29,30,32,38,39,40,41,42,43,46,66

	O=$(sms_tool -d $_DEVICE at "at^slband?")
	# БЕРЁМ ТОЛЬКО СЕКЦИЮ «LTE,Enabled». Шаблон /LTE/ цеплял и строку
	# «^SLBAND: LTE,Disabled,...» - у неё префикс не срезался, и в список бендов
	# уезжали слова («1 3 7 20 LTE Disabled 2 4 5»): json-сборщик писал их в
	# массив как числа, а ВЫКЛЮЧЕННЫЕ диапазоны показывались включёнными - нажав
	# «Применить», человек закреплял их. (аудит 12.09.2026)
	echo "$O" | tr -d '\r' | awk '
		/LTE,Disabled/ { next }
		/LTE,Enabled,/ { sub(/.*LTE,Enabled,/, ""); gsub(/,/, " "); print; exit }
		/LTE,Enable Bands *:/ { sub(/.*LTE,Enable Bands *:/, ""); gsub(/,/, " "); print; exit }
		/SLBAND: *LTE,[0-9]/ { sub(/.*SLBAND: *LTE,/, ""); gsub(/,/, " "); print; exit }' | xargs
}

setbands() {
	BANDS="$1"
	[ "$BANDS" = "default" ] && BANDS="$_DEFAULT_LTE_BANDS"

	T=""
	for BAND in $BANDS; do
		case $BAND in
			''|*[!0-9]*) continue ;;
		esac
		[ -n "$T" ] && T="${T},"
		T="${T}${BAND}"
	done

	[ -n "$T" ] && sms_tool -d $_DEVICE at "at^slband=lte,2,$T"
}
