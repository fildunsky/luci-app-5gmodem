_DEVICE=""

. $RES/_fibocom_fm350_common

_fg_model() {
    [ -n "$_FG_MDL" ] || _FG_MDL=$(sms_tool -d $_DEVICE at "AT+CGMM?" 2>/dev/null | tr -d '\r"' \
        | sed -n 's/^+CGMM: *//p' | head -1)
    echo "$_FG_MDL"
}

getsupportedbands() {
    _b=$(_fm350_caps lte)
    [ -n "$_b" ] && { echo "$_b"; return; }
    case "$(_fg_model)" in
        *FG6*) echo "1 3 5 7 8 20 28 38 40 41" ;;
        *) echo "$_DEFAULT_LTE_BANDS" ;;
    esac
}

_fm350_no_nr() {
    _nn_cf="/tmp/5gmodem_fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    case "$(_fg_model)" in
        *FG6*) _fm350_caps lte >/dev/null 2>&1; return 0 ;;
    esac
    _fm350_caps lte >/dev/null 2>&1 || return 1
    [ -s "$_nn_cf" ] || return 1
    [ -z "$(_fm350_caps nr)" ]
}
