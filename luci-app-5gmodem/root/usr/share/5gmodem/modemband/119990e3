# Sierra Wireless EM9291 - следующее поколение серии EM919x, тот же AT-набор
# (!BAND мультимасками, !SDPREF, !UIMS, ENTERCND). Профиль общий с EM9190
# (119990d3); НЕ путать с EM9191 - тот делит с EM9190 сам PID 1199:90d3 и
# отдельного файла не требует (в ядре запись 90d3 так и подписана EM9191).
# Живьём EM9291 не проверялся: профиль пишет-проверяет каждую команду и
# отказ уйдёт в журнал, а не потеряется молча.
. "${RES:-/usr/share/5gmodem/modemband}/119990d3"

getinfo() {
	echo "Sierra Wireless EM9291"
}
