_DEVICE=""
_BANDS_APPLY_LIVE=1

getinfo() {
	echo "Altair LTE"
}

_alt_at() {
	[ -n "$_DEVICE" ] || return 1
	sms_tool -d $_DEVICE at "$1" 2>/dev/null | tr -d '\r'
}

_alt_nums() {
	tr -c '0-9\n' ' ' | tr -s ' ' '\n' | awk '/^[0-9]+$/ && $1 >= 1 && $1 <= 255' \
		| sort -nu | tr '\n' ' ' | sed 's/ *$//'
}

_alt_payload() {
	awk '
		/^AT/ { next }
		/^(OK|ERROR)/ { next }
		/^[[:space:]]*$/ { next }
		{ sub(/^.*:/, ""); print; exit }'
}

getsupportedbands() {
	_ab_key=$(printf '%s' "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')
	_ab_nc="/tmp/5gmodem/bands_alt_nobandcap_$_ab_key"
	[ -n "$(find "$_ab_nc" -mmin +30 2>/dev/null)" ] && rm -f "$_ab_nc"
	_ab_s=""
	if [ ! -f "$_ab_nc" ]; then
		for _ab_q in 'AT%BANDCAP' 'AT%BANDCAP=' 'AT%BANDCAP?'; do
			_ab_s=$(_alt_at "$_ab_q" | grep -i 'BANDCAP:' | _alt_payload | _alt_nums)
			[ -n "$_ab_s" ] && break
		done
		[ -n "$_ab_s" ] || : > "$_ab_nc" 2>/dev/null
	fi
	[ -n "$_ab_s" ] && { echo "$_ab_s"; return; }

	_ab_mem=""
	[ -n "$_bs_sec" ] && _ab_mem=$(uci -q get "5gmodem.$_bs_sec.band_full" | _alt_nums)
	_ab_s=$(printf '%s %s\n' "$_ab_mem" "$(getbands)" | _alt_nums)
	if [ -n "$_bs_sec" ] && [ -n "$_ab_s" ] && [ "$_ab_s" != "$_ab_mem" ]; then
		uci -q set "5gmodem.$_bs_sec.band_full=$_ab_s" && uci -q commit 5gmodem
	fi
	echo "$_ab_s"
}

getbands() {
	_alt_at 'AT%GETCFG="BAND"' | _alt_payload | _alt_nums
}

setbands() {
	_ab_sup=$(getsupportedbands)
	if [ "$1" = "default" ]; then
		_ab_want="$_ab_sup"
	else
		_ab_want=$(echo "$1" | _alt_nums)
	fi
	if [ -n "$_ab_sup" ]; then
		_ab_f=""
		for _ab_b in $_ab_want; do
			case " $_ab_sup " in *" $_ab_b "*) _ab_f="$_ab_f${_ab_f:+ }$_ab_b" ;; esac
		done
		_ab_want="$_ab_f"
	fi
	[ -n "$_ab_want" ] || return 1

	_ab_cur=$(getbands)
	[ "$_ab_cur" = "$_ab_want" ] && return 0

	_ab_arg=""
	for _ab_b in $_ab_want; do
		_ab_arg="$_ab_arg,\"$_ab_b\""
	done
	_ab_o=$(_alt_at "AT%SETCFG=\"BAND\"$_ab_arg")
	case "$_ab_o" in
		*ERROR*)
			logger -t 5gmodem "bands: firmware rejected AT%SETCFG=\"BAND\"$_ab_arg: $(printf '%s' "$_ab_o" | tr '\n' ' ' | head -c 120)"
			return 1 ;;
	esac
	_ab_cur=$(getbands)
	if [ "$_ab_cur" != "$_ab_want" ]; then
		logger -t 5gmodem "bands: AT%SETCFG answered, but NV holds \"$_ab_cur\" instead of \"$_ab_want\" - not restarting the modem"
		return 1
	fi
	logger -t 5gmodem "bands: NV band list set to \"$_ab_want\", restarting the modem to apply it"
	case "$(_alt_at 'AT+CFUN=1,1')" in
		*ERROR*)
			case "$(_alt_at 'ATZ')" in
				*ERROR*)
					_alt_at 'AT+CFUN=4' >/dev/null
					sleep 3
					_alt_at 'AT+CFUN=1' >/dev/null
					;;
			esac
			;;
	esac
	return 0
}

getantports() {
	_ap_o=$(_alt_at 'AT%MEAS="0"')
	_ap_r=$(printf '%s\n' "$_ap_o" | awk '
		{
			s = $0
			gsub(/[[:space:]]*=[[:space:]]*/, "=", s)
			n = split(s, f, /[,:]/)
			for (i = 1; i <= n; i++) {
				t = f[i]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
				if (t !~ /^Rx[01]Tx[0-3]=-?[0-9]+(\.[0-9]+)?$/) continue
				rx = substr(t, 3, 1); v = substr(t, 8) + 0
				if (v < -150 || v > -30) continue
				if (!(rx in best) || v > best[rx]) best[rx] = v
			}
		}
		END {
			for (r = 0; r <= 1; r++) if (r in best) printf "%s%d:%.0f:", (o++ ? " " : ""), r, best[r]
		}')
	[ -n "$_ap_r" ] || { echo "Unsupported"; return; }
	echo "$_ap_r"
}
