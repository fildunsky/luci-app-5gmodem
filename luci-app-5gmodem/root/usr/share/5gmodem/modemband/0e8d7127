_DEVICE=""

. "$RES/_fibocom_fm350_common"

_fibocom_band_at() {
	local reply

	command -v at_query >/dev/null 2>&1 || . /usr/share/5gmodem/lib.sh
	case "$1" in
		*\?) at_query "$_DEVICE" "$1"; return ;;
	esac

	# The transport can return success even when the modem rejected the set.
	reply=$(AT_QUERY_RAW=1 at_query "$_DEVICE" "$1") || return $?
	printf '%s\n' "$reply"
	printf '%s\n' "$reply" | tr -d '\r' \
		| awk 'NF { last = $0 } END { exit last !~ /^[[:space:]]*OK[[:space:]]*$/ }'
}

getcelllock() {
	O=$(_fibocom_band_at "AT+EMMCHLCK?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^+EMMCHLCK: *//p' | head -1)
	[ -n "$O" ] || { echo "Unsupported"; return; }

	_EN=$(echo "$O" | awk -F, '{print $1}' | tr -d ' ')
	[ "$_EN" = "1" ] || { echo "off"; return; }

	_AR=$(echo "$O" | awk -F, '{print $4}' | tr -d ' ')
	_PC=$(echo "$O" | awk -F, '{print $5}' | tr -d ' ')
	[ -n "$_AR" ] || { echo "off"; return; }
	if [ -n "$_PC" ] && [ "$_PC" != "0" ]; then
		echo "cell $_AR $_PC"
	else
		echo "arfcn $_AR"
	fi
}

get5gmode() {
	_fm350_no_nr && { echo "Unsupported"; return; }
	O=$(_fibocom_band_at "AT+E5GOPT?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^+E5GOPT: *//p' | head -1 | tr -cd '0-9')
	[ -n "$O" ] || { echo "Unsupported"; return; }
	_SA=$((O & 2)); _NSA=$((O & 4))
	if [ "$_SA" -gt 0 ] && [ "$_NSA" -gt 0 ]; then echo "sa+nsa"
	elif [ "$_SA" -gt 0 ]; then echo "sa"
	elif [ "$_NSA" -gt 0 ]; then echo "nsa"
	else echo "off"; fi
}

set5gmode() {
	_fm350_no_nr && return
	[ "$1" = "full" ] || return
	_fibocom_band_at "AT+CFUN=4" >/dev/null 2>&1
	sleep 2
	_fibocom_band_at "AT+E5GOPT=7" >/dev/null 2>&1
	sleep 1
	_fibocom_band_at "AT+CFUN=1" >/dev/null 2>&1
	sleep 8
	_fm350_reapply_bands
}

setcelllock() {
	case "$1" in
		off)
			_fibocom_band_at "AT+CFUN=4" >/dev/null 2>&1
			sleep 2
			_fibocom_band_at "AT+EMMCHLCK=0" >/dev/null 2>&1
			sleep 1
			_fibocom_band_at "AT+CFUN=1" >/dev/null 2>&1
			sleep 8
			_fm350_reapply_bands
			;;
		arfcn|cell)
			_AR="$2"; _PC="$3"
			[ -n "$_AR" ] || return
			_fibocom_band_at "AT+CFUN=4" >/dev/null 2>&1
			sleep 2
			_fibocom_band_at "AT+EMMCHLCK=0" >/dev/null 2>&1
			sleep 1
			if [ "$1" = "cell" ] && [ -n "$_PC" ]; then
				_fibocom_band_at "AT+EMMCHLCK=1,7,0,$_AR,$_PC,3" >/dev/null 2>&1
			else
				_fibocom_band_at "AT+EMMCHLCK=1,7,0,$_AR,,3" >/dev/null 2>&1
			fi
			sleep 1
			_fibocom_band_at "AT+CFUN=1" >/dev/null 2>&1
			sleep 8
			_fm350_reapply_bands
			;;
	esac
}
