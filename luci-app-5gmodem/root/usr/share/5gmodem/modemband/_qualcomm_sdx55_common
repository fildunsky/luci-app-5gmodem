# Общая часть модемов на Qualcomm SDX55 (Foxconn T99W175 / Thales MV31-W).
#
# ВЫНЕСЕНО В ОТДЕЛЬНЫЙ ФАЙЛ НАМЕРЕННО. Раньше это были шесть одинаковых
# копий по числу USB-композиций (05c6:9025, 05c6:90d5, 1e2d:00b3, 00b7,
# 00b8, 00b9), и они уже разошлись: правку для T99W175 внесли в 90d5, а в
# остальные пять - нет. Один и тот же модем в разных режимах вёл бы себя
# по-разному. Композиция меняет нумерацию портов и драйвер, но НЕ набор
# AT-команд, поэтому общей должна быть вся логика.

_DEVICE=""   # порт задаёт bands.sh (uci at_port / detect.sh); в профиле НЕ прибиваем — на мультимодеме это порт другого модема
_DEFAULT_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 34 38 39 40 41 42 46 48 66 71"
# n25 убран: ни один из десяти живых дампов AT^BAND_PREF? на форуме его не
# содержит, а забракованный список = не применился ни один диапазон.
_DEFAULT_5GNSA_BANDS="1 2 3 5 7 8 12 20 28 38 41 66 71 77 78 79"

getinfo() {
	# Файл общий для 05c6:9025/90d5 и 1e2d:*, где на 9025 живут Foxconn/Dell -
	# не подписываем всех как Thales.
	echo "Qualcomm SDX55 (T99W175 / MV31-W / DW5930e)"
}

# getsupportedbands / getsupportedbands5gnsa - НИЖЕ, у блока _bp_sup: список
# берётся у модема, а константы выше остались фолбэком на молчащий порт.

getbands() {
	O=$(sms_tool -d $_DEVICE at "AT^BAND_PREF?")
	echo "$O" | awk -F: '/LTE,Enable.*Bands.*:/{gsub(",", " ");print $2}' | xargs
}

setbands() {
	BANDS="$1"

	if [ "$BANDS" = "default" ]; then
		sms_tool -d $_DEVICE at "AT^BAND_PREF"
		return
	fi

	T=""
	for BAND in $BANDS; do
		case $BAND in
			''|*[!0-9]*) continue ;;
		esac
		[ -n "$T" ] && T="${T},"
		T="${T}${BAND}"
	done

	[ -z "$T" ] && return 1

	# БЕЗ голого AT^BAND_PREF перед записью: он сбрасывает маски ВСЕХ RAT к
	# заводским, а мы затем перезаписываем только один - у остальных всё снова
	# включено («трогаешь 4G - весь 5G синий», MV31-W 17.08.2026, доказано
	# юзером вручную). enable=2 сам переопределяет маску своего RAT целиком и
	# переживает перезагрузку - сброс не нужен. Список НЕ в кавычках: форма с
	# кавычками молча игнорируется прошивкой (те же живые пробы).
	_sb_o=$(sms_tool -d $_DEVICE at "AT^BAND_PREF=LTE,2,$T" 2>&1 | tr -d '\r')
	case "$_sb_o" in
		*ERROR*) logger -t 5gmodem "band_pref(LTE): firmware rejected the write \"AT^BAND_PREF=LTE,2,$T\": $(echo "$_sb_o" | tr '\n' ' ' | head -c 120)" ;;
	esac
}

# РЕЖИМ СЕТИ (RAT) через AT^SLMODE. Раньше режим у этого семейства умел только
# ModemManager, и на kernel-протоколе (mbim/qmi) кнопки режима не работали вовсе -
# живая жалоба с форума: «бенды и режим не срабатывают» на T99W175 под MBIM.
#
# Второй параметр - БИТОВАЯ МАСКА: 1=WCDMA, 2=LTE, 4=NR5G, 0=Auto. Сверено по
# фирменному набору команд (YAT, страница T99W175/DW5930/Lenovo SDX55):
#   1,0 Auto | 1,1 WCDMA | 1,2 LTE | 1,3 WCDMA+LTE
#   1,4 NR5G | 1,5 WCDMA+NR5G | 1,6 LTE+NR5G | 1,7 WCDMA+LTE+NR5G
#
# ОСТОРОЖНО: у T77W968 (Dell DW5821e, Snapdragon X20) та же команда, но ДРУГИЕ
# значения (Auto=4, WCDMA=14, LTE=30, WCDMA+LTE=35). У него отдельный профиль
# 413c81d7 - эту кодировку сюда переносить нельзя.
getsupportedmodes() {
	echo "0:Auto 1:3G 2:4G 3:3G+4G 6:4G+5G 7:3G+4G+5G"
}

getmode() {
	O=$(sms_tool -d $_DEVICE at "AT^SLMODE?" 2>/dev/null | tr -d '\r')
	echo "$O" | awk -F[:,] '/\^SLMODE:/{gsub(/ /,"",$3); print $3; exit}'
}

setmode() {
	M="$1"
	case "$M" in
		''|*[!0-9]*) return 1 ;;
	esac
	sms_tool -d $_DEVICE at "AT^SLMODE=1,$M"
}

getbands5gnsa() {
	O=$(sms_tool -d $_DEVICE at "AT^BAND_PREF?")
	echo "$O" | awk -F: '/NR5G,Enable.*Bands.*:/{gsub(",", " ");print $2}' | xargs
}

setbands5gnsa() {
	BANDS="$1"

	if [ "$BANDS" = "default" ]; then
		sms_tool -d $_DEVICE at "AT^BAND_PREF"
		return
	fi

	T=""
	for BAND in $BANDS; do
		case $BAND in
			''|*[!0-9]*) continue ;;
		esac
		[ -n "$T" ] && T="${T},"
		T="${T}${BAND}"
	done

	[ -z "$T" ] && return 1

	_sb_o=$(sms_tool -d $_DEVICE at "AT^BAND_PREF=NR5G,2,$T" 2>&1 | tr -d '\r')
	case "$_sb_o" in
		*ERROR*) logger -t 5gmodem "band_pref(NR5G): firmware rejected the write \"AT^BAND_PREF=NR5G,2,$T\": $(echo "$_sb_o" | tr '\n' ' ' | head -c 120)" ;;
	esac
}
# --- Привязка к соте и агрегация (Qualcomm SDX55) ----------------------------
#
# НАПИСАНО БЕЗ МОДЕМА В РУКАХ - только чтение, поэтому состояние радио изменить
# не может. Если команда не ответит или ответ не разберётся, вернём "Unsupported"
# и строка в интерфейсе просто не появится.
#
# Форматы взяты из инструкции к T99W175 и подтверждены там примером для 3G:
#   AT^WCDMA_LOCK?  ->  ^WCDMA_LOCK:(10663,143)     т.е. (uarfcn,psc)
#   AT^LTE_LOCK=PCI,EARFCN,...                      т.е. ПОРЯДОК ОБРАТНЫЙ нашему
# Наш контракт - "cell <arfcn> <pci>", поэтому пару меняем местами. Это главная
# ловушка этого модема: у FM350 сначала ARFCN, здесь - сначала PCI.
#
# ЗАПИСЬ ЕСТЬ, но с двумя особенностями этой прошивки (обе подтверждены живыми
# отчётами 24.08.2026):
#   1) порядок аргументов ОБРАТНЫЙ нашему контракту - сначала PCI, потом EARFCN;
#   2) команда вступает в силу ТОЛЬКО после перезапуска модуля (AT+CFUN=1,1), а
#      до него чтение честно отвечает «Have not set cell lock before». Без
#      перезапуска пользователь видел «привязано», а сота не менялась.
# Привязка переживает перезагрузку и снимается только вручную - снятие тем же
# вербом (off).
# setcelllock off | cell <arfcn> <pci>  (контракт bands.sh)
setcelllock() {
	case "$1" in
		off)
			sms_tool -d $_DEVICE at "AT^LTE_LOCK" >/dev/null 2>&1
			sms_tool -d $_DEVICE at "AT^WCDMA_LOCK" >/dev/null 2>&1
			;;
		cell)
			_sc_ar="$2"; _sc_pc="$3"
			case "$_sc_ar" in ''|*[!0-9]*) return 1 ;; esac
			case "$_sc_pc" in ''|*[!0-9]*) return 1 ;; esac
			# ПОРЯДОК: PCI, EARFCN - у этой прошивки он обратный нашему
			_sc_o=$(sms_tool -d $_DEVICE at "AT^LTE_LOCK=$_sc_pc,$_sc_ar" 2>&1 | tr -d '\r')
			case "$_sc_o" in
				*ERROR*) logger -t 5gmodem "celllock: firmware rejected \"AT^LTE_LOCK=$_sc_pc,$_sc_ar\": $(echo "$_sc_o" | tr '\n' ' ' | head -c 120)"
				         return 1 ;;
			esac
			;;
		*) return 1 ;;
	esac
	# ПРИМЕНЕНИЕ - ТОЛЬКО ПЕРЕЗАПУСКОМ МОДУЛЯ. Без него команда записана, но
	# сота не меняется, а чтение отвечает «привязки нет»: ровно так это и
	# выглядело у пользователя.
	sms_tool -d $_DEVICE at "AT+CFUN=1,1" >/dev/null 2>&1
	return 0
}

getcelllock() {
	O=$(sms_tool -d $_DEVICE at "AT^LTE_LOCK?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^\^*LTE_LOCK: *//p' | head -1 | tr -d '() ')
	if [ -n "$O" ]; then
		_PC=$(echo "$O" | cut -d, -f1)
		_AR=$(echo "$O" | cut -d, -f2)
		case "$_AR" in ''|*[!0-9]*) _AR="" ;; esac
		case "$_PC" in ''|*[!0-9]*) _PC="" ;; esac
		if [ -n "$_AR" ] && [ -n "$_PC" ]; then
			echo "cell $_AR $_PC"; return
		fi
	fi
	# 3G-привязка - отдельная команда; сообщаем о ней так же, как об LTE.
	O=$(sms_tool -d $_DEVICE at "AT^WCDMA_LOCK?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^\^*WCDMA_LOCK: *//p' | head -1 | tr -d '() ')
	if [ -n "$O" ]; then
		_AR=$(echo "$O" | cut -d, -f1)
		case "$_AR" in ''|*[!0-9]*) _AR="" ;; esac
		[ -n "$_AR" ] && { echo "arfcn $_AR"; return; }
	fi
	# Команда есть, но привязки нет - это тоже полезный ответ.
	# ИЩЕМ ОТВЕТ, А НЕ ЭХО. sms_tool печатает и саму команду, а в её эхе
	# «LTE_LOCK» есть всегда - по голому grep «off» получался и на прошивке,
	# которая команды НЕ знает (эхо + ERROR). «Unsupported» тогда не возвращался
	# никогда, на странице появлялся рабочий на вид блок привязки к соте, а его
	# кнопка делала AT+CFUN=1,1 - модем перезагружался впустую. Строки эха
	# начинаются на AT, а ERROR означает «команды нет». (аудит 12.09.2026)
	_gcl_o=$(sms_tool -d $_DEVICE at "AT^LTE_LOCK?" 2>/dev/null | tr -d '\r' | grep -v '^AT')
	case "$_gcl_o" in
		*ERROR*)    : ;;
		*LTE_LOCK*) echo "off"; return ;;
	esac
	echo "Unsupported"
}

# Агрегация может быть выключена в самом модеме - тогда он работает как cat4, а
# причина ниоткуда не видна. Ровно тот же класс диагностики, что и режим 5G у
# FM350: показываем, когда выключено, и молчим, когда всё в порядке.
getcaenabled() {
	# Модем отвечает «CA_FLAG: ENABLE» / «CA_FLAG: DISABLE» (форум, живые
	# ответы), а не «^CA_ENABLE: <цифра>» - прежний разбор всегда давал
	# «Unsupported», и диагностика «агрегация выключена» не срабатывала никогда
	# (ревью 12.09.2026). DISABLE проверяем первым: в нём есть подстрока ABLE.
	O=$(sms_tool -d $_DEVICE at "AT^CA_ENABLE?" 2>/dev/null | tr -d '\r' | grep -v '^AT')
	case "$O" in
		*CA_FLAG*[Dd][Ii][Ss][Aa][Bb][Ll][Ee]*) echo "off"; return ;;
		*CA_FLAG*[Ee][Nn][Aa][Bb][Ll][Ee]*)     echo "on";  return ;;
	esac
	echo "Unsupported"
}

# --- Диапазоны 3G (WCDMA) ----------------------------------------------------
#
# Прошивка управляет WCDMA той же командой, что LTE и NR5G - подтверждено живым
# выводом (сообщество, MV31-W/T99W175):
#   AT^BAND_PREF?
#      WCDMA,Enable Bands :1,2,4,5,6,8,9,19,
#      WCDMA,Disable Bands:
# ВЕДУЩИЙ ПРОБЕЛ В СТРОКАХ - НЕ ОПЕЧАТКА: прошивка печатает их с отступом
# (живой вывод пользователя 24.08.2026). Якорь "^" в шаблоне поэтому НЕ
# ставим - с ним разбор молча возвращал пустоту, и секция 3G не появлялась.
# У LTE-ветки выше якоря нет с самого начала, потому она и работала.
# Список ровно совпадает с паспортом модуля (UMTS/HSPA+ FDD 1,2,4,5,6,8,9,19),
# то есть прошивка отдаёт полный набор железа.
#
# Стиль - mask (галочки произвольного набора), как у LTE/NR: готовых комбинаций
# у этого семейства нет.
bands3g_style() {
	echo "mask"
}

# Поддерживаемые - объединение Enable и Disable из ответа модема (что железо
# умеет), с откатом на паспортный список, если ответ не пришёл.
getsupportedbands3g() {
	_g3_o=$(sms_tool -d $_DEVICE at "AT^BAND_PREF?" 2>/dev/null | tr -d '\r')
	_g3_l=$(printf '%s\n' "$_g3_o" | awk -F: '/WCDMA,(Enable|Disable) Bands/{print $2}' \
		| tr ',' ' ' | tr -s ' ')
	_g3_u=""
	for _g3_b in $_g3_l; do
		case "$_g3_b" in ''|*[!0-9]*) continue ;; esac
		case " $_g3_u " in *" $_g3_b "*) continue ;; esac
		_g3_u="$_g3_u$_g3_b "
	done
	_g3_u=$(printf '%s' "$_g3_u" | tr ' ' '\n' | sort -n | tr '\n' ' ' | sed 's/ *$//')
	[ -n "$_g3_u" ] && { echo "$_g3_u"; return; }
	echo "1 2 4 5 6 8 9 19"
}

getbands3g() {
	sms_tool -d $_DEVICE at "AT^BAND_PREF?" 2>/dev/null | tr -d '\r' \
		| awk -F: '/WCDMA,Enable Bands/{gsub(",", " "); print $2}' | xargs
}

setbands3g() {
	BANDS="$1"

	if [ "$BANDS" = "default" ]; then
		sms_tool -d $_DEVICE at "AT^BAND_PREF"
		return
	fi

	T=""
	for BAND in $BANDS; do
		case $BAND in
			''|*[!0-9]*) continue ;;
		esac
		[ -n "$T" ] && T="${T},"
		T="${T}${BAND}"
	done
	[ -z "$T" ] && return 1

	# enable=2 переопределяет маску своего RAT целиком и переживает
	# перезагрузку - ровно как у LTE-ветки выше; голый AT^BAND_PREF перед
	# записью не шлём, он сбрасывает маски ВСЕХ RAT к заводским.
	_s3_o=$(sms_tool -d $_DEVICE at "AT^BAND_PREF=WCDMA,2,$T" 2>&1 | tr -d '\r')
	case "$_s3_o" in
		*ERROR*) logger -t 5gmodem "band_pref(WCDMA): firmware rejected the write \"AT^BAND_PREF=WCDMA,2,$T\": $(echo "$_s3_o" | tr '\n' ' ' | head -c 120)" ;;
	esac
}

# --- Поддерживаемые диапазоны - У МОДЕМА, а не из константы -------------------
#
# Ответ AT^BAND_PREF? содержит ОБЕ половины - Enable и Disable (#186, #366,
# #1034), и их объединение даёт список ИМЕННО этой прошивки/ревизии. Раньше мы
# отдавали статику: у модуля с урезанным набором (OEM-прошивки, Canada-only) на
# странице появлялись галочки, которых в железе нет, а запись
# AT^BAND_PREF=<RAT>,2,<весь список> могла уйти в ERROR целиком.
# Рабочий образец уже был рядом - getsupportedbands3g ниже.
#
# КЭШИРУЕМ В /tmp НАВСЕГДА (до перезагрузки): набор «что железо вообще умеет»
# меняется только с прошивкой, а json на странице «Сеть» и так спрашивает
# AT^BAND_PREF? шесть раз за сборку - седьмой и восьмой запрос в тот же занятый
# порт ничего не добавляют. Текущий ВЫБОР (getbands/getbands5gnsa) читается
# по-прежнему живьём.
# ВЕДУЩИЙ ПРОБЕЛ в строках ответа - не опечатка прошивки, поэтому якоря "^" в
# шаблоне нет (та же ловушка, что расписана у 3G ниже).
# (ревью 13.09.2026, форум 4pda)
_bp_sup() {   # $1 - метка RAT в ответе (LTE / NR5G)
	_bs_f="/tmp/5gmodem_bpsup_$1_$(echo "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')"
	_bs_c=$(cat "$_bs_f" 2>/dev/null)
	[ -n "$_bs_c" ] && { echo "$_bs_c"; return; }
	_bs_l=$(sms_tool -d $_DEVICE at "AT^BAND_PREF?" 2>/dev/null | tr -d '\r' \
		| awk -v rat="$1" '$0 ~ rat ",(Enable|Disable) *Bands" { p = index($0, ":"); if (p) print substr($0, p + 1) }' \
		| tr ',' ' ' | tr -s ' ')
	_bs_u=""
	for _bs_b in $_bs_l; do
		case "$_bs_b" in ''|*[!0-9]*) continue ;; esac
		case " $_bs_u " in *" $_bs_b "*) continue ;; esac
		_bs_u="$_bs_u$_bs_b "
	done
	_bs_u=$(printf '%s' "$_bs_u" | tr ' ' '\n' | sort -n | tr '\n' ' ' | sed 's/ *$//')
	[ -n "$_bs_u" ] || return 0
	printf '%s' "$_bs_u" > "$_bs_f" 2>/dev/null
	echo "$_bs_u"
}

getsupportedbands() {
	_gl=$(_bp_sup LTE)
	[ -n "$_gl" ] && { echo "$_gl"; return; }
	echo "$_DEFAULT_LTE_BANDS"
}

getsupportedbands5gnsa() {
	_gn=$(_bp_sup NR5G)
	[ -n "$_gn" ] && { echo "$_gn"; return; }
	echo "$_DEFAULT_5GNSA_BANDS"
}

# --- Привязка к соте 5G (AT^NR5G_LOCK) ---------------------------------------
#
# Третья команда лока этой прошивки рядом с AT^LTE_LOCK и AT^WCDMA_LOCK, живой
# вывод чтения есть (#366, saniap):
#   AT^NR5G_LOCK?  ->  NR5G_LOCK:Have not set cell lock before   (лока нет)
# Модем в теме гоняют по NSA, и 5G-лок для него - такой же рабочий инструмент,
# как 4G-лок.
#
# ЧЕСТНАЯ ОГОВОРКА: живого дампа ЗАПИСИ на форуме нет ни одного - форму
# «AT^NR5G_LOCK=<pci>,<arfcn>» берём по симметрии с AT^LTE_LOCK (там порядок
# именно такой, обратный нашему контракту, #123, #6253). Поэтому ответ модема
# проверяем: на ERROR возвращаем "Unsupported" (bands.sh тогда ничего не
# запоминает и пишет строку в журнал) и, главное, НЕ шлём AT+CFUN=1,1 - иначе
# модем перезагружался бы впустую после каждой неудачной попытки.
# Как и у 4G-лока, запись вступает в силу только после перезапуска модуля.
# (ревью 13.09.2026, форум 4pda)
getcelllock5g() {
	_g5_o=$(sms_tool -d $_DEVICE at "AT^NR5G_LOCK?" 2>/dev/null | tr -d '\r' | grep -v '^AT')
	case "$_g5_o" in
		*ERROR*) echo "Unsupported"; return ;;
		*NR5G_LOCK*) : ;;
		*) echo "Unsupported"; return ;;
	esac
	_g5_v=$(printf '%s\n' "$_g5_o" | sed -n 's/^\^*NR5G_LOCK: *//p' | head -1 | tr -d '() ')
	_g5_pc=$(echo "$_g5_v" | cut -d, -f1)
	_g5_ar=$(echo "$_g5_v" | cut -d, -f2)
	case "$_g5_pc" in ''|*[!0-9]*) echo "off"; return ;; esac
	case "$_g5_ar" in ''|*[!0-9]*) echo "off"; return ;; esac
	echo "cell $_g5_ar $_g5_pc"
}

# setcelllock5g off | cell <nr-arfcn> <pci>   (контракт bands.sh)
setcelllock5g() {
	case "$1" in
		off)
			_s5_c="AT^NR5G_LOCK" ;;
		cell)
			case "$2" in ''|*[!0-9]*) echo "Unsupported"; return 1 ;; esac
			case "$3" in ''|*[!0-9]*) echo "Unsupported"; return 1 ;; esac
			# ПОРЯДОК: PCI, ARFCN - как у AT^LTE_LOCK, обратный нашему контракту
			_s5_c="AT^NR5G_LOCK=$3,$2" ;;
		*) return 1 ;;
	esac
	_s5_o=$(sms_tool -d $_DEVICE at "$_s5_c" 2>&1 | tr -d '\r')
	case "$_s5_o" in
		*ERROR*)
			logger -t 5gmodem "celllock5g: firmware rejected \"$_s5_c\": $(echo "$_s5_o" | tr '\n' ' ' | head -c 120)"
			echo "Unsupported"; return 1 ;;
	esac
	sms_tool -d $_DEVICE at "AT+CFUN=1,1" >/dev/null 2>&1
	return 0
}
