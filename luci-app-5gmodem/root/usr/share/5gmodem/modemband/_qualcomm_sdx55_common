setcelllock() {
	case "$1" in
		off)
			sms_tool -d $_DEVICE at "AT^LTE_LOCK" >/dev/null 2>&1
			sms_tool -d $_DEVICE at "AT^WCDMA_LOCK" >/dev/null 2>&1
			;;
		cell)
			_sc_ar="$2"; _sc_pc="$3"
			case "$_sc_ar" in ''|*[!0-9]*) return 1 ;; esac
			case "$_sc_pc" in ''|*[!0-9]*) return 1 ;; esac
			# PCI before EARFCN is the firmware order: see docs/subsystems/bands-profiles.md#qualcomm-sdx55-atband_pref
			_sc_o=$(sms_tool -d $_DEVICE at "AT^LTE_LOCK=$_sc_pc,$_sc_ar" 2>&1 | tr -d '\r')
			case "$_sc_o" in
				*ERROR*) logger -t 5gmodem "celllock: firmware rejected \"AT^LTE_LOCK=$_sc_pc,$_sc_ar\": $(echo "$_sc_o" | tr '\n' ' ' | head -c 120)"
				         return 1 ;;
			esac
			;;
		*) return 1 ;;
	esac
	sms_tool -d $_DEVICE at "AT+CFUN=1,1" >/dev/null 2>&1
	return 0
}

getcelllock() {
	O=$(sms_tool -d $_DEVICE at "AT^LTE_LOCK?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^\^*LTE_LOCK: *//p' | head -1 | tr -d '() ')
	if [ -n "$O" ]; then
		_PC=$(echo "$O" | cut -d, -f1)
		_AR=$(echo "$O" | cut -d, -f2)
		case "$_AR" in ''|*[!0-9]*) _AR="" ;; esac
		case "$_PC" in ''|*[!0-9]*) _PC="" ;; esac
		if [ -n "$_AR" ] && [ -n "$_PC" ]; then
			echo "cell $_AR $_PC"; return
		fi
	fi
	O=$(sms_tool -d $_DEVICE at "AT^WCDMA_LOCK?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^\^*WCDMA_LOCK: *//p' | head -1 | tr -d '() ')
	if [ -n "$O" ]; then
		_AR=$(echo "$O" | cut -d, -f1)
		case "$_AR" in ''|*[!0-9]*) _AR="" ;; esac
		[ -n "$_AR" ] && { echo "arfcn $_AR"; return; }
	fi
	_gcl_o=$(sms_tool -d $_DEVICE at "AT^LTE_LOCK?" 2>/dev/null | tr -d '\r' | grep -v '^AT')
	case "$_gcl_o" in
		*ERROR*)    : ;;
		*LTE_LOCK*) echo "off"; return ;;
	esac
	echo "Unsupported"
}

getcaenabled() {
	O=$(sms_tool -d $_DEVICE at "AT^CA_ENABLE?" 2>/dev/null | tr -d '\r' | grep -v '^AT')
	case "$O" in
		*CA_FLAG*[Dd][Ii][Ss][Aa][Bb][Ll][Ee]*) echo "off"; return ;;
		*CA_FLAG*[Ee][Nn][Aa][Bb][Ll][Ee]*)     echo "on";  return ;;
	esac
	echo "Unsupported"
}

bands3g_style() {
	echo "mask"
}

getsupportedbands3g() {
	_g3_o=$(sms_tool -d $_DEVICE at "AT^BAND_PREF?" 2>/dev/null | tr -d '\r')
	_g3_l=$(printf '%s\n' "$_g3_o" | awk -F: '/WCDMA,(Enable|Disable) Bands/{print $2}' \
		| tr ',' ' ' | tr -s ' ')
	_g3_u=""
	for _g3_b in $_g3_l; do
		case "$_g3_b" in ''|*[!0-9]*) continue ;; esac
		case " $_g3_u " in *" $_g3_b "*) continue ;; esac
		_g3_u="$_g3_u$_g3_b "
	done
	_g3_u=$(printf '%s' "$_g3_u" | tr ' ' '\n' | sort -n | tr '\n' ' ' | sed 's/ *$//')
	[ -n "$_g3_u" ] && { echo "$_g3_u"; return; }
	echo "1 2 4 5 6 8 9 19"
}

getbands3g() {
	sms_tool -d $_DEVICE at "AT^BAND_PREF?" 2>/dev/null | tr -d '\r' \
		| awk -F: '/WCDMA,Enable Bands/{gsub(",", " "); print $2}' | xargs
}

setbands3g() {
	BANDS="$1"

	if [ "$BANDS" = "default" ]; then
		sms_tool -d $_DEVICE at "AT^BAND_PREF"
		return
	fi

	T=""
	for BAND in $BANDS; do
		case $BAND in
			''|*[!0-9]*) continue ;;
		esac
		[ -n "$T" ] && T="${T},"
		T="${T}${BAND}"
	done
	[ -z "$T" ] && return 1

	_s3_o=$(sms_tool -d $_DEVICE at "AT^BAND_PREF=WCDMA,2,$T" 2>&1 | tr -d '\r')
	case "$_s3_o" in
		*ERROR*) logger -t 5gmodem "band_pref(WCDMA): firmware rejected the write \"AT^BAND_PREF=WCDMA,2,$T\": $(echo "$_s3_o" | tr '\n' ' ' | head -c 120)" ;;
	esac
}

_bp_sup() {
	_bs_f="/tmp/5gmodem/bpsup_$1_$(echo "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')"
	_bs_c=$(cat "$_bs_f" 2>/dev/null)
	[ -n "$_bs_c" ] && { echo "$_bs_c"; return; }
	_bs_l=$(sms_tool -d $_DEVICE at "AT^BAND_PREF?" 2>/dev/null | tr -d '\r' \
		| awk -v rat="$1" '$0 ~ rat ",(Enable|Disable) *Bands" { p = index($0, ":"); if (p) print substr($0, p + 1) }' \
		| tr ',' ' ' | tr -s ' ')
	_bs_u=""
	for _bs_b in $_bs_l; do
		case "$_bs_b" in ''|*[!0-9]*) continue ;; esac
		case " $_bs_u " in *" $_bs_b "*) continue ;; esac
		_bs_u="$_bs_u$_bs_b "
	done
	_bs_u=$(printf '%s' "$_bs_u" | tr ' ' '\n' | sort -n | tr '\n' ' ' | sed 's/ *$//')
	[ -n "$_bs_u" ] || return 0
	printf '%s' "$_bs_u" > "$_bs_f" 2>/dev/null
	echo "$_bs_u"
}

getsupportedbands() {
	_gl=$(_bp_sup LTE)
	[ -n "$_gl" ] && { echo "$_gl"; return; }
	echo "$_DEFAULT_LTE_BANDS"
}

getsupportedbands5gnsa() {
	_gn=$(_bp_sup NR5G)
	[ -n "$_gn" ] && { echo "$_gn"; return; }
	echo "$_DEFAULT_5GNSA_BANDS"
}

getcelllock5g() {
	_g5_o=$(sms_tool -d $_DEVICE at "AT^NR5G_LOCK?" 2>/dev/null | tr -d '\r' | grep -v '^AT')
	case "$_g5_o" in
		*ERROR*) echo "Unsupported"; return ;;
		*NR5G_LOCK*) : ;;
		*) echo "Unsupported"; return ;;
	esac
	_g5_v=$(printf '%s\n' "$_g5_o" | sed -n 's/^\^*NR5G_LOCK: *//p' | head -1 | tr -d '() ')
	_g5_pc=$(echo "$_g5_v" | cut -d, -f1)
	_g5_ar=$(echo "$_g5_v" | cut -d, -f2)
	case "$_g5_pc" in ''|*[!0-9]*) echo "off"; return ;; esac
	case "$_g5_ar" in ''|*[!0-9]*) echo "off"; return ;; esac
	echo "cell $_g5_ar $_g5_pc"
}

setcelllock5g() {
	case "$1" in
		off)
			_s5_c="AT^NR5G_LOCK" ;;
		cell)
			case "$2" in ''|*[!0-9]*) echo "Unsupported"; return 1 ;; esac
			case "$3" in ''|*[!0-9]*) echo "Unsupported"; return 1 ;; esac
			_s5_c="AT^NR5G_LOCK=$3,$2" ;;
		*) return 1 ;;
	esac
	_s5_o=$(sms_tool -d $_DEVICE at "$_s5_c" 2>&1 | tr -d '\r')
	case "$_s5_o" in
		*ERROR*)
			logger -t 5gmodem "celllock5g: firmware rejected \"$_s5_c\": $(echo "$_s5_o" | tr '\n' ' ' | head -c 120)"
			echo "Unsupported"; return 1 ;;
	esac
	sms_tool -d $_DEVICE at "AT+CFUN=1,1" >/dev/null 2>&1
	return 0
}
