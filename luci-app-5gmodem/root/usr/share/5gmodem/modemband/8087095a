_DEVICE=""
_BANDS_APPLY_LIVE="reconnect"

getinfo() {
	O=$(sms_tool -d $_DEVICE at "at+gmm")
	_NAME="Fibocom $(echo "$O" | awk -F, '/^\+GMM:/{gsub(/"/,""); gsub(/^ +| +$/,"",$2); print $2; exit}')"
	echo "$_NAME"
}

getsupportedbands() {
	_XS=$(sms_tool -d $_DEVICE at "at+xact=?" 2>/dev/null | tr -d '\r' \
		| awk -F: '/^\+XACT:/{print $2}' | tr ',' '\n' | tr -cd '0-9\n' \
		| awk '$1>100 && $1<300 {print $1-100}' | sort -n | uniq | xargs)
	if [ -n "$_XS" ]; then echo "$_XS"; return; fi
	O=$(sms_tool -d $_DEVICE at "at+gmm")
	if echo "$O" | grep -q "L850"; then
		_DEFAULT_LTE_BANDS="1 2 3 4 5 7 8 11 12 13 17 18 19 20 21 26 28 29 30 38 39 40 41 66"
	fi
	if echo "$O" | grep -q "L860"; then
		_DEFAULT_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 38 39 40 41 42 46 66"
	fi
	if echo "$O" | grep -q "L860-GL-16"; then
		_DEFAULT_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 34 38 39 40 41 42 43 46 48 66 71"
	fi
	echo "$_DEFAULT_LTE_BANDS"
}

getbands() {
	O=$(sms_tool -d $_DEVICE at "at+xact?")
	BANDS=$(echo "$O" | awk -F: '/^\+XACT:/{gsub(","," ");print $2}' | tr -d '\r')
	for BAND in $BANDS; do
		case $BAND in ''|*[!0-9]*) continue ;; esac
		if [ $BAND -gt 100 ] && [ $BAND -lt 200 ]; then
			echo -n "$((BAND - 100)) "
		fi
	done
	echo ""
}

getsupportedmodes() {
	echo "4:Auto 2:4G 1:3G"
}

getmode() {
	O=$(sms_tool -d $_DEVICE at "at+xact?")
	echo "$O" | awk -F'[:,]' '/^\+XACT:/{gsub(/ /,"",$2); print $2}'
}

setmode() {
	_ID="$1"
	case "$_ID" in 1|2|4) : ;; *) echo "Unsupported"; return 1 ;; esac
	O=$(sms_tool -d $_DEVICE at "at+xact?")
	T=$(echo "$O" | awk -F: '/^\+XACT:/{print $2}' | awk -F, '{s="";for(i=4;i<=NF;i++){gsub(/ /,"",$i); if($i!="") s=s (s==""?"":",") $i} print s}')
	_PREF=""
	[ "$_ID" = 4 ] && _PREF=2
	sms_tool -d $_DEVICE at "at+xact=$_ID,$_PREF,,$T"
}

bands3g_style() {
	echo "mask"
}

getsupportedbands3g() {
	O=$(sms_tool -d $_DEVICE at "at+xact=?")
	_S=$(echo "$O" | awk -F'\),' '/^\+XACT:/{print $NF}' | awk -F, '{s="";for(i=2;i<=NF;i++){gsub(/ /,"",$i); if($i!="" && $i+0<100 && $i+0>0) s=s (s==""?"":" ") $i} print s}')
	[ -n "$_S" ] && echo "$_S" || echo "Unsupported"
}

getbands3g() {
	O=$(sms_tool -d $_DEVICE at "at+xact?")
	echo "$O" | awk -F: '/^\+XACT:/{print $2}' | awk -F, '{s="";for(i=4;i<=NF;i++){gsub(/ /,"",$i); if($i!="" && $i+0<100 && $i+0>0) s=s (s==""?"":" ") $i} print s}'
}

setbands3g() {
	_B3="$1"
	O=$(sms_tool -d $_DEVICE at "at+xact?")
	_LN=$(echo "$O" | awk -F: '/^\+XACT:/{print $2}')
	_RAT=$(echo "$_LN" | awk -F, '{gsub(/ /,"",$1); print $1}')
	_LTE=$(echo "$_LN" | awk -F, '{s="";for(i=4;i<=NF;i++){gsub(/ /,"",$i); if($i!="" && $i+0>100) s=s (s==""?"":",") $i} print s}')
	T=""
	for B in $_B3; do
		case "$B" in ''|*[!0-9]*) continue ;; esac
		[ -n "$T" ] && T="${T},"
		T="${T}${B}"
	done
	[ -n "$T" ] && [ -n "$_LTE" ] && T="${T},${_LTE}"
	[ -n "$T" ] || T="$_LTE"
	[ -n "$T" ] && sms_tool -d $_DEVICE at "at+xact=$_RAT,,,$T"
}

setbands() {
	BANDS="$1"

	T=""
	if [ "$BANDS" = "default" ]; then
		T="0"
	else
		for BAND in $BANDS; do
			case $BAND in
				''|*[!0-9]*) continue ;;
			esac
			[ -n "$T" ] && T="${T},"
			T="${T}$((BAND + 100))"
		done
	fi

	if [ -n "$T" ]; then
		O=$(sms_tool -d $_DEVICE at "at+xact?")
		MODE=$(echo "$O" | awk -F[:,] '/^\+XACT:/{print $2; exit}' | xargs)
		_G3=$(echo "$O" | awk -F: '/^\+XACT:/{print $2}' | awk -F, '{s="";for(i=4;i<=NF;i++){gsub(/ /,"",$i); if($i!="" && $i+0<100 && $i+0>0) s=s (s==""?"":",") $i} print s}')
		[ "$T" = "0" ] || { [ -n "$_G3" ] && T="${_G3},${T}"; }
		sms_tool -d $_DEVICE at "at+xact=$MODE,,,$T"
	fi
}

_ch2band() {
	case "$1" in ''|*[!0-9]*) echo 0; return ;; esac
	if   [ "$1" -le 599 ];  then echo 1
	elif [ "$1" -le 1199 ]; then echo 2
	elif [ "$1" -le 1949 ]; then echo 3
	elif [ "$1" -le 2399 ]; then echo 4
	elif [ "$1" -le 2649 ]; then echo 5
	elif [ "$1" -ge 2750 ] && [ "$1" -le 3449 ]; then echo 7
	elif [ "$1" -ge 3450 ] && [ "$1" -le 3799 ]; then echo 8
	elif [ "$1" -ge 5010 ] && [ "$1" -le 5179 ]; then echo 12
	elif [ "$1" -ge 5180 ] && [ "$1" -le 5279 ]; then echo 13
	elif [ "$1" -ge 5730 ] && [ "$1" -le 5849 ]; then echo 17
	elif [ "$1" -ge 5850 ] && [ "$1" -le 5999 ]; then echo 18
	elif [ "$1" -ge 6000 ] && [ "$1" -le 6149 ]; then echo 19
	elif [ "$1" -ge 6150 ] && [ "$1" -le 6449 ]; then echo 20
	elif [ "$1" -ge 66436 ] && [ "$1" -le 67335 ]; then echo 66
	elif [ "$1" -ge 9210 ] && [ "$1" -le 9659 ]; then echo 28
	elif [ "$1" -ge 9770 ] && [ "$1" -le 9869 ]; then echo 30
	elif [ "$1" -ge 37750 ] && [ "$1" -le 38249 ]; then echo 38
	elif [ "$1" -ge 38250 ] && [ "$1" -le 38649 ]; then echo 39
	elif [ "$1" -ge 38650 ] && [ "$1" -le 39649 ]; then echo 40
	elif [ "$1" -ge 39650 ] && [ "$1" -le 41589 ]; then echo 41
	else echo 0
	fi
}

_CELLLOCK_WRITEONLY=1

getcelllock() {
	echo "off"
}

# CFUN=15 and PCI 65535 are deliberate: see docs/subsystems/bands-profiles.md#intel-xmm-l850l860-atxact
setcelllock() {
	case "$1" in
		off)
			sms_tool -d $_DEVICE at "AT+CFUN=4" >/dev/null 2>&1; sleep 2
			sms_tool -d $_DEVICE at "at@sic:freq_lock(0,3,255,0,4294967295,65535)" >/dev/null 2>&1; sleep 1
			sms_tool -d $_DEVICE at "AT+CFUN=15" >/dev/null 2>&1; sleep 6
			;;
		arfcn|cell)
			_AR="$2"; _PC="$3"; [ -n "$_AR" ] || return
			case "$_PC" in ''|*[!0-9]*) _PC=65535 ;; esac
			[ "$1" = arfcn ] && _PC=65535
			_B=$(_ch2band "$_AR"); case "$_B" in ""|0) _B=255 ;; esac
			sms_tool -d $_DEVICE at "AT+CFUN=4" >/dev/null 2>&1; sleep 2
			sms_tool -d $_DEVICE at "at@sic:freq_lock(0,3,$_B,1,$_AR,$_PC)" >/dev/null 2>&1; sleep 1
			sms_tool -d $_DEVICE at "AT+CFUN=15" >/dev/null 2>&1; sleep 6
			;;
	esac
}
