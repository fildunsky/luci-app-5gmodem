_DEFAULT_LTE_BANDS="1 3 5 7 8 20 28 38 40 41"
# 3G И РЕЖИМ СЕТИ - ПО ЖИВОМУ ЧТЕНИЮ ЭТОГО МОДЕМА (стенд, 05.08.2026):
#   at+qcfg="band" -> +QCFG: "band",0x8d0,0x1a0080800d5,0x0
# Первый аргумент (общая маска GSM+WCDMA) = 0x8d0: биты 0x10/0x40/0x80 - это
# WCDMA B1/B5/B8, а GSM-биты (0x1 900, 0x2 1800, 0x4 850, 0x8 1900) ПУСТЫ.
# У EP06-E радио 2G нет вовсе, поэтому _DEFAULT_2G_BANDS не объявляем - строка
# «Диапазоны 2G» останется скрытой, а не пустой.
# Режимы сети без GSM: nwscanmode 0=Auto, 2=WCDMA, 3=LTE (1=GSM модулю нечем).
_DEFAULT_3G_BANDS="1 5 8"
_QMODES="0:Auto 2:3G 3:4G"

getinfo() {
