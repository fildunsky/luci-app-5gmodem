_DEVICE=""

. $RES/_fibocom_fm350_common

_DEFAULT_LTE_BANDS="1 3 5 7 8 20 28 38 40 41"

_fm350_no_nr() {
    _nn_cf="/tmp/5gmodem/fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    _fm350_caps lte >/dev/null 2>&1
    return 0
}

getinfo() {
    _gi_m=$(sms_tool -d $_DEVICE at "AT+CGMM?" 2>/dev/null | tr -d '\r"' \
        | sed -n 's/^+CGMM: *//p' | head -1 | xargs)
    echo "Fibocom ${_gi_m:-NL668}"
}

getsupportedmodes() {
    _fm350_caps lte >/dev/null 2>&1
    _nn_cf="/tmp/5gmodem/fm350_caps_$(basename "$_DEVICE" 2>/dev/null)"
    _sm_r=""
    [ -s "$_nn_cf" ] && _sm_r=$(sed -n '1p' "$_nn_cf" | tr -d '() ' | tr ',' '\n' \
        | awk -F- 'NF == 2 { for (i = $1; i <= $2; i++) print i; next } { print }' | xargs)
    _sm_r=" $_sm_r "
    case "$_sm_r" in
        "  ") echo "10:Auto 2:4G 4:3G+4G"; return ;;
    esac
    _sm_o=""
    case "$_sm_r" in *" 10 "*) _sm_o="10:Auto" ;; esac
    case "$_sm_r" in *" 1 "*) _sm_o="$_sm_o 1:3G" ;; esac
    case "$_sm_r" in *" 4 "*) _sm_o="$_sm_o 4:3G+4G" ;; esac
    case "$_sm_r" in *" 2 "*) _sm_o="$_sm_o 2:4G" ;; esac
    echo ${_sm_o:-2:4G}
}
