# Общая часть модемов Foxconn T99W373 / Thales Cinterion MV32-W (Qualcomm SDX62).
#
# ОТКУДА ФОРМАТЫ. Всё ниже сверено по фирменному «MV32-W AT Command Reference
# Guide» 80781ST11134A Rev 3 (2024-11-12), разделы 15.20-15.40. Модема в руках
# не было: НИ ОДНА функция чтения состояния радио не трогает, а у записи ошибка
# прошивки уходит в журнал (logger), а не проглатывается.
#
# ЧЕМ MV32 ОТЛИЧАЕТСЯ ОТ MV31 (_qualcomm_sdx55_common) - три вещи, и все три
# ломают прямое переиспользование того файла:
#   1) имена RAT в BAND_PREF. У MV31 маска 5G одна и зовётся NR5G; у MV32 их
#      ДВЕ - NR5G_NSA и NR5G_SA, а голое NR5G означает «обе сразу». Прочитать
#      SA-маску шаблоном MV31 нельзя: «NR5G,Enable» не совпадает с
#      «NR5G_SA,Enable», и раздел 5G SA остался бы пустым.
#   2) префикс команд. Руководство MV32 называет их через «+» (AT+BAND_PREF),
#      а примеры в том же документе отвечают через «^» (^SLMODE:, ^NR5G_LOCK:).
#      Прошивка понимает оба, но какой именно - зависит от сборки, поэтому
#      команды идут через _mv32_at: сперва «+», при ERROR/пустоте - «^».
#   3) BAND_PREF применяется БЕЗ перезагрузки (прямая цитата руководства:
#      «The difference between AT+BAND_PREF and AT+SLBAND is AT+BAND_PREF can
#      enable/disable band(s) without reboot»). У MV31 мы этого не знали и
#      перезагружали модем после каждой правки.
#
# _DEVICE задаёт bands.sh (uci at_port / detect.sh) - в профиле НЕ прибиваем:
# на мультимодемном роутере прибитый порт принадлежал бы другому модему.
_DEVICE=""

# Применение диапазонов - ВЖИВУЮ, без перезапуска радио (см. пункт 3 выше).
_BANDS_APPLY_LIVE=1

# Паспортные списки - на случай, если модем не ответил (порт занят дозвоном).
# Взяты из <band> в разделах 15.20/15.30, а не из даташита: прошивка отдаёт
# именно их, и расхождение (даташит обещает WCDMA B6, руководство - нет)
# лучше решать в пользу того, что реально примет команда.
_MV32_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 34 38 39 40 41 42 43 46 48 66 71"
_MV32_NR_BANDS="1 2 3 5 7 8 12 13 14 18 20 25 26 28 30 38 40 41 48 53 66 70 71 75 76 77 78 79"
_MV32_WCDMA_BANDS="1 2 4 5 8"

getinfo() {
	echo "Thales/Cinterion MV32-W"
}

# --- Транспорт ---------------------------------------------------------------
#
# ОДНА КОМАНДА, ДВА ПРЕФИКСА. Пробуем документированный «+», при отказе - «^».
# Второй заход стоит одного лишнего обмена с портом и только на тех сборках,
# где «+» не понят; на понявших его не будет вовсе.
_mv32_at() {   # $1 - тело команды без префикса, напр. "BAND_PREF?"
	_m32_o=$(sms_tool -d $_DEVICE at "AT+$1" 2>&1 | tr -d '\r')
	case "$_m32_o" in
		''|*ERROR*) _m32_o=$(sms_tool -d $_DEVICE at "AT^$1" 2>&1 | tr -d '\r') ;;
	esac
	printf '%s\n' "$_m32_o"
}

# Одна секция ответа AT+BAND_PREF? / AT+SLBAND?.
#
# Ответ прошивки - набор строк вида «LTE,Enable Bands : 1,2,3,». В фирменном
# руководстве соседние секции местами напечатаны В ОДНОЙ строке
# («LTE,Disable Bands: NR5G_NSA,Enable Bands :»), и полагаться на то, что
# живая прошивка так не делает, нельзя: разбор по номеру поля после первого
# «:» отдал бы тогда чужой список. Поэтому сперва режем ответ ПЕРЕД каждым
# заголовком, и только затем берём свой - вместе с продолжением: длинный список
# 5G прошивка переносит на следующие строки, и разбор «только заголовок»
# вернул бы пустоту там, где бенды есть.
_mv32_pick() {   # $1 - RAT, $2 - Enable|Disable; ответ на stdin
	awk '
	{
		gsub(/[A-Za-z0-9_]+,(Enable|Disable) Bands[[:space:]]*:/, "\n&")
		print
	}' | awk -v h="$1,$2 Bands" '
	index($0, h) == 1 { grab = 1; sub(/^[^:]*:[[:space:]]*/, ""); acc = $0; next }
	grab && $0 ~ /^[A-Za-z0-9_]+,(Enable|Disable) Bands/ { exit }
	grab && $0 ~ /^(OK|ERROR)/ { exit }
	grab { acc = acc $0 }
	END { gsub(/,/, " ", acc); print acc }
	'
}

# ОДИН ОТВЕТ BAND_PREF? НА ВЕСЬ ПОКАЗ СТРАНИЦЫ.
#
# json-сборщик bands.sh зовёт get*/getsupported* по отдельности, каждый в своей
# подоболочке, - переменную-кэш между ними не передать. А чтений восемь
# (4G/5G NSA/5G SA/3G, каждое дважды), и без кэша это восемь походов в порт, за
# который дерутся дозвон, метрики и SMS. Кэш короткий (5 c) и лежит под
# префиксом /tmp/5gmodem_bands_* - тем самым, который set*-вербы уже чистят
# после записи, так что «применил и вижу старое» здесь появиться неоткуда.
_mv32_bp() {
	_m32_c="/tmp/5gmodem_bands_mv32bp_$(printf '%s' "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')"
	if [ -s "$_m32_c" ]; then
		_m32_ts=$(cat "$_m32_c.t" 2>/dev/null)
		case "$_m32_ts" in
			''|*[!0-9]*) _m32_ts="" ;;
		esac
		if [ -n "$_m32_ts" ]; then
			_m32_age=$(( $(cut -d. -f1 /proc/uptime) - _m32_ts ))
			if [ "$_m32_age" -ge 0 ] && [ "$_m32_age" -le 5 ]; then
				cat "$_m32_c"
				return
			fi
		fi
	fi
	_m32_o=$(_mv32_at "BAND_PREF?")
	case "$_m32_o" in
		*Bands*)
			printf '%s\n' "$_m32_o" > "$_m32_c.tmp" 2>/dev/null \
				&& mv "$_m32_c.tmp" "$_m32_c" 2>/dev/null \
				&& cut -d. -f1 /proc/uptime > "$_m32_c.t" 2>/dev/null
			;;
	esac
	printf '%s\n' "$_m32_o"
}

# Оставить только числа: у прошивки список кончается запятой, и пустое поле
# после неё иначе доехало бы до интерфейса пустой кнопкой.
_mv32_nums() {
	_m32_r=""
	for _m32_b in $(cat); do
		case "$_m32_b" in
			''|*[!0-9]*) continue ;;
		esac
		_m32_r="$_m32_r${_m32_r:+ }$_m32_b"
	done
	printf '%s\n' "$_m32_r"
}

# Список бендов -> «1,2,3» для записи. Пустой список = отказ: команда с пустым
# хвостом у этой прошивки означает «сбросить к заводским», а это не то, что
# просил человек.
_mv32_csv() {
	_m32_t=""
	for _m32_b in $1; do
		case "$_m32_b" in
			''|*[!0-9]*) continue ;;
		esac
		_m32_t="${_m32_t}${_m32_t:+,}${_m32_b}"
	done
	[ -n "$_m32_t" ] || return 1
	printf '%s\n' "$_m32_t"
}

# Запись маски одного RAT. status=2 - «включить ровно эти», маска своего RAT
# переопределяется целиком (раздел 15.30). Голое AT+BAND_PREF СЮДА НЕ ШЛЁМ: у
# родственного MV31 это сбрасывало маски ВСЕХ RAT к заводским, и правка 4G
# возвращала весь 5G (живой разбор 17.08.2026, см. _qualcomm_sdx55_common).
# Список без кавычек: руководство MV32 печатает их, а прошивка MV31 такую форму
# молча проглатывала - вариант без кавычек понимают обе.
_mv32_setbands() {   # $1 - RAT, $2 - список бендов через пробел
	if [ "$2" = "default" ]; then
		_mv32_at "BAND_PREF" >/dev/null 2>&1
		return
	fi
	_m32_l=$(_mv32_csv "$2") || return 1
	rm -f "/tmp/5gmodem_bands_mv32bp_$(printf '%s' "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')" \
		"/tmp/5gmodem_bands_mv32bp_$(printf '%s' "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_').t" 2>/dev/null
	_m32_w=$(_mv32_at "BAND_PREF=$1,2,$_m32_l")
	case "$_m32_w" in
		*ERROR*) logger -t 5gmodem "band_pref($1): firmware rejected the write \"BAND_PREF=$1,2,$_m32_l\": $(printf '%s' "$_m32_w" | tr '\n' ' ' | head -c 120)"
		         return 1 ;;
	esac
	return 0
}

