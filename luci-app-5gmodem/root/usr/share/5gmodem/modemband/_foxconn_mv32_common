	_m32_o=$(_mv32_bp)
	_m32_u=$(printf '%s %s\n' "$(printf '%s\n' "$_m32_o" | _mv32_pick LTE Enable)" \
		"$(printf '%s\n' "$_m32_o" | _mv32_pick LTE Disable)" \
		| _mv32_nums | tr ' ' '\n' | sort -nu | tr '\n' ' ' | sed 's/ *$//')
	[ -n "$_m32_u" ] && { echo "$_m32_u"; return; }
	echo "$_MV32_LTE_BANDS"
}

getbands() {
	_mv32_bp | _mv32_pick LTE Enable | _mv32_nums
}

setbands() {
	_mv32_setbands LTE "$1"
}

