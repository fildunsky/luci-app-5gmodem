_DEVICE=""

_BANDS_APPLY_LIVE=1

_MV32_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 34 38 39 40 41 42 43 46 48 66 71"
_MV32_NR_BANDS="1 2 3 5 7 8 12 13 14 18 20 25 26 28 30 38 40 41 48 53 66 70 71 75 76 77 78 79"
_MV32_WCDMA_BANDS="1 2 4 5 8"

getinfo() {
	echo "Thales/Cinterion MV32-W"
}

_mv32_at() {
	_m32_o=$(sms_tool -d $_DEVICE at "AT+$1" 2>&1 | tr -d '\r')
	case "$_m32_o" in
		''|*ERROR*) _m32_o=$(sms_tool -d $_DEVICE at "AT^$1" 2>&1 | tr -d '\r') ;;
	esac
	printf '%s\n' "$_m32_o"
}

_mv32_pick() {
	awk '
	{
		gsub(/[A-Za-z0-9_]+,(Enable|Disable) Bands[[:space:]]*:/, "\n&")
		print
	}' | awk -v h="$1,$2 Bands" '
	index($0, h) == 1 { grab = 1; sub(/^[^:]*:[[:space:]]*/, ""); acc = $0; next }
	grab && $0 ~ /^[A-Za-z0-9_]+,(Enable|Disable) Bands/ { exit }
	grab && $0 ~ /^(OK|ERROR)/ { exit }
	grab { acc = acc $0 }
	END { gsub(/,/, " ", acc); print acc }
	'
}

_mv32_bp() {
	_m32_c="/tmp/5gmodem/bands_mv32bp_$(printf '%s' "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')"
	if [ -s "$_m32_c" ]; then
		_m32_ts=$(cat "$_m32_c.t" 2>/dev/null)
		case "$_m32_ts" in
			''|*[!0-9]*) _m32_ts="" ;;
		esac
		if [ -n "$_m32_ts" ]; then
			_m32_age=$(( $(cut -d. -f1 /proc/uptime) - _m32_ts ))
			if [ "$_m32_age" -ge 0 ] && [ "$_m32_age" -le 5 ]; then
				cat "$_m32_c"
				return
			fi
		fi
	fi
	_m32_o=$(_mv32_at "BAND_PREF?")
	case "$_m32_o" in
		*Bands*)
			printf '%s\n' "$_m32_o" > "$_m32_c.tmp" 2>/dev/null \
				&& mv "$_m32_c.tmp" "$_m32_c" 2>/dev/null \
				&& cut -d. -f1 /proc/uptime > "$_m32_c.t" 2>/dev/null
			;;
	esac
	printf '%s\n' "$_m32_o"
}

_mv32_nums() {
	_m32_r=""
	for _m32_b in $(cat); do
		case "$_m32_b" in
			''|*[!0-9]*) continue ;;
		esac
		_m32_r="$_m32_r${_m32_r:+ }$_m32_b"
	done
	printf '%s\n' "$_m32_r"
}

_mv32_csv() {
	_m32_t=""
	for _m32_b in $1; do
		case "$_m32_b" in
			''|*[!0-9]*) continue ;;
		esac
		_m32_t="${_m32_t}${_m32_t:+,}${_m32_b}"
	done
	[ -n "$_m32_t" ] || return 1
	printf '%s\n' "$_m32_t"
}

_mv32_setbands() {
	if [ "$2" = "default" ]; then
		_mv32_at "BAND_PREF" >/dev/null 2>&1
		return
	fi
	_m32_l=$(_mv32_csv "$2") || return 1
	rm -f "/tmp/5gmodem/bands_mv32bp_$(printf '%s' "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')" \
		"/tmp/5gmodem/bands_mv32bp_$(printf '%s' "${_DEVICE##*/}" | tr -c 'A-Za-z0-9' '_').t" 2>/dev/null
	_m32_w=$(_mv32_at "BAND_PREF=$1,2,$_m32_l")
	case "$_m32_w" in
		*ERROR*) logger -t 5gmodem "band_pref($1): firmware rejected the write \"BAND_PREF=$1,2,$_m32_l\": $(printf '%s' "$_m32_w" | tr '\n' ' ' | head -c 120)"
		         return 1 ;;
	esac
	return 0
}

getsupportedbands() {
	_m32_o=$(_mv32_bp)
	_m32_u=$(printf '%s %s\n' "$(printf '%s\n' "$_m32_o" | _mv32_pick LTE Enable)" \
		"$(printf '%s\n' "$_m32_o" | _mv32_pick LTE Disable)" \
		| _mv32_nums | tr ' ' '\n' | sort -nu | tr '\n' ' ' | sed 's/ *$//')
	[ -n "$_m32_u" ] && { echo "$_m32_u"; return; }
	echo "$_MV32_LTE_BANDS"
}

getbands() {
	_mv32_bp | _mv32_pick LTE Enable | _mv32_nums
}

setbands() {
	_mv32_setbands LTE "$1"
}

