# --- Режим сети (RAT) --------------------------------------------------------
# AT+SLMODE=<pref_term>,<pref_mode>. pref_term=1 - PERMANENT (переживает
# перезагрузку модуля), pref_mode - БИТОВАЯ МАСКА 1=WCDMA, 2=LTE, 4=NR5G
# (раздел 15.22). Кодировка совпала с MV31 - но переносить её «по родству»
# нельзя: у T77W968 та же команда с совершенно другими числами (Auto=4), и
# ошибка не даёт сообщения, модем просто уходит в другой RAT.
getsupportedmodes() {
	echo "0:Auto 1:3G 2:4G 3:3G+4G 6:4G+5G 7:3G+4G+5G"
}

getmode() {
	_mv32_at "SLMODE?" | awk -F'[:,]' '/SLMODE:/{gsub(/ /,"",$3); print $3; exit}'
}

setmode() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	_mv32_at "SLMODE=1,$1" >/dev/null 2>&1
}

# --- Агрегация несущих -------------------------------------------------------
# Агрегация бывает выключена в самой прошивке - тогда модуль работает как cat4,
# а причина ниоткуда не видна. Ответ: «CA_FLAG: DISABLE» / «CA_FLAG: ENABLE».
# ВНИМАНИЕ на инверсию в записи: у AT+CA_ENABLE 0 = включить, 1-255 = выключить
# (раздел 15.24). Мы только читаем, но следующему это сэкономит вечер.
getcaenabled() {
	_m32_o=$(_mv32_at "CA_ENABLE?" | sed -n 's/.*CA_FLAG:[[:space:]]*//p' | head -1 | tr -d ' ')
	case "$_m32_o" in
		[Ee][Nn][Aa][Bb][Ll][Ee]*) echo "on" ;;
		[Dd][Ii][Ss][Aa][Bb][Ll][Ee]*) echo "off" ;;
		*) echo "Unsupported" ;;
	esac
}

# --- Режим 5G в самом модеме -------------------------------------------------
# AT+NR5G_MODE: 0 - NSA и SA, 1 - только NSA, 2 - только SA (раздел 15.39).
# Полного выключения 5G эта команда не умеет - «off» отдавать неоткуда, и это
# честно: за выключение 5G у MV32 отвечает режим сети (SLMODE) и маски бендов.
# Применяется без перезапуска модуля, модему нужно время на пересканирование.
get5gmode() {
	_m32_o=$(_mv32_at "NR5G_MODE?" | sed -n 's/.*NR5G_MODE:[[:space:]]*//p' | head -1 | tr -cd '0-9')
	case "$_m32_o" in
		0) echo "sa+nsa" ;;
		1) echo "nsa" ;;
		2) echo "sa" ;;
		*) echo "Unsupported" ;;
	esac
}

set5gmode() {
	case "$1" in
		full) _mv32_at "NR5G_MODE=0" >/dev/null 2>&1 ;;
		*) return 1 ;;
	esac
}

# --- Привязка к соте ---------------------------------------------------------
#
# ТРИ РАЗНЫЕ КОМАНДЫ, И У КАЖДОЙ СВОЙ ПОРЯДОК АРГУМЕНТОВ (разделы 15.36-15.40):
#   AT+LTE_LOCK=<pci>,<earfcn>[,<pci>,<earfcn> ... до 8 пар]
#   AT+WCDMA_LOCK=<uarfcn>,<psc>
#   AT+NR5G_LOCK=<band>,<scs>,<nr_arfcn>,<pci>
# Наш контракт - «cell <arfcn> <pci>». У LTE пару поэтому МЕНЯЕМ МЕСТАМИ: это
# главная ловушка семейства (у FM350 сначала ARFCN, здесь - сначала PCI).
#
# ЗАПИСЬ ВСТУПАЕТ В СИЛУ ТОЛЬКО ПОСЛЕ ПЕРЕЗАПУСКА МОДУЛЯ - прямая оговорка
# руководства («Write command and Exec command needs to restart device to take
# effect»), и ровно так же вёл себя MV31: до перезапуска чтение честно отвечает
# «Have not set cell lock before», а человек видит «привязано» и недоумевает,
# почему сота прежняя.
#
# ПОЧЕМУ 5G-ПРИВЯЗКУ МЫ ЧИТАЕМ, НО НЕ СТАВИМ. NR5G_LOCK требует ещё band и
# нумерологию SCS, которых в контракте «cell <arfcn> <pci>» нет и угадать
# нельзя: неверная пара band/SCS уводит модуль в «no service». Читать - можно и
# нужно: иначе поставленная другим приложением привязка была бы невидимой, а
# кнопка «Снять» - недоступной.
setcelllock() {
	case "$1" in
		off)
			_mv32_at "LTE_LOCK" >/dev/null 2>&1
			_mv32_at "WCDMA_LOCK" >/dev/null 2>&1
			_mv32_at "NR5G_LOCK" >/dev/null 2>&1
			;;
		cell)
			_m32_ar="$2"; _m32_pc="$3"
			case "$_m32_ar" in ''|*[!0-9]*) return 1 ;; esac
			case "$_m32_pc" in ''|*[!0-9]*) return 1 ;; esac
			# ПОРЯДОК: PCI, EARFCN - у этой прошивки он обратный нашему
			_m32_w=$(_mv32_at "LTE_LOCK=$_m32_pc,$_m32_ar")
			case "$_m32_w" in
				*ERROR*) logger -t 5gmodem "celllock: firmware rejected \"LTE_LOCK=$_m32_pc,$_m32_ar\": $(printf '%s' "$_m32_w" | tr '\n' ' ' | head -c 120)"
				         return 1 ;;
			esac
			;;
		*) return 1 ;;
	esac
	# ПРИМЕНЕНИЕ - ТОЛЬКО ПЕРЕЗАПУСКОМ МОДУЛЯ. AT+CFUN=1,1, а не AT+RESET:
	# первый проверен на родственном MV31, второй у этого семейства уводит
	# модуль в полную переэнумерацию USB.
	_mv32_at "CFUN=1,1" >/dev/null 2>&1
	return 0
}

getcelllock() {
	# LTE. Ответ: «+LTE_LOCK: (405,40936),(477,1300)» - пары (pci,earfcn).
	# Показываем ПЕРВУЮ: контракт держит одну соту, а привязка к нескольким
	# парам - это всё равно «привязан».
	_m32_o=$(_mv32_at "LTE_LOCK?" | sed -n 's/.*LTE_LOCK:[[:space:]]*//p' | head -1)
	case "$_m32_o" in
		*[0-9]*)
			_m32_p=$(printf '%s' "$_m32_o" | sed -n 's/^[^(]*(\([0-9]*\),\([0-9]*\)).*/\1 \2/p')
			if [ -n "$_m32_p" ]; then
				_m32_pc=${_m32_p%% *}; _m32_ar=${_m32_p##* }
				case "$_m32_ar$_m32_pc" in
					''|*[!0-9]*) ;;
					*) echo "cell $_m32_ar $_m32_pc"; return ;;
				esac
			fi
			;;
	esac
	# 5G SA. Ответ: «^NR5G_LOCK:(78,1,627264,148)» - band,scs,arfcn,pci.
	_m32_o=$(_mv32_at "NR5G_LOCK?" | sed -n 's/.*NR5G_LOCK:[[:space:]]*//p' | head -1)
	_m32_p=$(printf '%s' "$_m32_o" | sed -n 's/^[^(]*([0-9]*,[0-9]*,\([0-9]*\),\([0-9]*\)).*/\1 \2/p')
	if [ -n "$_m32_p" ]; then
		_m32_ar=${_m32_p%% *}; _m32_pc=${_m32_p##* }
		case "$_m32_ar$_m32_pc" in
			''|*[!0-9]*) ;;
			*) echo "cell $_m32_ar $_m32_pc"; return ;;
		esac
	fi
	# 3G. Ответ: «^WCDMA_LOCK:(10663,143)» - uarfcn,psc.
	_m32_o=$(_mv32_at "WCDMA_LOCK?" | sed -n 's/.*WCDMA_LOCK:[[:space:]]*//p' | head -1)
	_m32_ar=$(printf '%s' "$_m32_o" | sed -n 's/^[^(]*(\([0-9]*\),[0-9]*).*/\1/p')
	case "$_m32_ar" in
		''|*[!0-9]*) ;;
		*) echo "arfcn $_m32_ar"; return ;;
	esac
	# Команда есть, привязки нет - «Have not set cell lock before». Это тоже
	# полезный ответ: раздел в интерфейсе появится с кнопкой привязки.
	_mv32_at "LTE_LOCK?" | grep -q "LTE_LOCK" && { echo "off"; return; }
	echo "Unsupported"
}

# --- Сигнал по антенным портам -----------------------------------------------
# Из того же AT+DEBUG?, что и метрики: «lte_ant_rsrp:rx_diversity:15
# (-77.0dBm,-256.0dBm,...)». В 5G SA строки lte_ant_rsrp нет - там уровни по
# трактам печатаются после nr_rsrp. Формат вывода общий со страницей:
# «порт:rsrp:rsrq», RSRQ по трактам модуль не даёт - поле пустое.
# «-256.0dBm» и «NA» - ЗАГЛУШКИ «измерения нет», а не уровни: показать их
# значило бы нарисовать мёртвые антенны там, где просто нет данных.
getantports() {
	# ОДНОЙ СТРОКОЙ. Уровень и скобка с уровнями по трактам у части сборок
	# печатаются на РАЗНЫХ строках (так они и напечатаны в руководстве), и
	# построчный разбор молча возвращал бы «нет данных».
	_m32_o=$(_mv32_at "DEBUG?" | tr '\n' ' ')
	_m32_v=$(printf '%s\n' "$_m32_o" | sed -n 's/.*lte_ant_rsrp:rx_diversity:[0-9]*[^(]*(\([^)]*\)).*/\1/p' | head -1)
	[ -n "$_m32_v" ] || _m32_v=$(printf '%s\n' "$_m32_o" | sed -n 's/.*nr_rsrp:[^(]*rx_diversity:[[:space:]]*[0-9]*[^(]*(\([^)]*\)).*/\1/p' | head -1)
	[ -n "$_m32_v" ] || { echo "Unsupported"; return; }
	_m32_i=0; _m32_r=""
	for _m32_x in $(printf '%s\n' "$_m32_v" | tr ',' ' '); do
		_m32_x=$(printf '%s' "$_m32_x" | sed 's/dBm//g' | tr -d ' ')
		case "$_m32_x" in
			''|*[!0-9.-]*) _m32_i=$((_m32_i + 1)); continue ;;
		esac
		_m32_n=$(awk "BEGIN{printf \"%.0f\", $_m32_x}" 2>/dev/null)
		case "$_m32_n" in
			''|*[!0-9-]*) _m32_i=$((_m32_i + 1)); continue ;;
		esac
		if [ "$_m32_n" -le -160 ] 2>/dev/null || [ "$_m32_n" -ge -20 ] 2>/dev/null; then
			_m32_i=$((_m32_i + 1)); continue
		fi
		_m32_r="$_m32_r${_m32_r:+ }$_m32_i:$_m32_n:"
		_m32_i=$((_m32_i + 1))
	done
	[ -n "$_m32_r" ] || { echo "Unsupported"; return; }
	printf '%s\n' "$_m32_r"
}
