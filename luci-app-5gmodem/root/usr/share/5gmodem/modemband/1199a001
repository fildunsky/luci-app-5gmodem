_DEVICE=""   # порт задаёт bands.sh (uci at_port / detect.sh)
#
# Sierra Wireless EM7345 (1199:a001) - ярлык Sierra, чип Intel XMM7160
# (ревью EM7345 13.09.2026, форум 4pda, тема 444921, #731, #2405-2407).
#
# ПОЧЕМУ ТОЛЬКО СПИСОК И НИКАКОЙ ЗАПИСИ.
# Управлять диапазонами нечем: Sierra-рычаг AT!BAND недоступен в принципе
# («!»-команды этому чипу не отвечают: AT!ENTERCND="A710" -> ERROR, #2405-2407),
# а интеловский AT+XACT, которым ведутся L850/L860 (modemband/2cb70007), с
# EM7345 живьём никем не проверен - в теме нет ни одного ответа +XACT от этого
# модуля. Писать вслепую нельзя: неверно понятый XACT у XMM пересобирает набор
# диапазонов целиком и может оставить модем без сети (так уже было на L860, см.
# комментарии в 2cb70007). Поэтому setbands/getbands НЕ определяем - остаются
# заглушки bands.sh («Unsupported»), а список показываем как справочный.
#
# _BAND_READONLY даёт UI честную картинку: кнопки диапазонов видны, но
# неактивны, вместо кнопок, которые молча ничего не делают. Управление этим
# модулем реально живёт в ModemManager (он же его штатный хозяин: плагин
# sierra, порты cdc-wdm0/ttyACM0/wwan0) - ровно туда и ведёт подсказка UI.
_BAND_READONLY=1

getinfo() {
	echo "Sierra Wireless EM7345 (Intel XMM7160)"
}

# СПИСОК - ИЗ ЖИВОГО mmcli С ФОРУМА (#731), а не из чужой таблицы Sierra:
# «Bands supported: LTE - eutran-1,2,3,4,5,7,8,13,17,18,19,20» (там же 3G:
# utran-1,2,4,5,8; 2G: egsm, dcs, pcs, g850). Набор шире привычных таблиц
# AT!BAND именно потому, что это Intel, а не Qualcomm. Живого запроса не
# делаем - спрашивать нечем (см. выше).
getsupportedbands() {
	echo "1 2 3 4 5 7 8 13 17 18 19 20"
}
