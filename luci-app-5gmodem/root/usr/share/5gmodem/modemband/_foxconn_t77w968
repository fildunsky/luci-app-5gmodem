# ОБЩАЯ ЧАСТЬ ДЛЯ МОДУЛЯ Foxconn T77W968 (Snapdragon X20 LTE).
# Один и тот же модуль продаётся под разными VID:PID - 413c:81d7 и 413c:81e0
# (Dell), 0489:e0b5 (Foxconn). Профили были ПОБАЙТОВО одинаковыми, а модем с
# третьим идентификатором не находил ни одного и оставался вовсе без управления
# диапазонами («Port not found» в отчёте). Держим содержимое здесь, а рядом -
# тонкие файлы по идентификаторам.

_DEVICE=""   # порт задаёт bands.sh (uci at_port / detect.sh); в профиле НЕ прибиваем — на мультимодеме это порт другого модема
# По AT^SLBAND=? самого модуля (форум): ...,43,46,48,66 - без 48 «сброс» тихо
# запрещал диапазон.
_DEFAULT_LTE_BANDS="1 2 3 4 5 7 8 12 13 14 17 18 19 20 25 26 28 29 30 32 38 39 40 41 42 43 46 48 66"

getinfo() {
	echo "Dell DW5821e Snapdragon X20 LTE"
}

# РЕЖИМ СЕТИ (RAT) через AT^SLMODE. Значения У ЭТОГО МОДУЛЯ СВОИ и с масками
# T99W175 не совпадают: там 1=WCDMA, 2=LTE, 4=NR5G, а здесь набор произвольный.
# Сверено по фирменному набору команд (YAT, страница «T77W968/Dell DW5821»):
#   1,4 Auto | 1,14 WCDMA | 1,30 LTE | 1,35 WCDMA+LTE | 1,6 LTE+NR
# Перепутать нельзя молча: 1,4 здесь «Авто», а у T99W175 - «только NR5G».
#
# LTE+NR (1,6) в список НЕ выносим: Snapdragon X20 - модем LTE Cat.16 (AT^GETLTECAT?
# отвечает 16; Cat.12 - это родня T77W676/lt4220), 5G у него
# нет вовсе, и кнопка «4G+5G» вводила бы в заблуждение.
#
# Функции объявлены ДО общей части: _foxconn_common1 их не переопределяет
# (там только бенды), но порядок оставляем очевидным.
getsupportedmodes() {
	echo "4:Auto 14:3G 30:4G 35:3G+4G"
}

getmode() {
	# Ответ - «^SLMODE:1,30-LTE Only»: после кода идёт текст через дефис, и $3
	# давал «30-LTEOnly» - режим не подсвечивался, setmodelive всегда «fail»
	# (ревью 12.09.2026 по живым логам форума). Берём только число.
	sms_tool -d $_DEVICE at "AT^SLMODE?" 2>/dev/null | tr -d '\r' \
		| sed -n 's/^\^SLMODE: *[0-9]*, *\([0-9][0-9]*\).*/\1/p' | head -n 1
}

setmode() {
	M="$1"
	case "$M" in
		''|*[!0-9]*) return 1 ;;
	esac
	sms_tool -d $_DEVICE at "AT^SLMODE=1,$M"
}

. $RES/_foxconn_common1

# --- Поддерживаемые диапазоны - У МОДЕМА, а не из константы -------------------
#
# Функции объявлены ПОСЛЕ `. $RES/_foxconn_common1` намеренно: там своя
# getsupportedbands на константе, и объявление выше она бы просто перекрыла.
#
# Список зависит от КОНКРЕТНОЙ прошивки и заметно расходится с нашей статикой:
# #10938 - AT^SLBAND=? отдаёт `^SLBAND: LTE,(1,2,3,...,66)`, а #59526 на живом
# модуле показал набор БЕЗ 12/17/42/43/48. Мы же предлагали галочки, которых у
# модуля нет, и запись `at^slband=lte,2,<весь список>` могла уйти в ERROR
# ЦЕЛИКОМ - то есть не применялся ни один диапазон.
# Статика остаётся ФОЛБЭКОМ на молчащий порт: кнопки диапазонов не должны
# исчезать ровно тогда, когда ими надо воспользоваться.
# (ревью 13.09.2026, форум 4pda)
getsupportedbands() {
	_gs_o=$(sms_tool -d $_DEVICE at "at^slband=?" 2>/dev/null | tr -d '\r' | grep -v '^AT')
	_gs_l=$(printf '%s\n' "$_gs_o" | awk '
		/SLBAND:.*LTE,/ {
			p = index($0, "LTE,")
			s = substr($0, p + 4)
			gsub(/[()]/, "", s)
			gsub(/,/, " ", s)
			print s
			exit
		}')
	_gs_u=""
	for _gs_b in $_gs_l; do
		case "$_gs_b" in ''|*[!0-9]*) continue ;; esac
		case " $_gs_u " in *" $_gs_b "*) continue ;; esac
		_gs_u="$_gs_u$_gs_b "
	done
	_gs_u=$(printf '%s' "$_gs_u" | tr ' ' '\n' | sort -n | tr '\n' ' ' | sed 's/ *$//')
	[ -n "$_gs_u" ] && { echo "$_gs_u"; return; }
	echo "$_DEFAULT_LTE_BANDS"
}

# --- Агрегация в восходящем канале (AT^ULCA) ---------------------------------
#
# Аплинк у этого модуля - известное узкое место: при богатой агрегации вниз
# вверх часто держится 1-2 Мбит. Включение поднимало его до 55-90 Мбит
# (#50082, #58893). Живые ответы: `AT^ULCA?` -> `ULCA is enabled` / `ULCA is
# disabled` (#9174, #50094, #51845, #55063), часть терминалов печатает их без
# пробелов - `ULCAisenabled` (#54370, #56094), поэтому сверяем подстрокой.
# ВЫКЛЮЧЕНИЯ НЕТ: на прямой вопрос «как отменить AT^ULCA» (#48878) в теме не
# ответили ни разу, формы `AT^ULCA=0` не встречается. Поэтому setulca принимает
# только "on" - кнопка, которая молча ничего не делает, хуже её отсутствия.
# На части прошивок ULCA включена по умолчанию (#59005), а на части слетает
# после перезагрузки (#49238, #51843) - строка честно показывает, как есть.
# (ревью 13.09.2026, форум 4pda)
getulca() {
	_gu_o=$(sms_tool -d $_DEVICE at "at^ulca?" 2>/dev/null | tr -d '\r ' | grep -v '^AT')
	case "$_gu_o" in
		*[Uu][Ll][Cc][Aa]*[Dd][Ii][Ss][Aa][Bb][Ll][Ee][Dd]*) echo "off" ;;
		*[Uu][Ll][Cc][Aa]*[Ee][Nn][Aa][Bb][Ll][Ee][Dd]*)     echo "on" ;;
		*) echo "Unsupported" ;;
	esac
}

setulca() {
	[ "$1" = "on" ] || { echo "Unsupported"; return 1; }
	_su_o=$(sms_tool -d $_DEVICE at "at^ulca" 2>&1 | tr -d '\r')
	case "$_su_o" in
		*ERROR*)
			logger -t 5gmodem "ulca: firmware rejected AT^ULCA: $(echo "$_su_o" | tr '\n' ' ' | head -c 120)"
			echo "Unsupported"; return 1 ;;
	esac
	return 0
}
