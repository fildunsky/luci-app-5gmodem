_DEFAULT_LTE_BANDS="1 3 5 8 34 38 39 40 41"
_DEFAULT_5GNSA_BANDS="1 3 5 8 28 41 77 78 79"
_BAND_RECONNECT_WARN=1

getinfo() {
	echo "TD Tech MT5700M-CN"
}

getsupportedbands() {
	echo "$_DEFAULT_LTE_BANDS"
}

getsupportedbands5gnsa() {
	echo "$_DEFAULT_5GNSA_BANDS"
}

_td_lock_read() {
	sms_tool -d "$_DEVICE" at "AT^${1}FREQLOCK?" 2>/dev/null | tr -d '\r" ' | awk -F'[:,]' -v rat="$1" '
		/^OK$/ {
			if (!header) exit
			if (type == 0) print "default"
			else if (counted && seen == count) print bands
			exit
		}
		$1 == "^" rat "FREQLOCK" {
			if ($2 ~ /^[0-3]$/) { type = $2; header = 1 }
			next
		}
		header && !counted {
			if ($1 !~ /^[01]$/ || $2 !~ /^[0-9]+$/ || $2 < 1 || $2 > 20) exit
			count = $2; counted = 1; next
		}
		counted && seen < count {
			if ($1 !~ /^[0-9]+$/ || $1 < 1 || $1 > 512) exit
			bands = bands (seen ? " " : "") $1; seen++; next
		}
		'
}

getbands() {
	local bands
	bands=$(_td_lock_read LTE)
	if [ "$bands" = default ]; then getsupportedbands; else echo "$bands"; fi
}

getbands5gnsa() {
	local bands
	bands=$(_td_lock_read NR)
	if [ "$bands" = default ]; then getsupportedbands5gnsa; else echo "$bands"; fi
}

_td_band_write() {
	local rat="$1" bands="$2" supported="$3" count=0 band list="" out
	if [ "$bands" = default ]; then
		out=$(sms_tool -d "$_DEVICE" at "AT^${rat}FREQLOCK=0" 2>&1)
	else
		for band in $bands; do
			case " $supported " in *" $band "*) ;; *) echo "ERROR: unsupported band"; return 1 ;; esac
			count=$((count + 1))
			[ "$count" -le 20 ] || { echo "ERROR: too many bands"; return 1; }
			list="$list${list:+,}$band"
		done
		[ "$count" -gt 0 ] || { echo "ERROR: empty band list"; return 1; }
		out=$(sms_tool -d "$_DEVICE" at "AT^${rat}FREQLOCK=3,1,$count,\"$list\"" 2>&1)
	fi
	printf '%s\n' "$out"
	printf '%s\n' "$out" | tr -d '\r' | grep -q '^OK$'
}

setbands() {
	_td_band_write LTE "$1" "$_DEFAULT_LTE_BANDS"
}

setbands5gnsa() {
	_td_band_write NR "$1" "$_DEFAULT_5GNSA_BANDS"
}

getsupportedmodes() {
	echo "1:Auto 2:3G 4:4G 5:4G+5G 6:5G"
}

getmode() {
	local mode
	mode=$(sms_tool -d "$_DEVICE" at 'AT^SYSCFGEX?' 2>/dev/null | tr -d '\r" ' \
		| sed -n 's/^\^SYSCFGEX:\([^,]*\),.*/\1/p' | head -1)
	case "$mode" in
		02) echo 2 ;;
		03) echo 4 ;;
		0803|0308) echo 5 ;;
		08) echo 6 ;;
		00|080302|030208|020308) echo 1 ;;
	esac
}

setmode() {
	local mode cfg out
	case "$1" in
		1) mode=080302 ;;
		2) mode=02 ;;
		4) mode=03 ;;
		5) mode=0803 ;;
		6) mode=08 ;;
		*) return 1 ;;
	esac
	cfg=$(sms_tool -d "$_DEVICE" at 'AT^SYSCFGEX?' 2>/dev/null | tr -d '\r ' \
		| sed -n 's/^\^SYSCFGEX:[^,]*,//p' | head -1)
	printf '%s\n' "$cfg" | grep -qE '^[0-9A-Fa-f]+,[0-9]+,[0-9]+,[0-9A-Fa-f]+(,[0-9A-Fa-f,]*)?$' || return 1
	out=$(sms_tool -d "$_DEVICE" at "AT^SYSCFGEX=\"$mode\",$cfg" 2>&1)
	printf '%s\n' "$out"
	printf '%s\n' "$out" | tr -d '\r' | grep -q '^OK$'
}
