# 05c6:9025 - QMI, порты ttyUSB0..2 (нужен option1 - см. хотплаг)
#
# Идентификатор делят Foxconn T99W175 и Compal RXM-G1 (новая прошивка),
# переведённый в QMI командой AT+USBCOMP=debug. У Compal НЕТ ни одной AT-команды
# бенд-лока, управление диапазонами возможно только через mmcli - поэтому
# передаём управление профилю 05c690d6, как это делают modemband/05c690d5 и
# modemband/1e2d00b7 для своих композиций. Без этого мы ушли бы в Thales/Foxconn
# ветку (AT-профиль БЕЗ _BAND_VIA=mmcli), гейт в bands.sh не сработал бы, и UI
# нарисовал нерабочие кнопки диапазонов вместо честного «через ModemManager».
#
# Опознание - через ОБЩИЙ помощник (см. iscompal.sh). Здесь оно опирается на
# МОДЕЛЬ, и вот почему нельзя иначе:
#   - USB-дескриптор бесполезен: в этой композиции модем отдаёт generic
#     "Qualcomm, Inc. HSUSB Device" без строк VOS_5G / Tri Cascade;
#   - AT-фолбэка быть не может: bands.sh выставляет _DEVICE ПОСЛЕ того, как
#     подключит профиль, т.е. на этот момент AT-порт ещё неизвестен - поэтому
#     зовём помощник без AT-порта, ему хватит QMI/mmcli.
# В QMI-композиции cdc-wdm существует по определению, так что путь надёжен.
. /usr/share/5gmodem/iscompal.sh
if is_compal; then
	. "$RES/05c690d6"
	return 0 2>/dev/null || exit 0
fi

# Логика общая для всех композиций этого модема, см. _qualcomm_sdx55_common:
# режим USB меняет нумерацию портов и драйвер, но не набор AT-команд.
. $RES/_qualcomm_sdx55_common
