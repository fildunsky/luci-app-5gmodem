# HP lt4120 Snapdragon X5 LTE (Foxconn T77W595, 03f0:9d1d)
#
# ЗАЧЕМ ПРОФИЛЬ. Модуль работает по QMI, а под proto=qmi/qmiraw общий QMI-опрос
# у нас ВЫКЛЮЧЕН (qmi_channel_free): канал держит netifd, и второй владелец
# путает ответы - см. lib.sh. Поэтому уровни, сота и соседи достаются только по
# AT, как у Telit FN990. Без профиля карточка показывала прочерки во всём блоке
# сигнала при живом соединении (проверено на стенде 08.09.2026).
#
# ЧТО УМЕЕТ ЭТА ПРОШИВКА (список снят живьём, AT+CLAC / AT$QCCLAC):
#   $QCRSRP? - «<PCI>,<EARFCN>,"<RSRP>"» тройками: первая - обслуживающая
#              сота, дальше соседи. Это единственный источник PCI и EARFCN.
#   $QCRSRQ? - те же тройки с RSRQ; сводим их с предыдущими по PCI+EARFCN.
#   $QCSQ    - «-74,-2,0,0,-76»: первое поле - RSSI в dBm (сверено с
#              uqmi --get-signal-info: -76 против -76, -74 против -74).
#   ^VERINFO - «HW Revision: V055 / SW Revision: T77W595.F0.0.0.6.6.GC.029».
# SINR прошивка по AT не отдаёт вовсе (в списке команд его нет), и выдумывать
# его неоткуда - остаётся прочерком. Температуры у модуля тоже нет.
#
# +CESQ ЗДЕСЬ НЕТ - не переносить решение из профиля FN990: в AT+CLAC этой
# прошивки команды нет, отвечает ERROR.
#
# ЦЕПОЧКА ОДНИМ ЗАХОДОМ. Проверено вживую: все четыре команды отвечают подряд,
# ни одна не обрывает остальные. Порт общий с SMS и USSD, поэтому лишние
# заходы тут дороже разбора.
[ -n "$DEVICE" ] && [ -c "$DEVICE" ] || return 0

O=$(sms_tool -d "$DEVICE" at 'AT$QCRSRP?;$QCRSRQ?;$QCSQ;^VERINFO' 2>/dev/null | tr -d '\r')

# --- ПРОШИВКА ---------------------------------------------------------------
# Берём SW Revision: ATI печатает ту же строку, но с датой сборки и служебными
# полями в той же строке, а тут она уже отдельная и чистая.
_HP_V=$(printf '%s\n' "$O" | sed -n 's/^SW Revision: *//p' | head -1 \
	| sed 's/[[:space:]]*$//')
[ -n "$_HP_V" ] && FW="$_HP_V"

# --- СОТЫ -------------------------------------------------------------------
# Обе строки разбираем в тройки «pci earfcn значение». PCI приходит с ведущими
# нулями («076»), значение - в кавычках и с десятыми («-106.80»), поэтому
# нормализуем оба: PCI - в число, уровень - до целого (карточка показывает dBm
# целыми, а десятые у RSRP всё равно шум).
# Префикс ищем через index(), а НЕ шаблоном sed: в имени команды стоит доллар,
# и в двойных кавычках «\$$1» разворачивается в PID шелла - первая редакция
# молча не находила ни одной строки (стенд, 08.09.2026: уровни остались
# прочерками при живом ответе модема).
_hp_triples() {   # $1 - начало строки ответа, например «$QCRSRP:»
	printf '%s\n' "$O" | awk -v k="$1" '
		index($0, k) == 1 {
			sub(/^[^:]*: */, "")
			gsub(/"/, "")
			n = split($0, f, ",")
			for (i = 1; i + 2 <= n; i += 3) {
				pci = f[i] + 0; ch = f[i + 1] + 0; v = f[i + 2] + 0
				if (ch <= 0) continue
				printf "%d %d %.0f\n", pci, ch, v
			}
			exit
		}'
}

_HP_RP=$(_hp_triples '$QCRSRP:')
_HP_RQ=$(_hp_triples '$QCRSRQ:')

_HP_SIFS="$IFS"
IFS='
'
_HP_N=0
_HP_NB=""
for _hp_l in $_HP_RP; do
	IFS="$_HP_SIFS"
	# Разбираем строку САМИ, без `set --`: профиль подключается через «.», то
	# есть в окружении диспетчера, и позиционные параметры там чужие.
	_hp_pci="${_hp_l%% *}"
	_hp_rest="${_hp_l#* }"
	_hp_ch="${_hp_rest%% *}"
	_hp_rp="${_hp_rest#* }"
	# RSRQ той же соты - по паре «PCI+EARFCN», а не по порядку: у двух команд
	# он может разойтись, и тогда соседу досталось бы чужое качество.
	_hp_rq=$(printf '%s\n' "$_HP_RQ" | awk -v p="$_hp_pci" -v c="$_hp_ch" \
		'$1 == p && $2 == c { print $3; exit }')
	_hp_bn=$(earfcn2band "$_hp_ch")
	if [ "$_HP_N" = 0 ]; then
		PCI="$_hp_pci"
		EARFCN="$_hp_ch"
		RSRP="$_hp_rp"
		[ -n "$_hp_rq" ] && RSRQ="$_hp_rq"
		if [ -n "$_hp_bn" ]; then
			PBAND=$(band4g "$_hp_bn")
			MODE="LTE | $PBAND"
		fi
	else
		_HP_NB="$_HP_NB${_HP_NB:+,}$(printf \
			'{"band":"%s","earfcn":"%s","pci":"%s","rsrp":"%s","rsrq":"%s","rssi":"","serving":0}' \
			"$_hp_bn" "$_hp_ch" "$_hp_pci" "$_hp_rp" "$_hp_rq")"
	fi
	_HP_N=$(( _HP_N + 1 ))
	IFS='
'
done
IFS="$_HP_SIFS"

# --- RSSI -------------------------------------------------------------------
# «$QCSQ :-74,-2,0,0,-76» - пробел стоит ПЕРЕД двоеточием, поэтому режем по
# нему, а не по обычному «: ». Значение принимаем только правдоподобное: что
# означают остальные четыре поля, прошивка нигде не документирует, и ставить
# в уровень случайное число хуже, чем оставить прочерк.
_HP_S=$(printf '%s\n' "$O" | sed -n 's/^\$QCSQ *: *//p' | head -1 | cut -d, -f1)
case "$_HP_S" in
	-[0-9]*)
		if [ "$_HP_S" -le -30 ] && [ "$_HP_S" -ge -120 ]; then
			RSSI="$_HP_S"
		fi ;;
esac

# --- СОСЕДИ -----------------------------------------------------------------
# Таблица соседей - те же тройки, что уже разобраны: отдельного сканирования
# ($QCACQDBC и родня) не зовём, оно занимает порт на секунды и рвёт SMS.
if [ -n "$PCI" ] && [ -n "$EARFCN" ]; then
	NEIGHBORS=$(printf '{"band":"%s","earfcn":"%s","pci":"%s","rsrp":"%s","rsrq":"%s","rssi":"%s","serving":1}' \
		"$(earfcn2band "$EARFCN")" "$EARFCN" "$PCI" "$RSRP" "$RSRQ" "$RSSI")
	NEIGHBORS="$NEIGHBORS${_HP_NB:+,$_HP_NB}"
elif [ -n "$_HP_NB" ]; then
	NEIGHBORS="$_HP_NB"
fi
