#!/bin/sh

# ==============================================================================
# ПЕРВИЧНОЕ ОПРЕДЕЛЕНИЕ МОДЕЛИ УСТРОЙСТВА
# ==============================================================================
OL=$(sms_tool -d $DEVICE at "AT+CGMM")
MODELB=$(echo "$OL" | sed s/"AT+CGMM"// | tr -s "\n" | xargs)
if [ -n "$MODELB" ]; then
	MODEL="$(echo $MODELB | sed 's,_, ,')"
fi

if echo "$MODEL" | grep -qE "7100|7500|7600"; then
	# ==============================================================================
	# РАЗБОР CPSI ДЛЯ SIM7100 / SIM7500 / SIM7600 (одинаковый формат LTE)
	# ==============================================================================
	# SIM7600E-H сюда НЕ ПОПАДАЛ (в модели нет "7100") и проваливался в ветку
	# SIM8200 ниже, где CPSI разбирается через -F[,:]. Двоеточие в "+CPSI:"
	# добавляет лишнее поле, и ВСЕ индексы съезжают на один: band читался из
	# поля PCI ("366" -> B3), earfcn - из band, а DL/UL - из соседних чисел.
	# Отсюда и расхождение: главный MODE говорил "LTE | B7", а карточка PCC -
	# "B3 (1800 MHz)" с мусорными "@3 MHz". Разбор -F, ниже совпадает с форматом
	# LTE из руководства (V1.01): band=поле 7, earfcn=8, RSRP=12/10, RSSI=13/10.
	
	# Температура (удаляем \r и пробелы)
	OT=$(sms_tool -d $DEVICE at "AT+CPMUTEMP")
	T=$(echo "$OT" | awk -F: '/^\+CPMUTEMP:/ {print $2}' | tr -d '\r' | xargs)
	[ -n "$T" ] && TEMP="$T &deg;C"

	# Запрос информации о сети
	O=$(sms_tool -d $DEVICE at "AT+CPSI?")
	
	# Берем строго строку, содержащую +CPSI:
	T1=$(echo "$O" | grep "+CPSI:" | tr -d '\r')

	if [ -n "$T1" ]; then
		# TAC (4-е поле, например: 0x0088)
		T=$(echo "$T1" | awk -F, '{print $4}' | xargs)
		if [ -n "$T" ]; then
			TAC_HEX=$(echo "$T" | sed 's/0x//g')
			TAC_DEC=$(printf "%d" "0x$TAC_HEX" 2>/dev/null)
		fi
		
		# PCI (6-е поле)
		PCI=$(echo "$T1" | awk -F, '{print $6}' | xargs)

		# Основной диапазон (PCC) (7-е поле, например: EUTRAN-BAND 3)
		T=$(echo "$T1" | awk -F, '{print $7}' | xargs)
		if [ -n "$T" ]; then
			# Безопасное удаление букв и пробелов без ключа -e, чтобы не ломать JSON
			B_NUM=$(echo "$T" | sed 's/EUTRAN-BAND//g' | tr -d ' ' | tr -d '\r' | tr -d '\n')
			PBAND="B${B_NUM}"
			case "$B_NUM" in
				1)  PBAND="B1 (FDD 2100 MHz)" ;;
				3)  PBAND="B3 (FDD 1800 MHz)" ;;
				7)  PBAND="B7 (FDD 2600 MHz)" ;;
				8)  PBAND="B8 (FDD 900 MHz)" ;;
				20) PBAND="B20 (FDD 800 MHz)" ;;
				38) PBAND="B38 (TDD 2600 MHz)" ;;
				40) PBAND="B40 (TDD 2300 MHz)" ;;
			esac
			MODE="LTE | $PBAND"
		fi
		
		# EARFCN (8-е поле)
		EARFCN=$(echo "$T1" | awk -F, '{print $8}' | xargs)

		# Сигналы
		T=$(echo "$T1" | awk -F, '{print $11}' | xargs)
		[ -n "$T" ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", $1/10}')
		
		T=$(echo "$T1" | awk -F, '{print $12}' | xargs)
		[ -n "$T" ] && RSRP=$(echo "$T" | awk '{printf "%0.1f", $1/10}')
		
		T=$(echo "$T1" | awk -F, '{print $13}' | xargs)
		[ -n "$T" ] && RSSI=$(echo "$T" | awk '{printf "%0.1f", $1/10}')
		
		# SINR (14-е поле) — вычитаем 10
		T=$(echo "$T1" | awk -F, '{print $14}' | xargs)
		[ -n "$T" ] && SINR=$((T - 10))
		
		# Обязательные переменные агрегации, чтобы JSON не оставался пустым
		S1BAND="-"; S1PCI="-"; S1EARFCN="-"
		S2BAND="-"; S2PCI="-"; S2EARFCN="-"
		S3BAND="-"; S3PCI="-"; S3EARFCN="-"
		S4BAND="-"; S4PCI="-"; S4EARFCN="-"
	fi

else
	# ==============================================================================
	# ОРИГИНАЛЬНЫЙ ФОЛЛБЕК ДЛЯ SIM8200EA-M2 / SIM7906
	# ==============================================================================
	OT=$(sms_tool -d $DEVICE at "AT+CPMUTEMP")
	T=$(echo "$OT" | awk -F[,:] '/^\+CPMUTEMP: / {print $2}' | xargs)
	[ -n "$T" ] && TEMP="$T &deg;C"

	O=$(sms_tool -d $DEVICE at "AT+CPSI?")

	case $MODE_NUM in
		7)
			MODE="LTE |"
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $5}')
			if [ -n "$T" ]; then
				TAC_DEC=$(printf "%d" "$T")
				TAC_HEX="${T/0x/}"
			fi
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $7}')
			[ -n "$T" ] && PCI=$T
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $8}')
			if [ -n "$T" ]; then
				PBAND="$(band4g ${T/EUTRAN-BAND/})"
				MODE="$MODE $(band4g ${T/EUTRAN-BAND/})"
			fi
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $9}')
			[ -n "$T" ] && EARFCN=$T
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $10}')
			if [ -n "$T" ]; then
				DLBW="DL: @$T MHz"
				PBAND="$(band4g ${T/EUTRAN-BAND/}) $DLBW"
			fi
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $11}')
			if [ -n "$T" ]; then
				ULBW="UL: @$T MHz"
				PBAND="$(band4g ${T/EUTRAN-BAND/}) $DLBW $ULBW"
			fi
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $12/10}')
			[ -n "$T" ] && RSRQ=$T
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $13/10}')
			[ -n "$T" ] && RSRP=$T
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $14/10}')
			[ -n "$T" ] && RSSI=$T
			T=$(echo "$O" | awk -F[,:] '/^\+CPSI: LTE/ {print $15}' | xargs)
			[ -n "$T" ] && SINR=$T
			;;
		11) MODE="5G SA";;
		13) MODE="5G NSA";;
	esac

	MODE=$(echo $MODE | sed 's,/,+,'| sed 's,LTE B,LTE | B,')
fi

# ==============================================================================
# ОБЩИЙ БЛОК ДЛЯ ИНФОРМАЦИИ О МОДЕМЕ
# ==============================================================================
OF=$(sms_tool -d $DEVICE at "AT+CGMR")
FWA=$(echo "$OF" | awk -F [:] '/^\+CGMR: /{print $2}' | xargs)
if [ -n "$FWA" ]; then
	FW="$FWA"
fi

if [ -n "$MODELB" ]; then
	MODEL="$(echo $MODELB | sed 's,_, ,')"
fi

OM=$(sms_tool -d $DEVICE at "AT+CGSN")
NR_I=$(echo "$OM" | sed s/"AT+CGSN"// | xargs)
if [ -n "$NR_I" ]; then
	NR_IMEI="$NR_I"
fi

OC=$(sms_tool -d $DEVICE at "AT+CIMI")
NR_C=$(echo "$OC" | sed s/"AT+CIMI"// | tr -s "\n" | xargs)
if [ -n "$NR_C" ]; then
	NR_IMSI="$NR_C"
fi

OI=$(sms_tool -d $DEVICE at "AT+ICCID")
NR_D=$(echo "$OI" | awk -F [:] '/^\+ICCID: /{print $2}' | xargs)
if [ -n "$NR_D" ]; then
	NR_ICCID="$NR_D"
fi

PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
PVCUT=$(echo $PV | awk -F 'Vendor=1e0e ProdID=9001' '{print $2}' | cut -c-1290)
if echo "$PVCUT" | grep -q "Driver=qmi_wwan"
then
	PROTO="qmi"
elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"
then
	PROTO="mbim"
elif echo "$PVCUT" | grep -q "Driver=cdc_ether"
then
	PROTO="ecm"
fi
