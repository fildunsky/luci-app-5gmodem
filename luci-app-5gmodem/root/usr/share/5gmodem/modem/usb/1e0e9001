#!/bin/sh

# ==============================================================================
# ПЕРВИЧНОЕ ОПРЕДЕЛЕНИЕ МОДЕЛИ УСТРОЙСТВА
# ==============================================================================
OL=$(sms_tool -d $DEVICE at "AT+CGMM")
MODELB=$(echo "$OL" | sed s/"AT+CGMM"// | tr -s "\n" | xargs)
if [ -n "$MODELB" ]; then
	MODEL="$(echo $MODELB | sed 's,_, ,')"
fi

if echo "$MODEL" | grep -qE "7100|7500|7600|7906|7912"; then
	# ==============================================================================
	# РАЗБОР CPSI ДЛЯ SIM7100 / SIM7500 / SIM7600 (одинаковый формат LTE)
	# ==============================================================================
	# SIM7600E-H сюда НЕ ПОПАДАЛ (в модели нет "7100") и проваливался в ветку
	# SIM8200 ниже, где CPSI разбирается через -F[,:]. Двоеточие в "+CPSI:"
	# добавляет лишнее поле, и ВСЕ индексы съезжают на один: band читался из
	# поля PCI ("366" -> B3), earfcn - из band, а DL/UL - из соседних чисел.
	# Отсюда и расхождение: главный MODE говорил "LTE | B7", а карточка PCC -
	# "B3 (1800 MHz)" с мусорными "@3 MHz". Разбор -F, ниже совпадает с форматом
	# LTE из руководства (V1.01): band=поле 7, earfcn=8, RSRP=12/10, RSSI=13/10.
	
	# Температура (удаляем \r и пробелы)
	OT=$(sms_tool -d $DEVICE at "AT+CPMUTEMP")
	T=$(echo "$OT" | awk -F: '/^\+CPMUTEMP:/ {print $2}' | tr -d '\r' | xargs)
	[ -n "$T" ] && TEMP="$T &deg;C"

	# Запрос информации о сети
	O=$(sms_tool -d $DEVICE at "AT+CPSI?")
	
	# Берем строго строку, содержащую +CPSI:
	T1=$(echo "$O" | grep "+CPSI:" | tr -d '\r')

	# СИСТЕМА - ПЕРВОЕ ПОЛЕ. Раскладка колонок у GSM/WCDMA другая, и прежний
	# безусловный LTE-разбор на GSM-строке брал уровень сигнала как номер
	# диапазона - карточка показывала бессмысленный «B-86» без единой метрики
	# (живой случай 20.08.2026: SIM7100E ночью свалился с LTE на EGSM 900).
	_SYS=$(echo "$T1" | sed 's/^+CPSI: *//' | awk -F, '{print $1}' | xargs)

	if [ -n "$T1" ] && [ "$_SYS" = "GSM" ]; then
		# +CPSI: GSM,Online,<MCC-MNC>,<LAC>,<CellID>,<bsic+band>,<RSSI>,...
		MODE="GSM"
		T=$(echo "$T1" | awk -F, '{print $4}' | xargs)
		if [ -n "$T" ]; then
			TAC_HEX=$(echo "$T" | sed 's/0x//g')
			TAC_DEC=$(printf "%d" "0x$TAC_HEX" 2>/dev/null)
		fi
		T=$(echo "$T1" | awk -F, '{print $5}' | xargs)
		case "$T" in *[!0-9]*|'') ;; *) CID_DEC="$T"; CID_HEX=$(printf '%X' "$T" 2>/dev/null) ;; esac
		# «34 EGSM 900» - подпись диапазона без выдуманного Bx
		_gb=$(echo "$T1" | awk -F, '{print $6}' | sed 's/^[0-9]* *//' | xargs)
		[ -n "$_gb" ] && { PBAND="$_gb"; MODE="GSM | $_gb"; }
		T=$(echo "$T1" | awk -F, '{print $7}' | xargs)
		case "$T" in -*[0-9]*) RSSI="$T" ;; esac
	elif [ -n "$T1" ] && [ "$_SYS" = "WCDMA" ]; then
		# Раскладку WCDMA-строки без живого образца не угадываем: берём только
		# совпадающие у всех систем поля (LAC/CID) и честный ярлык режима.
		MODE="WCDMA"
		T=$(echo "$T1" | awk -F, '{print $4}' | xargs)
		if [ -n "$T" ]; then
			TAC_HEX=$(echo "$T" | sed 's/0x//g')
			TAC_DEC=$(printf "%d" "0x$TAC_HEX" 2>/dev/null)
		fi
		T=$(echo "$T1" | awk -F, '{print $5}' | xargs)
		case "$T" in *[!0-9]*|'') ;; *) CID_DEC="$T"; CID_HEX=$(printf '%X' "$T" 2>/dev/null) ;; esac
	elif [ -n "$T1" ]; then
		# TAC (4-е поле, например: 0x0088)
		T=$(echo "$T1" | awk -F, '{print $4}' | xargs)
		if [ -n "$T" ]; then
			TAC_HEX=$(echo "$T" | sed 's/0x//g')
			TAC_DEC=$(printf "%d" "0x$TAC_HEX" 2>/dev/null)
		fi
		
		# PCI (6-е поле)
		PCI=$(echo "$T1" | awk -F, '{print $6}' | xargs)

		# Основной диапазон (PCC) (7-е поле, например: EUTRAN-BAND 3)
		T=$(echo "$T1" | awk -F, '{print $7}' | xargs)
		if [ -n "$T" ]; then
			# Безопасное удаление букв и пробелов без ключа -e, чтобы не ломать JSON
			B_NUM=$(echo "$T" | sed 's/EUTRAN-BAND//g' | tr -d ' ' | tr -d '\r' | tr -d '\n')
			PBAND="B${B_NUM}"
			case "$B_NUM" in
				1)  PBAND="B1 (FDD 2100 MHz)" ;;
				3)  PBAND="B3 (FDD 1800 MHz)" ;;
				7)  PBAND="B7 (FDD 2600 MHz)" ;;
				8)  PBAND="B8 (FDD 900 MHz)" ;;
				20) PBAND="B20 (FDD 800 MHz)" ;;
				38) PBAND="B38 (TDD 2600 MHz)" ;;
				40) PBAND="B40 (TDD 2300 MHz)" ;;
				*[0-9]) PBAND="$(band4g "$B_NUM")" ;;
			esac
			MODE="LTE | $PBAND"
		fi
		
		# EARFCN (8-е поле)
		EARFCN=$(echo "$T1" | awk -F, '{print $8}' | xargs)
		case "$(echo "$T1" | awk -F, '{print $9}' | xargs)" in
			0) BANDWIDTH="1.4 MHz" ;;
			1) BANDWIDTH="3 MHz" ;;
			2) BANDWIDTH="5 MHz" ;;
			3) BANDWIDTH="10 MHz" ;;
			4) BANDWIDTH="15 MHz" ;;
			5) BANDWIDTH="20 MHz" ;;
		esac

		# ID СОТЫ - ИЗ CPSI, А НЕ ИЗ CREG.
		#
		# Каркас берёт CID из `+CREG`/`+CEREG`, а SIM7100E кладёт туда НОЛЬ:
		# «+CREG: 2,1,E936,0». Из-за этого в карточке был «ID соты 0» и не
		# появлялась кнопка карты сот (ей нужен настоящий идентификатор). Тот же
		# ответ `+CPSI` даёт его пятым полем в ДЕСЯТИЧНОМ виде (231794689 =
		# 0xDD0E801) - оттуда и берём, если каркас остался с нулём.
		T=$(echo "$T1" | awk -F, '{print $5}' | xargs)
		case "$T" in
			''|*[!0-9]*) ;;
			*) if [ "$T" -gt 0 ]; then
				case "${CID_DEC:-0}" in
					''|0|-) CID_DEC="$T"; CID_HEX=$(printf '%X' "$T" 2>/dev/null) ;;
				esac
			   fi ;;
		esac

		# Сигналы
		T=$(echo "$T1" | awk -F, '{print $11}' | xargs)
		[ -n "$T" ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", $1/10}')
		
		T=$(echo "$T1" | awk -F, '{print $12}' | xargs)
		[ -n "$T" ] && RSRP=$(echo "$T" | awk '{printf "%0.1f", $1/10}')
		
		T=$(echo "$T1" | awk -F, '{print $13}' | xargs)
		[ -n "$T" ] && RSSI=$(echo "$T" | awk '{printf "%0.1f", $1/10}')
		
		# SINR (14-е поле) - ПО ФОРМУЛЕ ИЗ ДОКУМЕНТАЦИИ SIMCOM.
		#
		# В `+CPSI` это поле называется RSSNR, и мануал (SIM7000 Series AT
		# Command Manual V1.04, раздел AT+CPSI) даёт пересчёт прямым текстом:
		#   SINR = 2 * <RSSNR> - 20, диапазон SINR от -20 до 30.
		# Здесь стояло «минус 10» - откуда, неизвестно, но занижало примерно на
		# десять децибел. Сверка с QMI на живом SIM7100E 07.08.2026 (пять пар
		# подряд): RSSNR 19 -> формула 18 при QMI 19.0; 22 -> 24 при QMI 20.2;
		# прежний вариант давал 9 и 12 соответственно.
		T=$(echo "$T1" | awk -F, '{print $14}' | xargs)
		[ -n "$T" ] && SINR=$((2 * T - 20))
		
		# Обязательные переменные агрегации, чтобы JSON не оставался пустым
		S1BAND="-"; S1PCI="-"; S1EARFCN="-"
		S2BAND="-"; S2PCI="-"; S2EARFCN="-"
		S3BAND="-"; S3PCI="-"; S3EARFCN="-"
		S4BAND="-"; S4PCI="-"; S4EARFCN="-"

		case "$MODEL" in
			*7906*|*7912*)
				_CA=$(sms_tool -d $DEVICE at "AT+CMGRMI=4" 2>/dev/null | tr -d '\r' | grep -i '^+CMGRMI: *CA_SCELL,')
				_ci=0
				_cm=""
				while IFS=, read -r _c0 _cear _c2 _cband _cbw _c5 _cpci _crest; do
					[ "${_crest##*,}" = "1" ] || continue
					case "$_cear$_cband$_cpci" in ''|*[!0-9]*) continue ;; esac
					_ci=$((_ci + 1))
					[ "$_ci" -le 4 ] || break
					_cb="$(band4g "$_cband")"
					_cw=""
					case "$_cbw" in
						0) _cw="1.4" ;; 1) _cw="3" ;; 2) _cw="5" ;;
						3) _cw="10" ;; 4) _cw="15" ;; 5) _cw="20" ;;
					esac
					_cm="$_cm + $_cb"
					[ -n "$_cw" ] && _cb="$_cb @$_cw MHz"
					eval "S${_ci}BAND=\$_cb; S${_ci}PCI=\$_cpci; S${_ci}EARFCN=\$_cear; S${_ci}STATE=activated"
				done <<EOF_CA
$_CA
EOF_CA
				if [ "$_ci" -gt 0 ] && [ -n "$PBAND" ]; then
					MODE="LTE-A | $PBAND$_cm"
				fi
				;;
		esac
	fi

else
	OT=$(sms_tool -d $DEVICE at "AT+CPMUTEMP")
	T=$(echo "$OT" | awk -F[,:] '/^\+CPMUTEMP: / {print $2}' | xargs)
	[ -n "$T" ] && TEMP="$T &deg;C"

	O=$(sms_tool -d $DEVICE at "AT+CPSI?" | tr -d '\r')

	_sc_d10() {
		case "$1" in ''|*[!0-9-]*) return ;; esac
		awk -v v="$1" 'BEGIN{printf "%g", v/10}'
	}
	_sc_nbw() {
		case "$1" in
			0) echo 5 ;; 1) echo 10 ;; 2) echo 15 ;; 3) echo 20 ;; 4) echo 25 ;; 5) echo 30 ;;
			6) echo 35 ;; 7) echo 40 ;; 8) echo 45 ;; 9) echo 50 ;; 10) echo 60 ;; 11) echo 70 ;;
			12) echo 80 ;; 13) echo 90 ;; 14) echo 100 ;; 15) echo 200 ;; 16) echo 400 ;;
		esac
	}

	_sc_l=$(echo "$O" | grep -m1 '^+CPSI: LTE,')
	_sc_n=$(echo "$O" | grep -m1 '^+CPSI: NR5G_NSA,')
	_sc_s=$(echo "$O" | grep -m1 '^+CPSI: NR5G_SA,')
	_SC4=""
	_SC5=""

	if [ -n "$_sc_l" ]; then
		_oIFS=$IFS; IFS=','; set -- $_sc_l; IFS=$_oIFS
		case "$4" in 0x*) TAC_HEX="${4#0x}"; TAC_DEC=$(printf "%d" "$4" 2>/dev/null) ;; esac
		[ -n "$6" ] && PCI=$6
		[ -n "$8" ] && EARFCN=$8
		B_NUM=${7#EUTRAN-BAND}
		case "$B_NUM" in ''|*[!0-9]*) ;; *) _SC4="$(band4g $B_NUM)"; PBAND="$_SC4" ;; esac
		case "$9" in
			0) BANDWIDTH="1.4 MHz" ;; 1) BANDWIDTH="3 MHz" ;; 2) BANDWIDTH="5 MHz" ;;
			3) BANDWIDTH="10 MHz" ;; 4) BANDWIDTH="15 MHz" ;; 5) BANDWIDTH="20 MHz" ;;
		esac
		T=$(_sc_d10 "${11}"); [ -n "$T" ] && RSRQ=$T
		T=$(_sc_d10 "${12}"); [ -n "$T" ] && RSRP=$T
		T=$(_sc_d10 "${13}"); [ -n "$T" ] && RSSI=$T
		case "${14}" in ''|*[!0-9-]*) ;; *) SINR=${14} ;; esac
	fi

	if [ -n "$_sc_n" ]; then
		_oIFS=$IFS; IFS=','; set -- $_sc_n; IFS=$_oIFS
		B=${3#NR5G_BAND}
		case "$B" in ''|*[!0-9]*) ;; *)
			_SC5="$(band5g $B)"
			_sc_w=$(_sc_nbw "$9")
			S1BAND="$_SC5"
			[ -n "$_sc_w" ] && S1BAND="$_SC5 @$_sc_w MHz"
			S1PCI=$2; S1EARFCN=$4; S1STATE="activated"
			S1RSRP=$(_sc_d10 "$5"); S1RSRQ=$(_sc_d10 "$6"); S1SINR=$(_sc_d10 "$7")
			;;
		esac
	fi

	if [ -n "$_sc_s" ]; then
		_oIFS=$IFS; IFS=','; set -- $_sc_s; IFS=$_oIFS
		case "$4" in 0x*) TAC_HEX="${4#0x}"; TAC_DEC=$(printf "%d" "$4" 2>/dev/null) ;; esac
		[ -n "$6" ] && PCI=$6
		[ -n "$8" ] && EARFCN=$8
		B=${7#NR5G_BAND}
		case "$B" in ''|*[!0-9]*) ;; *) _SC5="$(band5g $B)"; PBAND="$_SC5" ;; esac
		T=$(_sc_d10 "$9"); [ -n "$T" ] && RSRP=$T
		T=$(_sc_d10 "${10}"); [ -n "$T" ] && RSRQ=$T
		T=$(_sc_d10 "${11}"); [ -n "$T" ] && SINR=$T
	fi

	if [ -n "$_SC4" ] && [ -n "$_SC5" ]; then
		MODE="5G NSA | $_SC4 / $_SC5"
	elif [ -n "$_SC5" ]; then
		MODE="5G SA | $_SC5"
	elif [ -n "$_SC4" ]; then
		MODE="LTE | $_SC4"
	fi
fi

# ==============================================================================
# ОБЩИЙ БЛОК ДЛЯ ИНФОРМАЦИИ О МОДЕМЕ
# ==============================================================================
OF=$(sms_tool -d $DEVICE at "AT+CGMR")
FWA=$(echo "$OF" | awk -F [:] '/^\+CGMR: /{print $2}' | xargs)
if [ -n "$FWA" ]; then
	FW="$FWA"
fi

if [ -n "$MODELB" ]; then
	MODEL="$(echo $MODELB | sed 's,_, ,')"
fi

OM=$(sms_tool -d $DEVICE at "AT+CGSN")
NR_I=$(echo "$OM" | sed s/"AT+CGSN"// | xargs)
if [ -n "$NR_I" ]; then
	NR_IMEI="$NR_I"
fi

OC=$(sms_tool -d $DEVICE at "AT+CIMI")
NR_C=$(echo "$OC" | sed s/"AT+CIMI"// | tr -s "\n" | xargs)
if [ -n "$NR_C" ]; then
	NR_IMSI="$NR_C"
fi

OI=$(sms_tool -d $DEVICE at "AT+ICCID")
NR_D=$(echo "$OI" | awk -F [:] '/^\+ICCID: /{print $2}' | xargs)
if [ -n "$NR_D" ]; then
	NR_ICCID="$NR_D"
fi

PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
PVCUT=$(echo $PV | awk -F 'Vendor=1e0e ProdID=9001' '{print $2}' | cut -c-1290)
if echo "$PVCUT" | grep -q "Driver=qmi_wwan"
then
	PROTO="qmi"
elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"
then
	PROTO="mbim"
elif echo "$PVCUT" | grep -q "Driver=cdc_ether"
then
	PROTO="ecm"
fi
