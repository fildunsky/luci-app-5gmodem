# ОБЩИЙ БЛОК СЕМЕЙСТВА Qualcomm SDX55 (Foxconn T99W175 / Dell DW5930e / Thales
# MV31-W): антенные порты из ^DEBUG? и соседние сектора по AT+VZWRSRP?/VZWRSRQ?.
#
# Жил только в 05c690d5 (MBIM-композиция), а в 05c69025 (QMI), 1e2d:00b3/00b7/
# 00b8/00b9 (Thales-кастомеры) и PCIe 105b:e0b0 его не было вовсе - половина
# карточки не доезжала до владельцев этих композиций, хотя набор AT-команд от
# композиции не зависит (ревью 12.09.2026 по форуму: тот же ^DEBUG? на 9025,
# VZWRSRP на 1e2d). Один файл на всех, как _qualcomm_sdx55_common у диапазонов.
#
# КОНТРАКТ: вызывающий профиль уже сделал `_DBG="$O"` сразу после at^debug?
# (O ниже переиспользуется под CGSN/CIMI/ICCID) и держит DEVICE = AT-порт.
# COMPAL СЮДА НЕ ХОДИТ: на 05c6:9025/90d5 и 1e2d:00b7 тот же ID носит Compal
# RXM-G1 с другими командами; профили отсеивают его раньше (is_compal ->
# 05c690d6 -> return), а здесь стоит вторая, независимая проверка флага.
[ -n "$_IS_COMPAL" ] && return 0 2>/dev/null

# --- Антенные порты и соседние сектора (Qualcomm SDX55) ----------------------
#
# АНТЕННЫ - ИЗ ТОГО ЖЕ ^DEBUG?, лишних запросов к порту ноль. Формат строки
# (подтверждён сообществом по T99W175):
#   lte_ant_rsrp:rx_diversity:15 (-77.7dBm,-78.8dBm,-78.4dBm,-79.6dBm)
#                                   ANT0      ANT3     ANT2     ANT1
# О ПОРЯДКЕ ЗНАЧЕНИЙ. На форуме под этой строкой подписывают цепи как
# «ANT0 ANT3 ANT2 ANT1», но живой вывод с маской 3 (-90.2dBm,-91.9dBm,NA,NA)
# эту подпись опровергает: маска 3 - это цепи 0 и 1, и измеренные значения
# стоят в позициях 0 и 1. Значит порядок ПРЯМОЙ: позиция = номер цепи. На
# полной маске обе версии дают одинаковую разбивку пар (0,2 против 1,3),
# поэтому раньше подмену было не видно. Берём прямой порядок - он согласован
# с маской во всех известных выводах.
# ЛОВУШКИ, которые в этой строке действительно есть:
#   1) заглушки «нет измерения» - «NA» и «-256.0dBm» (отсекаем по диапазону);
#   2) rx_diversity - БИТОВАЯ МАСКА активных цепей (15 = 0b1111 = четыре).
#      По ней и считаем вердикт разнесённого приёма, а не по числу значений:
#      уровни печатаются для всех цепей, включая выключенные.
# Формат ANTPORTS общий со страницей: "порт:rsrp:rsrq" (RSRQ по цепям модем не
# даёт - поле пустое, как у Sierra). Уровни округляем до целых: страница
# принимает только целые.
if [ -z "$ANTPORTS" ]; then
	_AL=$(echo "$_DBG" | sed -n 's/.*lte_ant_rsrp:rx_diversity:\([0-9]*\)[^(]*(\([^)]*\)).*/\1|\2/p' | head -1)
	# 3G ПИШЕТ ЭТУ ЖЕ СТРОКУ ПОД ДРУГИМ ИМЕНЕМ И С ПРОБЕЛАМИ: «wcdma_ant_rscp:
	# rx_diversity: 3 (-114.0dBm,-125.5dBm)» (ревью 13.09.2026, форум 4pda #5278,
	# #5282, #7887). Цепей у WCDMA две, а не четыре - их и покажем; шаблон
	# допускает пробел после двоеточия, которого в LTE-строке нет.
	[ -n "$_AL" ] || _AL=$(echo "$_DBG" | sed -n 's/.*wcdma_ant_rscp: *rx_diversity: *\([0-9]*\)[^(]*(\([^)]*\)).*/\1|\2/p' | head -1)
	if [ -n "$_AL" ]; then
		_AMASK="${_AL%%|*}"; _AVALS="${_AL#*|}"
		# значения идут в порядке ANT0, ANT3, ANT2, ANT1
		# «-256.0dBm» - ЗАГЛУШКА «ИЗМЕРЕНИЯ НЕТ», а не уровень. Живой вывод с
		# форума: (-256.0dBm,-75.3dBm,-256.0dBm,-256.0dBm) при маске 15 - три
		# цепи включены, но ничего не мерили в этот момент. Показать «-256 дБм»
		# значило бы нарисовать мёртвые антенны там, где просто нет данных.
		# Отсекаем всё за пределами физичного диапазона (-160..-20 дБм).
		_AI=0; _AOK=0; _AGOOD=0
		for _AV in $(echo "$_AVALS" | tr ',' ' '); do
			_AV=$(echo "$_AV" | sed 's/dBm//g' | tr -d ' ')
			case "$_AV" in ''|*[!0-9.-]*) _AI=$((_AI+1)); continue ;; esac
			_AR=$(awk "BEGIN{printf \"%.0f\", $_AV}" 2>/dev/null)
			case "$_AR" in ''|*[!0-9-]*) _AI=$((_AI+1)); continue ;; esac
			if [ "$_AR" -le -160 ] 2>/dev/null || [ "$_AR" -ge -20 ] 2>/dev/null; then
				_AI=$((_AI+1)); continue
			fi
			ANTPORTS="$ANTPORTS${ANTPORTS:+ }$_AI:$_AR:"
			_AOK=$((_AOK+1))
			[ "$_AR" -gt -130 ] 2>/dev/null && _AGOOD=$((_AGOOD+1))
			_AI=$((_AI+1))
		done
		# порядок в строке - по номеру порта, чтобы таблица не прыгала
		ANTPORTS=$(echo "$ANTPORTS" | tr ' ' '\n' | sort -n | tr '\n' ' ' | sed 's/ *$//')
		# ВЕРДИКТ РАЗНЕСЁННОГО ПРИЁМА - только когда есть на чём его строить.
		# Маска говорит, сколько цепей ВКЛЮЧЕНО, но при одном измеренном
		# значении отличить «три цепи не мерили» от «три цепи мертвы» нельзя:
		# в первом случае «4RX» - вымысел, во втором «off» - ложная тревога.
		# Меньше двух живых уровней - вердикта не даём вовсе (строка скрыта).
		if [ "$_AOK" -ge 2 ]; then
			case "$_AMASK" in
				''|*[!0-9]*) ;;
				*) _AN=0
				   for _AB in 1 2 4 8; do [ $(( _AMASK & _AB )) -ne 0 ] && _AN=$((_AN+1)); done
				   case "$_AN" in
					   1) RXDIV="off" ;;
					   2) RXDIV="2rx" ;;
					   3|4) RXDIV="4rx" ;;
				   esac ;;
			esac
		fi
	fi
fi

# СОСЕДНИЕ СЕКТОРА - AT+VZWRSRP?/AT+VZWRSRQ?.
#
# ФОРМАТ ОТВЕТА ОКАЗАЛСЯ НЕОЧЕВИДНЫМ - разобран по живым выводам сообщества:
#   AT+VZWRSRP?
#     +VZWRSRP: 325,1275,"-1082"      <- префикс только у ПЕРВОЙ строки
#     387,6350,"-1016"                <- остальные секторы идут БЕЗ него
#     ...
#   AT+VZWRSRQ?
#     +VZWRSRQ: 325,1275,"-122",387,6350,"-99",243,6350,"-137",...
#                                     <- ВСЁ ОДНОЙ строкой, тройками
# Тройка - это <pci>,<earfcn>,"<значение>". Значение - В ДЕСЯТЫХ ДОЛЯХ и в
# кавычках: "-1082" = -108.2 dBm, "-122" = -12.2 dB. Делим на 10 и округляем.
# RSRQ сшиваем с RSRP ПО ПАРЕ (pci,earfcn), а не по порядку: в живом выводе
# порядок совпадал не всегда (последняя тройка RSRQ шла с чужим pci).
# Первый сектор в списке - обслуживающий, помечаем его serving.
#
# НЕГАТИВНЫЙ КЭШ. Команды вендорские: у части прошивок их нет, и тогда каждый
# опрос платил бы двумя заведомо пустыми AT-запросами в порт, который делят
# дозвон и метрики. Один раз получили ERROR - больше не спрашиваем (кэш в
# /tmp, то есть до перезагрузки).
_VNC="/tmp/5gmodem_novzw_$(echo "${DEVICE##*/}" | tr -c 'A-Za-z0-9' '_')"
if [ -z "$NEIGHBORS" ] && [ ! -f "$_VNC" ]; then
	_VP=$(sms_tool -d $DEVICE at "AT+VZWRSRP?" 2>/dev/null | tr -d '\r')
	case "$_VP" in
		*VZWRSRP:*) ;;
		*) : > "$_VNC" ;;
	esac
	if echo "$_VP" | grep -q "VZWRSRP:"; then
		_VQ=$(sms_tool -d $DEVICE at "AT+VZWRSRQ?" 2>/dev/null | tr -d '\r')
		NEIGHBORS=$(printf '%s\n@@RSRQ@@\n%s\n' "$_VP" "$_VQ" | awk '
			function num(v) {   # "-1082" -> -108.2 -> -108
				gsub(/"/, "", v); gsub(/[ \t]/, "", v)
				if (v !~ /^-?[0-9]+$/) return ""
				return sprintf("%.0f", v / 10)
			}
			/@@RSRQ@@/ { part = 2; next }
			{
				line = $0
				sub(/^.*VZWRSRP:[ \t]*/, "", line)
				sub(/^.*VZWRSRQ:[ \t]*/, "", line)
				gsub(/[ \t]/, "", line)
				if (line == "" || line == "OK") next
				n = split(line, a, ",")
				# тройки <pci>,<earfcn>,"<значение>"
				for (i = 1; i + 2 <= n; i += 3) {
					pc = a[i]; ef = a[i+1]; vl = num(a[i+2])
					if (pc !~ /^[0-9]+$/ || ef !~ /^[0-9]+$/) continue
					key = pc "_" ef
					if (part == 2) { rq[key] = vl; continue }
					if (!(key in seen)) { seen[key] = ++cnt; kp[cnt] = pc; ke[cnt] = ef; kr[cnt] = vl }
				}
			}
			END {
				for (i = 1; i <= cnt; i++) {
					key = kp[i] "_" ke[i]
					printf "%s{\"band\":\"\",\"earfcn\":\"%s\",\"pci\":\"%s\",\"rsrp\":\"%s\",\"rsrq\":\"%s\",\"rssi\":\"\",\"serving\":%s}",
						(o++ ? "," : ""), ke[i], kp[i], kr[i], (key in rq ? rq[key] : ""), (i == 1 ? 1 : 0)
				}
			}')
	fi
fi

# --- Мощность передатчика ----------------------------------------------------
#
# Величина лежит в каждом ответе ^DEBUG? и никуда не уходила (ревью 13.09.2026,
# форум 4pda): «lte_tx_pwr:-33.0dBm» (#953), «lte_tx_pwr:21.0dBm» (#1194),
# «lte_tx_pwr:0.0dBm» (#1034), на 3G - «tx_pwr:0dBm» (#5278, #5282). Для этого
# модуля она не косметическая: тема связывает высокую мощность передачи с
# нагревом и спонтанными ребутами под нагрузкой. «NA» (#1771, #2771, #7896) -
# это «не измерено», а не ноль, поэтому фильтр по числу обязателен.
# С ЕДИНИЦЕЙ «dBm»: страница печатает поле как есть (mutil.cellVal), и у
# остальных профилей оно приходит с единицей - голое «21.0» читалось бы как что
# угодно. Единица в ответе плавает («lte_tx_pwr:10.0dB», #3956) - берём число.
# nr_tx_pwr живого дампа на SDX55 не имеет, но читаем его тем же перебором: имя
# симметрично остальным полям nr_* этого ответа и уже используется у SDX62
# (_foxconn_mv32_common) - лишнего запроса к порту это не стоит.
if [ -z "$TXPOWER" ]; then
	# Разбор по ключу через awk, а не «\|» в sed: альтернация в BRE - расширение
	# GNU, у busybox sed на неё рассчитывать нельзя.
	_TXP=$(printf '%s\n' "$_DBG" | awk '
		{
			line = $0
			gsub(/[ \t]/, "", line)
			n = split(line, a, ",")
			for (i = 1; i <= n; i++) {
				p = index(a[i], ":")
				if (p < 2) continue
				k = substr(a[i], 1, p - 1)
				v = substr(a[i], p + 1)
				if (k != "lte_tx_pwr" && k != "nr_tx_pwr" && k != "tx_pwr") continue
				sub(/(dBm|dB)$/, "", v)
				if (v ~ /^-?[0-9]+(\.[0-9]+)?$/) { print v; exit }
			}
		}')
	[ -n "$_TXP" ] && TXPOWER="$_TXP dBm"
fi

# --- Уровни вторичных несущих (LTE) ------------------------------------------
#
# Блок «scell:» ответа ^DEBUG? отдаёт их полностью (форум 4pda #953, дословно):
#   scell: lte_band:7 lte_band_width:20.0MHz
#   channel:2850 pci:54
#   lte_rsrp:-78.6dBm,rsrq:-9.0dB
#   lte_rssi:-60.0dBm,lte_snr:-20.0dB
# Профили семейства разбирали эти строки и тут же выбрасывали - присваивания
# остались закомментированными от давно удалённого API `addon`, и в таблице
# агрегации у вторичных несущих стояли прочерки. Имена полей общие со всеми
# профилями: S<n>RSRP/RSRQ/RSSI/SINR (ревью 13.09.2026, форум 4pda).
# ЗАПОЛНЯЕМ ТОЛЬКО ПУСТОЕ: профиль, если он что-то уже положил, знает больше.
# Через eval, как в _foxconn_mv32_common: awk печатает ТОЛЬКО числа из белого
# списка ключей, подставлять в eval сырой ответ модема нельзя.
eval "$(printf '%s\n' "$_DBG" | awk '
	function num(v) {
		sub(/(dBm|dB)$/, "", v)
		return (v ~ /^-?[0-9]+(\.[0-9]+)?$/) ? v : ""
	}
	/^[ \t]*pcell:/ { sec = 0; next }
	/^[ \t]*scell:/ { sec = ++n; next }
	/^[ \t]*nr_/    { sec = 0 }
	sec > 0 {
		line = $0
		gsub(/[ \t]/, "", line)
		m = split(line, a, ",")
		for (i = 1; i <= m; i++) {
			p = index(a[i], ":")
			if (p < 2) continue
			k = substr(a[i], 1, p - 1)
			v = num(substr(a[i], p + 1))
			if (v == "") continue
			if (k == "lte_rsrp" || k == "rsrp")      rp[sec] = v
			else if (k == "lte_rsrq" || k == "rsrq") rq[sec] = v
			else if (k == "lte_rssi" || k == "rssi") rs[sec] = v
			else if (k == "lte_snr"  || k == "snr")  sr[sec] = v
		}
	}
	END {
		for (i = 1; i <= n && i <= 4; i++) {
			if (i in rp) printf "_SX%dRSRP=%s\n", i, rp[i]
			if (i in rq) printf "_SX%dRSRQ=%s\n", i, rq[i]
			if (i in rs) printf "_SX%dRSSI=%s\n", i, rs[i]
			if (i in sr) printf "_SX%dSINR=%s\n", i, sr[i]
		}
	}')"
for _SI in 1 2 3 4; do
	for _SM in RSRP RSRQ RSSI SINR; do
		eval "_SV=\$_SX${_SI}${_SM}; _SC=\$S${_SI}${_SM}"
		case "$_SC" in
			''|-) [ -n "$_SV" ] && eval "S${_SI}${_SM}=\$_SV" ;;
		esac
	done
	unset _SX${_SI}RSRP _SX${_SI}RSRQ _SX${_SI}RSSI _SX${_SI}SINR
done
unset _SV _SC

# --- 3G: уровни есть, просто зовутся иначе -----------------------------------
#
# В WCDMA прошивка печатает совсем другой набор (форум 4pda #5278, дословно):
#   RAT:WCDMA
#   band:1 / band_width:5.0MHz / channel:10687 / cell_id:8893013 / lac:7601
#   cell1: psc:298,rscp:-112.0dBm,ecio:-15.0dB
#   rssi:-98dBm
# Профили семейства обрабатывают только MODE_NUM 7/11/13 и поля pcell/scell/nr_*,
# поэтому на 3G карточка оставалась пустой целиком. Берём то, чему в снимке есть
# своё поле: RSCP/ECIO (как это делает профиль MV32 на SDX62), RSSI, канал и PSC
# в роли PCI. ДИАПАЗОН И ЯРЛЫК НЕ ТРОГАЕМ НАМЕРЕННО: «band:1» здесь - номер
# UMTS-диапазона, а band4g превратил бы его в «LTE B1» на сети, где LTE нет
# вовсе (ровно этот довод записан в _foxconn_mv32_common). Заполняем только
# пустое (ревью 13.09.2026, форум 4pda).
case "$(printf '%s\n' "$_DBG" | sed -n 's/^[ \t]*RAT:[ \t]*//p' | head -1 | tr -d ' \t\r')" in
	WCDMA*|UMTS*|HSPA*|HSDPA*|HSUPA*|GSM*|GPRS*|EDGE*)
		_W3=$(printf '%s\n' "$_DBG" | sed 's/([^)]*)/ /g' | awk '
			function num(v) {
				sub(/(dBm|dB)$/, "", v)
				return (v ~ /^-?[0-9]+(\.[0-9]+)?$/) ? v : ""
			}
			{
				line = $0
				gsub(/[ \t]/, "", line)
				sub(/^cell[0-9]+:/, "", line)
				m = split(line, a, ",")
				for (i = 1; i <= m; i++) {
					p = index(a[i], ":")
					if (p < 2) continue
					k = substr(a[i], 1, p - 1)
					v = num(substr(a[i], p + 1))
					if (v == "") continue
					# ТОЛЬКО ПЕРВОЕ ВХОЖДЕНИЕ: первая сота в ответе -
					# обслуживающая, дальше могут идти соседи активного набора.
					if (!(k in g)) g[k] = v
				}
			}
			END { printf "%s|%s|%s|%s|%s\n", g["rscp"], g["ecio"], g["rssi"], g["channel"], g["psc"] }')
		_W_RSCP=${_W3%%|*}; _W3=${_W3#*|}
		_W_ECIO=${_W3%%|*}; _W3=${_W3#*|}
		_W_RSSI=${_W3%%|*}; _W3=${_W3#*|}
		_W_CHAN=${_W3%%|*}; _W_PSC=${_W3##*|}
		[ -n "$_W_RSCP" ] && [ -z "$RSCP" ] && RSCP="$_W_RSCP"
		[ -n "$_W_ECIO" ] && [ -z "$ECIO" ] && ECIO="$_W_ECIO"
		[ -n "$_W_RSSI" ] && [ -z "$RSSI" ] && RSSI="$_W_RSSI"
		[ -n "$_W_CHAN" ] && [ -z "$EARFCN" ] && EARFCN="$_W_CHAN"
		[ -n "$_W_PSC" ]  && [ -z "$PCI" ]    && PCI="$_W_PSC"
		;;
esac
