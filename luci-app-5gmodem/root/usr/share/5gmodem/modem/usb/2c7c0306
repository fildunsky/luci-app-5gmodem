# Quectel EP06
# Quectel EG06

. "$RES/modem/usb/_quectel_common"

O=$(sms_tool -d $DEVICE at "at+qtemp")

# Датчиков 3 или 4 в зависимости от прошивки (форум: «+QTEMP: 49,47,47» и
# четырёхзначные ответы) - берём максимум по ВСЕМ полям, а не по первым трём:
# перегрев у EP06 - главный класс отказов, и пропущенный горячий датчик стоил бы
# карточке самого важного числа. Отрицательные (мороз) сравниваются как числа.
T=$(echo "$O" | awk -F[,:] '/^\+QTEMP/ {t=-999; for(i=2;i<=NF;i++){v=$i; gsub(/[^0-9-]/,"",v); if(v ~ /^-?[0-9]+$/ && v*1>t) t=v*1}; if(t>-999) printf "%d", t}')
[ -n "$T" ] && TEMP="$T &deg;C"

O=$(sms_tool -d $DEVICE at "at+qnwinfo;+qeng=\"servingcell\";+qspn")

T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO/ {print $2"/"$4}' | xargs)
if [ "x$MODE_NUM" = "x7" ]; then
	B=$(echo $T | sed -n 's/.*LTE BAND \([0-9][0-9]*\).*/\1/p')
	[ -n "$B" ] || B=$(echo "$O" | awk -F[,:] '/^\+QENG:/ && $4 ~ /LTE/ {v=$11; gsub(/[^0-9]/,"",v); print v; exit}')
	case "$B" in
		''|*[!0-9]*) : ;;
		*)
			MODE="LTE $(band4g ${B})"
			MAINCUT="$(band4g ${B})"
			;;
	esac
fi

_qc_qeng_bw

_qc_spn4

if [ "x$MODE_NUM" = "x7" ]; then
	# ОТВЕТ QENG СОХРАНЯЕМ: ниже $O перезаписывается ответом QCAINFO, а из QENG
	# ещё нужен SINR. Без этого он считался по строке, которой в новом $O уже
	# нет, и на модеме С АГРЕГАЦИЕЙ поле «SINR» всегда было пустым (живой EP06-E
	# на стенде 05.08.2026: QENG отдаёт индекс 5, а в снимке прочерк).
	_QENG_O="$O"
	O=$(sms_tool -d $DEVICE at "AT+QCAINFO")
	
	# ТОЛЬКО АКТИВНЫЕ ВТОРИЧНЫЕ НЕСУЩИЕ.
	#
	# Формат строки: "scc",<earfcn>,<bandwidth>,"LTE BAND N",<state>,<pci>,...
	# <state>: 1 - несущая СКОНФИГУРИРОВАНА, но ДЕАКТИВИРОВАНА (данные по ней не
	# идут), 2 - активна. Раньше состояние не проверялось вовсе, и агрегация
	# показывалась по любой строке scc - то есть «LTE-A» горел, когда сеть уже
	# отпустила вторую несущую. Живой замер 06.08.2026 (EP06-E, спидтест): на
	# 2-4-й секунде state=2, дальше сеть держала ту же несущую в state=1 -
	# карточка при этом продолжала рисовать агрегацию. Для Compal это правило
	# уже действовало, теперь и здесь.
	# ВСЕ ВТОРИЧНЫЕ НЕСУЩИЕ, каждая со СВОИМ состоянием: state=2 - активна
	# (участвует в MODE и метке LTE-A), state=1 - сконфигурирована сетью, но
	# выключена - такую кладём в слот с s<n>state=deactivated: карточка теперь
	# показывает собранную-но-неактивную агрегацию приглушённо (идея владельца
	# EM9190, 19.08.2026), а раньше state=1 отбрасывался целиком и на Quectel
	# этой картины не было вовсе. Метрики каждой несущей - в её собственные
	# поля s<n>* (см. историю про затирание основных полей в git).
	_scc_i=0
	_SCCL=$(echo "$O" | tr -d '\r' | awk -F, '/^\+QCAINFO: "scc"/ && ($5==1 || $5==2) {
		gsub(/"/, "", $4); print $5 "|" $2 "|" $3 "|" $4 "|" $6 "|" $7 "|" $8 }')
	while IFS='|' read -r _SST _SE _SBW _SBSTR _SPCI _SRSRP _SRSRQ; do
		[ -n "$_SST" ] || continue
		[ "$_scc_i" -ge 4 ] && break
		_scc_i=$((_scc_i + 1))
		B="${_SBSTR#LTE BAND }"
		_qc_cbw T1 "$_SBW" "?"
		if [ "$_SST" = "2" ]; then
			_SSTW="activated"
			case "$MODE" in *LTE_A*) MODE="$MODE / $(band4g ${B})" ;;
				*) MODE="${MODE/LTE/LTE_A} / $(band4g ${B})" ;; esac
		else
			_SSTW="deactivated"
		fi
		case "$_scc_i" in
			1) S1BAND="$(band4g ${B}) @$T1 MHz"; S1PCI="$_SPCI"; S1EARFCN="$_SE"
			   S1RSRP=$_SRSRP; S1RSRQ=$_SRSRQ; S1STATE="$_SSTW" ;;
			2) S2BAND="$(band4g ${B}) @$T1 MHz"; S2PCI="$_SPCI"; S2EARFCN="$_SE"
			   S2RSRP=$_SRSRP; S2RSRQ=$_SRSRQ; S2STATE="$_SSTW" ;;
			3) S3BAND="$(band4g ${B}) @$T1 MHz"; S3PCI="$_SPCI"; S3EARFCN="$_SE"
			   S3RSRP=$_SRSRP; S3RSRQ=$_SRSRQ; S3STATE="$_SSTW" ;;
			4) S4BAND="$(band4g ${B}) @$T1 MHz"; S4PCI="$_SPCI"; S4EARFCN="$_SE"
			   S4RSRP=$_SRSRP; S4RSRQ=$_SRSRQ; S4STATE="$_SSTW" ;;
		esac
	done <<EOF
$_SCCL
EOF
	if [ -n "$S1BAND" ]; then
		# SINR - ИЗ СОХРАНЁННОГО ОТВЕТА QENG (в $O его уже нет, см. выше).
		T=$(echo "$_QENG_O" | awk -F[,:] '/^\+QENG:/ {v=$18; gsub(/[^0-9-]/,"",v); if(v ~ /^-?[0-9]+$/) print v; exit}')
		[ -n "$T" ] && SINR=$T
	fi
fi

# ШИРИНА ПОЛОСЫ ОТДЕЛЬНЫМ ПОЛЕМ. В подписи диапазона она уже есть («DL: @20
# MHz»), но карточка показывает её и самостоятельной строкой - там был прочерк.
# Индекс DL-полосы - поле 13 ответа QENG (0=1.4, 1=3, 2=5, 3=10, 4=15, 5=20).
if [ -z "$BANDWIDTH" ]; then
	T=$(echo "${_QENG_O:-$O}" | awk -F[,:] '/^\+QENG:/ {print $13}')
	case "$T" in
		0) BANDWIDTH="1.4 MHz";; 1) BANDWIDTH="3 MHz";; 2) BANDWIDTH="5 MHz";;
		3) BANDWIDTH="10 MHz";; 4) BANDWIDTH="15 MHz";; 5) BANDWIDTH="20 MHz";;
	esac
fi

# СОСЕДНИЕ СОТЫ. AT+QENG="neighbourcell" отдаёт строки вида
#   +QENG: "neighbourcell intra","LTE",<earfcn>,<pci>,<rsrq>,<rsrp>,<rssi>,...
# Столбец 5 - именно RSRQ, а 6 - RSRP (порядок обратный привычному), проверено
# на живом EP06-E: rsrq -19, rsrp -105. Таблицу соседей страница уже умеет
# рисовать - до сих пор для этого модема она просто была пуста.
if [ -z "$NEIGHBORS" ]; then
	_NB=$(sms_tool -d $DEVICE at "AT+QENG=\"neighbourcell\"" 2>/dev/null | tr -d '\r')
	# ДИАПАЗОН СЧИТАЕМ ИЗ EARFCN. Сам модем его для соседей не сообщает, и в
	# таблице стояли прочерки - хотя номер канала однозначно задаёт диапазон
	# (3GPP 36.101, таблица 5.7.3-1). Диапазоны перечислены те, что EP06-E
	# поддерживает; незнакомый канал оставляем без подписи, а не врём.
	# ПУСТЫЕ СТРОКИ ОТСЕИВАЕМ: модем печатает и обрезанные записи (все нули или
	# без хвоста) - в таблице они выглядели как сота «по нулям» (замечание
	# владельца 05.08.2026). Сота без уровня сигнала бесполезна.
	# ОБСЛУЖИВАЮЩАЯ СОТА В СПИСКЕ ЕСТЬ: neighbourcell печатает и текущую (форум,
	# многократно) - помечаем её по PCI+EARFCN, иначе она рисовалась «ещё одним
	# соседом» с бессмысленной кнопкой лока. B32 (SDL, 9920-10359) добавлен: он
	# участвует в CA-комбо EP06-E (20A2A-32A2) и попадал в таблицу без подписи.
	NEIGHBORS=$(echo "$_NB" | awk -v spci="$PCI" -v sear="$EARFCN" -F, '
		function ch2band(c) {
			if (c <= 599) return 1;      if (c <= 1199) return 2
			if (c <= 1949) return 3;     if (c <= 2399) return 4
			if (c <= 2649) return 5;     if (c >= 2750 && c <= 3449) return 7
			if (c >= 3450 && c <= 3799) return 8
			if (c >= 6150 && c <= 6449) return 20
			if (c >= 9210 && c <= 9659) return 28
			if (c >= 9920 && c <= 10359) return 32
			if (c >= 37750 && c <= 38249) return 38
			if (c >= 38650 && c <= 39649) return 40
			if (c >= 39650 && c <= 41589) return 41
			return 0
		}
		/^\+QENG: "neighbourcell/ {
			gsub(/"/, "", $2)
			if ($2 != "LTE") next
			if (NF < 7) next
			earfcn = $3 + 0; pci = $4 + 0; rsrq = $5 + 0; rsrp = $6 + 0; rssi = $7 + 0
            if (earfcn == 0 || rsrp == 0) next
			b = ch2band(earfcn)
			if (n++) printf ","
			sv = (spci != "" && sear != "" && pci == spci+0 && earfcn == sear+0) ? "true" : "false"
			printf "{\"band\":\"%s\",\"earfcn\":\"%d\",\"pci\":\"%d\",\"rsrp\":\"%d\",\"rsrq\":\"%d\",\"rssi\":\"%d\",\"serving\":%s}", (b ? b : ""), earfcn, pci, rsrp, rsrq, rssi, sv
		}')
fi

MODE=$(echo $MODE | sed 's,/,+,' | sed 's, / \(B[0-9]\), + \1,g' | sed "s/LTE_A/LTE-A | /g")

# Modem
_qc_ati

_qc_ids

_qc_proto "Vendor=2c7c ProdID=0306" 1220

. "$RES/modem/usb/_quectel_qrsrp"
