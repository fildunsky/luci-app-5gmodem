_qc_spn2() {
	T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $2}' | xargs)
	if [ -n "$T" ] && [ -z "$FORCE_PLMN" ]; then
		COPS="$T"
	fi
}

# +QSPN: <FNN>,<SNN>,<SPN>,<alphabet>,<RPLMN>. Брали поле 2 (FNN) - на старых
# прошивках при ограниченном сервисе там «000 000» (форум: «+QSPN: "000 000",
# "000 000","beCloud",0,"000000"»), и это затирало имя, уже найденное по +COPS?.
# Берём SPN (поле 4, как у EC25/EG25), при пустом - FNN; цифровой мусор не имя.
_qc_spn4() {
	T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $4}' | xargs)
	case "$T" in ''|*[!0-9\ ]*) : ;; *) T="" ;; esac
	[ -n "$T" ] || { T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $2}' | xargs); case "$T" in ''|*[!0-9\ ]*) : ;; *) T="" ;; esac; }
	if [ -n "$T" ] && [ -z "$FORCE_PLMN" ]; then
		COPS="$T"
	fi
}

_qc_ec25_lte() {
	O=$(sms_tool -d $DEVICE at "at+qnwinfo;+qeng=\"servingcell\";+qspn")

	T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO/ {print $2"/"$4}' | xargs)
	if [ -n "$T" ]; then
		if [ "x$MODE_NUM" = "x7" ]; then
			B=$(echo $T | sed 's/.*LTE BAND \(.*\)/\1/')
			MODE="LTE | $(band4g ${B})"
			MAINCUT="$(band4g ${B})"
		fi
	fi

	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4}' | xargs)
	if [ "x$T" = "xLTE" ] || [ "x$T" = "x4G" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14}')
		TAC_DEC=$(printf "%d" "0x$T")
		TAC_HEX="$T"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $12}')
		_qc_lbw T1 "$T" ""
		[ -n "$T1" ] && ULBW="UL: @$T1 MHz"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13}')
		_qc_lbw T1 "$T" ""
		[ -n "$T1" ] && DLBW="DL: @$T1 MHz"
		PBAND="$MAINCUT $DLBW $ULBW"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $9}')
		[ -n "$T" ] && PCI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $10}')
		[ -n "$T" ] && EARFCN="$T"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $17}')
		RSSI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $15}')
		RSRP="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $16}')
		RSRQ="$T"
		# Поле SINR в QENG="servingcell" у EC21/EC25 уже в дБ (сверено с AT+QCSQ:
		# QENG SINR=2 ≈ QCSQ 112 -> 112/5-20 = 2.4 дБ). Прежняя формула *0.2-20
		# давала абсурдные ~-19 дБ на рабочем соединении.
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18}' | xargs)
		SINR="$T"
	fi

	T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $4}' | xargs)
	if [ -n "$T" ]; then
		COPS="$T"
	fi
}

_qc_qeng_bw() {
	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4}' | xargs)
	if [ "x$T" = "xLTE" ] || [ "x$T" = "x4G" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14}')
		T_DEC=$(printf "%d" "0x$T")
		T_HEX=$T

		# Полосы - ОТДЕЛЬНЫМ полем BANDWIDTH, а не внутри PBAND. Легаси-формат
		# «B3 DL: @20 MHz UL: @20 MHz» ломал фронт: caSplitBand режет строку по
		# « @», и таблица несущих показывала «B3 (1800 MHz) DL:» в колонке
		# диапазона и «20 MHz UL:» в колонке полосы с пустотой после двоеточий
		# (живой случай EP06-E, 19.08.2026). UL-полосу показываем только когда
		# она отличается от DL (на FDD они совпадают почти всегда).
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $12}')
		_qc_lbw T1 "$T" ""
		_ULBW="$T1"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13}')
		_qc_lbw T1 "$T" ""
		if [ -n "$T1" ]; then
			BANDWIDTH="$T1 MHz"
			[ -n "$_ULBW" ] && [ "$_ULBW" != "$T1" ] && BANDWIDTH="$T1/$_ULBW MHz"
		fi
		PBAND="$MAINCUT"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $9}')
		PCI=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $10}')
		EARFCN=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $17}')
		RSSI=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $15}')
		RSRP=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $16}')
		RSRQ=$T
		# SINR В QENG="servingcell" УЖЕ В ДЕЦИБЕЛАХ. Прежняя формула 0.2*x*10-20 (= 2x-20)
		# не была ни «1/5 дБ» из мануала EC25, ни живым замером; по 23 живым ответам
		# QENG с форума поле лежит в 0..25 и растёт вместе с RSRP (-114 → 6, -67 → 25) -
		# это дБ как есть, ровно как сверено на EC25 (modem/usb/2c7c0125) по AT+QCSQ.
		# Со сдвигом карточка занижала SINR на 4-14 дБ и решение «256QAM нельзя».
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {v=$18; gsub(/[^0-9-]/,"",v); if(v ~ /^-?[0-9]+$/) print v; exit}')
		SINR=$T
	fi
}

