_qc_temp3n() {
	O=$(sms_tool -d $DEVICE at "at+qtemp")

	T=$(echo "$O" | awk -F[,:] '/^\+QTEMP/ {print $3}' | tr -d '"' | sort -rn | head -n1 | xargs)
	[ -n "$T" ] && TEMP="$T &deg;C"
}

_qc_spn2() {
	T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $2}' | xargs)
	if [ -n "$T" ] && [ -z "$FORCE_PLMN" ]; then
		COPS="$T"
	fi
}

_qc_spn4() {
	T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $4}' | xargs)
	case "$T" in ''|*[!0-9\ ]*) : ;; *) T="" ;; esac
	[ -n "$T" ] || { T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $2}' | xargs); case "$T" in ''|*[!0-9\ ]*) : ;; *) T="" ;; esac; }
	if [ -n "$T" ] && [ -z "$FORCE_PLMN" ]; then
		COPS="$T"
	fi
}

_qc_ec25_lte() {
	O=$(sms_tool -d $DEVICE at "at+qnwinfo;+qeng=\"servingcell\";+qspn")

	T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO/ {print $2"/"$4}' | xargs)
	if [ -n "$T" ]; then
		if [ "x$MODE_NUM" = "x7" ]; then
			B=$(echo $T | sed 's/.*LTE BAND \(.*\)/\1/')
			MODE="LTE | $(band4g ${B})"
			MAINCUT="$(band4g ${B})"
		fi
	fi

	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4}' | xargs)
	if [ "x$T" = "xLTE" ] || [ "x$T" = "x4G" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14}')
		TAC_DEC=$(printf "%d" "0x$T")
		TAC_HEX="$T"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $12}')
		_qc_lbw T1 "$T" ""
		[ -n "$T1" ] && ULBW="UL: @$T1 MHz"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13}')
		_qc_lbw T1 "$T" ""
		[ -n "$T1" ] && DLBW="DL: @$T1 MHz"
		PBAND="$MAINCUT $DLBW $ULBW"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $9}')
		[ -n "$T" ] && PCI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $10}')
		[ -n "$T" ] && EARFCN="$T"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $17}')
		RSSI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $15}')
		RSRP="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $16}')
		RSRQ="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18}' | xargs)
		SINR="$T"
	fi

	_qc_spn4
}

_qc_qeng_bw() {
	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4}' | xargs)
	if [ "x$T" = "xLTE" ] || [ "x$T" = "x4G" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14}')
		T_DEC=$(printf "%d" "0x$T")
		T_HEX=$T

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $12}')
		_qc_lbw T1 "$T" ""
		_ULBW="$T1"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13}')
		_qc_lbw T1 "$T" ""
		if [ -n "$T1" ]; then
			BANDWIDTH="$T1 MHz"
			[ -n "$_ULBW" ] && [ "$_ULBW" != "$T1" ] && BANDWIDTH="$T1/$_ULBW MHz"
		fi
		PBAND="$MAINCUT"

		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $9}')
		PCI=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $10}')
		EARFCN=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $17}')
		RSSI=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $15}')
		RSRP=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $16}')
		RSRQ=$T
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {v=$18; gsub(/[^0-9-]/,"",v); if(v ~ /^-?[0-9]+$/) print v; exit}')
		SINR=$T
	fi
}

_qc_act() {
	printf '%s\n' "$1" | tr -d '\r' | awk -F, '!(/^\+QCAINFO: "(scc|SCC)"/ && $4 ~ /LTE BAND/ && ($5 == "0" || $5 == "1"))'
}

_qc_sst() {
	_qc_sst_v=$(printf '%s' "$2" | tr -d '\r' | awk -F, '$4 ~ /LTE BAND/ && ($5 == "0" || $5 == "1") {print "deactivated"; exit} {print "activated"}')
	_qc_s "$1" STATE "$_qc_sst_v"
}

_qc_scc_lte() {
	IDX=1
	LINES=$(echo "$O" | grep -E "^\+QCAINFO: \"(scc|SCC)\"")
	for LINE in $LINES; do

		T=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $5}')
		B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
		T2=$(band4g ${B})
		_qc_sst $IDX "$LINE"
		[ "$2" = mode ] && [ "$_qc_sst_v" = activated ] && MODE="$MODE / $T2"
		T3=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $4}')
		_qc_cbw T4 "$T3" "$1"
		if [ -z "$T4" ]; then
			_qc_s $IDX BAND "$T2"
		else
			_qc_s $IDX BAND "$T2 @$T4 MHz"
		fi
		T=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $3}')
		[ -n "$T" ] && _qc_s $IDX EARFCN "$T"
		T=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $7}')
		[ -n "$T" ] && _qc_s $IDX PCI "$T"

		IDX=$((IDX + 1))
	done
}

