_qc_proto() {
	# Protocol
	# DRIVER=QMI_WWAN & DRIVER=CDC_MBIM & DRIVER=CDC_ETHER
	PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
	PVCUT=$(echo $PV | awk -F "$1" '{print $2}' | cut -c-$2)
	if echo "$PVCUT" | grep -q "Driver=qmi_wwan"
	then
	    PROTO="qmi"
	elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"
	then
	    PROTO="mbim"
	elif echo "$PVCUT" | grep -q "Driver=cdc_ether"
	then
	    PROTO="ecm"
	elif [ "$3" = rndis ] && echo "$PVCUT" | grep -q "Driver=rndis_host"
	then
	    PROTO="ncm"
	fi
}

_q5_c5greg() {
	O=$(sms_tool -d $DEVICE at "at+c5greg=2;+c5greg?")

	# C5GREG
	if [ "$1" = reset ]; then
		shift
		T=""
		TAC_HEX=""
		CID_HEX=""
		TAC_DEC=""
	fi
	eval $(echo "$O" | "$@" -F[,] '/^\+C5GREG/ {gsub(/[[:space:]"]+/,"");printf "T=\"%d\";TAC_HEX=\"%X\";CID_HEX=\"%s\";TAC_DEC=\"%d\";MODE_NUM=\"%d\"", $2, "0x"$3, $4, "0x"$3, $5}')
	case "$T" in
		0*) REG="0";;
		1*) REG="1";;
		2*) REG="2";;
		3*) REG="3";;
		5*) REG="5";;
		*) REG="";;
	esac
	[ "x$REG" = "x1" ] || [ "x$REG" = "x5" ] && REGOK=1

	[ "$TAC_DEC" != "0" ]
	[ -n "$CID_HEX" ] && CID_DEC=$(printf "%d" "0x${CID_HEX}")
}

_q5_on() {
	case " $_q5_f " in
		*" $1 "*) return 0;;
	esac
	return 1
}

_q5_ots() {
	OTS=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | awk '{v=$1; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/ && v+0 >= -30 && v+0 <= 50) print v; exit}')
#	OTS=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | xargs)
	SINR=$OTS

	TDX=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14; exit}')
	TAC_DEC=$(case "$TDX" in ''|*[!0-9A-Fa-f]*) ;; *) printf "%d" "0x$TDX";; esac)
	TAC_HEX=$TDX
}

_q5_lte() {
	T=$(echo "$1" | awk -F[,:] -v f="$2" '/^\+QENG:/ {print $f; exit}')
	_q5_v=$(case "$T" in ''|*[!0-9A-Fa-f]*) ;; *) printf "%d" "0x$T";; esac)
	eval "${6}_DEC=\$_q5_v; ${6}_HEX=\$T"
	T=$(echo "$1" | awk -F[,:] -v f="$3" '/^\+QENG:/ {print $f; exit}' | awk '{v=$1; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/ && v+0 >= -30 && v+0 <= 50) print v; exit}')
#	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | xargs)
	SINR="$T"
	T=$(echo "$1" | awk -F[,:] -v f="$4" '/^\+QENG:/ {print $f; exit}')
	_qc_lbwp T1 "$T" ""
	[ -n "$T1" ] && ULBW="UL: @$T1 MHz"
	T=$(echo "$1" | awk -F[,:] -v f="$5" '/^\+QENG:/ {print $f; exit}')
	_qc_lbwp T1 "$T" ""
	[ -n "$T1" ] && DLBW="DL: @$T1 MHz"
}

# УРОВНИ ПО КАЖДОЙ ВТОРИЧНОЙ НЕСУЩЕЙ.
#
# QCAINFO отдаёт их прямо в строке SCC, а код читал и выбрасывал: присвоения
# оставались от давно удалённого API `addon` (закомментированные строки).
# На форуме нормой считаются 3-5 несущих («1+1+3+3+78», 5 несущих на 85 МГц -
# #1145, #1398-1401, #2377, #2656), и без уровней таблица агрегации отвечала
# на вопрос «какая полоса» и молчала о том, живая ли она вообще.
#
# Раскладка LTE SCC подтверждена пятью независимыми живыми дампами
# (#487, #1364, #2378, #2383, #2545):
#   "SCC",<earfcn>,<bw>,"LTE BAND n",<state>,<pci>,<rsrp>,<rsrq>,<rssi>,
#         <sinr>[,<ul_cfg>,<ul_bw>,<ul_earfcn>]
# При разборе через -F[,:] это поля $3,$4,$5,$6,$7,$8,$9,$10,$11 - те самые,
# что уже брал код для earfcn/pci. Хвост после SINR прошивка заполняет
# прочерками («,0,-,-»), поэтому каждое значение проверяем на число и на
# физичный диапазон, иначе в карточку уедет «-».
# (ревью 13.09.2026, форум 4pda)
_sccnum() {   # $1 - имя переменной, $2 - значение, $3 - минимум, $4 - максимум
	# Пишем через eval, а не через echo в $(...): подстановка команды - это
	# ещё один форк на каждое из четырёх значений каждой несущей.
	eval "$1=''"
	case "$2" in
		''|'-'|*[!0-9-]*) return;;
	esac
	[ "$2" -ge "$3" ] 2>/dev/null || return
	[ "$2" -le "$4" ] 2>/dev/null || return
	eval "$1=\$2"
}
_sccsig() {   # $1 - номер несущей, дальше rsrp rsrq rssi sinr
	case "$1" in
		1) S1RSRP="$2"; S1RSRQ="$3"; S1RSSI="$4"; S1SINR="$5";;
		2) S2RSRP="$2"; S2RSRQ="$3"; S2RSSI="$4"; S2SINR="$5";;
		3) S3RSRP="$2"; S3RSRQ="$3"; S3RSSI="$4"; S3SINR="$5";;
		4) S4RSRP="$2"; S4RSRQ="$3"; S4RSSI="$4"; S4SINR="$5";;
	esac
}

_q5_core() {
	_q5_f="$*"

	case "$MODE_NUM" in
		7*)
			if _q5_on mb; then
				MODE="LTE |"
				echo "$O" | grep -q -i "+QCAINFO.*SCC" && MODE="LTE_A"
			elif echo "$O" | grep -q -i "+QCAINFO.*SCC"; then
				MODE="LTE-A |"
			fi
			;;
		11*)
			MODE="5G SA |"
			;;
		13*)
			_q5_on mb && MODE="LTE |"
			if echo "$O" | grep -q -i "+QCAINFO.*NR5G"; then
				MODE="5G NSA |"
			else
				if echo "$O" | grep -q -i "+QCAINFO.*PCC.*LTE"; then
					_q5_on mb || MODE="LTE |"

					_q5_ots

					if echo "$O" | grep -q -i "+QCAINFO.*SCC"; then
						MODE="LTE-A |"

						_q5_ots
					fi
				fi
			fi
			;;
	esac

	T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $5}')
	if [ -n "$T" ]; then
		case $T in
			*"LTE BAND"*)
				B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
				MODE="$MODE $(band4g ${B})"
				;;
			*"NR5G BAND"*)
				B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
				MODE="$MODE $(band5g ${B})"
				;;
			*"NR N"*)
				if _q5_on nrn; then
					B=$(echo $T | sed 's/NR N\(.*\)/\1/')
					MODE="$MODE $(band5g ${B})"
				fi
				;;
		esac

		T1=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{gsub(" ", "-");print $5}')
		if [ -n "$T1" ]; then
			for T in $T1; do
				case $T in
					*"LTE-BAND"*)
						B=$(echo $T | sed 's/"LTE-BAND-\(.*\)"/\1/')
						MODE="$MODE / $(band4g ${B})"
						;;
					*"NR5G-BAND"*)
						B=$(echo $T | sed 's/"NR5G-BAND-\(.*\)"/\1/')
						MODE="$MODE / $(band5g ${B})"
						;;
					*"NR-N"*)
						if _q5_on nrn; then
							B=$(echo $T | sed 's/NR-N\(.*\)/\1/')
							MODE="$MODE / $(band5g ${B})"
						fi
						;;
				esac
			done
		fi
	elif _q5_on qnw; then
		case "$MODE_NUM" in
			7 | 13)
				T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO:.*LTE.*/{print $4}')
				if [ -n "$T" ]; then
					B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
					MODE="$MODE $(band4g ${B})"
				fi
				;;
			11*)
				T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO:.*NR5G.*/{print $4}')
				if [ -n "$T" ]; then
					B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
					MODE="$MODE $(band5g ${B})"
				fi
				;;
		esac
	fi

	if [ "x$MODE_NUM" = "x7" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4; exit}' | xargs)
		if [ "x$T" = "xLTE" ]; then
			_q5_lte "$O" 14 18 12 13 TAC
		fi
	fi

	if [ "x$MODE_NUM" = "x11" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4; exit}' | xargs)
		if [ "x$T" = "xNR5G-SA" ]; then
			T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $8; exit}')
			if [ -n "$T" ]; then
				CID_HEX=$T
				CID_DEC=$(printf "%d" "0x${CID_HEX}")
			fi
#			T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $9; exit}')
#			[ -n "$T" ] && PCI="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13; exit}')
			_qc_nbw BW "$T" ""
			[ -n "$BW" ] && DBW="@$BW MHz"
			T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14; exit}')
			if [ -n "$T" ]; then
				RSRP="$T"
				if [ -n "$BW" ]; then
					N=$((BW * 5))
					RSSI=$(echo "$T $N" | awk '{printf "%d\n", $1 + 10*log(12*$2)/log(10)}')
					if [ -n "$RSSI" ]; then
						[ "$RSSI" -lt -113 ] && RSSI="-113"
						[ "$RSSI" -gt -51 ] && RSSI="-51"
						RSSI="$RSSI"
						[ -z "$CSQ_PER" ] && CSQ_PER=$(((RSSI + 113) * 100 / 62 ))
						[ -z "$CSQ" ] && CSQ=$(((31 * CSQ_PER) / 100))
					fi
				fi
			fi
			T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $15; exit}')
			[ -n "$T" ] && RSRQ="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $16; exit}')
			[ -n "$T" ] && SINR="$T"
		fi
	fi

	IFS="
"

	if [ "x$MODE_NUM" = "x13" ]; then
		LINES=$(echo "$O" | grep "+QENG")
		for LINE in $LINES; do
			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/{print $2; exit}' | xargs)
			if [ "x$T" = "xLTE" ]; then
				_q5_lte "$LINE" 12 16 10 11 TAC
			elif [ "x$T" = "xservingcell" ]; then
				if [ "x${MODE:0:3}" = "xLTE" ]; then
					_q5_lte "$O" 14 18 12 13 T
				fi
			fi
		done
	fi

	T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $5}')
	if [ -n "$T" ]; then
		case $T in
			*"LTE BAND"*)
				B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
				T2=$(band4g ${B})
				;;
			*"NR5G BAND"*)
				B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
				T2=$(band5g ${B})
				;;
			*"NR N"*)
				if _q5_on nrn2; then
					B=$(echo $T | sed 's/NR N\(.*\)/\1/')
					T2=$(band5g ${B})
				fi
				;;
		esac
		T3=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $4}')
		_qc_cbwp T4 "$T3" ""
		if [ -z "$T4" ]; then
			PBAND="$T2"
				if [ -n "$DBW" ]; then
				PBAND="$T2 $DBW"
			fi
		else
			PBAND="$T2 @$T4 MHz"
		fi
		if [ "x$MODE_NUM" = "x11" ]; then
			T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $3}')
			[ -n "$T" ] && EARFCN="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $6}' | xargs)
			[ -n "$T" ] && PCI="$T"
		else
			T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $3}')
			[ -n "$T" ] && EARFCN="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $7}')
			[ -n "$T" ] && PCI="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $10}')
			[ -n "$T" ] && RSSI="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $8}')
			[ -n "$T" ] && RSRP="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $9}')
			[ -n "$T" ] && RSRQ="$T"
			if _q5_on scclev; then
				# SINR - ИЗ QCAINFO, а не из QENG: у SDX62 поле SINR обслуживающей соты
				# в QENG отдаёт 0, тогда как последнее поле PCC в QCAINFO той же сессии
				# показывает 8 дБ (живой дамп с форума 4pda, ревью RM520N 13.09.2026).
				# Целые дБ как есть; QENG остаётся запасным вариантом выше.
				T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{v=$11; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/) print v; exit}')
				[ -n "$T" ] && SINR="$T"
			fi
		fi

		IDX=1
		LINES=$(echo "$O" | grep -E "^\+QCAINFO: \"(scc|SCC)\"")
		for LINE in $LINES; do

			T=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $5}')
			T3=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $4}')
			T4=""
			case $T in
				*"LTE BAND"*)
					B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
					T2=$(band4g ${B})
					_qc_cbwp T4 "$T3" ""
					T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $3}' | xargs)
					[ -n "$T5" ] && _qc_s $IDX EARFCN "$T5"

					T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $7}' | xargs)
					[ -n "$T5" ] && _qc_s $IDX PCI "$T5"

					if _q5_on scclev; then
						# Четыре уровня - ОДНИМ awk, а не четырьмя: цикл крутится на
						# каждом опросе по числу несущих (до пяти), и прежние три awk
						# на несущую стоили полтора десятка форков впустую. Пустое поле
						# заменяем прочерком ПРЯМО В AWK: без этого два пробела подряд
						# схлопнулись бы при разборе и уровни уехали бы на поле влево.
						T5=$(echo "$LINE" | tr -d '\r' | awk -F[,:] '{
							for (i = 8; i <= 11; i++) printf "%s%s", ($i == "" ? "-" : $i), (i < 11 ? " " : "\n")
						}')
						_oIFS=$IFS; IFS=' '; set -- $T5; IFS=$_oIFS
						_sccnum _S_RSRP "$1" -160 -30
						_sccnum _S_RSRQ "$2" -40 0
						_sccnum _S_RSSI "$3" -160 -10
						_sccnum _S_SINR "$4" -30 50
						_sccsig "$IDX" "$_S_RSRP" "$_S_RSRQ" "$_S_RSSI" "$_S_SINR"
					else
						T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $10}' | xargs)
#						[ -n "$T5" ] && addon $((POS + 5)) "(S${IDX}) RSSI" "$T5 dBm"

						T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $8}' | xargs)
#						[ -n "$T5" ] && addon $((POS + 6)) "(S${IDX}) RSRP" "$T5 dBm"

						T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $9}' | xargs)
#						[ -n "$T5" ] && addon $((POS + 7)) "(S${IDX}) RSRQ" "$T5 dB"
					fi
					;;
				*"NR5G BAND"*)
					B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
					T2=$(band5g ${B})
					_qc_nbw T4 "$T3" ""
					T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $3}')
					[ -n "$T5" ] && _qc_s $IDX EARFCN "$T5"

					if [ "x$MODE_NUM" = "x11" ]; then
						T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $7}' | xargs)
						if [ -n "$T5" ] && [ "$T5" != "-" ]; then
							_qc_s $IDX PCI "$T5"
						fi

						if _q5_on scclev; then
							# УРОВНЕЙ ПО NR-НЕСУЩЕЙ НЕ ЗАПОЛНЯЕМ. В теме нет ни одного
							# живого дампа QCAINFO в SA, где у строки NR5G были бы
							# уровни: закомментированные $8/$9 пришли из чужого кода и
							# сверить их не с чем. Угадывать позиции - значит рисовать
							# чужой RSRP (ревью 13.09.2026, форум 4pda).
							:
						else
							T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $8}')
#							[ -n "$T5" ] && [ "$T5" != "-" ] && addon $((POS + 6)) "(S${IDX}) RSRP" "$T5 dBm"
							T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $9}')
#							[ -n "$T5" ] && [ "$T5" != "-" ] && addon $((POS + 7)) "(S${IDX}) RSRQ" "$T5 dB"
						fi
					else
						T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $6}' | xargs)
						[ -n "$T5" ] && _qc_s $IDX PCI "$T5"
						if _q5_on scclev; then
							# NR-НЕСУЩАЯ В NSA УРОВНЕЙ НЕ НЕСЁТ ВОВСЕ. Единственный
							# живой дамп такой строки в теме - `+QCAINFO: "SCC",643320,
							# 12,"NR5G BAND 78",145` (#487): пять полей, дальше ничего.
							# Поэтому заполняем только то, что там есть, - ARFCN, полосу
							# и PCI (выше), а RSRP/RSRQ/RSSI/SINR оставляем пустыми:
							# уровни 5G в NSA приходится смотреть по LTE-якорю.
							# (ревью 13.09.2026, форум 4pda)
							:
						else
							T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $7}')
#							[ -n "$T5" ] && [ "$T5" != "-" ] && addon $((POS + 6)) "(S${IDX}) RSRP" "$T5 dBm"
							T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $8}')
#							[ -n "$T5" ] && [ "$T5" != "-" ] && addon $((POS + 7)) "(S${IDX}) RSRQ" "$T5 dB"
						fi
					fi
					;;
			esac
			if [ -z "$T4" ]; then
				_qc_s $IDX BAND "$T2"
			else
				_qc_s $IDX BAND "$T2 @$T4 MHz"
			fi

			IDX=$((IDX + 1))
		done
	fi
}

_qc_neighbours() {
	[ -z "$NEIGHBORS" ] || return 0
	_NB=$(sms_tool -d $DEVICE at "AT+QENG=\"neighbourcell\"" 2>/dev/null | tr -d '\r')
	NEIGHBORS=$(echo "$_NB" | awk -v spci="$PCI" -v sear="$EARFCN" -v only="$1" -F, '
		function ch2band(c) {
			if (c <= 599) return 1;      if (c <= 1199) return 2
			if (c <= 1949) return 3;     if (c <= 2399) return 4
			if (c <= 2649) return 5;     if (c >= 2750 && c <= 3449) return 7
			if (c >= 3450 && c <= 3799) return 8
			if (c >= 5010 && c <= 5179) return 12;  if (c >= 5180 && c <= 5279) return 13
			if (c >= 5280 && c <= 5379) return 14;  if (c >= 5730 && c <= 5849) return 17
			if (c >= 5850 && c <= 5999) return 18;  if (c >= 6000 && c <= 6149) return 19
			if (c >= 6150 && c <= 6449) return 20
			if (c >= 8040 && c <= 8689) return 25;  if (c >= 8690 && c <= 9039) return 26
			if (c >= 9210 && c <= 9659) return 28;  if (c >= 9660 && c <= 9769) return 29
			if (c >= 9770 && c <= 9869) return 30;  if (c >= 9920 && c <= 10359) return 32
			if (c >= 36200 && c <= 36349) return 34
			if (c >= 37750 && c <= 38249) return 38; if (c >= 38250 && c <= 38649) return 39
			if (c >= 38650 && c <= 39649) return 40; if (c >= 39650 && c <= 41589) return 41
			if (c >= 41590 && c <= 43589) return 42; if (c >= 43590 && c <= 45589) return 43
			if (c >= 46790 && c <= 54539) return 46; if (c >= 55240 && c <= 56739) return 48
			if (c >= 66436 && c <= 67335) return 66; if (c >= 68586 && c <= 68935) return 71
			return 0
		}
		/^\+QENG: "neighbourcell/ {
			gsub(/"/, "", $2)
			if ($2 != "LTE") next
			if (NF < 7) next
			earfcn = $3 + 0; pci = $4 + 0; rsrq = $5 + 0; rsrp = $6 + 0; rssi = $7 + 0
			if (earfcn == 0 || rsrp == 0) next
			b = ch2band(earfcn)
			if (b && only != "" && index(" " only " ", " " b " ") == 0) b = 0
			if (n++) printf ","
			sv = (spci != "" && sear != "" && pci == spci+0 && earfcn == sear+0) ? "true" : "false"
			printf "{\"band\":\"%s\",\"earfcn\":\"%d\",\"pci\":\"%d\",\"rsrp\":\"%d\",\"rsrq\":\"%d\",\"rssi\":\"%d\",\"serving\":%s}", (b ? b : ""), earfcn, pci, rsrp, rsrq, rssi, sv
		}')
}
