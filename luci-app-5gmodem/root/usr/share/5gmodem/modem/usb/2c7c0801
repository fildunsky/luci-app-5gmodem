# Quectel RM520N-GL (2c7c:0801; RM521F-GL - по общему руководству AT-команд, свой PID в теме не подтверждён)

O=$(sms_tool -d $DEVICE at "at+qtemp")

T=$(echo "$O" | awk -F[,:] '/^\+QTEMP/ {print $3}' | tr -d '"' | sort -rn | head -n1 | xargs)
[ -n "$T" ] && TEMP="$T &deg;C"

if [ -z "$REG" ] || [ "x$MODE_NUM" = "x11" ]; then
	O=$(sms_tool -d $DEVICE at "at+c5greg=2;+c5greg?")

	# C5GREG
	T=""
	TAC_HEX=""
	CID_HEX=""
	TAC_DEC=""
	eval $(echo "$O" | busybox awk -F[,] '/^\+C5GREG/ {gsub(/[[:space:]"]+/,"");printf "T=\"%d\";TAC_HEX=\"%X\";CID_HEX=\"%s\";TAC_DEC=\"%d\";MODE_NUM=\"%d\"", $2, "0x"$3, $4, "0x"$3, $5}')
	case "$T" in
		0*) REG="0";;
		1*) REG="1";;
		2*) REG="2";;
		3*) REG="3";;
		5*) REG="5";;
		*) REG="";;
	esac
	[ "x$REG" = "x1" ] || [ "x$REG" = "x5" ] && REGOK=1

	[ -n "$TAC_DEC" ] && [ "$TAC_DEC" != "0" ] && TAC_DEC="${TAC_DEC}"
	[ -n "$CID_HEX" ] && CID_DEC=$(printf "%d" "0x${CID_HEX}")
fi

if [ "$REGOK" = "1" ]; then

O=$(sms_tool -d $DEVICE at "at+qnwinfo;+qcainfo;+qeng=\"servingcell\";+qspn")

T=$(echo "$O" | awk -F[,:] '/^\+QSPN/ {print $2}' | xargs)
if [ -n "$T" ] && [ -z "$FORCE_PLMN" ]; then
	COPS="$T"
fi

# ИДЕНТИФИКАТОР СОТЫ - ИЗ УЖЕ ПОЛУЧЕННОГО QENG, БЕЗ ВТОРОГО ЗАХОДА В ПОРТ.
# Раньше поле бралось как 5-е по запятым - в сплошной раскладке
# +QENG: "servingcell","NOCONN","LTE","FDD",250,11,4E23802,... это MCC (250),
# и в карточку уезжала «сота 592». Раскладок две: сплошная (сота - 7-е поле)
# и NSA-разнесённая +QENG: "LTE",... (сота - 5-е) (ревью RM520N 13.09.2026,
# живой ответ с форума 4pda).
if [ "$CID_HEX" = "0" ] || [ -z "$CID_HEX" ]; then
	T=$(echo "$O" | tr -d '\r' | awk -F, '/^\+QENG: "servingcell",.*"LTE"/ {print $7; exit} /^\+QENG: "LTE",/ {print $5; exit}' | tr -cd '0-9A-Fa-f')
	if [ -n "$T" ]; then
		CID_HEX="$T"
		CID_DEC=$(printf "%d" "0x$T" 2>/dev/null)
	fi
fi


case "$MODE_NUM" in
	7*)
		MODE="LTE |"
		echo "$O" | grep -q -i "+QCAINFO.*SCC" && MODE="LTE_A"
		;;
	11*)
		MODE="5G SA |"
		;;
	13*)
		MODE="LTE |"
		if echo "$O" | grep -q -i "+QCAINFO.*NR5G"; then
			MODE="5G NSA |"
		else
			if echo "$O" | grep -q -i "+QCAINFO.*PCC.*LTE"; then

					OTS=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | awk '{v=$1; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/ && v+0 >= -30 && v+0 <= 50) print v; exit}')
#					OTS=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | xargs)
					SINR=$OTS

					TDX=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14; exit}')
					TAC_DEC=$(case "$TDX" in ''|*[!0-9A-Fa-f]*) ;; *) printf "%d" "0x$TDX";; esac)
					TAC_HEX=$TDX

				if echo "$O" | grep -q -i "+QCAINFO.*SCC"; then
					MODE="LTE-A |"

						OTS=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | awk '{v=$1; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/ && v+0 >= -30 && v+0 <= 50) print v; exit}')
#						OTS=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | xargs)
						SINR=$OTS

						TDX=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14; exit}')
						TAC_DEC=$(case "$TDX" in ''|*[!0-9A-Fa-f]*) ;; *) printf "%d" "0x$TDX";; esac)
						TAC_HEX=$TDX
				fi
			fi
		fi
		;;
esac

T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $5}')
if [ -n "$T" ]; then
	case $T in
		*"LTE BAND"*)
			B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
			MODE="$MODE $(band4g ${B})"
			;;
		*"NR N"*)
			B=$(echo $T | sed 's/NR N\(.*\)/\1/')
			MODE="$MODE $(band5g ${B})"
			;;
		*"NR5G BAND"*)
			B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
			MODE="$MODE $(band5g ${B})"
			;;
	esac

	T1=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{gsub(" ", "-");print $5}')
	if [ -n "$T1" ]; then
		for T in $T1; do
			case $T in
				*"LTE-BAND"*)
					B=$(echo $T | sed 's/"LTE-BAND-\(.*\)"/\1/')
					MODE="$MODE / $(band4g ${B})"
					;;
				*"NR-N"*)
					B=$(echo $T | sed 's/NR-N\(.*\)/\1/')
					MODE="$MODE / $(band5g ${B})"
					;;
				*"NR5G-BAND"*)
					B=$(echo $T | sed 's/"NR5G-BAND-\(.*\)"/\1/')
					MODE="$MODE / $(band5g ${B})"
					;;
			esac
		done
	fi
else
	case "$MODE_NUM" in
		7 | 13)
			T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO:.*LTE.*/{print $4}')
			if [ -n "$T" ]; then
				B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
				MODE="$MODE $(band4g ${B})"
			fi
			;;
		11*)
			T=$(echo "$O" | awk -F[,:] '/^\+QNWINFO:.*NR5G.*/{print $4}')
			if [ -n "$T" ]; then
				B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
				MODE="$MODE $(band5g ${B})"
			fi
			;;
	esac
fi

if [ "x$MODE_NUM" = "x7" ]; then
	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4; exit}' | xargs)
	if [ "x$T" = "xLTE" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14; exit}')
		TAC_DEC=$(case "$T" in ''|*[!0-9A-Fa-f]*) ;; *) printf "%d" "0x$T";; esac)
		TAC_HEX="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | awk '{v=$1; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/ && v+0 >= -30 && v+0 <= 50) print v; exit}')
#		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | xargs)
		SINR="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $12; exit}')
		case $T in
			0*) T1="1.4";;
			1*) T1="3";;
			2*) T1="5";;
			3*) T1="10";;
			4*) T1="15";;
			5*) T1="20";;
			*) T1="";;
		esac
		[ -n "$T1" ] && ULBW="UL: @$T1 MHz"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13; exit}')
		case $T in
			0*) T1="1.4";;
			1*) T1="3";;
			2*) T1="5";;
			3*) T1="10";;
			4*) T1="15";;
			5*) T1="20";;
			*) T1="";;
		esac
		[ -n "$T1" ] && DLBW="DL: @$T1 MHz"
	fi
fi

if [ "x$MODE_NUM" = "x11" ]; then
	T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $4; exit}' | xargs)
	if [ "x$T" = "xNR5G-SA" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $8; exit}')
		if [ -n "$T" ]; then
			CID_HEX=$T
			CID_DEC=$(printf "%d" "0x${CID_HEX}")
		fi
#		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $9; exit}')
#		[ -n "$T" ] && PCI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13; exit}')
		case $T in
			0) BW="5";;
			1) BW="10";;
			2) BW="15";;
			3) BW="20";;
			4) BW="25";;
			5) BW="30";;
			6) BW="40";;
			7) BW="50";;
			8) BW="60";;
			9) BW="70";;
			10) BW="80";;
			11) BW="90";;
			12) BW="100";;
			13) BW="200";;
			14) BW="400";;
			*) BW="";;
		esac
		[ -n "$BW" ] && DBW="@$BW MHz"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14; exit}')
		if [ -n "$T" ]; then
			RSRP="$T"
			if [ -n "$BW" ]; then
				N=$((BW * 5))
				RSSI=$(echo "$T $N" | awk '{printf "%d\n", $1 + 10*log(12*$2)/log(10)}')
				if [ -n "$RSSI" ]; then
					[ "$RSSI" -lt -113 ] && RSSI="-113"
					[ "$RSSI" -gt -51 ] && RSSI="-51"
					RSSI="$RSSI"
					[ -z "$CSQ_PER" ] && CSQ_PER=$(((RSSI + 113) * 100 / 62 ))
					[ -z "$CSQ" ] && CSQ=$(((31 * CSQ_PER) / 100))
				fi
			fi
		fi
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $15; exit}')
		[ -n "$T" ] && RSRQ="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $16; exit}')
		[ -n "$T" ] && SINR="$T"
	fi
fi

IFS="
"

if [ "x$MODE_NUM" = "x13" ]; then
	LINES=$(echo "$O" | grep "+QENG")
	for LINE in $LINES; do
		T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/{print $2; exit}' | xargs)
		if [ "x$T" = "xLTE" ]; then
			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $12; exit}')
			TAC_DEC=$(case "$T" in ''|*[!0-9A-Fa-f]*) ;; *) printf "%d" "0x$T";; esac)
			TAC_HEX=$T

			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $16; exit}' | awk '{v=$1; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/ && v+0 >= -30 && v+0 <= 50) print v; exit}')
#			T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | xargs)
			SINR="$T"
			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $10; exit}')
			case $T in
				0*) T1="1.4";;
				1*) T1="3";;
				2*) T1="5";;
				3*) T1="10";;
				4*) T1="15";;
				5*) T1="20";;
				*) T1="";;
			esac
			[ -n "$T1" ] && ULBW="UL: @$T1 MHz"
			T=$(echo "$LINE" | awk -F[,:] '/^\+QENG:/ {print $11; exit}')
			case $T in
				0*) T1="1.4";;
				1*) T1="3";;
				2*) T1="5";;
				3*) T1="10";;
				4*) T1="15";;
				5*) T1="20";;
				*) T1="";;
			esac
			[ -n "$T1" ] && DLBW="DL: @$T1 MHz"
			elif [ "x$T" = "xservingcell" ]; then
			if [ "x${MODE:0:3}" = "xLTE" ]; then
				T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $14; exit}')
				T_DEC=$(case "$T" in ''|*[!0-9A-Fa-f]*) ;; *) printf "%d" "0x$T";; esac)
				T_HEX="$T"
				T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | awk '{v=$1; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/ && v+0 >= -30 && v+0 <= 50) print v; exit}')
#				T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $18; exit}' | xargs)
				SINR="$T"
				T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $12; exit}')
				case $T in
					0*) T1="1.4";;
					1*) T1="3";;
					2*) T1="5";;
					3*) T1="10";;
					4*) T1="15";;
					5*) T1="20";;
					*) T1="";;
				esac
				[ -n "$T1" ] && ULBW="UL: @$T1 MHz"
				T=$(echo "$O" | awk -F[,:] '/^\+QENG:/ {print $13; exit}')
				case $T in
					0*) T1="1.4";;
					1*) T1="3";;
					2*) T1="5";;
					3*) T1="10";;
					4*) T1="15";;
					5*) T1="20";;
					*) T1="";;
				esac
				[ -n "$T1" ] && DLBW="DL: @$T1 MHz"
			fi
		fi
	done
fi

T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $5}')
if [ -n "$T" ]; then
	case $T in
		*"LTE BAND"*)
			B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
			T2=$(band4g ${B})
			;;
		*"NR5G BAND"*)
			B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
			T2=$(band5g ${B})
			;;
	esac
	T3=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $4}')
	case $T3 in
		6*) T4="1.4";;
		15*) T4="3";;
		25*) T4="5";;
		50*) T4="10";;
		75*) T4="15";;
		100*) T4="20";;
		*) T4="";;
	esac
	if [ -z "$T4" ]; then
		PBAND="$T2"
			if [ -n "$DBW" ]; then
			PBAND="$T2 $DBW"
		fi
	else
		PBAND="$T2 @$T4 MHz"
	fi
	if [ "x$MODE_NUM" = "x11" ]; then
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $3}')
		[ -n "$T" ] && EARFCN="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $6}' | xargs)
		[ -n "$T" ] && PCI="$T"
	else
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $3}')
		[ -n "$T" ] && EARFCN="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $7}')
		[ -n "$T" ] && PCI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $10}')
		[ -n "$T" ] && RSSI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $8}')
		[ -n "$T" ] && RSRP="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{print $9}')
		[ -n "$T" ] && RSRQ="$T"
		# SINR - ИЗ QCAINFO, а не из QENG: у SDX62 поле SINR обслуживающей соты
		# в QENG отдаёт 0, тогда как последнее поле PCC в QCAINFO той же сессии
		# показывает 8 дБ (живой дамп с форума 4pda, ревью RM520N 13.09.2026).
		# Целые дБ как есть; QENG остаётся запасным вариантом выше.
		T=$(echo "$O" | awk -F[,:] '/^\+QCAINFO: "(pcc|PCC)"/{v=$11; gsub(/[^0-9-]/,"",v); if (v ~ /^-?[0-9]+$/) print v; exit}')
		[ -n "$T" ] && SINR="$T"
	fi

	# УРОВНИ ПО КАЖДОЙ ВТОРИЧНОЙ НЕСУЩЕЙ.
	#
	# QCAINFO отдаёт их прямо в строке SCC, а код читал и выбрасывал: присвоения
	# оставались от давно удалённого API `addon` (закомментированные строки).
	# На форуме нормой считаются 3-5 несущих («1+1+3+3+78», 5 несущих на 85 МГц -
	# #1145, #1398-1401, #2377, #2656), и без уровней таблица агрегации отвечала
	# на вопрос «какая полоса» и молчала о том, живая ли она вообще.
	#
	# Раскладка LTE SCC подтверждена пятью независимыми живыми дампами
	# (#487, #1364, #2378, #2383, #2545):
	#   "SCC",<earfcn>,<bw>,"LTE BAND n",<state>,<pci>,<rsrp>,<rsrq>,<rssi>,
	#         <sinr>[,<ul_cfg>,<ul_bw>,<ul_earfcn>]
	# При разборе через -F[,:] это поля $3,$4,$5,$6,$7,$8,$9,$10,$11 - те самые,
	# что уже брал код для earfcn/pci. Хвост после SINR прошивка заполняет
	# прочерками («,0,-,-»), поэтому каждое значение проверяем на число и на
	# физичный диапазон, иначе в карточку уедет «-».
	# (ревью 13.09.2026, форум 4pda)
	_sccnum() {   # $1 - имя переменной, $2 - значение, $3 - минимум, $4 - максимум
		# Пишем через eval, а не через echo в $(...): подстановка команды - это
		# ещё один форк на каждое из четырёх значений каждой несущей.
		eval "$1=''"
		case "$2" in
			''|'-'|*[!0-9-]*) return;;
		esac
		[ "$2" -ge "$3" ] 2>/dev/null || return
		[ "$2" -le "$4" ] 2>/dev/null || return
		eval "$1=\$2"
	}
	_sccsig() {   # $1 - номер несущей, дальше rsrp rsrq rssi sinr
		case "$1" in
			1) S1RSRP="$2"; S1RSRQ="$3"; S1RSSI="$4"; S1SINR="$5";;
			2) S2RSRP="$2"; S2RSRQ="$3"; S2RSSI="$4"; S2SINR="$5";;
			3) S3RSRP="$2"; S3RSRQ="$3"; S3RSSI="$4"; S3SINR="$5";;
			4) S4RSRP="$2"; S4RSRQ="$3"; S4RSSI="$4"; S4SINR="$5";;
		esac
	}

	IDX=1
	LINES=$(echo "$O" | grep -E "^\+QCAINFO: \"(scc|SCC)\"")
	for LINE in $LINES; do

		T=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $5}')
		T3=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $4}')
		T4=""
		case $T in
			*"LTE BAND"*)
				B=$(echo $T | sed 's/"LTE BAND \(.*\)"/\1/')
				T2=$(band4g ${B})
				case $T3 in
					6*) T4="1.4";;
					15*) T4="3";;
					25*) T4="5";;
					50*) T4="10";;
					75*) T4="15";;
					100*) T4="20";;
					*) T4="";;
				esac
				T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $3}' | xargs)
				if [ -n "$T5" ]; then
					case $IDX in
					1) S1EARFCN="$T5";;
					2) S2EARFCN="$T5";;
					3) S3EARFCN="$T5";;
					4) S4EARFCN="$T5";;
					*) ;;
					esac
				fi
				
				T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $7}' | xargs)
				if [ -n "$T5" ]; then
					case $IDX in
					1) S1PCI="$T5";;
					2) S2PCI="$T5";;
					3) S3PCI="$T5";;
					4) S4PCI="$T5";;
					*) ;;
					esac
				fi
				
				# Четыре уровня - ОДНИМ awk, а не четырьмя: цикл крутится на
				# каждом опросе по числу несущих (до пяти), и прежние три awk
				# на несущую стоили полтора десятка форков впустую. Пустое поле
				# заменяем прочерком ПРЯМО В AWK: без этого два пробела подряд
				# схлопнулись бы при разборе и уровни уехали бы на поле влево.
				T5=$(echo "$LINE" | tr -d '\r' | awk -F[,:] '{
					for (i = 8; i <= 11; i++) printf "%s%s", ($i == "" ? "-" : $i), (i < 11 ? " " : "\n")
				}')
				_oIFS=$IFS; IFS=' '; set -- $T5; IFS=$_oIFS
				_sccnum _S_RSRP "$1" -160 -30
				_sccnum _S_RSRQ "$2" -40 0
				_sccnum _S_RSSI "$3" -160 -10
				_sccnum _S_SINR "$4" -30 50
				_sccsig "$IDX" "$_S_RSRP" "$_S_RSRQ" "$_S_RSSI" "$_S_SINR"
				;;
			*"NR5G BAND"*)
				B=$(echo $T | sed 's/"NR5G BAND \(.*\)"/\1/')
				T2=$(band5g ${B})
				case $T3 in
					0) T4="5";;
					1) T4="10";;
					2) T4="15";;
					3) T4="20";;
					4) T4="25";;
					5) T4="30";;
					6) T4="40";;
					7) T4="50";;
					8) T4="60";;
					9) T4="70";;
					10) T4="80";;
					11) T4="90";;
					12) T4="100";;
					13) T4="200";;
					14) T4="400";;
					*) T4="";;
				esac
				T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $3}')
				[ -n "$T5" ]
				if [ -n "$T5" ]; then
						case $IDX in
				            	1) S1EARFCN="$T5";;
				            	2) S2EARFCN="$T5";;
				            	3) S3EARFCN="$T5";;
				            	4) S4EARFCN="$T5";;
						*) ;;
						esac
					fi
				
				if [ "x$MODE_NUM" = "x11" ]; then
					T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $7}' | xargs)
					if [ -n "$T5" ] && [ "$T5" != "-" ]; then
			                case $IDX in
				                1) S1PCI="$T5";;
				                2) S2PCI="$T5";;
				                3) S3PCI="$T5";;
				                4) S4PCI="$T5";;
				                *) ;;
			                esac
		            		fi
					
					# УРОВНЕЙ ПО NR-НЕСУЩЕЙ НЕ ЗАПОЛНЯЕМ. В теме нет ни одного
					# живого дампа QCAINFO в SA, где у строки NR5G были бы
					# уровни: закомментированные $8/$9 пришли из чужого кода и
					# сверить их не с чем. Угадывать позиции - значит рисовать
					# чужой RSRP (ревью 13.09.2026, форум 4pda).
				else
					T5=$(echo "$LINE" | awk -F[,:] '/^\+QCAINFO: "(scc|SCC)"/{print $6}' | xargs)
						if [ -n "$T5" ]; then
							case $IDX in
							1) S1PCI="$T5";;
							2) S2PCI="$T5";;
							3) S3PCI="$T5";;
							4) S4PCI="$T5";;
							*) ;;
							esac
						fi
					# NR-НЕСУЩАЯ В NSA УРОВНЕЙ НЕ НЕСЁТ ВОВСЕ. Единственный
					# живой дамп такой строки в теме - `+QCAINFO: "SCC",643320,
					# 12,"NR5G BAND 78",145` (#487): пять полей, дальше ничего.
					# Поэтому заполняем только то, что там есть, - ARFCN, полосу
					# и PCI (выше), а RSRP/RSRQ/RSSI/SINR оставляем пустыми:
					# уровни 5G в NSA приходится смотреть по LTE-якорю.
					# (ревью 13.09.2026, форум 4pda)
				fi
				;;
		esac
		if [ -z "$T4" ]; then
			case $IDX in
				1) S1BAND="$T2";;
				2) S2BAND="$T2";;
				3) S3BAND="$T2";;
				4) S4BAND="$T2";;
				*) ;;
			esac
		else
			case $IDX in
				1) S1BAND="$T2 @$T4 MHz";;
				2) S2BAND="$T2 @$T4 MHz";;
				3) S3BAND="$T2 @$T4 MHz";;
				4) S4BAND="$T2 @$T4 MHz";;
				*) ;;
			esac
		fi

		IDX=$((IDX + 1))
	done
fi

fi

# СОСЕДНИЕ СОТЫ - AT+QENG="neighbourcell", формат тот же, что у EP06:
#   +QENG: "neighbourcell intra","LTE",<earfcn>,<pci>,<rsrq>,<rsrp>,<rssi>,...
# (живой дамп RM520N с форума 4pda: intra 2850,136,-10,-100,-68 сходится с
# обслуживающей сотой - 5-е поле RSRQ, 6-е RSRP). Разбор перенесён из
# modem/usb/2c7c0306, таблица EARFCN->диапазон расширена до набора RM520N-GL
# (ревью RM520N 13.09.2026). Обслуживающая сота в списке есть - помечаем её.
if [ -z "$NEIGHBORS" ]; then
	_NB=$(sms_tool -d $DEVICE at "AT+QENG=\"neighbourcell\"" 2>/dev/null | tr -d '\r')
	NEIGHBORS=$(echo "$_NB" | awk -v spci="$PCI" -v sear="$EARFCN" -F, '
		function ch2band(c) {
			if (c <= 599) return 1;      if (c <= 1199) return 2
			if (c <= 1949) return 3;     if (c <= 2399) return 4
			if (c <= 2649) return 5;     if (c >= 2750 && c <= 3449) return 7
			if (c >= 3450 && c <= 3799) return 8
			if (c >= 5010 && c <= 5179) return 12;  if (c >= 5180 && c <= 5279) return 13
			if (c >= 5280 && c <= 5379) return 14;  if (c >= 5730 && c <= 5849) return 17
			if (c >= 5850 && c <= 5999) return 18;  if (c >= 6000 && c <= 6149) return 19
			if (c >= 6150 && c <= 6449) return 20
			if (c >= 8040 && c <= 8689) return 25;  if (c >= 8690 && c <= 9039) return 26
			if (c >= 9210 && c <= 9659) return 28;  if (c >= 9660 && c <= 9769) return 29
			if (c >= 9770 && c <= 9869) return 30;  if (c >= 9920 && c <= 10359) return 32
			if (c >= 36200 && c <= 36349) return 34
			if (c >= 37750 && c <= 38249) return 38; if (c >= 38250 && c <= 38649) return 39
			if (c >= 38650 && c <= 39649) return 40; if (c >= 39650 && c <= 41589) return 41
			if (c >= 41590 && c <= 43589) return 42; if (c >= 43590 && c <= 45589) return 43
			if (c >= 46790 && c <= 54539) return 46; if (c >= 55240 && c <= 56739) return 48
			if (c >= 66436 && c <= 67335) return 66; if (c >= 68586 && c <= 68935) return 71
			return 0
		}
		/^\+QENG: "neighbourcell/ {
			gsub(/"/, "", $2)
			if ($2 != "LTE") next
			if (NF < 7) next
			earfcn = $3 + 0; pci = $4 + 0; rsrq = $5 + 0; rsrp = $6 + 0; rssi = $7 + 0
			if (earfcn == 0 || rsrp == 0) next
			b = ch2band(earfcn)
			if (n++) printf ","
			sv = (spci != "" && sear != "" && pci == spci+0 && earfcn == sear+0) ? "true" : "false"
			printf "{\"band\":\"%s\",\"earfcn\":\"%d\",\"pci\":\"%d\",\"rsrp\":\"%d\",\"rsrq\":\"%d\",\"rssi\":\"%d\",\"serving\":%s}", (b ? b : ""), earfcn, pci, rsrp, rsrq, rssi, sv
		}')
fi

MODE=$(echo $MODE | sed 's,/,+,' | sed 's, / \(B[0-9]\), + \1,g' | sed 's,LTE B,LTE | B,' | sed 's,LTE_A,LTE-A,' | sed 's,LTE-A B,LTE-A | B,')

if [ "${LAC_DEC}" = "0" ]; then
	LAC_DEC="-"
	LAC_HEX="-"
fi

# Modem
FWA=$(sms_tool -d $DEVICE at "AT+GMR" | tr -s "\n" | xargs)
FW=$(echo $FWA | sed s/"AT+GMR "//)
# ПОЛНЫЙ БИЛД - AT+QGMR?: RM520NGLAAR03A03M4G_01.201.01.201. Только по нему
# видно ветку прошивки (R01A06 - без регионального блока, R03/«200/201/30x» -
# с блоком РФ), AT+GMR отдаёт короткую ревизию (форум 4pda, ревью 13.09.2026).
T=$(sms_tool -d $DEVICE at "AT+QGMR?" 2>/dev/null | tr -d '\r' | awk '/^[A-Z][A-Z0-9]+_[0-9][0-9.]*$/ {print; exit}')
[ -n "$T" ] && FW="$T"

MODELA=$(sms_tool -d $DEVICE at "AT+CGMM" | tr -s "\n" | xargs)
MODELB=$(sms_tool -d $DEVICE at "AT+CGMI" | tr -s "\n" | xargs)
MODELACUT=$(echo $MODELA | sed s/"AT+CGMM "//)
MODELBCUT=$(echo $MODELB | sed s/"AT+CGMI "//)
MODEL="$MODELBCUT "$MODELACUT

# Slot SIM
O=$(sms_tool -d $DEVICE at "AT+QUIMSLOT?")
T=$(echo "$O" | awk -F [:] '/^\+QUIMSLOT/{print $2}' | xargs)
if [ -n "$T" ]; then
	SSIM="$T"
fi

# International Mobile Equipment Identity (IMEI)
O=$(sms_tool -d $DEVICE at "AT+GSN" | xargs)
NR_I=$(echo "$O" | sed s/"AT+GSN "//)
if [ -n "$NR_I" ]; then
	NR_IMEI="$NR_I"
fi

# International Mobile Subscriber Identity (IMSI)
O=$(sms_tool -d $DEVICE at "AT+CIMI" | xargs)
NR_C=$(echo "$O" | sed s/"AT+CIMI "//)
if [ -n "$NR_C" ]; then
	NR_IMSI="$NR_C"
fi

#  Integrated Circuit Card Identifier (ICCID)
O=$(sms_tool -d $DEVICE at "AT+QCCID")
NR_D=$(echo "$O" | awk -F [:] '/^\+QCCID/{print $2}' | xargs)
if [ -n "$NR_D" ]; then
	NR_ICCID="$NR_D"
fi

# Protocol
# DRIVER=QMI_WWAN & DRIVER=CDC_MBIM & DRIVER=CDC_ETHER
# ДРАЙВЕР - ИЗ SYSFS СВОЕГО USB-ПУТИ. Разбор debugfs брал текст после ПЕРВОГО
# «Vendor=2c7c ProdID=0801» и резал по 1290 символам: при двух одинаковых
# модулях протокол приезжал от соседа, а без смонтированного debugfs не
# определялся вовсе (ревью RM520N 13.09.2026). debugfs остаётся запасным.
_QPROTO=""
if [ -n "$_POLL_AM" ] && [ -d "/sys/bus/usb/devices/$_POLL_AM" ]; then
	for _qi in "/sys/bus/usb/devices/$_POLL_AM":*/driver; do
		[ -L "$_qi" ] || continue
		case "$(readlink "$_qi" 2>/dev/null)" in
			*/qmi_wwan)  _QPROTO="qmi" ;;
			*/cdc_mbim)  _QPROTO="mbim" ;;
			*/cdc_ether) _QPROTO="ecm" ;;
		esac
		[ -n "$_QPROTO" ] && break
	done
fi
if [ -z "$_QPROTO" ]; then
	PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
	PVCUT=$(echo $PV | awk -F 'Vendor=2c7c ProdID=0801' '{print $2}' | cut -c-1290)
	if echo "$PVCUT" | grep -q "Driver=qmi_wwan"; then
		_QPROTO="qmi"
	elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"; then
		_QPROTO="mbim"
	elif echo "$PVCUT" | grep -q "Driver=cdc_ether"; then
		_QPROTO="ecm"
	fi
fi
[ -n "$_QPROTO" ] && PROTO="$_QPROTO"
                                                                                                                                                                                                                                         

. "$RES/modem/usb/_quectel_qrsrp"
