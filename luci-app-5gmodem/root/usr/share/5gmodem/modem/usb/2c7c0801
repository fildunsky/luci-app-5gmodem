# Quectel RM520N-GL (2c7c:0801; RM521F-GL - по общему руководству AT-команд, свой PID в теме не подтверждён)

. "$RES/modem/usb/_quectel_common"

_qc_temp3n

if [ -z "$REG" ] || [ "x$MODE_NUM" = "x11" ]; then
	_q5_c5greg reset busybox awk
fi

if [ "$REGOK" = "1" ]; then

O=$(sms_tool -d $DEVICE at "at+qnwinfo;+qcainfo;+qeng=\"servingcell\";+qspn")

_qc_spn2

# ИДЕНТИФИКАТОР СОТЫ - ИЗ УЖЕ ПОЛУЧЕННОГО QENG, БЕЗ ВТОРОГО ЗАХОДА В ПОРТ.
# Раньше поле бралось как 5-е по запятым - в сплошной раскладке
# +QENG: "servingcell","NOCONN","LTE","FDD",250,11,4E23802,... это MCC (250),
# и в карточку уезжала «сота 592». Раскладок две: сплошная (сота - 7-е поле)
# и NSA-разнесённая +QENG: "LTE",... (сота - 5-е) (ревью RM520N 13.09.2026,
# живой ответ с форума 4pda).
if [ "$CID_HEX" = "0" ] || [ -z "$CID_HEX" ]; then
	T=$(echo "$O" | tr -d '\r' | awk -F, '/^\+QENG: "servingcell",.*"LTE"/ {print $7; exit} /^\+QENG: "LTE",/ {print $5; exit}' | tr -cd '0-9A-Fa-f')
	if [ -n "$T" ]; then
		CID_HEX="$T"
		CID_DEC=$(printf "%d" "0x$T" 2>/dev/null)
	fi
fi


_q5_core mb nrn qnw scclev

fi

# СОСЕДНИЕ СОТЫ - AT+QENG="neighbourcell", формат тот же, что у EP06:
#   +QENG: "neighbourcell intra","LTE",<earfcn>,<pci>,<rsrq>,<rsrp>,<rssi>,...
# (живой дамп RM520N с форума 4pda: intra 2850,136,-10,-100,-68 сходится с
# обслуживающей сотой - 5-е поле RSRQ, 6-е RSRP). Разбор перенесён из
# modem/usb/2c7c0306, таблица EARFCN->диапазон расширена до набора RM520N-GL
# (ревью RM520N 13.09.2026). Обслуживающая сота в списке есть - помечаем её.
if [ -z "$NEIGHBORS" ]; then
	_NB=$(sms_tool -d $DEVICE at "AT+QENG=\"neighbourcell\"" 2>/dev/null | tr -d '\r')
	NEIGHBORS=$(echo "$_NB" | awk -v spci="$PCI" -v sear="$EARFCN" -F, '
		function ch2band(c) {
			if (c <= 599) return 1;      if (c <= 1199) return 2
			if (c <= 1949) return 3;     if (c <= 2399) return 4
			if (c <= 2649) return 5;     if (c >= 2750 && c <= 3449) return 7
			if (c >= 3450 && c <= 3799) return 8
			if (c >= 5010 && c <= 5179) return 12;  if (c >= 5180 && c <= 5279) return 13
			if (c >= 5280 && c <= 5379) return 14;  if (c >= 5730 && c <= 5849) return 17
			if (c >= 5850 && c <= 5999) return 18;  if (c >= 6000 && c <= 6149) return 19
			if (c >= 6150 && c <= 6449) return 20
			if (c >= 8040 && c <= 8689) return 25;  if (c >= 8690 && c <= 9039) return 26
			if (c >= 9210 && c <= 9659) return 28;  if (c >= 9660 && c <= 9769) return 29
			if (c >= 9770 && c <= 9869) return 30;  if (c >= 9920 && c <= 10359) return 32
			if (c >= 36200 && c <= 36349) return 34
			if (c >= 37750 && c <= 38249) return 38; if (c >= 38250 && c <= 38649) return 39
			if (c >= 38650 && c <= 39649) return 40; if (c >= 39650 && c <= 41589) return 41
			if (c >= 41590 && c <= 43589) return 42; if (c >= 43590 && c <= 45589) return 43
			if (c >= 46790 && c <= 54539) return 46; if (c >= 55240 && c <= 56739) return 48
			if (c >= 66436 && c <= 67335) return 66; if (c >= 68586 && c <= 68935) return 71
			return 0
		}
		/^\+QENG: "neighbourcell/ {
			gsub(/"/, "", $2)
			if ($2 != "LTE") next
			if (NF < 7) next
			earfcn = $3 + 0; pci = $4 + 0; rsrq = $5 + 0; rsrp = $6 + 0; rssi = $7 + 0
			if (earfcn == 0 || rsrp == 0) next
			b = ch2band(earfcn)
			if (n++) printf ","
			sv = (spci != "" && sear != "" && pci == spci+0 && earfcn == sear+0) ? "true" : "false"
			printf "{\"band\":\"%s\",\"earfcn\":\"%d\",\"pci\":\"%d\",\"rsrp\":\"%d\",\"rsrq\":\"%d\",\"rssi\":\"%d\",\"serving\":%s}", (b ? b : ""), earfcn, pci, rsrp, rsrq, rssi, sv
		}')
fi

MODE=$(echo $MODE | sed 's,/,+,' | sed 's, / \(B[0-9]\), + \1,g' | sed 's,LTE B,LTE | B,' | sed 's,LTE_A,LTE-A,' | sed 's,LTE-A B,LTE-A | B,')

if [ "${LAC_DEC}" = "0" ]; then
	LAC_DEC="-"
	LAC_HEX="-"
fi

# Modem
_qc_gmr_fw
# ПОЛНЫЙ БИЛД - AT+QGMR?: RM520NGLAAR03A03M4G_01.201.01.201. Только по нему
# видно ветку прошивки (R01A06 - без регионального блока, R03/«200/201/30x» -
# с блоком РФ), AT+GMR отдаёт короткую ревизию (форум 4pda, ревью 13.09.2026).
T=$(sms_tool -d $DEVICE at "AT+QGMR?" 2>/dev/null | tr -d '\r' | awk '/^[A-Z][A-Z0-9]+_[0-9][0-9.]*$/ {print; exit}')
[ -n "$T" ] && FW="$T"

_qc_gmr_model

_qc_qslot

_qc_ids_sed

# Protocol
# DRIVER=QMI_WWAN & DRIVER=CDC_MBIM & DRIVER=CDC_ETHER
# ДРАЙВЕР - ИЗ SYSFS СВОЕГО USB-ПУТИ. Разбор debugfs брал текст после ПЕРВОГО
# «Vendor=2c7c ProdID=0801» и резал по 1290 символам: при двух одинаковых
# модулях протокол приезжал от соседа, а без смонтированного debugfs не
# определялся вовсе (ревью RM520N 13.09.2026). debugfs остаётся запасным.
_QPROTO=""
if [ -n "$_POLL_AM" ] && [ -d "/sys/bus/usb/devices/$_POLL_AM" ]; then
	for _qi in "/sys/bus/usb/devices/$_POLL_AM":*/driver; do
		[ -L "$_qi" ] || continue
		case "$(readlink "$_qi" 2>/dev/null)" in
			*/qmi_wwan)  _QPROTO="qmi" ;;
			*/cdc_mbim)  _QPROTO="mbim" ;;
			*/cdc_ether) _QPROTO="ecm" ;;
		esac
		[ -n "$_QPROTO" ] && break
	done
fi
if [ -z "$_QPROTO" ]; then
	PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
	PVCUT=$(echo $PV | awk -F 'Vendor=2c7c ProdID=0801' '{print $2}' | cut -c-1290)
	if echo "$PVCUT" | grep -q "Driver=qmi_wwan"; then
		_QPROTO="qmi"
	elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"; then
		_QPROTO="mbim"
	elif echo "$PVCUT" | grep -q "Driver=cdc_ether"; then
		_QPROTO="ecm"
	fi
fi
[ -n "$_QPROTO" ] && PROTO="$_QPROTO"
                                                                                                                                                                                                                                         

. "$RES/modem/usb/_quectel_qrsrp"
