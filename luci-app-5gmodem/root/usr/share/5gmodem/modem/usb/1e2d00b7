# ==========================================================================
# Compal RXM-G1 (model "SG500M2-X") switched to QMI/debug mode reports the SAME
# USB id 1e2d:00b7 as the Foxconn T99W175 / Dell DW5930e / Thales MV31-W below,
# so tell them apart by the model. The Compal exposes NO AT signal commands
# (AT+CSQ / AT^TEMP? / AT^DEBUG? are empty) - read metrics via qmicli instead.
# Operator / registration / TAC / CID / firmware still come from the framework
# over AT (AT+COPS / +CREG / +CGMR work on this modem).
# ==========================================================================
# ЕДИНАЯ реализация метрик Compal живёт в 05c690d6 - здесь только развод по
# модели и делегирование. Раньше тут лежала УРЕЗАННАЯ копия той же логики, и она
# успела разойтись с оригиналом: в ней не было ни уровня троттлинга (+CEITHERM),
# ни агрегации несущих, ни 5G-полей. Именно этим и объяснялось, почему в
# композиции QMI пропадало «тепловое состояние», исправно работавшее в MBIM.
# Копия по определению отстаёт от оригинала - поэтому её тут больше нет.
# _IS_COMPAL=1 выставляем заранее: 05c690d6 его уважает и не детектит повторно.
. /usr/share/5gmodem/iscompal.sh
if is_compal "${_POLL_AM:-$MODEM_PATH}" "$(/usr/share/5gmodem/modemswitch.sh wdm 2>/dev/null)" "$DEVICE"; then
	_IS_COMPAL=1
	. "$RES/modem/usb/05c690d6"
	return 0 2>/dev/null || exit 0
fi

# Dell DW5930e
# Foxconn T99W175
# Thales Cinterion MV31-W

O=$(sms_tool -d $DEVICE at "AT^TEMP?")

T=$(echo "$O" | awk '/^TSENS: / {gsub("C","",$2); print $2}')
T1=$(echo "$O" | awk '/^PA: / {gsub("C","",$2); print $2}')
if [ -n "$T" ] && [ -n "$T1" ]; then
    if [[ "$T1" =~ ^[0-9]+$ && "$T" =~ ^[0-9]+$ ]]; then
        if [ "$T1" -gt "$T" ]; then
            T="$T1"
        fi
    fi
fi

T1=$(echo "$O" | awk '/^Skin Sensor: / {gsub("C","",$2); print $2}')
if [ -n "$T" ] && [ -n "$T1" ]; then
    if [[ "$T1" =~ ^[0-9]+$ && "$T" =~ ^[0-9]+$ ]]; then
        if [ "$T1" -gt "$T" ]; then
            T="$T1"
        fi
    fi
fi
[ -n "$T" ] && TEMP="$T &deg;C"

if [ "$REGOK" = "1" ]; then

O=$(sms_tool -d $DEVICE at "at^debug?")

case "$MODE_NUM" in
	"7")
		MODE="LTE |"
		echo "$O" | grep -q "scell:" && MODE="LTE-A |"
		;;
	"11")
		MODE="5G SA |"
		;;
	"13")
		# AcT=13 - ЗАЯВКА EN-DC, а не работающий 5G: Билайн раздаёт её на
		# голом LTE, и в карточке красовалось «5G» при единственной несущей
		# B3 - а после принудительного «только 4G» человек не мог даже
		# убедиться, что режим применился (живой отчёт 08.08.2026). Ярлык -
		# по факту NR-несущей в ^debug: тот же урок, что у FM350 (AcT=13)
		# и EM9190 (System mode: ENDC).
		if echo "$O" | grep -q "^nr_band:"; then
			MODE="5G NSA |"
		elif echo "$O" | grep -q "scell:"; then
			MODE="LTE-A |"
		else
			MODE="LTE |"
		fi
		;;
esac

T=$(echo "$O" | awk -F: '/^lte_tac:/ {print $2}' | xargs)
if [ -n "$T" ]; then
#	TAC_HEX=$(printf "%X" $T)
#	TAC_DEC=$(printf "%d" "0x$T")

	TAC_HEX=$(printf "%X" $T)
	TAC_DEC="$T"
fi

O1=$(echo "$O" | grep -A 3 pcell)
T=$(echo "$O1" | awk -F: '/^pcell:/ {print $3}' | cut -f1 -d" ")
if [ -n "$T" ]; then
	MODE="$MODE $(band4g $T)"
	T1=$(echo "$O1" | awk -F: '/^pcell:/ {print $4}' | xargs)
	PBAND="$(band4g $T) @${T1/MHz/} MHz"
	
	T=$(echo "$O1" | awk -F: '/pci:/ {print $3}' | xargs)
	[ -n "$T" ] && PCI=$T
	T=$(echo "$O1" | awk -F: '/^channel:/ {print $2}' | cut -f1 -d" " | xargs)
	[ -n "$T" ] && EARFCN=$T
	T=$(echo "$O1" | awk -F[:,] '/^lte_rsrp:/ {print $2}')
	[ -n "$T" ] && RSRP="${T/dBm/}"
	T=$(echo "$O1" | awk -F[:,] '/rsrq:/ {print $4}' | xargs)
	[ -n "$T" ] && RSRQ="${T/dB/}"
	T=$(echo "$O1" | awk -F[:,] '/^lte_rssi:/ {print $2}')
	[ -n "$T" ] && RSSI="${T/dBm/}"
	T=$(echo "$O1" | awk -F[:,] '/lte_snr:/ {print $4}' | xargs)
	[ -n "$T" ] && [ "$T" != "NA" ] && SINR="${T/dB/}"
fi

O1=$(echo "$O" | grep -A 3 scell)
IDX=0;
while true; do
	O2=$(echo "$O1" | head -n4)
	if [ -z "$O2" ]; then
		break
	fi
	IDX=$((IDX + 1))

	T=$(echo "$O2" | awk -F: '/^scell:/ {print $3}' | cut -f1 -d" ")
	MODE="$MODE / $(band4g $T)"
	T1=$(echo "$O2" | awk -F: '/^scell:/ {print $4}' | xargs)
		if [ -n "$T1" ]; then
			case $IDX in
				1) S1BAND="$(band4g $T) @${T1/MHz/} MHz";;
				2) S2BAND="$(band4g $T) @${T1/MHz/} MHz";;
				3) S3BAND="$(band4g $T) @${T1/MHz/} MHz";;
				4) S4BAND="$(band4g $T) @${T1/MHz/} MHz";;
				*) ;;
			esac
		fi
	
	T=$(echo "$O2" | awk -F: '/pci:/ {print $3}' | xargs)
		if [ -n "$T" ]; then
			case $IDX in
				1) S1PCI="$T";;
				2) S2PCI="$T";;
				3) S3PCI="$T";;
				4) S4PCI="$T";;
				*) ;;
			esac
		fi
	
	T=$(echo "$O2" | awk -F: '/^channel:/ {print $2}' | cut -f1 -d" " | xargs)
		if [ -n "$T" ]; then
			case $IDX in
				1) S1EARFCN="$T";;
				2) S2EARFCN="$T";;
				3) S3EARFCN="$T";;
				4) S4EARFCN="$T";;
				*) ;;
			esac
		fi
	
	T=$(echo "$O2" | awk -F[:,] '/^lte_rsrp:/ {print $2}')
#	[ -n "$T" ] && addon $((POS + 6)) "(S${IDX}) RSRP" "${T/dBm/} dBm"
	T=$(echo "$O2" | awk -F[:,] '/rsrq:/ {print $4}' | xargs)
#	[ -n "$T" ] && addon $((POS + 7)) "(S${IDX}) RSRQ" "${T/dB/} dB"
	T=$(echo "$O2" | awk -F[:,] '/^lte_rssi:/ {print $2}')
#	[ -n "$T" ] && addon $((POS + 5)) "(S${IDX}) RSSI" "${T/dBm/} dBm"
	T=$(echo "$O2" | awk -F[:,] '/lte_snr:/ {print $4}' | xargs)
#	[ -n "$T" ] && [ "$T" != "NA" ] && addon $((POS + 8)) "(S${IDX}) SNR" "${T/dB/} dB"

	O1=$(echo "$O1" | sed '1,4d')
done

T=$(echo "$O" | awk -F: '/^nr_band:/ {print $2}' | xargs)
if [ -n "$T" ]; then
	MODE="$MODE / $(band5g ${T/n/})"
	IDX=$((IDX + 1))

	T1=$(echo "$O" | awk -F: '/^nr_band_width:/ {print $2}' | xargs)
		if [ -n "$T1" ]; then
			case $IDX in
				1) S1BAND="$(band5g ${T/n/}) @${T1/MHz/} MHz";;
				2) S2BAND="$(band5g ${T/n/}) @${T1/MHz/} MHz";;
				3) S3BAND="$(band5g ${T/n/}) @${T1/MHz/} MHz";;
				4) S4BAND="$(band5g ${T/n/}) @${T1/MHz/} MHz";;
				*) ;;
			esac
		fi
	
	T=$(echo "$O" | awk -F: '/^nr_pci:/ {print $2}' | xargs)
		if [ -n "$T" ]; then
			case $IDX in
				1) S1PCI="$T";;
				2) S2PCI="$T";;
				3) S3PCI="$T";;
				4) S4PCI="$T";;
				*) ;;
			esac
		fi
	T=$(echo "$O" | awk -F: '/^nr_channel:/ {print $2}' | xargs)
		if [ -n "$T" ]; then
			case $IDX in
				1) S1EARFCN="$T";;
				2) S2EARFCN="$T";;
				3) S3EARFCN="$T";;
				4) S4EARFCN="$T";;
				*) ;;
			esac
		fi
	T=$(echo "$O" | awk -F: '/^nr_rsrp:/ {print $2}' | cut -f1 -d" ")
#	[ -n "$T" ] && addon $((POS + 6)) "(S${IDX}) RSRP" "${T/dBm/} dBm"
	T=$(echo "$O" | awk -F: '/^nr_rsrq:/ {print $2}' | xargs)
#	[ -n "$T" ] && addon $((POS + 7)) "(S${IDX}) RSRQ" "${T/dB/} dB"
	T=$(echo "$O" | awk -F: '/^nr_snr:/ {print $2}' | xargs)
#	[ -n "$T" ] && [ "$T" != "NA" ] && addon $((POS + 8)) "(S${IDX}) SNR" "${T/dB/} dB"
fi

fi

MODE=$(echo $MODE | sed 's,/,+,'| sed 's,LTE B,LTE | B,')


# Modem

# ПЕРВАЯ ОСМЫСЛЕННАЯ СТРОКА ОТВЕТА - остальное мусор. У этого модуля эхо
# включено с завода, а батч ядра подписывает +CREG=2/+CEREG=2 - и их URC
# прилетают ПОСРЕДИ чужого чтения. Прежний разбор склеивал всё в одну строку,
# и в имени модема оседали обрывки команд: «Thales AT MV31-W AT +CREG: 0
# +CEREG: 0» (живой отчёт 08.08.2026).
_mv_first_clean() {
	printf '%s\n' "$1" | tr -d '\r' | awk '
		/^AT/ { next }
		/^\+/ { next }
		/^\^/ { next }
		/^(OK|ERROR)$/ { next }
		/^[[:space:]]*$/ { next }
		{ print; exit }
	'
}
MODELACUT=$(_mv_first_clean "$(sms_tool -d $DEVICE at "AT+CGMM")")
MODELBCUT=$(_mv_first_clean "$(sms_tool -d $DEVICE at "AT+CGMI")")
MODEL="$MODELBCUT $MODELACUT"

FWA=$(sms_tool -d $DEVICE at "AT+CGMR" | tr -s "\n" | xargs)
FW=$(echo $FWA | sed s/"AT+CGMR "//)

# International Mobile Equipment Identity (IMEI)
O=$(sms_tool -d $DEVICE at "AT+CGSN" | xargs)
NR_I=$(digits_of "$O" 15 17)
if [ -n "$NR_I" ]; then
	NR_IMEI="$NR_I"
fi

# International Mobile Subscriber Identity (IMSI)
O=$(sms_tool -d $DEVICE at "AT+CIMI" | xargs)
NR_C=$(digits_of "$O" 14 16)
if [ -n "$NR_C" ]; then
	NR_IMSI="$NR_C"
fi

#  Integrated Circuit Card Identifier (ICCID)
O=$(sms_tool -d $DEVICE at "AT+ICCID")
NR_D=$(echo "$O" | awk -F [:] '/^\ICCID:/{print $2}' | xargs)
if [ -n "$NR_D" ]; then
	NR_ICCID="$NR_D"
fi

# Protocol
# DRIVER=QMI_WWAN & DRIVER=CDC_MBIM & DRIVER=CDC_ETHER

PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
PVCUT=$(echo $PV | awk -F 'Vendor=1e2d ProdID=00b7' '{print $2}' | cut -c-1290)
if echo "$PVCUT" | grep -q "Driver=qmi_wwan"
then
    PROTO="qmi"
elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"
then
    PROTO="mbim"
elif echo "$PVCUT" | grep -q "Driver=cdc_ether"
then
    PROTO="ecm"
fi
