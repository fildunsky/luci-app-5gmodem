O=$(sms_tool -d $DEVICE at "at+zrssi;+zcellinfo?;+zcainfo?")

case "$MODE_NUM" in
	3*)
		T=$(echo "$O" | awk -F[,:] '/^\+ZRSSI/ {print $2}' | xargs)
		RSSI="$T"
		;;
	2*|\
	4*|\
	5*|\
	6*)
		T=$(echo "$O" | awk -F[,:] '/^\+ZCELLINFO/ {print $4}' | xargs)
		[ -n "$T" ] && MODE="$T"
		;;
	7*)
		T=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $4}' | xargs)
		if [ -n "$T" ]; then
			T_HEX=$(printf "%X" $T)
			T_DEC=$T
		fi

		T=$(echo "$O" | awk -F[,:] '/^\+ZRSSI/ {print $4}' | xargs)
		RSSI="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+ZRSSI/ {print $2}' | xargs)
		RSRP="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+ZRSSI/ {print $3}' | xargs)
		RSRQ="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+ZRSSI/ {print $5}' | xargs)
		SINR="$T"
		T=$(echo "$O" | awk -F[,:] '/^\+ZCELLINFO/ {print $4}' | xargs)
		MODE="LTE $(band4g ${T/LTE B/})"

		T=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $3}' | xargs)
		if [ -n "$T" ]; then
			T1=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $6}' | xargs)
			PBAND="$(band4g $T "") @$T1 MHz"
			T=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $2}' | xargs)
			[ -n "$T" ] && PCI="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $5}' | xargs)
			[ -n "$T" ] && EARFCN="$T"
		fi

		T=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $9}' | xargs)
		if [ -n "$T" ]; then
			T1=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $11}' | xargs)
			S1BAND="$(band4g $T "") @$T1 MHz"
			MODE="${MODE/LTE/LTE_A} / $(band4g ${T})"
			T=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $7}' | xargs)
			[ -n "$T" ] && S1PCI="$T"
			T=$(echo "$O" | awk -F[,:] '/^\+ZCAINFO/ {print $10}' | xargs)
			[ -n "$T" ] && S1EARFCN="$T"
		fi

		# +ZCAINFO shows one secondary carrier at most. In QMI mode the modem's own control
		# channel lists the primary and every activated secondary, so it replaces the AT answer.
		_zq_wdm=""
		_zq_path=$(tty_usbpath "$DEVICE" 2>/dev/null)
		if [ -n "$_zq_path" ] && command -v uqmi >/dev/null 2>&1; then
			for _zq_s in /sys/bus/usb/devices/"$_zq_path":*/usbmisc/cdc-wdm*; do
				[ -e "$_zq_s" ] || continue
				case "$(readlink -f "${_zq_s%/usbmisc/*}/driver" 2>/dev/null)" in
					*/qmi_wwan) _zq_wdm="/dev/${_zq_s##*/}"; break ;;
				esac
			done
		fi
		_zq_ca=""
		[ -n "$_zq_wdm" ] && _zq_ca=$(uqmi -s -d "$_zq_wdm" -t 3000 --get-lte-cphy-ca-info 2>/dev/null)
		_zq_b=$(printf '%s\n' "$_zq_ca" | jsonfilter -e '@.primary.band' 2>/dev/null)
		if [ -n "$_zq_b" ]; then
			_zq_w=$(printf '%s\n' "$_zq_ca" | jsonfilter -e '@.primary.bandwidth' 2>/dev/null)
			PBAND="$(band4g "$_zq_b" "")${_zq_w:+ @$_zq_w MHz}"
			MODE="LTE $(band4g "$_zq_b")"
			# uqmi calls the physical cell id "cell_id"
			T=$(printf '%s\n' "$_zq_ca" | jsonfilter -e '@.primary.cell_id' 2>/dev/null)
			[ -n "$T" ] && PCI="$T"
			T=$(printf '%s\n' "$_zq_ca" | jsonfilter -e '@.primary.channel' 2>/dev/null)
			[ -n "$T" ] && EARFCN="$T"
			S1BAND="-"; S1PCI="-"; S1EARFCN="-"
			_zq_mode=""; _zq_n=0
			for _zq_i in 1 2 3 4; do
				[ "$(printf '%s\n' "$_zq_ca" | jsonfilter -e "@.secondary_${_zq_i}.state" 2>/dev/null)" = activated ] || continue
				_zq_b=$(printf '%s\n' "$_zq_ca" | jsonfilter -e "@.secondary_${_zq_i}.band" 2>/dev/null)
				[ -n "$_zq_b" ] || continue
				_zq_w=$(printf '%s\n' "$_zq_ca" | jsonfilter -e "@.secondary_${_zq_i}.bandwidth" 2>/dev/null)
				_zq_p=$(printf '%s\n' "$_zq_ca" | jsonfilter -e "@.secondary_${_zq_i}.cell_id" 2>/dev/null)
				_zq_c=$(printf '%s\n' "$_zq_ca" | jsonfilter -e "@.secondary_${_zq_i}.channel" 2>/dev/null)
				# activated carriers fill S1, S2... without gaps
				_zq_n=$((_zq_n + 1))
				eval "S${_zq_n}BAND=\"\$(band4g \"\$_zq_b\" \"\")\${_zq_w:+ @\$_zq_w MHz}\""
				[ -n "$_zq_p" ] && eval "S${_zq_n}PCI=\$_zq_p"
				[ -n "$_zq_c" ] && eval "S${_zq_n}EARFCN=\$_zq_c"
				_zq_mode="$_zq_mode / $(band4g "$_zq_b")"
			done
			[ -n "$_zq_mode" ] && MODE="${MODE/LTE/LTE_A}$_zq_mode"
		fi
		;;
esac

MODE=$(echo $MODE | sed "s/LTE_A/LTE-A |/g" | sed 's,/,+,' | sed 's, / \(B[0-9]\), + \1,g')

if [ "${LAC_DEC}" = "0" ]; then
	LAC_DEC="-"
	LAC_HEX="-"
fi 

OF=$(sms_tool -d $DEVICE at "ati")
DEVV=$(echo $OF | tr -s "\n"  | xargs)
FWA=$(sms_tool -d $DEVICE at "AT+GMR" | tr -s "\n"  | xargs)
FW=$(echo $FWA | sed 's/^.*AT+GMR *//' | xargs)

MODELA=$(echo $DEVV | awk -F 'Revision: ' '{print $1}'| xargs)
MODELB=$(echo $MODELA | awk -F 'Manufacturer: |CORPORATION' '{print $2}'| xargs)

MODELD=$(sms_tool -d $DEVICE at "AT+CGMM" | tr -s "\n"  | xargs)
MODELDCUT=$(echo $MODELD | cut -c 9-)

MODEL="$MODELB "$MODELDCUT

O=$(sms_tool -d $DEVICE at "AT+GSN" | xargs)
NR_I=$(digits_of "$O" 15 17)
if [ -n "$NR_I" ]; then
	NR_IMEI="$NR_I"
fi

O=$(sms_tool -d $DEVICE at "AT+CIMI" | xargs)
NR_C=$(digits_of "$O" 14 16)
if [ -n "$NR_C" ]; then
	NR_IMSI="$NR_C"
fi

O=$(sms_tool -d $DEVICE at "AT+ICCID")
NR_D=$(echo "$O" | awk -F [:] '/^\ICCID:/{print $2}' | xargs)
if [ -n "$NR_D" ]; then
	NR_ICCID="$NR_D"
fi

PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
PV85=$(echo $PV | awk -F 'Vendor=19d2 ProdID=1485' '{print $2}' | cut -c-1220)
if [ -n "$PV85" ]; then
    if echo "$PV85" | grep -q "Driver=qmi_wwan"
    then
    PROTO="qmi"
    elif echo "$PV85" | grep -q "Driver=cdc_mbim"
    then
    PROTO="mbim"
    elif echo "$PV85" | grep -q "Driver=cdc_ether"
    then
    PROTO="ecm"
    fi
fi
PV32=$(echo $PV | awk -F 'Vendor=19d2 ProdID=1432' '{print $2}' | cut -c-1220)
if [ -n "$PV32" ]; then
    if echo "$PV32" | grep -q "Driver=qmi_wwan"
    then
    PROTO="qmi"
    elif echo "$PV32" | grep -q "Driver=cdc_mbim"
    then
    PROTO="mbim"
    elif echo "$PV32" | grep -q "Driver=cdc_ether"
    then
    PROTO="ecm"
    fi
fi
