O=$(sms_tool -d $DEVICE at "at^chiptemp?;^hcsq?;^iccid?")
case "$O" in
	*"^HCSQ:"*) ;;
	*) O=$(sms_tool -d $DEVICE at "at^hcsq?") ;;
esac

T=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $2}' | xargs)
if [ -n "$T" ]; then
	MODE="$T"

	case "$MODE" in
		WCDMA*)
			PARAM1=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $3}' | xargs)
			PARAM2=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $4}' | xargs)
			PARAM3=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $5}' | xargs)
			case "$PARAM1" in ''|*[!0-9]*) ;; *) RSSI=$(awk 'BEGIN {print -121 + '$PARAM1'}') ;; esac
			RSCP=$(awk 'BEGIN {print -121 + '$PARAM2'}')
			ECIO=$(awk 'BEGIN {print -32.5 + '$PARAM3'/2}')
			;;
		LTE*)
			PARAM1=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $3}' | xargs)
			PARAM2=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $4}' | xargs)
			PARAM3=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $5}' | xargs)
			PARAM4=$(echo "$O" | awk -F[,:] '/^\^HCSQ:/ {print $6}' | xargs)
			case "$PARAM1" in ''|*[!0-9]*) ;; *) RSSI=$(awk 'BEGIN {print -121 + '$PARAM1'}') ;; esac
			RSRP=$(awk 'BEGIN {print -141 + '$PARAM2'}')
			SINR=$(awk 'BEGIN {print -20.2 + '$PARAM3'/5}')
			RSRQ=$(awk 'BEGIN {print -20 + '$PARAM4'/2}')
			;;
	esac
fi

OF=$(sms_tool -d $DEVICE at "ati")
DEV2=$(echo $OF | tr -s "\n"  | xargs)
MODELB=$(echo $DEV2 | awk -F 'Manufacturer:|Revision:' '{print $2}'| xargs)
MODELC=$(echo $MODELB | sed 's/Model://' | xargs)
MODEL=$(echo $MODELC | awk '{ $1 = toupper(substr($1,1,1)) tolower(substr($1,2)); print }')
FW=$(echo $DEV2 | awk -F 'Revision:|IMEI' '{print $2}'| xargs)

_PV_V=$(cat "/sys/bus/usb/devices/$_POLL_AM/idVendor" 2>/dev/null)
_PV_P=$(cat "/sys/bus/usb/devices/$_POLL_AM/idProduct" 2>/dev/null)
_PV_ID="Vendor=${_PV_V:-12d1} ProdID=${_PV_P:-1506}"
PV=$(cat /sys/kernel/debug/usb/devices 2>/dev/null)
PVCUT=$(echo $PV | awk -F "$_PV_ID" '{print $2}' | cut -c-1104)
if echo "$PVCUT" | grep -q "Driver=qmi_wwan"
then
    PROTO="qmi"
elif echo "$PVCUT" | grep -q "Driver=cdc_mbim"
then
    PROTO="mbim"
elif echo "$PVCUT" | grep -q "Driver=cdc_ether"
then
    PROTO="ecm"
elif echo "$PVCUT" | grep -q "cdc_ncm"
then
    PROTO="ncm"
fi

OI=$(sms_tool -d $DEVICE at "AT+GSN" | xargs)
NR_I=$(echo "$OI" | sed 's/AT+GSN//g' | xargs)
if [ -n "$NR_I" ]
then
	NR_IMEI="$NR_I"
fi

OC=$(sms_tool -d $DEVICE at "AT+CIMI" | xargs)
NR_C=$(echo "$OC" | sed 's/AT+CIMI//g' | xargs)
if [ -n "$NR_C" ]; then
	NR_IMSI="$NR_C"
fi

NR_D=$(echo "$O" | awk -F [:] '/^\^ICCID: /{print $2}' | xargs)
if [ -n "$NR_D" ]; then
	NR_ICCID="$NR_D"
fi

XFR=$(sms_tool -d $DEVICE at "at^hfreqinfo?")
XFRCOUNT=$(echo -n "$XFR" | wc -c)

if [ -n "$XFR" ] && [ "$XFRCOUNT" -gt "15" ]; then

TBX=$(echo "$XFR" | awk -F [:] '/^\^HFREQINFO:/{print $2}' | xargs)
TB=$(echo "$TBX" | cut -d ',' -f3-3 )

TDL=$(echo "$TBX" | cut -d ',' -f6-6 )
case "$TDL" in
	''|*[!0-9]*) DL="" ;;
	1400) DL=1.4 ;;
	*) DL=$((TDL / 1000)) ;;
esac

TUL=$(echo "$TBX" | cut -d ',' -f9-9 )
case "$TUL" in
	''|*[!0-9]*) UL="" ;;
	*) UL=$((TUL / 1000)) ;;
esac

ULBW=""
[ -n "$UL" ] && ULBW="UL: @$UL MHz"
DLBW=""
[ -n "$DL" ] && DLBW="DL: @$DL MHz"

PBAND=""
case "$TB" in
	''|*[!0-9]*) ;;
	*) PBAND="$(band4g $TB "")"
	   [ -n "$DL" ] && PBAND="$PBAND @$DL MHz" ;;
esac
EARFCN=$(echo "$TBX" | cut -d ',' -f4-4 )
PCI="-"

case "$MODE" in *LTE*) _hw_lte=1 ;; *) _hw_lte=0 ;; esac
if [ "$_hw_lte" = 1 ] && [ -n "$TB" ]; then
MODE="LTE | "$(band4g $TB "")
fi
      
fi

if [ -z "$PBAND" ] && [ "$_hl_kind" = hilink ]; then
	_HS=$("$RES/hilink.sh" get /api/device/signal "$_POLL_AM" 2>/dev/null | tr -d '\r')
	_HB=$(echo "$_HS" | sed -n 's|.*<band>\([0-9]*\)</band>.*|\1|p' | head -1)
	if [ -n "$_HB" ]; then
		_HW=$(echo "$_HS" | sed -n 's|.*<dlbandwidth>\([0-9.]*\)MHz</dlbandwidth>.*|\1|p' | head -1)
		PBAND="$(band4g $_HB "")"
		[ -n "$_HW" ] && { PBAND="$PBAND @$_HW MHz"; BANDWIDTH="$_HW MHz"; }
		case "$MODE" in *LTE*) MODE="LTE | $(band4g $_HB "")" ;; esac
		_HV=$(echo "$_HS" | sed -n 's|.*<earfcn>DL:\([0-9]*\).*|\1|p' | head -1)
		[ -n "$_HV" ] && EARFCN="$_HV"
		_HV=$(echo "$_HS" | sed -n 's|.*<pci>\([0-9]*\)</pci>.*|\1|p' | head -1)
		[ -n "$_HV" ] && PCI="$_HV"
		_HV=$(echo "$_HS" | sed -n 's|.*PPusch:\(-*[0-9]*\)dBm.*|\1|p' | head -1)
		[ -n "$_HV" ] && TXPOWER="$_HV dBm"
	fi
	if [ -z "$NR_ICCID" ]; then
		_HV=$("$RES/hilink.sh" get /api/device/information "$_POLL_AM" 2>/dev/null \
			| sed -n 's|.*<Iccid>\([0-9A-Fa-f]*\)</Iccid>.*|\1|p' | head -1)
		[ -n "$_HV" ] && NR_ICCID="$_HV"
	fi
fi

T_HEX=$LAC_HEX
T_DEC=$LAC_DEC

T=$(echo "$O" | awk -F[,:] '/^\^CHIPTEMP/ {gsub(/[ \r]/,"");t=0;for(i=2;i<=NF;i++)if($i!=65535){if($i>100){$i=$i/10};if($i>t){t=$i}};printf "%.1f", t}')
if [ -n "$T" ] && [ "$T" != "0.0" ]; then
	TEMP="$T &deg;C"
fi
