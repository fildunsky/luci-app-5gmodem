# MeigLink SLM770A-R (2dee:4d57)
#
# Диалект: НЕ Quectel - AT+QENG="servingcell" модем не понимает вовсе.
# Основа - стандартная 3GPP AT+CESQ, она отдаёт RSRP и RSRQ индексами:
#   +CESQ: <rxlev>,<ber>,<rscp>,<ecno>,<rsrq>,<rsrp>
#   на LTE поля rscp/ecno = 255 ("нет значения") - это 3G-показатели.
# Дополнительно модем отвечает на ^HCSQ (семейство Huawei), где рядом с теми же
# RSRQ и RSRP есть ЧЕТВЁРТОЕ значение - предположительно SINR:
#   ^HCSQ: 0,0,"LTE",<rxlev>,<rsrq>,<rsrp>,<sinr>
# Живой замер: +CESQ: 43,99,255,255,21,46 и ^HCSQ: ...,"LTE",43,21,46,150
# SINR ПОКА НЕ ВЫСТАВЛЯЕМ: шкала для этого значения не подтверждена (у Huawei
# встречаются разные множители), а показать неверное число хуже, чем не показать.

# Модель для заголовка блока. Общий код MODEL не заполняет - это делает профиль.
# Берём из ATI (проверено: "Model: SLM770A-R"), а не из AT+CGMM: у этого модуля
# ATI отвечает стабильно и содержит и производителя, и модель.
# Модель не меняется, а лишний
# AT-сеанс на КАЖДОМ опросе - это реальная плата. На слабом роутере, где
# склейка команд не работает и мы и так шлём их по одной, счёт обращений к
# порту растёт до десятка за опрос, и порт начинает быть занят: метрики
# мигают (температура появилась и пропала - наблюдалось вживую).
# Кэш держим САМИ, а не через at_static: тот объявлен в 5gmodem.sh НИЖЕ места,
# где подключается профиль, и на момент нашего запуска ещё не существует
# (проверено: модель пропала из вывода). Инвалидация - по смене tty модема.
_MC="/tmp/5gmodem_meig_ati_$(basename "$DEVICE")"
if [ -s "$_MC" ]; then
	_I=$(cat "$_MC")
else
	_I=$(sms_tool -d $DEVICE at "ATI" 2>/dev/null | tr -d '\r')
	case "$_I" in *Model:*) printf '%s' "$_I" > "$_MC" ;; esac
fi
_M=$(echo "$_I" | sed -n 's/^Model: *\(.*\)$/\1/p' | head -1)
[ -n "$_M" ] && MODEL="MeigLink $_M"
# Прошивку берём из того же кэшированного ATI ("Revision: SLM770A-R_B.0.3_EQ101") -
# отдельной команды не нужно, а поле в интерфейсе иначе стоит пустым.
_FWV=$(echo "$_I" | sed -n 's/^Revision: *\(.*\)$/\1/p' | head -1)
[ -n "$_FWV" ] && FW="$_FWV"

O=$(sms_tool -d $DEVICE at "at+cesq")

# RSRQ: индекс 0..34 -> дБ, шаг 0.5, смещение -19.5 (3GPP TS 27.007).
T=$(echo "$O" | awk -F'[,:]' '/^\+CESQ/ {gsub(/ /,"",$6); print $6}')
if [ -n "$T" ] && [ "$T" != "255" ]; then
	RSRQ=$(awk -v v="$T" 'BEGIN{printf "%.1f", -19.5 + v*0.5}')
fi

# RSRP: индекс 0..97 -> дБм, шаг 1, смещение -140.
T=$(echo "$O" | awk -F'[,:]' '/^\+CESQ/ {gsub(/ /,"",$7); print $7}')
if [ -n "$T" ] && [ "$T" != "255" ]; then
	RSRP=$((T - 140))
fi

# RSSI берём из rxlev (индекс 0..63 -> дБм, смещение -111), если общий код его
# ещё не заполнил из AT+CSQ.
if [ -z "$RSSI" ]; then
	T=$(echo "$O" | awk -F'[,:]' '/^\+CESQ/ {gsub(/ /,"",$2); print $2}')
	if [ -n "$T" ] && [ "$T" != "99" ]; then
		RSSI=$((T - 111))
	fi
fi

# --- +SGCELLINFOEX: сота, диапазон и расширенные метрики одной командой -------
# Берём ЕЁ, а не ^CELLINFO: содержит всё то же плюс eNBID, TM, PATHLOSS,
# TX_POWER, UE_category, CQI, VOLTE - и отдаёт ИМЕНОВАННЫМИ полями "КЛЮЧ:значение"
# вместо позиционного CSV. Разбор по имени не сломается, если производитель
# вставит поле в середину, а лишней AT-команды это не стоит: одна вместо одной.
#
# Живой ответ (сокращённо):
#   CURR_MODE:LTE / BAND:40 / LTE_BANDWIDTH:100 / DL CHANNEL:38750
#   RSSI:-66 / RSRP:-103 / RSRQ:-16.0 / SINR:110 / SNR:2 / TM:4 / VOLTE:0
# SINR приходит в десятых (110 = 11.0 дБ) - рядом лежащий SNR:2 это подтверждает.
C=$(sms_tool -d $DEVICE at "AT+SGCELLINFOEX?" 2>/dev/null | tr -d '\r')
if [ -n "$C" ]; then
	# _sg <ИМЯ> - значение поля по имени
	_sg() { echo "$C" | sed -n "s/^$1:\(.*\)$/\1/p" | head -1 | tr -d ' '; }

	T=$(_sg "BAND")
	if [ -n "$T" ] && [ "$T" != "0" ]; then
		PBAND="$(band4g $T)"
		case "$MODE" in
			*"$PBAND"*) : ;;
			*) [ -n "$MODE" ] && MODE="$MODE | $PBAND" || MODE="$PBAND" ;;
		esac
	fi
	T=$(_sg "DL CHANNEL"); [ -n "$T" ] && EARFCN="$T"
	# полоса приходит блоками по 5 (100 -> 20 МГц)
	T=$(_sg "LTE_BANDWIDTH")
	[ -n "$T" ] && [ "$T" -gt 0 ] 2>/dev/null && BANDWIDTH="$((T / 5)) MHz"
	T=$(_sg "PHYSICAL_CELL_ID"); [ -n "$T" ] && PCI="$T"
	T=$(_sg "GLOBAL CELL ID");   [ -n "$T" ] && CELLID="$T"
	T=$(_sg "TAC_ID");           [ -n "$T" ] && TAC_DEC="$T"
	# Идентификатор БАЗОВОЙ СТАНЦИИ отдельно от сектора - именно он опознаёт вышку
	T=$(_sg "eNBID");            [ -n "$T" ] && ENBID="$T"
	# Уровни здесь уже в дБ, а не индексами - точнее, чем из CESQ
	T=$(_sg "RSSI"); case "$T" in -*) RSSI="$T" ;; esac
	T=$(_sg "RSRP"); case "$T" in -*) RSRP="$T" ;; esac
	T=$(_sg "RSRQ"); case "$T" in -*) RSRQ="$T" ;; esac
	T=$(_sg "SINR")
	[ -n "$T" ] && [ "$T" != "0" ] && SINR=$(awk -v v="$T" 'BEGIN{printf "%.1f", v/10}')
	# TM - режим передачи. TM4 и выше означают пространственное мультиплексирование,
	# то есть работающий MIMO; в вебе это поле называется pmimo.
	T=$(_sg "TM"); [ -n "$T" ] && [ "$T" != "0" ] && PMIMO="TM$T"
	T=$(_sg "PATHLOSS");    [ -n "$T" ] && PATHLOSS="$T dB"
	T=$(_sg "TX_POWER");    [ -n "$T" ] && TXPOWER="$T"
	T=$(_sg "UE_category"); [ -n "$T" ] && UECAT="$T"
	# CQI приходит как "0:-" при отсутствии измерения - берём только число до ":"
	T=$(_sg "CQI"); T=${T%%:*}
	[ -n "$T" ] && [ "$T" != "0" ] && CQI="$T"
	T=$(_sg "VOLTE")
	case "$T" in 1) VOLTE="вкл" ;; 0) VOLTE="выкл" ;; esac
fi

# --- Температура --------------------------------------------------------------
# +TEMP: "cpu_temp","40" / +TEMP: "rf_temp","28". Берём радиочасть, если есть -
# она ближе к тому, что показывают остальные модемы; иначе процессор.
TP=$(sms_tool -d $DEVICE at "AT+TEMP" 2>/dev/null | tr -d '\r')
T=$(echo "$TP" | sed -n 's/^+TEMP: *"rf_temp","\([0-9-]*\)".*/\1/p' | head -1)
[ -n "$T" ] || T=$(echo "$TP" | sed -n 's/^+TEMP: *"cpu_temp","\([0-9-]*\)".*/\1/p' | head -1)
[ -n "$T" ] && TEMP="$T"

