# ===== СОСЕДНИЕ СОТЫ (AT+XMCI) ==============================================
#
# XMCI уже в батче выше, отдельных команд не добавляем. Строки типизированы:
#   +XMCI: 4,...  - ОБСЛУЖИВАЮЩАЯ сота
#   +XMCI: 5,...  - СОСЕДНЯЯ
# Живой L850-GL (MBIM-композиция, порт ttyACM0):
#   +XMCI: 4,250,20,"0x73AD","0x05813D15","0x016E","0x00000D48",...,37,16,4,...
#   +XMCI: 5,000,000,"0xFFFE","0xFFFFFFFF","0x0134","0x00000D48",...,31,11,255,...
# Поля: mcc,mnc,tac,cellid,PCI,EARFCN,(зарезервировано),rsrp,rsrq,sinr - PCI и
# EARFCN шестнадцатеричные (0x016E = 366, 0x00000D48 = 3400).
#
# ПЕРЕСЧЁТ УРОВНЕЙ ПРОВЕРЕН СВЕРКОЙ С ИНТЕЛОВСКИМИ СЧЁТЧИКАМИ на живом модеме:
#   AT+RSRP? -> 366,3400,-104.00   XMCI rsrp=37  -> 37-141      = -104 ✓
#   AT+RSRQ? -> 366,3400,-14.50    XMCI rsrq=16  -> (16-45)/2   = -14.5 ✓
# (у RSRQ шкала интеловская, а не «idx/2-19.5» из 3GPP - отсюда и сверка).
# Заглушки «неизвестно» прошивка кодирует всеми F и mcc/mnc 000 - наружу их не
# отдаём: в таблице это выглядело бы как настоящий идентификатор.
#
# SCC СЮДА НЕ ПОПАДАЮТ. Дополнительные несущие у XMM приходят через XLEC и
# AT+RSRP? и уже показаны как SCC в таблице агрегации (см. комментарий выше);
# соседи - это отдельные строки типа 5, их со SCC не путаем.
# strtonum в busybox awk НЕТ (проверено: "Call to undefined function") -
# шестнадцатеричные поля переводим вручную.
_XN=$(printf '%s' "$_XMCI_RAW" | tr -d '\r' | awk -F, '
	# Диапазон по EARFCN (3GPP TS 36.101, табл. 5.7.3-1). В ЭТОМ профиле
	# channeltoband нет (она есть у 8087095a/1bc71040), а тащить её копию в
	# шелл только ради соседей дороже, чем короткая таблица здесь.
	function e2b(e) {
		if (e <= 599) return 1;   if (e <= 1199) return 2
		if (e <= 1949) return 3;  if (e <= 2399) return 4
		if (e <= 2649) return 5
		if (e >= 2750 && e <= 3449) return 7
		if (e >= 3450 && e <= 3799) return 8
		if (e >= 6150 && e <= 6449) return 20
		if (e >= 9210 && e <= 9659) return 28
		if (e >= 37750 && e <= 38249) return 38
		if (e >= 38650 && e <= 39649) return 40
		if (e >= 39650 && e <= 41589) return 41
		return ""
	}
	function hex2dec(h,   i, c, n) {
		gsub(/^0[xX]/, "", h); h = toupper(h); n = 0
		if (h == "" || h ~ /[^0-9A-F]/) return -1
		for (i = 1; i <= length(h); i++) {
			c = index("0123456789ABCDEF", substr(h, i, 1))
			n = n * 16 + c - 1
		}
		return n
	}
	/^\+XMCI: 5,/ {
		gsub(/"/, ""); gsub(/ /, "")
		pci = hex2dec($6); earfcn = hex2dec($7)
		rsrp = $10 + 0; rsrq = $11 + 0
		# Заглушки «не знаю»: все F (после перевода - огромные числа) и нулевой
		# канал. Реальный EARFCN не бывает больше 262143 (3GPP 36.101).
		if (pci < 0 || pci > 503 || earfcn <= 0 || earfcn > 262143) next
		if (rsrp <= 0 || rsrp > 200) next
		printf "%s{\"band\":\"%s\",\"earfcn\":\"%d\",\"pci\":\"%d\",\"rsrp\":\"%d\",\"rsrq\":\"%.1f\",\"rssi\":\"\",\"serving\":0}",
			(n++ ? "," : ""), e2b(earfcn), earfcn, pci, rsrp - 141, (rsrq - 45) / 2
	}
')
# Обслуживающая - первой строкой, из уже разобранных полей профиля.
if [ -n "$PCI" ] && [ -n "$EARFCN" ]; then
	# ПОЛЯ ПРОФИЛЯ ПРИХОДЯТ С ПРОБЕЛАМИ (в снимке видно "pci":" 366") - в JSON
	# они уехали бы как есть, а channeltoband на " 3400" отвечает пусто.
	_xn_e=$(echo $EARFCN | xargs); _xn_p=$(echo $PCI | xargs)
	# Диапазон обслуживающей уже посчитан профилем в PBAND ("B7 (2600 MHz) @20 MHz") -
	# берём из него номер, чтобы таблица и заголовок не разошлись.
	_xn_b=$(printf '%s' "$PBAND" | sed -n 's/^B\([0-9]\{1,\}\).*/\1/p')
	NEIGHBORS=$(printf '{"band":"%s","earfcn":"%s","pci":"%s","rsrp":"%s","rsrq":"%s","rssi":"%s","serving":1}' \
		"$_xn_b" "$_xn_e" "$_xn_p" "$RSRP" "$RSRQ" "$RSSI")
	NEIGHBORS="$NEIGHBORS${_XN:+,$_XN}"
else
	NEIGHBORS="$_XN"
fi
