S1=$(echo "$CABANDx" | awk -F [,] '/\,/{print $2" "}' | sed 's/ //g')
S2=$(echo "$CABANDx" | awk -F [,] '/\,/{print $3" "}' | sed 's/ //g')
S3=$(echo "$CABANDx" | awk -F [,] '/\,/{print $4" "}' | sed 's/ //g')
S4=$(echo "$CABANDx" | awk -F [,] '/\,/{print $5" "}' | sed 's/ //g')

BWCA=0
BWCA_INFO=""
for T3 in $BWCx; do
	case $T3 in
		1*) T5="3";;
		2*) T5="5";;
		3*) T5="10";;
		4*) T5="15";;
		5*) T5="20";;
		*) T5="0";;
	esac
