# Quectel EC200A-EL (2c7c:6005)
#
# БОЛВАНКА, собрана по офлайн-дампу ATI/QENG/QCFG (модуля на руках НЕТ). Диалект -
# стандартный Quectel: AT+QENG="servingcell", +QTEMP, +QNWINFO, +QSPN, +QCCID -
# те же, что у EC25, поэтому разбор скопирован с 2c7c0125 и выверен по дампу
# полями. Что подтверждено дампом - помечено; что нет (шкала SINR, hex/dec у TAC) -
# оставлено как у EC25 и требует проверки на живом модуле.
#
# Дамп: EC200AELLAR01A05M16; usbnet ECM/RNDIS; AT-порт обычно /dev/ttyUSB1.
# QENG: "servingcell","NOCONN","LTE","FDD",460,11,6138907,489,100,1,5,5,7706,-65,-8,-55,35,58
#   -> поля 1:1 совпали с EC25 (PCI=$9, EARFCN=$10, ULbw=$12, DLbw=$13, TAC=$14,
#      RSRP=$15, RSRQ=$16, RSSI=$17, SINR=$18).

. "$RES/modem/usb/_quectel_common"

# --- Температура --------------------------------------------------------------
# +QTEMP: 37,255,255 - у EC200A незанятые датчики отдают 255 (нет значения).
# Общий EC25-разбор берёт МАКСИМУМ из трёх и на таком ответе вернул бы 255;
# поэтому берём максимум ТОЛЬКО среди значений != 255.
O=$(sms_tool -d $DEVICE at "at+qtemp")
T=$(echo "$O" | awk -F[,:] '/^\+QTEMP/ {t=-999; for(i=2;i<=4;i++){v=$i*1; if(v!=255 && v>t) t=v} if(t>-999) printf "%d", t}')
[ -n "$T" ] && TEMP="$T &deg;C"

if [ "$REGOK" = "1" ]; then
	# TAC: у EC25 приходит hex (разбираем через 0x$T). У EC200A в дампе TAC=7706 -
	# по конвенции Quectel это тоже hex; если на живом модуле окажется dec, убрать
	# "0x". Показываем и dec, и hex.
	# SINR: у EC21/EC25 в QENG уже в дБ (см. 2c7c0125). Для EC200A шкала НЕ
	# проверена живьём - оставляем как есть; если окажется «сырой» (0..250),
	# понадобится масштаб, как у некоторых модулей.
	_qc_ec25_lte
fi

_qc_ids

# Modem
_qc_ati

# EC200A-EL: usbnet бывает ECM (cdc_ether) или RNDIS - в дампе оба допустимы.
_qc_proto "Vendor=2c7c ProdID=6005" 1220 rndis

. "$RES/modem/usb/_quectel_qrsrp"
