convert_bw() {
  case "${1}" in
    "6") echo "1.4 MHz";;
    "15") echo "3 MHz";;
    "25") echo "5 MHz";;
    "50") echo "10 MHz";;
    "75") echo "15 MHz";;
    "100") echo "20 MHz";;
    "125") echo "25 MHz";;
    "150") echo "30 MHz";;
    "200") echo "40 MHz";;
    "250") echo "50 MHz";;
    "300") echo "60 MHz";;
    "400") echo "80 MHz";;
    "450") echo "90 MHz";;
    "500") echo "100 MHz";;
    "1000") echo "200 MHz";;
    "2000") echo "400 MHz";;
    *) echo "";;
  esac
}

convert_mod() {
  case "${1}" in
    "0") echo "BPSK";;
    "1") echo "QPSK";;
    "2") echo "16QAM";;
    "3") echo "64QAM";;
    "4") echo "256QAM";;
    "5") echo "1024QAM";;
    *) echo "";;
  esac
}

earfcn2band() {
	[ -n "$1" ] || return
	e=$1
	if   [ "$e" -le 599 ];   then echo 1
	elif [ "$e" -le 1199 ];  then echo 2
	elif [ "$e" -le 1949 ];  then echo 3
	elif [ "$e" -le 2399 ];  then echo 4
	elif [ "$e" -le 2649 ];  then echo 5
	elif [ "$e" -ge 2750 ] && [ "$e" -le 3449 ]; then echo 7
	elif [ "$e" -ge 3450 ] && [ "$e" -le 3799 ]; then echo 8
	elif [ "$e" -ge 5010 ] && [ "$e" -le 5179 ]; then echo 12
	elif [ "$e" -ge 5180 ] && [ "$e" -le 5279 ]; then echo 13
	elif [ "$e" -ge 5280 ] && [ "$e" -le 5379 ]; then echo 14
	elif [ "$e" -ge 5730 ] && [ "$e" -le 5849 ]; then echo 17
	elif [ "$e" -ge 5850 ] && [ "$e" -le 5999 ]; then echo 18
	elif [ "$e" -ge 6000 ] && [ "$e" -le 6149 ]; then echo 19
	elif [ "$e" -ge 6150 ] && [ "$e" -le 6449 ]; then echo 20
	elif [ "$e" -ge 8040 ] && [ "$e" -le 8689 ]; then echo 25
	elif [ "$e" -ge 8690 ] && [ "$e" -le 9039 ]; then echo 26
	elif [ "$e" -ge 9210 ] && [ "$e" -le 9659 ]; then echo 28
	elif [ "$e" -ge 9660 ] && [ "$e" -le 9769 ]; then echo 29
	elif [ "$e" -ge 9770 ] && [ "$e" -le 9869 ]; then echo 30
	elif [ "$e" -ge 9920 ] && [ "$e" -le 10359 ]; then echo 32
	elif [ "$e" -ge 36200 ] && [ "$e" -le 36349 ]; then echo 34
	elif [ "$e" -ge 37750 ] && [ "$e" -le 38249 ]; then echo 38
	elif [ "$e" -ge 38250 ] && [ "$e" -le 38649 ]; then echo 39
	elif [ "$e" -ge 38650 ] && [ "$e" -le 39649 ]; then echo 40
	elif [ "$e" -ge 39650 ] && [ "$e" -le 41589 ]; then echo 41
	elif [ "$e" -ge 41590 ] && [ "$e" -le 43589 ]; then echo 42
	elif [ "$e" -ge 43590 ] && [ "$e" -le 45589 ]; then echo 43
	elif [ "$e" -ge 46790 ] && [ "$e" -le 54539 ]; then echo 46
	elif [ "$e" -ge 55240 ] && [ "$e" -le 56739 ]; then echo 48
	elif [ "$e" -ge 66436 ] && [ "$e" -le 67335 ]; then echo 66
	elif [ "$e" -ge 68586 ] && [ "$e" -le 68935 ]; then echo 71
	fi
}

O=$(sms_tool -d $DEVICE at "AT+GTCCINFO?;+GTCAINFO?;+CESQ;+GTRXPATHEN?")

case "$MODE_NUM" in
  7*) 
       if echo "$O" | grep -q -E '^SCC'; then
         MODE="LTE-A |"
       fi
       ;;
  11*) 
       MODE="5G SA |"
       ;;
  13*) NSA_CLAIM=1
       ;;
esac

T_MODE=""

T1=$(echo "$O" | grep -E "^1,[49]," | head -1)
if [ -n "$T1" ]; then
  _oIFS=$IFS; IFS=','; set -- $T1; IFS=$_oIFS
  _F2=$2; _F5=$5; _F7=$7; _F8=$8; _F9=$9; _F11=${11}; _F13=${13}; _F14=${14}
  T_RAT=$_F2
  T=$_F5
  if [ -n "$T" ]; then
    T_DEC=$(printf "%d" "0x$T" 2>/dev/null)
    T_HEX=$T
  fi
  T=$_F7
  if [ -n "$T" ]; then
    EARFCN=$T
  fi
  T=$_F8
  if [ -n "$T" ]; then
    PCI=$T
  fi
  T=$_F9
  if [ -n "$T" ]; then
    case $T_RAT in
      4)
        T=$((T - 100))
        T_MODE="$(band4g $T)"
        PBAND="$(band4g $T)"
        ;;
      9)
        T=$(echo "$T" | sed 's/^50//')
        T_MODE="$(band5g $T)"
        PBAND="$(band5g $T)"
        ;;
    esac
  elif [ "$T_RAT" = "4" ] && [ -n "$EARFCN" ]; then
    T=$(earfcn2band "$EARFCN")
    if [ -n "$T" ]; then
      T_MODE="$(band4g $T)"
      PBAND="$(band4g $T)"
      MODE="$MODE $(band4g $T)"
    fi
  fi
  T=$_F11
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge -100 ] && [ "$T" -le 100 ] && SINR=$(echo "$T" | awk '{printf "%0.1f", $1 }');;
      9) [ "$T" -ge 0 ] && [ "$T" -le 127 ] && SINR=$(echo "$T" | awk '{printf "%0.1f", ($1-45)/2-1 }');;
    esac
  fi
  T=$_F13
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge 0 ] && [ "$T" -le 140 ] && RSRP=$((T - 141));;
      9) [ "$T" -ge 0 ] && [ "$T" -le 157 ] && RSRP=$((T - 157));;
    esac
  fi
  T=$_F14
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge 0 ] && [ "$T" -le 40 ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", ($1-34)/2-3 }');;
      9) [ "$T" -ge 0 ] && [ "$T" -le 127 ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", ($1-87)/2 }');;
    esac
  fi
  if [ "$CSQ" -ge 0 ] 2>/dev/null && [ "$CSQ" -le 31 ]; then
    RSSI=$((2 * CSQ - 113))
  fi
fi

NEIGHBORS=$(echo "$O" | awk -F, '
	function e2b(e) {
		if (e == "" || e + 0 != e) return ""
		e = e + 0
		if (e <= 599) return 1;  if (e <= 1199) return 2
		if (e <= 1949) return 3;  if (e <= 2399) return 4
		if (e <= 2649) return 5
		if (e >= 2750 && e <= 3449) return 7
		if (e >= 3450 && e <= 3799) return 8
		if (e >= 5010 && e <= 5179) return 12
		if (e >= 5180 && e <= 5279) return 13
		if (e >= 5280 && e <= 5379) return 14
		if (e >= 5730 && e <= 5849) return 17
		if (e >= 5850 && e <= 5999) return 18
		if (e >= 6000 && e <= 6149) return 19
		if (e >= 6150 && e <= 6449) return 20
		if (e >= 8040 && e <= 8689) return 25
		if (e >= 8690 && e <= 9039) return 26
		if (e >= 9210 && e <= 9659) return 28
		if (e >= 9660 && e <= 9769) return 29
		if (e >= 9770 && e <= 9869) return 30
		if (e >= 9920 && e <= 10359) return 32
		if (e >= 36200 && e <= 36349) return 34
		if (e >= 37750 && e <= 38249) return 38
		if (e >= 38250 && e <= 38649) return 39
		if (e >= 38650 && e <= 39649) return 40
		if (e >= 39650 && e <= 41589) return 41
		if (e >= 41590 && e <= 43589) return 42
		if (e >= 43590 && e <= 45589) return 43
		if (e >= 46790 && e <= 54539) return 46
		if (e >= 55240 && e <= 56739) return 48
		if (e >= 66436 && e <= 67335) return 66
		if (e >= 68586 && e <= 68935) return 71
		return ""
	}
	function lvl(v, base,   x) {
		if (v == "" || v + 0 != v || v == 255) return ""
		x = v + 0
		if (x < 0 || x > 200) return ""
		return x + base
	}
	function half(v, base,   x) {
		if (v == "" || v + 0 != v || v == 255) return ""
		x = v + 0
		if (x < 0 || x > 200) return ""
		return sprintf("%.1f", base + x / 2)
	}
	/^(PCC|SCC *[0-9]*):/ {
		gsub(/\r/, "")
		k = split($0, ca, ",")
		if ($0 ~ /^PCC/) { if (k >= 3 && ca[3] + 0 > 0) known[ca[3] + 0] = 1 }
		else if (k >= 5 && ca[5] + 0 > 0) known[ca[5] + 0] = 1
		next
	}
	/^[12],[249],/ {
		gsub(/\r/, "")
		srv = ($1 == 1) ? 1 : 0
		rat = $2 + 0
		arfcn = $7; pci = $8
		band = ""; rsrp = ""; rsrq = ""
		if (rat == 4) {
			if (srv) { band = $9; rsrp = lvl($13, -141); rsrq = half($14, -20) }
			else     {            rsrp = lvl($11, -141); rsrq = half($12, -20) }
			if (band != "" && band + 0 > 100) band = band - 100; else band = e2b(arfcn)
		} else if (rat == 9) {
			if (srv) { band = $9; rsrp = lvl($13, -157); rsrq = half($14, -43.5) }
			else     {            rsrp = lvl($11, -157); rsrq = half($12, -43.5) }
			sub(/^50/, "", band)
		} else {
			if (srv) rsrp = lvl($11, -121); else rsrp = lvl($15, -121)
		}
		if (pci == "") next
		if (!srv && (pci !~ /^[0-9]+$/ || pci + 0 > (rat == 9 ? 1007 : (rat == 4 ? 503 : 511)))) next
		if (arfcn + 0 > 0 && (srv || arfcn !~ /0$/)) known[arfcn + 0] = 1
		r++
		rw_rat[r] = rat; rw_srv[r] = srv; rw_band[r] = band; rw_arfcn[r] = arfcn
		rw_pci[r] = pci; rw_rsrp[r] = rsrp; rw_rsrq[r] = rsrq
	}
	END {
		for (i = 1; i <= r; i++) {
			a = rw_arfcn[i]
			if (rw_rat[i] == 4 && !rw_srv[i] && a ~ /^[0-9]+0$/ && !((a + 0) in known)) {
				t = int(a / 10)
				if ((t in known) || (e2b(a) == "" && e2b(t) != "")) {
					rw_arfcn[i] = t; rw_band[i] = e2b(t)
				}
			}
			printf "%s{\"band\":\"%s\",\"earfcn\":\"%s\",\"pci\":\"%s\",\"rsrp\":\"%s\",\"rsrq\":\"%s\",\"rssi\":\"\",\"serving\":%s}",
				(n++ ? "," : ""), rw_band[i], rw_arfcn[i], rw_pci[i], rw_rsrp[i], rw_rsrq[i], rw_srv[i]
		}
	}
')

if [ -z "$T1" ]; then
  _CE=$(echo "$O" | grep -E '^\+CESQ:' | head -1 | sed 's/^+CESQ:[[:space:]]*//')
  if [ -n "$_CE" ]; then
    _RSCP=$(echo "$_CE" | awk -F, '{print $3}' | tr -d ' ')
    _ECNO=$(echo "$_CE" | awk -F, '{print $4}' | tr -d ' ')
    if [ -n "$_RSCP" ] && [ "$_RSCP" -ge 0 ] && [ "$_RSCP" -le 96 ] 2>/dev/null; then
      RSCP=$((_RSCP - 121))
    fi
    if [ -n "$_ECNO" ] && [ "$_ECNO" -ge 0 ] && [ "$_ECNO" -le 49 ] 2>/dev/null; then
      ECIO=$(echo "$_ECNO" | awk '{printf "%0.1f", -24 + $1/2}')
    fi
  fi
  if [ -n "$RSCP" ] && [ "$CSQ" -ge 0 ] 2>/dev/null && [ "$CSQ" -le 31 ]; then
    RSSI=$((2 * CSQ - 113))
  fi
fi

_RXP=$(echo "$O" | tr -d '\r' | sed -n 's/^+GTRXPATHEN:[[:space:]]*[0-9]*,\([0-9]*\).*/\1/p' | head -1)
case "$_RXP" in
	''|*[!0-9]*) ;;
	*)
		_RXN=0
		for _RXB in 1 2 4 8; do
			[ $(( _RXP & _RXB )) -ne 0 ] && _RXN=$((_RXN + 1))
		done
		case "$_RXN" in
			1) RXDIV="off";;
			2) RXDIV="2rx";;
			3|4) RXDIV="4rx";;
		esac
		;;
esac

IFS="
"
IDX=1
LINES=$(echo "$O" | grep -E '^PCC:')
[ -n "$LINES" ] && T_MODE=""

T_4G_MODE=""
T_4G_PBAND=""
T_4G_NRB=""
T_4G_PCI=""
T_4G_EARFCN=""
T_4G_PRSRP=""

T_5G_MODE=""
T_5G_PBAND=""
T_5G_PCI=""
T_5G_EARFCN=""

for LINE in $LINES; do
  _oIFS=$IFS; IFS=':,'; set -- $LINE; IFS=$_oIFS
  T_BAND=$2
  T_PCI=$3
  T_EARFCN=$4
  T_DBW=$5
  if [ "$#" -ge 11 ] || { [ "$#" -eq 10 ] && [ "${6:-0}" -gt 4 ] 2>/dev/null; }; then
    T_MIMO=$7
    T_MOD=$(convert_mod "$9")
  else
    T_MIMO=$6
    T_MOD=$(convert_mod "$8")
  fi
  case "$T_MIMO" in
    1|2|3|4) ;;
    *) T_MIMO=""; T_MOD="";;
  esac

  if [ -n "$T_BAND" ]; then
    DBW=""
    if [ -n "$T_DBW" -a "$T_DBW" -ne "0" ]; then
      DBW=" @$(convert_bw $T_DBW)"
    fi

    if [ "$T_BAND" -lt "200" ]; then
      T_BAND=$((T_BAND - 100))
      T_4G_MODE="$(band4g ${T_BAND}) + "
      T_4G_PBAND="$(band4g ${T_BAND})${DBW}"
      T_4G_NRB="$T_DBW"
      T_4G_PCI="$T_PCI"
      T_4G_EARFCN="$T_EARFCN"
      T_4G_MIMO="$T_MIMO"
      T_4G_MOD="$T_MOD"
      eval T_4G_PRSRP=\${$#}
      T_4G_PRSRP=$(printf '%s' "$T_4G_PRSRP" | tr -cd '0-9-')
    elif [ "$T_BAND" -gt "500" ]; then
      T_BAND=$(echo "$T_BAND" | sed 's/^50//')
      T_5G_MODE="$(band5g ${T_BAND}) + "
      T_5G_PBAND="$(band5g ${T_BAND})${DBW}"
      T_5G_PCI="$T_PCI"
      T_5G_EARFCN="$T_EARFCN"
      T_5G_MIMO="$T_MIMO"
      T_5G_MOD="$T_MOD"
    fi
  fi

  IDX=$((IDX + 1))
done

if [ -n "$T_4G_PBAND" ]; then
  PBAND="$T_4G_PBAND"
  PCI="$T_4G_PCI"
  EARFCN="$T_4G_EARFCN"
  PMIMO="$T_4G_MIMO"
  PMOD="$T_4G_MOD"
elif [ -n "$T_5G_PBAND" ]; then
  PBAND="$T_5G_PBAND"
  PCI="$T_5G_PCI"
  EARFCN="$T_5G_EARFCN"
  PMIMO="$T_5G_MIMO"
  PMOD="$T_5G_MOD"
fi

IFS="
"
IDX=1
LINES=$(echo "$O" | grep -E '^SCC\s?[0-9]:2,')
for LINE in $LINES; do
  _oIFS=$IFS; IFS=':,'; set -- $LINE; IFS=$_oIFS
  _lidx="${1#SCC}"; _lidx="${_lidx# }"
  if [ "$_lidx" = "$IDX" ]; then
    _S4=$4; _S5=$5; _S6=$6; _S7=$7; _S9=$9; _S11=${11}; _S13=${13}; [ "$#" -ge 15 ] && _S13=${15}
  else
    _S4=""; _S5=""; _S6=""; _S7=""; _S9=""; _S11=""; _S13=""
  fi
  T=$_S4
  if [ -n "$T" ]; then
    T_DBW=$_S7
    DBW=""
    if [ -n "$T_DBW" -a "$T_DBW" -ne "0" ]; then
      DBW=" @$(convert_bw $T_DBW)"
    fi
    T2=""
    if [ "$T" -lt "200" ]; then
      T=$((T - 100))
      T2="$(band4g $T)${DBW}"
      T_4G_MODE="${T_4G_MODE}$(band4g $T) + "
    elif [ "$T" -gt "500" ]; then
      T=$(echo "$T" | sed 's/^50//')
      T2="$(band5g $T)${DBW}"
      T_5G_MODE="${T_5G_MODE}$(band5g $T) + "
    fi
    if [ -n "$T2" ]; then
      case $IDX in
        "1") S1BAND="$T2"; S1STATE="activated";;
        "2") S2BAND="$T2"; S2STATE="activated";;
        "3") S3BAND="$T2"; S3STATE="activated";;
        "4") S4BAND="$T2"; S4STATE="activated";;
        *);;
      esac
    fi
  fi
  
  T=$_S5
  if [ -n "$T" ]; then
    case $IDX in
      "1") S1PCI="$T";;
      "2") S2PCI="$T";;
      "3") S3PCI="$T";;
      "4") S4PCI="$T";;
      *);;
    esac
  fi
  
  T=$_S6
  if [ -n "$T" ]; then
    case $IDX in
      "1") S1EARFCN="$T";;
      "2") S2EARFCN="$T";;
      "3") S3EARFCN="$T";;
      "4") S4EARFCN="$T";;
      *);;
    esac
  fi

  T=$_S13
  if [ -n "$T" ] && [ "$T" != "255" ] && [ "$T" -le -40 ] 2>/dev/null && [ "$T" -ge -157 ] 2>/dev/null; then
    case $IDX in
      "1") S1RSRP="$T";;
      "2") S2RSRP="$T";;
      "3") S3RSRP="$T";;
      "4") S4RSRP="$T";;
      *);;
    esac
  fi

  T_SMIMO=$_S9
  case "$T_SMIMO" in
    1|2|3|4)
      T_SMOD=$(convert_mod ""$_S11"")
      case $IDX in
        "1") S1MIMO="$T_SMIMO"; S1MOD="$T_SMOD";;
        "2") S2MIMO="$T_SMIMO"; S2MOD="$T_SMOD";;
        "3") S3MIMO="$T_SMIMO"; S3MOD="$T_SMOD";;
        "4") S4MIMO="$T_SMIMO"; S4MOD="$T_SMOD";;
        *);;
      esac
      ;;
  esac

  IDX=$((IDX + 1))
done

case "$T_4G_PRSRP" in
  -[0-9]*)
    _cp_n=0; _cp_same=0; _cp_other=0
    for _cp_i in 1 2 3 4; do
      eval _cp_r=\$S${_cp_i}RSRP
      eval _cp_p=\$S${_cp_i}PCI
      _cp_r=$(printf '%s' "$_cp_r" | tr -d '\r')
      [ -n "$_cp_r" ] || continue
      _cp_n=$((_cp_n + 1))
      [ "$_cp_r" = "$T_4G_PRSRP" ] && _cp_same=$((_cp_same + 1))
      [ "$_cp_p" != "$PCI" ] && _cp_other=1
    done
    if [ "$_cp_n" -ge 2 ] && [ "$_cp_same" = "$_cp_n" ] && [ "$_cp_other" = 1 ]; then
      for _cp_i in 1 2 3 4; do
        eval _cp_p=\$S${_cp_i}PCI
        [ "$_cp_p" != "$PCI" ] && eval S${_cp_i}RSRP=""
      done
    fi
    ;;
esac

T_4G_MODE=$(echo "$T_4G_MODE" | sed 's/ [\/\+] $//')
T_5G_MODE=$(echo "$T_5G_MODE" | sed 's/ [\/\+] $//')

if [ -n "$T_4G_PBAND" -a -n "$T_5G_PBAND" ]; then
  if [ -n "$T_5G_PBAND" ]; then
    case $IDX in
      "1") S1BAND="$T_5G_PBAND";;
      "2") S2BAND="$T_5G_PBAND";;
      "3") S3BAND="$T_5G_PBAND";;
      "4") S4BAND="$T_5G_PBAND";;
      *);;
    esac
  fi

  if [ -n "$T_5G_PCI" ]; then
    case $IDX in
      "1") S1PCI="$T_5G_PCI";;
      "2") S2PCI="$T_5G_PCI";;
      "3") S3PCI="$T_5G_PCI";;
      "4") S4PCI="$T_5G_PCI";;
      *);;
    esac
  fi

  if [ -n "$T_5G_EARFCN" ]; then
    case $IDX in
      "1") S1EARFCN="$T_5G_EARFCN";;
      "2") S2EARFCN="$T_5G_EARFCN";;
      "3") S3EARFCN="$T_5G_EARFCN";;
      "4") S4EARFCN="$T_5G_EARFCN";;
      *);;
    esac
  fi
fi

if [ -n "$NSA_CLAIM" ]; then
  if [ -n "$T_5G_MODE" ] || [ -n "$T_5G_PBAND" ]; then
    MODE="5G NSA |"
  elif echo "$O" | grep -q -E '^SCC'; then
    MODE="LTE-A |"
  else
    MODE="LTE |"
  fi
fi

if [ -z "$T_MODE" ]; then
  if [ -n "$T_4G_MODE" ]; then
    MODE="$MODE $T_4G_MODE"
  fi

  if [ -n "$T_5G_MODE" ]; then
    [ -n "$T_4G_MODE" ] && MODE="$MODE /"
    MODE="$MODE $T_5G_MODE"
  fi
fi

if [ -z "$RSRP" ]; then
	CE_RSRP=$(echo "$O" | tr -d '\r' | sed -n 's/.*+CESQ:[[:space:]]*//p' | head -1 | awk -F, '{print $6}')
	case "$CE_RSRP" in
		''|255|*[!0-9]*) : ;;
		*) RSRP=$((CE_RSRP - 141)) ;;
	esac
fi

case "$T_4G_NRB" in
  6) _NRB_DB=7.8 ;; 15) _NRB_DB=11.8 ;; 25) _NRB_DB=14.0 ;;
  50) _NRB_DB=17.0 ;; 75) _NRB_DB=18.8 ;; 100) _NRB_DB=20.0 ;;
  *) _NRB_DB="" ;;
esac
if [ -n "$_NRB_DB" ] && [ -n "$T_4G_PBAND" ] && [ -n "$RSRP" ] && [ -n "$RSRQ" ]; then
  _WB=$(awk -v p="$RSRP" -v q="$RSRQ" -v n="$_NRB_DB" 'BEGIN { r = p - q + n; if (r >= -120 && r <= -25) printf "%.0f", r }')
  [ -n "$_WB" ] && RSSI="$_WB"
fi

SIGCACHE="/tmp/5gmodem/fm350_sig_${DEVICE##*/}"
if [ -n "$RSRP" ]; then
	CSQ_PER=$(sig_percent "$MODE" "$RSRP" "$RSRQ" "$SINR")
	CSQ=$(( 31 * CSQ_PER / 100 ))
	echo "$CSQ_PER" > "$SIGCACHE" 2>/dev/null
elif [ -f "$SIGCACHE" ] && [ -z "$(find "$SIGCACHE" -mmin +2 2>/dev/null)" ]; then
	CSQ_PER=$(cat "$SIGCACHE" 2>/dev/null)
	[ -n "$CSQ_PER" ] && CSQ=$(( 31 * CSQ_PER / 100 ))
fi

OA=$(at_static cgmm "AT+CGMM?")
MODELA=$(echo "$OA" | awk -F [:,] '/\+CGMM/{print $2}' | xargs)
OB=$(at_static cgmi "AT+CGMI?")
MODELB=$(echo "$OB" | awk -F [:,] '/\+CGMI/{print $2}' | xargs)
MODELBCUT=$(echo $MODELB | sed s/"Wireless Inc."//)
MODEL=$(echo "$MODELBCUT $MODELA" | xargs)

OF=$(at_static gmr "AT+GMR?" '\+GMR:')
FW=$(echo "$OF" | awk -F[,:] '/\+GMR:/ {print $2}' | xargs)
if [ -z "$FW" ]; then
	OF=$(at_static gtpkgver "AT+GTPKGVER?" '\+GTPKGVER:')
	FW=$(echo "$OF" | awk -F'"' '/\+GTPKGVER:/ {print $2}' | cut -d_ -f1 | xargs)
fi

OAA=$(at_static cgsn "AT+CGSN?")
NR_IMEI=$(echo "$OAA" | awk -F[,:] '/\+CGSN:/ {print $2}' | xargs)

[ -n "$SIMID" ] && NR_IMSI="$SIMID" || NR_IMSI=$(at_static cimi "AT+CIMI?" | awk -F [,:] '/\+CIMI:/ {print $2}' | xargs)

OCC=$(at_static iccid "AT+ICCID")
NR_ICCID=$(echo "$OCC" | awk -F [,:] '/\+ICCID:/ {print $2}' | xargs)

OT=$(sms_tool -d "$DEVICE" at "AT+ETHERMAL?")
TM=$(echo "$OT" | awk 'BEGIN{m=-999}
	/\+ETHERMAL:/ {
		s = $0; sub(/^.*\+ETHERMAL:/, "", s)
		n = split(s, a, ",")
		if (n >= 2) { v = a[2] + 0; if (v > -40 && v < 120 && v > m) m = v }
	}
	END { if (m > -999) printf "%.1f", m }' | xargs)
_TF="/tmp/5gmodem/temp_$(basename "$DEVICE")"
if [ -n "$TM" ]; then
	_prev=""; _cnt=0; _ptime=0
	[ -f "$_TF" ] && IFS=' ' read -r _prev _cnt _ptime < "$_TF" 2>/dev/null
	case "$_ptime" in ''|*[!0-9]*) _ptime=0 ;; esac
	case "$_cnt" in ''|*[!0-9]*) _cnt=0 ;; esac
	_now=$(cut -d. -f1 /proc/uptime)
	_use="$TM"; _new=0

	if [ -n "$_prev" ] && [ "$((_now - _ptime))" -lt 120 ]; then
		_d=$(awk -v a="$TM" -v b="$_prev" 'BEGIN{d=a-b; if(d<0)d=-d; printf "%d", d}')
		if [ "$_d" -gt 15 ]; then
			_new=$((_cnt + 1))
			if [ "$_new" -ge 3 ]; then
				_use="$TM"; _new=0
			else
				_use="$_prev"
			fi
		fi
	fi
	printf '%s %s %s\n' "$_use" "$_new" "$_now" > "$_TF"
	TEMP="$_use &deg;C"
fi

TTY=$(basename "$DEVICE")
devpath=$(readlink -f "/sys/class/tty/$TTY/device" 2>/dev/null)
BASE=""
[ -n "$devpath" ] && BASE=$(readlink -f "${devpath%/*/*}" 2>/dev/null)
NETDRV=""
if [ -n "$BASE" ]; then
	NETIF=$(for a in /sys/class/net/*; do readlink -f "$a"; done | grep "^$BASE/" | head -1)
	[ -n "$NETIF" ] && NETDRV=$(basename "$(readlink -f "$NETIF/../../driver" 2>/dev/null)")
fi

case $NETDRV in
  "qmi_wwan")
    PROTO="qmi";;
  "cdc_mbim")
    PROTO="mbim";;
  "cdc_ether")
     PROTO="ecm";;
   "rndis_host")
     PROTO="ncm";;
esac
