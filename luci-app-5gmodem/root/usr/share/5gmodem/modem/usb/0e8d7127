# Fibocom modems with ProdID=0e8d +GTUSBMODE: 41
# Fibocom FM350-GL

convert_bw() {
  case "${1}" in
    "6") echo "1.4 MHz";;
    "15") echo "3 MHz";;
    "25") echo "5 MHz";;
    "50") echo "10 MHz";;
    "75") echo "15 MHz";;
    "100") echo "20 MHz";;
    "125") echo "25 MHz";;
    "150") echo "30 MHz";;
    "200") echo "40 MHz";;
    "250") echo "50 MHz";;
    "300") echo "60 MHz";;
    "400") echo "80 MHz";;
    "450") echo "90 MHz";;
    "500") echo "100 MHz";;
    "1000") echo "200 MHz";;
    "2000") echo "400 MHz";;
    *) echo "";;
  esac
}

# Модуляция из GTCAINFO (<dl_modulation>/<ul_modulation>, мануал 11.1.16):
# 0 BPSK, 1 QPSK, 2 16QAM, 3 64QAM, 4 256QAM, 5 1024QAM, 6 UNKNOWN.
convert_mod() {
  case "${1}" in
    "0") echo "BPSK";;
    "1") echo "QPSK";;
    "2") echo "16QAM";;
    "3") echo "64QAM";;
    "4") echo "256QAM";;
    "5") echo "1024QAM";;
    *) echo "";;
  esac
}

# This FM350-GL firmware's GTCCINFO does NOT carry a band field, so derive the
# LTE band from the serving EARFCN (E-UTRA DL channel, 3GPP TS 36.101 Table 5.7.3-1).
earfcn2band() {
	[ -n "$1" ] || return
	e=$1
	if   [ "$e" -le 599 ];   then echo 1
	elif [ "$e" -le 1199 ];  then echo 2
	elif [ "$e" -le 1949 ];  then echo 3
	elif [ "$e" -le 2399 ];  then echo 4
	elif [ "$e" -le 2649 ];  then echo 5
	elif [ "$e" -ge 2750 ] && [ "$e" -le 3449 ]; then echo 7
	elif [ "$e" -ge 3450 ] && [ "$e" -le 3799 ]; then echo 8
	elif [ "$e" -ge 5010 ] && [ "$e" -le 5179 ]; then echo 12
	elif [ "$e" -ge 5180 ] && [ "$e" -le 5279 ]; then echo 13
	elif [ "$e" -ge 5730 ] && [ "$e" -le 5849 ]; then echo 17
	elif [ "$e" -ge 5850 ] && [ "$e" -le 5999 ]; then echo 18
	elif [ "$e" -ge 6000 ] && [ "$e" -le 6149 ]; then echo 19
	elif [ "$e" -ge 6150 ] && [ "$e" -le 6449 ]; then echo 20
	elif [ "$e" -ge 8040 ] && [ "$e" -le 8689 ]; then echo 25
	elif [ "$e" -ge 8690 ] && [ "$e" -le 9039 ]; then echo 26
	elif [ "$e" -ge 9210 ] && [ "$e" -le 9659 ]; then echo 28
	elif [ "$e" -ge 36200 ] && [ "$e" -le 36349 ]; then echo 34
	elif [ "$e" -ge 37750 ] && [ "$e" -le 38249 ]; then echo 38
	elif [ "$e" -ge 38250 ] && [ "$e" -le 38649 ]; then echo 39
	elif [ "$e" -ge 38650 ] && [ "$e" -le 39649 ]; then echo 40
	elif [ "$e" -ge 39650 ] && [ "$e" -le 41589 ]; then echo 41
	elif [ "$e" -ge 41590 ] && [ "$e" -le 43589 ]; then echo 42
	fi
}

O=$(sms_tool -d $DEVICE at "AT+GTCCINFO?;+GTCAINFO?;+CESQ")

case "$MODE_NUM" in
  7*) 
       if echo "$O" | grep -q -E '^SCC'; then
         MODE="LTE-A |"
       fi
       ;;
  11*) 
       MODE="5G SA |"
       ;;
  13*) MODE="5G NSA |"
       ;;
esac

T_MODE=""

# serving cell = first GTCCINFO data row (index 1). Row layout per the FM350
# AT manual (V2.10, 11.1.15), подтверждено живым выводом (EARFCN=3400 у B7,
# PCI=366 <= 503):
#   idx,rat,mcc,mnc,TAC(hex),CellID(hex),EARFCN,PCI,band,bw,SINR,rxlev,RSRP,RSRQ
# ВАЖНО: в унаследованном коде $7/$8 были перепутаны (PCI<->EARFCN). Из-за
# этого при пустом GTCAINFO (RRC idle) fallback считал бэнд из PCI как из
# EARFCN и pband прыгал (B1<->B3) на каждый переход idle<->active.
T1=$(echo "$O" | grep -A3 '+GTCCINFO:' | grep -E "^1,[49]," | head -1)
if [ -n "$T1" ]; then
  T_RAT=$(echo "$T1" | awk -F, '{print $2}')
  T=$(echo "$T1" | awk -F, '{print $5}')
  if [ -n "$T" ]; then
    T_DEC=$(printf "%d" "0x$T" 2>/dev/null)
    T_HEX=$T
  fi
  T=$(echo "$T1" | awk -F, '{print $7}')
  if [ -n "$T" ]; then
    EARFCN=$T
  fi
  T=$(echo "$T1" | awk -F, '{print $8}')
  if [ -n "$T" ]; then
    PCI=$T
  fi
  # band: prefer an explicit field ($9, index+100) if the firmware ever provides
  # one; otherwise derive it from the EARFCN (this unit leaves $9 empty).
  T=$(echo "$T1" | awk -F, '{print $9}')
  if [ -n "$T" ]; then
    case $T_RAT in
      4)
        T=$((T - 100))
        T_MODE="$(band4g $T)"
        PBAND="$(band4g $T)"
        ;;
      9)
        T=$(echo "$T" | sed 's/^50//')
        T_MODE="$(band5g $T)"
        PBAND="$(band5g $T)"
        ;;
    esac
  elif [ "$T_RAT" = "4" ] && [ -n "$EARFCN" ]; then
    T=$(earfcn2band "$EARFCN")
    if [ -n "$T" ]; then
      T_MODE="$(band4g $T)"
      PBAND="$(band4g $T)"
      MODE="$MODE $(band4g $T)"
    fi
  fi
  # Метрики берём ТОЛЬКО в допустимых по мануалу диапазонах (11.1.15): при
  # реинициализации прошивка шлёт мусор (напр. rssnr=8192 -> «SINR 4096.0 dB»
  # растягивал таблицу в горизонтальный скролл и дёргал страницу).
  T=$(echo "$T1" | awk -F, '{print $11}')
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge -100 ] && [ "$T" -le 100 ] && SINR=$(echo "$T" | awk '{printf "%0.1f", $1/2 }');;
      9) [ "$T" -ge 0 ] && [ "$T" -le 127 ] && SINR=$(echo "$T" | awk '{printf "%0.1f", ($1-45)/2-1 }');;
    esac
  fi
  T=$(echo "$T1" | awk -F, '{print $13}')
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge 0 ] && [ "$T" -le 140 ] && RSRP=$((T - 141));;
      9) [ "$T" -ge 0 ] && [ "$T" -le 157 ] && RSRP=$((T - 157));;
    esac
  fi
  T=$(echo "$T1" | awk -F, '{print $14}')
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge 0 ] && [ "$T" -le 40 ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", ($1-34)/2-3 }');;
      9) [ "$T" -ge 0 ] && [ "$T" -le 127 ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", ($1-87)/2 }');;
    esac
  fi
  if [ -n "$CSQ" ]; then
    RSSI=$((2 * $CSQ -113))
  fi
fi

# 3G (UMTS/HSPA): нет строки GTCCINFO с RAT 4/9, значит T1 пуст. Метрики берём из
# СТАНДАРТНОГО +CESQ (3GPP TS 27.007 8.69). FM350 расширяет +CESQ полями NR, но
# первые шесть остаются rxlev,ber,rscp,ecno,rsrq,rsrp. На WCDMA rsrq/rsrp = 255,
# а rscp/ecno несут реальный сигнал. НЕ трогаем CSQ: на 3G он честно совпадает с
# RSCP (в отличие от LTE, где мы правили его через RSRP).
if [ -z "$T1" ]; then
  _CE=$(echo "$O" | grep -E '^\+CESQ:' | head -1 | sed 's/^+CESQ:[[:space:]]*//')
  if [ -n "$_CE" ]; then
    _RSCP=$(echo "$_CE" | awk -F, '{print $3}' | tr -d ' ')
    _ECNO=$(echo "$_CE" | awk -F, '{print $4}' | tr -d ' ')
    # rscp: 0..96 -> -121+n dBm; 255 = недоступно
    if [ -n "$_RSCP" ] && [ "$_RSCP" -ge 0 ] && [ "$_RSCP" -le 96 ] 2>/dev/null; then
      RSCP=$((_RSCP - 121))
    fi
    # ecno: 0..49 -> -24 + 0.5n dB; 255 = недоступно
    if [ -n "$_ECNO" ] && [ "$_ECNO" -ge 0 ] && [ "$_ECNO" -le 49 ] 2>/dev/null; then
      ECIO=$(echo "$_ECNO" | awk '{printf "%0.1f", -24 + $1/2}')
    fi
  fi
  # RSSI на 3G из CSQ (строки GTCCINFO нет, а поле выше заполняется только в LTE-ветке)
  if [ -n "$CSQ" ] && [ -n "$RSCP" ]; then
    RSSI=$((2 * $CSQ -113))
  fi
fi

IFS="
"
IDX=1
LINES=$(echo "$O" | grep -E '^PCC:')
[ -n "$LINES" ] && T_MODE=""

T_4G_MODE=""
T_4G_PBAND=""
T_4G_PCI=""
T_4G_EARFCN=""

T_5G_MODE=""
T_5G_PBAND=""
T_5G_PCI=""
T_5G_EARFCN=""

for LINE in $LINES; do
  T_BAND=$(echo "$LINE" | awk -F[:,] '/^PCC:/{print $2}')
  T_PCI=$(echo "$LINE" | awk -F[:,] '/^PCC:/{print $3}')
  T_EARFCN=$(echo "$LINE" | awk -F[:,] '/^PCC:/{print $4}')
  T_DBW=$(echo "$LINE" | awk -F[:,] '/^PCC:/{print $5}')
  # PCC: у ЭТОЙ прошивки на одно поле больше, чем в мануале (лишний ul_bw):
  #   band,pci,earfcn,dl_bw,ul_bw,dl_mimo,ul_mimo,dl_mod,ul_mod,rsrp
  # (живой пример: PCC:107,366,3400,50,50,1,1,1,1,-104). Значит слои MIMO
  # (DL) = $7, модуляция (DL) = $9. MIMO валиден только в 1..4 (0/255 = нет
  # передачи) - иначе прочерк и для MIMO, и для модуляции.
  T_MIMO=$(echo "$LINE" | awk -F[:,] '/^PCC:/{print $7}')
  T_MOD=$(convert_mod "$(echo "$LINE" | awk -F[:,] '/^PCC:/{print $9}')")
  case "$T_MIMO" in
    1|2|3|4) ;;
    *) T_MIMO=""; T_MOD="";;
  esac

  if [ -n "$T_BAND" ]; then
    DBW=""
    if [ -n "$T_DBW" -a "$T_DBW" -ne "0" ]; then
      DBW=" @$(convert_bw $T_DBW)"
    fi

    if [ "$T_BAND" -lt "200" ]; then
      T_BAND=$((T_BAND - 100))
      T_4G_MODE="$(band4g ${T_BAND}) + "
      T_4G_PBAND="$(band4g ${T_BAND})${DBW}"
      T_4G_PCI="$T_PCI"
      T_4G_EARFCN="$T_EARFCN"
      T_4G_MIMO="$T_MIMO"
      T_4G_MOD="$T_MOD"
    elif [ "$T_BAND" -gt "500" ]; then
      T_BAND=$(echo "$T_BAND" | sed 's/^50//')
      T_5G_MODE="$(band5g ${T_BAND}) + "
      T_5G_PBAND="$(band5g ${T_BAND})${DBW}"
      T_5G_PCI="$T_PCI"
      T_5G_EARFCN="$T_EARFCN"
      T_5G_MIMO="$T_MIMO"
      T_5G_MOD="$T_MOD"
    fi
  fi

  IDX=$((IDX + 1))
done

if [ -n "$T_4G_PBAND" ]; then
  PBAND="$T_4G_PBAND"
  PCI="$T_4G_PCI"
  EARFCN="$T_4G_EARFCN"
  PMIMO="$T_4G_MIMO"
  PMOD="$T_4G_MOD"
elif [ -n "$T_5G_PBAND" ]; then
  PBAND="$T_5G_PBAND"
  PCI="$T_5G_PCI"
  EARFCN="$T_5G_EARFCN"
  PMIMO="$T_5G_MIMO"
  PMOD="$T_5G_MOD"
fi


IFS="
"
IDX=1
LINES=$(echo "$O" | grep -E '^SCC\s?[0-9]:2,')
for LINE in $LINES; do
  T=$(echo "$LINE" | awk -F[:,] '/^SCC\s?'$IDX':2,/{print $4}')
  if [ -n "$T" ]; then
    T_DBW=$(echo "$LINE" | awk -F[:,] '/^SCC\s?'$IDX':2,/{print $7}')
    DBW=""
    if [ -n "$T_DBW" -a "$T_DBW" -ne "0" ]; then
      DBW=" @$(convert_bw $T_DBW)"
    fi
    T2=""
    if [ "$T" -lt "200" ]; then
      T=$((T - 100))
      T2="$(band4g $T)${DBW}"
      T_4G_MODE="${T_4G_MODE}$(band4g $T) / "
    elif [ "$T" -gt "500" ]; then
      T=$(echo "$T" | sed 's/^50//')
      T2="$(band5g $T)${DBW}"
      T_5G_MODE="${T_5G_MODE}$(band5g $T) / "
    fi
    if [ -n "$T2" ]; then
      case $IDX in
        "1") S1BAND="$T2";;
        "2") S2BAND="$T2";;
        "3") S3BAND="$T2";;
        "4") S4BAND="$T2";;
        *);;
      esac
    fi
  fi
  
  T=$(echo "$LINE" | awk -F[:,] '/^SCC\s?'$IDX':2,/{print $5}')
  if [ -n "$T" ]; then
    case $IDX in
      "1") S1PCI="$T";;
      "2") S2PCI="$T";;
      "3") S3PCI="$T";;
      "4") S4PCI="$T";;
      *);;
    esac
  fi
  
  T=$(echo "$LINE" | awk -F[:,] '/^SCC\s?'$IDX':2,/{print $6}')
  if [ -n "$T" ]; then
    case $IDX in
      "1") S1EARFCN="$T";;
      "2") S2EARFCN="$T";;
      "3") S3EARFCN="$T";;
      "4") S4EARFCN="$T";;
      *);;
    esac
  fi

  # Per-SCC RSRP (LTE): GTCAINFO SCC field $13 is ALREADY in dBm (255 = n/a).
  # Field mapping confirmed against modemdata's FM350 (0e8d7127) parser. LTE SCC
  # rows don't carry per-carrier RSRQ/SINR (modemdata doesn't emit them either);
  # those exist only for 5G-NSA SCC (via GTCCINFO), added separately below.
  T=$(echo "$LINE" | awk -F[:,] '/^SCC\s?'$IDX':2,/{print $13}')
  if [ -n "$T" ] && [ "$T" != "255" ] && [ "$T" -le -40 ] 2>/dev/null && [ "$T" -ge -157 ] 2>/dev/null; then
    case $IDX in
      "1") S1RSRP="$T";;
      "2") S2RSRP="$T";;
      "3") S3RSRP="$T";;
      "4") S4RSRP="$T";;
      *);;
    esac
  fi

  # SCC ровно по мануалу (11.1.16): state,ul_cfg,band,pci,earfcn,dl_bw,ul_bw,
  # dl_mimo,ul_mimo,dl_mod,ul_mod,rsrp -> MIMO (DL) = $9, модуляция (DL) = $11.
  # mimo=0/255 значит "по SCC сейчас ничего не передаётся" (простой) - тогда
  # прочерк и для MIMO, и для модуляции (mod=0/BPSK там просто заглушка).
  T_SMIMO=$(echo "$LINE" | awk -F[:,] '/^SCC\s?'$IDX':2,/{print $9}')
  case "$T_SMIMO" in
    1|2|3|4)
      T_SMOD=$(convert_mod "$(echo "$LINE" | awk -F[:,] '/^SCC\s?'$IDX':2,/{print $11}')")
      case $IDX in
        "1") S1MIMO="$T_SMIMO"; S1MOD="$T_SMOD";;
        "2") S2MIMO="$T_SMIMO"; S2MOD="$T_SMOD";;
        "3") S3MIMO="$T_SMIMO"; S3MOD="$T_SMOD";;
        "4") S4MIMO="$T_SMIMO"; S4MOD="$T_SMOD";;
        *);;
      esac
      ;;
  esac

  IDX=$((IDX + 1))
done

T_4G_MODE=$(echo "$T_4G_MODE" | sed 's/ [\/\+] $//')
T_5G_MODE=$(echo "$T_5G_MODE" | sed 's/ [\/\+] $//')

if [ -n "$T_4G_PBAND" -a -n "$T_5G_PBAND" ]; then
  if [ -n "$T_5G_PBAND" ]; then
    case $IDX in
      "1") S1BAND="$T_5G_PBAND";;
      "2") S2BAND="$T_5G_PBAND";;
      "3") S3BAND="$T_5G_PBAND";;
      "4") S4BAND="$T_5G_PBAND";;
      *);;
    esac
  fi

  if [ -n "$T_5G_PCI" ]; then
    case $IDX in
      "1") S1PCI="$T_5G_PCI";;
      "2") S2PCI="$T_5G_PCI";;
      "3") S3PCI="$T_5G_PCI";;
      "4") S4PCI="$T_5G_PCI";;
      *);;
    esac
  fi

  if [ -n "$T_5G_EARFCN" ]; then
    case $IDX in
      "1") S1EARFCN="$T_5G_EARFCN";;
      "2") S2EARFCN="$T_5G_EARFCN";;
      "3") S3EARFCN="$T_5G_EARFCN";;
      "4") S4EARFCN="$T_5G_EARFCN";;
      *);;
    esac
  fi
fi

if [ -z "$T_MODE" ]; then
  if [ -n "$T_4G_MODE" ]; then
    MODE="$MODE $T_4G_MODE"
  fi

  if [ -n "$T_5G_MODE" ]; then
    [ -n "$T_4G_MODE" ] && MODE="$MODE /"
    MODE="$MODE $T_5G_MODE"
  fi
fi

# GTCCINFO doesn't always return its serving-cell row in a given poll (handover,
# CA changes, a busy port), which used to leave RSRP empty for that one poll and
# made the bar drop to the pessimistic AT+CSQ value (~25%) - a visible flicker.
# Fall back to AT+CESQ, which reports the standardized RSRP directly and reliably:
#   +CESQ: rxlev,ber,rscp,ecno,rsrq,rsrp   (rsrp 0..97 -> dBm = rsrp-141; 255=n/a)
if [ -z "$RSRP" ]; then
	CE_RSRP=$(echo "$O" | tr -d '\r' | sed -n 's/.*+CESQ:[[:space:]]*//p' | head -1 | awk -F, '{print $6}')
	if [ -n "$CE_RSRP" ] && [ "$CE_RSRP" != "255" ]; then
		RSRP=$((CE_RSRP - 141))
	fi
fi

# Signal bar НЕ из сырого AT+CSQ: он RSSI-based и на FM350 узкополосный - читает
# ~8..9 (=26%) даже при приличном LTE, а другие модемы в той же точке дают 70%+.
# Но и один RSRP врёт в ОБЕ стороны: сильный RSRP при плохих SINR/RSRQ (шум,
# загрузка соты) - это ПЛОХОЕ соединение, а бар по RSRP рисовал бы «полно»
# (живой пример: RSRP -107, но SINR 1 дБ и RSRQ -15 дБ - реально слабо, а прежняя
# формула (RSRP+150)*5/3 давала 71%). Поэтому считаем ВЗВЕШЕННО из того, что
# отдаёт +CESQ/GTCCINFO: сила (RSRP) 50% + качество SINR 30% + RSRQ 20%.
# Отсутствующие метрики исключаем и перенормируем веса (на LTE без SINR - только
# RSRP+RSRQ и т.д.). Шкалы по 3GPP TS 36.133:
#   RSRP  -130..-80 дБм -> 0..100  (перцептивно ~2%/дБ в рабочем диапазоне)
#   SINR   -10..20  дБ  -> 0..100  (>=20 отлично, ~13 хорошо, 0 средне)
#   RSRQ   -20..-3   дБ  -> 0..100  (>=-10 хорошо)
# Так бар отражает РЕАЛЬНОЕ качество, а не только силу, и убирает и «занижение»
# сырого CSQ, и «завышение» чистого RSRP. Кэшируем последний хороший процент,
# чтобы редкий опрос без GTCCINFO/CESQ не уронил бар к пессимистичному CSQ.
SIGCACHE="/tmp/5gmodem_fm350_sig_${DEVICE##*/}"
# FM350 занижает сырой +CSQ, поэтому ПЕРЕКРЫВАЕМ его взвешенной оценкой даже при
# валидном CSQ (общий хелпер sig_weighted в lib.sh - та же формула, что и в
# центральном fallback 5gmodem.sh, одна на всех). Кэшируем последний хороший
# процент: редкий опрос без GTCCINFO/CESQ иначе уронил бы бар к пессимистичному CSQ.
if [ -n "$RSRP" ]; then
	CSQ_PER=$(sig_weighted "$RSRP" "$SINR" "$RSRQ")
	CSQ=$(( 31 * CSQ_PER / 100 ))
	echo "$CSQ_PER" > "$SIGCACHE" 2>/dev/null
elif [ -f "$SIGCACHE" ] && [ -z "$(find "$SIGCACHE" -mmin +2 2>/dev/null)" ]; then
	CSQ_PER=$(cat "$SIGCACHE" 2>/dev/null)
	[ -n "$CSQ_PER" ] && CSQ=$(( 31 * CSQ_PER / 100 ))
fi

# Modem
OA=$(at_static cgmm "AT+CGMM?")
MODELA=$(echo "$OA" | awk -F [:,] '/\+CGMM/{print $2}' | xargs)
OB=$(at_static cgmi "AT+CGMI?")
MODELB=$(echo "$OB" | awk -F [:,] '/\+CGMI/{print $2}' | xargs)
MODELBCUT=$(echo $MODELB | sed s/"Wireless Inc."//)
MODEL=$(echo "$MODELBCUT $MODELA" | xargs)

OF=$(at_static gmr "AT+GMR?")
FW=$(echo "$OF" | awk -F[,:] '/\+GMR:/ {print $2}' | xargs)

# International Mobile Equipment Identity (IMEI)
OAA=$(at_static cgsn "AT+CGSN?")
NR_IMEI=$(echo "$OAA" | awk -F[,:] '/\+CGSN:/ {print $2}' | xargs)

# International Mobile Subscriber Identity (IMSI)
[ -n "$SIMID" ] && NR_IMSI="$SIMID" || NR_IMSI=$(at_static cimi "AT+CIMI?" | awk -F [,:] '/\+CIMI:/ {print $2}' | xargs)

# Integrated Circuit Card Identifier (ICCID)
OCC=$(at_static iccid "AT+ICCID")
NR_ICCID=$(echo "$OCC" | awk -F [,:] '/\+ICCID:/ {print $2}' | xargs)

# Temp. Во время реинициализации (смена SIM-слота, ресет) сенсоры ETHERMAL
# отдают заглушки (32767=0x7FFF, -127, -28479 и т.п.) - без фильтра в шапке
# светилось "32767.0 °C". Берём только правдоподобные значения.
# Берём МАКСИМУМ по сенсорам, а НЕ среднее: у FM350 несколько зон (PA, XO,
# baseband...), и «холодная» зона (~25 °C, ambient) в среднем роняла показание -
# оттого температура иногда внезапно проваливалась до 25° и на след. тик
# возвращалась к 55°. Максимум = температура самого горячего узла, это и есть
# осмысленная «температура модема», и она устойчива к разбросу зон.
OT=$(sms_tool -d "$DEVICE" at "AT+ETHERMAL?")
# Поля отсчитываем ОТ МАРКЕРА "+ETHERMAL:", а не от начала строки. Раньше awk
# просто делил всю строку по запятым и брал второе поле - и если ответы двух
# читателей порта слипались в одну строку (например "+CSQ: 25, 99" и следом
# хвост "+ETHERMAL: ..."), вторым полем оказывалось число из ЧУЖОГО ответа.
# Отсюда и брались внезапные 25 °C вместо 54. Отрезав всё до маркера, разбор
# перестаёт зависеть от того, что прилипло слева.
TM=$(echo "$OT" | awk 'BEGIN{m=-999}
	/\+ETHERMAL:/ {
		s = $0; sub(/^.*\+ETHERMAL:/, "", s)
		n = split(s, a, ",")
		if (n >= 2) { v = a[2] + 0; if (v > -40 && v < 150 && v > m) m = v }
	}
	END { if (m > -999) printf "%.1f", m }' | xargs)
# ФИЛЬТР СБОЙНЫХ ЗАМЕРОВ. Датчик FM350 изредка отдаёт неправдоподобное значение:
# в потоке ровных 53-57 проскакивает 25, причём это НЕ ошибка разбора - модем так
# и отвечает: "+ETHERMAL: 3, 25, 23, ..." при том, что секунду назад было 53.
# Поймать это можно только физикой: модуль не остывает на 30 градусов за пять
# секунд. Поэтому резкий скачок вниз принимаем лишь если он ПОДТВЕРДИЛСЯ
# следующим замером - настоящее остывание даёт серию низких значений, а сбой
# одиночный. Так мы не залипаем на старом значении, когда модем правда остыл.
_TF="/tmp/5gmodem_temp_$(basename "$DEVICE")"
if [ -n "$TM" ]; then
	# Формат файла: <последнее_значение> <счётчик_отклонений> <время>
	# Средние поля ВСЕГДА непустые: read схлопывает подряд идущие пробелы, и при
	# пустом поле время уезжало в соседнюю переменную - фильтр считал данные
	# протухшими и молча выключался.
	_prev=""; _cnt=0; _ptime=0
	# IFS ЗАДАЁМ ЯВНО. Выше в этом же профиле IFS переводится в перевод строки
	# для разбора сот, и он действует до конца скрипта - пробел перестаёт быть
	# разделителем, и read клал ВСЮ строку в первую переменную. Время не
	# читалось, фильтр считал данные протухшими и молча отключался: в модели
	# он работал, а на живом модеме нет.
	[ -f "$_TF" ] && IFS=' ' read -r _prev _cnt _ptime < "$_TF" 2>/dev/null
	case "$_ptime" in ''|*[!0-9]*) _ptime=0 ;; esac
	case "$_cnt" in ''|*[!0-9]*) _cnt=0 ;; esac
	_now=$(cut -d. -f1 /proc/uptime)
	_use="$TM"; _new=0

	if [ -n "$_prev" ] && [ "$((_now - _ptime))" -lt 120 ]; then
		_d=$(awk -v a="$TM" -v b="$_prev" 'BEGIN{d=a-b; if(d<0)d=-d; printf "%d", d}')
		if [ "$_d" -gt 15 ]; then
			# ТРИ подряд, а не два. Датчик FM350 выдаёт сбойное значение сериями:
			# в потоке ровных 53-55 приходит 25, и подтверждения со второго раза
			# оказалось мало - выброс повторялся дважды и проскакивал. Настоящее
			# остывание на 30 градусов длится десятки секунд, поэтому три опроса
			# подряд оно переживёт, а сбойная серия из двух - нет.
			_new=$((_cnt + 1))
			if [ "$_new" -ge 3 ]; then
				_use="$TM"; _new=0     # подтвердилось - принимаем
			else
				_use="$_prev"          # ещё не верим, показываем прежнее
			fi
		fi
	fi
	printf '%s %s %s\n' "$_use" "$_new" "$_now" > "$_TF"
	TEMP="$_use &deg;C"
fi

# Protocol
# DRIVER=QMI_WWAN & DRIVER=CDC_MBIM & DRIVER=CDC_ETHER

TTY=$(basename $DEVICE)
devpath=$(readlink -f /sys/class/tty/$TTY/device)
BASE=$(readlink -f ${devpath%/*/*})

NETIF=$(for a in /sys/class/net/*; do readlink -f $a; done | grep "$BASE")
NETDRV=$(basename $(readlink -f $NETIF/../../driver))

case $NETDRV in
  "qmi_wwan")
    PROTO="qmi";;
  "cdc_mbim")
    PROTO="mbim";;
  "cdc_ether")
     PROTO="ecm";;
   "rndis_host")
     PROTO="ncm";;
esac
