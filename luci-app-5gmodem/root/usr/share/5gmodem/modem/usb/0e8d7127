# Fibocom modems with ProdID=0e8d +GTUSBMODE: 41
# Fibocom FM350-GL

convert_bw() {
  case "${1}" in
    "6") echo "1.4 MHz";;
    "15") echo "3 MHz";;
    "25") echo "5 MHz";;
    "50") echo "10 MHz";;
    "75") echo "15 MHz";;
    "100") echo "20 MHz";;
    "125") echo "25 MHz";;
    "150") echo "30 MHz";;
    "200") echo "40 MHz";;
    "250") echo "50 MHz";;
    "300") echo "60 MHz";;
    "400") echo "80 MHz";;
    "450") echo "90 MHz";;
    "500") echo "100 MHz";;
    "1000") echo "200 MHz";;
    "2000") echo "400 MHz";;
    *) echo "";;
  esac
}

# Модуляция из GTCAINFO (<dl_modulation>/<ul_modulation>, мануал 11.1.16):
# 0 BPSK, 1 QPSK, 2 16QAM, 3 64QAM, 4 256QAM, 5 1024QAM, 6 UNKNOWN.
convert_mod() {
  case "${1}" in
    "0") echo "BPSK";;
    "1") echo "QPSK";;
    "2") echo "16QAM";;
    "3") echo "64QAM";;
    "4") echo "256QAM";;
    "5") echo "1024QAM";;
    *) echo "";;
  esac
}

# This FM350-GL firmware's GTCCINFO does NOT carry a band field, so derive the
# LTE band from the serving EARFCN (E-UTRA DL channel, 3GPP TS 36.101 Table 5.7.3-1).
earfcn2band() {
	[ -n "$1" ] || return
	e=$1
	if   [ "$e" -le 599 ];   then echo 1
	elif [ "$e" -le 1199 ];  then echo 2
	elif [ "$e" -le 1949 ];  then echo 3
	elif [ "$e" -le 2399 ];  then echo 4
	elif [ "$e" -le 2649 ];  then echo 5
	elif [ "$e" -ge 2750 ] && [ "$e" -le 3449 ]; then echo 7
	elif [ "$e" -ge 3450 ] && [ "$e" -le 3799 ]; then echo 8
	elif [ "$e" -ge 5010 ] && [ "$e" -le 5179 ]; then echo 12
	elif [ "$e" -ge 5180 ] && [ "$e" -le 5279 ]; then echo 13
	elif [ "$e" -ge 5280 ] && [ "$e" -le 5379 ]; then echo 14
	elif [ "$e" -ge 5730 ] && [ "$e" -le 5849 ]; then echo 17
	elif [ "$e" -ge 5850 ] && [ "$e" -le 5999 ]; then echo 18
	elif [ "$e" -ge 6000 ] && [ "$e" -le 6149 ]; then echo 19
	elif [ "$e" -ge 6150 ] && [ "$e" -le 6449 ]; then echo 20
	elif [ "$e" -ge 8040 ] && [ "$e" -le 8689 ]; then echo 25
	elif [ "$e" -ge 8690 ] && [ "$e" -le 9039 ]; then echo 26
	elif [ "$e" -ge 9210 ] && [ "$e" -le 9659 ]; then echo 28
	elif [ "$e" -ge 9660 ] && [ "$e" -le 9769 ]; then echo 29
	elif [ "$e" -ge 9770 ] && [ "$e" -le 9869 ]; then echo 30
	elif [ "$e" -ge 9920 ] && [ "$e" -le 10359 ]; then echo 32
	elif [ "$e" -ge 36200 ] && [ "$e" -le 36349 ]; then echo 34
	elif [ "$e" -ge 37750 ] && [ "$e" -le 38249 ]; then echo 38
	elif [ "$e" -ge 38250 ] && [ "$e" -le 38649 ]; then echo 39
	elif [ "$e" -ge 38650 ] && [ "$e" -le 39649 ]; then echo 40
	elif [ "$e" -ge 39650 ] && [ "$e" -le 41589 ]; then echo 41
	elif [ "$e" -ge 41590 ] && [ "$e" -le 43589 ]; then echo 42
	elif [ "$e" -ge 43590 ] && [ "$e" -le 45589 ]; then echo 43
	elif [ "$e" -ge 46790 ] && [ "$e" -le 54539 ]; then echo 46
	elif [ "$e" -ge 55240 ] && [ "$e" -le 56739 ]; then echo 48
	elif [ "$e" -ge 66436 ] && [ "$e" -le 67335 ]; then echo 66
	elif [ "$e" -ge 68586 ] && [ "$e" -le 68935 ]; then echo 71
	fi
}

# ОДИН БАТЧ НА ВЕСЬ ОПРОС. Порядок в склейке ЗНАЧИМ: если модем упрётся в
# неизвестную ему команду, всё, что стоит правее, не ответит. Поэтому сначала
# три команды, на которых держатся метрики, и только потом вендорские
# дополнения. GTRXPATHEN в склейке подтверждён живым выводом
# `AT+EPRATL?;+E5GOPT?;+GTRXPATHEN?` - ответили все три (#10284); ECELL в
# склейке живьём не видели (в теме он всегда отдельной командой, #1134),
# поэтому он последний - в худшем случае теряется только он сам.
# (ревью 13.09.2026, форум 4pda)
O=$(sms_tool -d $DEVICE at "AT+GTCCINFO?;+GTCAINFO?;+CESQ;+GTRXPATHEN?;+ECELL")

case "$MODE_NUM" in
  7*) 
       if echo "$O" | grep -q -E '^SCC'; then
         MODE="LTE-A |"
       fi
       ;;
  11*) 
       MODE="5G SA |"
       ;;
  # AcT=13 - ЭТО «МОДЕМ УМЕЕТ EN-DC», А НЕ «СЕЙЧАС ЕСТЬ 5G».
  #
  # По 27.007 значение 13 означает E-UTRA + NR dual connectivity, и раньше мы
  # печатали по нему «5G NSA» безусловно. На сети, где 5G нет вовсе, получалась
  # ложь: живой стенд 07.08.2026, Билайн - `+COPS: 0,2,"25099",13`, при этом
  # `+C5GREG: 0` (в 5G не зарегистрирован), в GTCCINFO единственная строка с
  # rat=4 (LTE), а в агрегации B8 + B3 - две ЧЕТВЁРОЧНЫЕ несущие. Карточка
  # показывала «5G», хотя честный ответ - «4G+».
  #
  # Поэтому ярлык решаем ПОСЛЕ разбора несущих (см. ниже, где известны
  # T_5G_*): есть хоть одна NR-несущая - «5G NSA», нет - обычная LTE-логика.
  13*) NSA_CLAIM=1
       ;;
esac

T_MODE=""

# serving cell = first GTCCINFO data row (index 1). Row layout per the FM350
# AT manual (V2.10, 11.1.15), подтверждено живым выводом (EARFCN=3400 у B7,
# PCI=366 <= 503):
#   idx,rat,mcc,mnc,TAC(hex),CellID(hex),EARFCN,PCI,band,bw,SINR,rxlev,RSRP,RSRQ
# ВАЖНО: в унаследованном коде $7/$8 были перепутаны (PCI<->EARFCN). Из-за
# этого при пустом GTCAINFO (RRC idle) fallback считал бэнд из PCI как из
# EARFCN и pband прыгал (B1<->B3) на каждый переход idle<->active.
# Без -A3: GTCCINFO печатает и до десяти соседей на каждый RAT, порядок RAT не
# гарантирован - обслуживающая LTE/NR-строка уезжала за границу трёх строк, и
# весь блок метрик пропадал на этом опросе (ревью 12.09.2026). Шаблон ^1,[49],
# в пределах ответа уникален.
T1=$(echo "$O" | grep -E "^1,[49]," | head -1)
if [ -n "$T1" ]; then
  # Поля CSV-строки - ОДНИМ разбором через IFS, а не awk на каждое: этот блок
  # выполняется на каждом опросе, и восемь awk стоили ~8 форков впустую
  # (замер 06.08.2026: сбор FM350 1.4 c чистого CPU, 41 awk на проход).
  _oIFS=$IFS; IFS=','; set -- $T1; IFS=$_oIFS
  _F2=$2; _F5=$5; _F7=$7; _F8=$8; _F9=$9; _F11=${11}; _F13=${13}; _F14=${14}
  T_RAT=$_F2
  T=$_F5
  if [ -n "$T" ]; then
    T_DEC=$(printf "%d" "0x$T" 2>/dev/null)
    T_HEX=$T
  fi
  T=$_F7
  if [ -n "$T" ]; then
    EARFCN=$T
  fi
  T=$_F8
  if [ -n "$T" ]; then
    PCI=$T
  fi
  # band: prefer an explicit field ($9, index+100) if the firmware ever provides
  # one; otherwise derive it from the EARFCN (this unit leaves $9 empty).
  T=$_F9
  if [ -n "$T" ]; then
    case $T_RAT in
      4)
        T=$((T - 100))
        T_MODE="$(band4g $T)"
        PBAND="$(band4g $T)"
        ;;
      9)
        T=$(echo "$T" | sed 's/^50//')
        T_MODE="$(band5g $T)"
        PBAND="$(band5g $T)"
        ;;
    esac
  elif [ "$T_RAT" = "4" ] && [ -n "$EARFCN" ]; then
    T=$(earfcn2band "$EARFCN")
    if [ -n "$T" ]; then
      T_MODE="$(band4g $T)"
      PBAND="$(band4g $T)"
      MODE="$MODE $(band4g $T)"
    fi
  fi
  # Метрики берём ТОЛЬКО в допустимых по мануалу диапазонах (11.1.15): при
  # реинициализации прошивка шлёт мусор (напр. rssnr=8192 -> «SINR 4096.0 dB»
  # растягивал таблицу в горизонтальный скролл и дёргал страницу).
  T=$_F11
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge -100 ] && [ "$T" -le 100 ] && SINR=$(echo "$T" | awk '{printf "%0.1f", $1/2 }');;
      9) [ "$T" -ge 0 ] && [ "$T" -le 127 ] && SINR=$(echo "$T" | awk '{printf "%0.1f", ($1-45)/2-1 }');;
    esac
  fi
  T=$_F13
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge 0 ] && [ "$T" -le 140 ] && RSRP=$((T - 141));;
      9) [ "$T" -ge 0 ] && [ "$T" -le 157 ] && RSRP=$((T - 157));;
    esac
  fi
  T=$_F14
  if [ -n "$T" -a "$T" -ne "255" ] 2>/dev/null; then
    case $T_RAT in
      4) [ "$T" -ge 0 ] && [ "$T" -le 40 ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", ($1-34)/2-3 }');;
      9) [ "$T" -ge 0 ] && [ "$T" -le 127 ] && RSRQ=$(echo "$T" | awk '{printf "%0.1f", ($1-87)/2 }');;
    esac
  fi
  if [ "$CSQ" -ge 0 ] 2>/dev/null && [ "$CSQ" -le 31 ]; then
    RSSI=$((2 * CSQ - 113))
  fi
fi

# СОСЕДНИЕ СОТЫ - ИЗ ТОГО ЖЕ ОТВЕТА, БЕЗ ЕДИНОЙ ЛИШНЕЙ КОМАНДЫ.
#
# GTCCINFO отдаёт и обслуживающую соту (строка с 1 в начале), и соседей (2) -
# до десяти на каждый RAT. Раньше строки соседей просто выбрасывались, хотя
# таблица «Соседние соты» на странице «Сеть» уже есть и ждёт поле neighbors
# (её заполняет QMI-путь у Qualcomm-модемов, см. _qr_nb в 5gmodem.sh). Формат
# объекта повторяем оттуда ОДИН В ОДИН: значения строками, serving - 0/1.
#
# ПЕРЕСЧЁТ ТОТ ЖЕ, ЧТО У ОБСЛУЖИВАЮЩЕЙ ВЫШЕ: rsrp = idx-141 (LTE) / idx-157
# (NR), rsrq = -20 + idx/2. Проверено на живом FM350: idx 40 -> -101 dBm,
# столько же показывает карточка.
#
# РАСКЛАДКА ПОЛЕЙ РАЗНАЯ У ОБСЛУЖИВАЮЩЕЙ И СОСЕДА (руководство 11.1.15):
#   LTE обслуживающая: ...,earfcn,pci,band,bw,sinr,rxlev,rsrp,rsrq   (14)
#   LTE сосед:         ...,earfcn,pci,bw,rxlev,rsrp,rsrq             (12)
# Плюс <band> прошивка заполняет ТОЛЬКО в RRC-connected и со смещением +100,
# поэтому для соседей диапазон считаем из EARFCN - тем же расчётом, что и
# earfcn2band выше (в awk он свой, иначе пришлось бы звать shell на строку).
NEIGHBORS=$(echo "$O" | awk -F, '
	function e2b(e) {
		if (e == "" || e + 0 != e) return ""
		e = e + 0
		if (e <= 599) return 1;  if (e <= 1199) return 2
		if (e <= 1949) return 3;  if (e <= 2399) return 4
		if (e <= 2649) return 5
		if (e >= 2750 && e <= 3449) return 7
		if (e >= 3450 && e <= 3799) return 8
		if (e >= 5010 && e <= 5179) return 12
		if (e >= 5180 && e <= 5279) return 13
		if (e >= 5280 && e <= 5379) return 14
		if (e >= 5730 && e <= 5849) return 17
		if (e >= 5850 && e <= 5999) return 18
		if (e >= 6000 && e <= 6149) return 19
		if (e >= 6150 && e <= 6449) return 20
		if (e >= 8040 && e <= 8689) return 25
		if (e >= 8690 && e <= 9039) return 26
		if (e >= 9210 && e <= 9659) return 28
		if (e >= 9660 && e <= 9769) return 29
		if (e >= 9770 && e <= 9869) return 30
		if (e >= 9920 && e <= 10359) return 32
		if (e >= 36200 && e <= 36349) return 34
		if (e >= 37750 && e <= 38249) return 38
		if (e >= 38250 && e <= 38649) return 39
		if (e >= 38650 && e <= 39649) return 40
		if (e >= 39650 && e <= 41589) return 41
		if (e >= 41590 && e <= 43589) return 42
		if (e >= 43590 && e <= 45589) return 43
		if (e >= 46790 && e <= 54539) return 46
		if (e >= 55240 && e <= 56739) return 48
		if (e >= 66436 && e <= 67335) return 66
		if (e >= 68586 && e <= 68935) return 71
		return ""
	}
	# «Нет данных» прошивка кодирует 255 (а SINR ещё и мусором при
	# реинициализации) - такие поля отдаём пустыми, страница покажет прочерк.
	function lvl(v, base,   x) {
		if (v == "" || v + 0 != v || v == 255) return ""
		x = v + 0
		if (x < 0 || x > 200) return ""
		return x + base
	}
	function half(v, base,   x) {
		if (v == "" || v + 0 != v || v == 255) return ""
		x = v + 0
		if (x < 0 || x > 200) return ""
		return sprintf("%.1f", base + x / 2)
	}
	/^[12],[249],/ {
		# sms_tool отдаёт строки с CR - без чистки ПОСЛЕДНЕЕ поле (rsrq) уходит
		# в проверки как "16\r" и молча отбрасывается: в таблице был прочерк.
		gsub(/\r/, "")
		srv = ($1 == 1) ? 1 : 0
		rat = $2 + 0
		arfcn = $7; pci = $8
		band = ""; rsrp = ""; rsrq = ""
		if (rat == 4) {
			if (srv) { band = $9; rsrp = lvl($13, -141); rsrq = half($14, -20) }
			else     {            rsrp = lvl($11, -141); rsrq = half($12, -20) }
			if (band != "" && band + 0 > 100) band = band - 100; else band = e2b(arfcn)
		} else if (rat == 9) {
			if (srv) { band = $9; rsrp = lvl($13, -157); rsrq = half($14, -43.5) }
			else     {            rsrp = lvl($11, -157); rsrq = half($12, -43.5) }
			sub(/^50/, "", band)
		} else {
			# WCDMA: уровень тут RSCP (idx-121), диапазона в строке нет.
			if (srv) rsrp = lvl($11, -121); else rsrp = lvl($15, -121)
		}
		if (pci == "") next
		printf "%s{\"band\":\"%s\",\"earfcn\":\"%s\",\"pci\":\"%s\",\"rsrp\":\"%s\",\"rsrq\":\"%s\",\"rssi\":\"\",\"serving\":%s}",
			(n++ ? "," : ""), band, arfcn, pci, rsrp, rsrq, srv
	}
')

# 3G (UMTS/HSPA): нет строки GTCCINFO с RAT 4/9, значит T1 пуст. Метрики берём из
# СТАНДАРТНОГО +CESQ (3GPP TS 27.007 8.69). FM350 расширяет +CESQ полями NR, но
# первые шесть остаются rxlev,ber,rscp,ecno,rsrq,rsrp. На WCDMA rsrq/rsrp = 255,
# а rscp/ecno несут реальный сигнал. НЕ трогаем CSQ: на 3G он честно совпадает с
# RSCP (в отличие от LTE, где мы правили его через RSRP).
if [ -z "$T1" ]; then
  _CE=$(echo "$O" | grep -E '^\+CESQ:' | head -1 | sed 's/^+CESQ:[[:space:]]*//')
  if [ -n "$_CE" ]; then
    _RSCP=$(echo "$_CE" | awk -F, '{print $3}' | tr -d ' ')
    _ECNO=$(echo "$_CE" | awk -F, '{print $4}' | tr -d ' ')
    # rscp: 0..96 -> -121+n dBm; 255 = недоступно
    if [ -n "$_RSCP" ] && [ "$_RSCP" -ge 0 ] && [ "$_RSCP" -le 96 ] 2>/dev/null; then
      RSCP=$((_RSCP - 121))
    fi
    # ecno: 0..49 -> -24 + 0.5n dB; 255 = недоступно
    if [ -n "$_ECNO" ] && [ "$_ECNO" -ge 0 ] && [ "$_ECNO" -le 49 ] 2>/dev/null; then
      ECIO=$(echo "$_ECNO" | awk '{printf "%0.1f", -24 + $1/2}')
    fi
  fi
  # RSSI на 3G из CSQ (строки GTCCINFO нет, а поле выше заполняется только в LTE-ветке)
  if [ -n "$RSCP" ] && [ "$CSQ" -ge 0 ] 2>/dev/null && [ "$CSQ" -le 31 ]; then
    RSSI=$((2 * CSQ - 113))
  fi
fi

# АНТЕННЫ (RX-ПУТИ) - ИЗ ТОГО ЖЕ ОТВЕТА, БЕЗ ЛИШНЕЙ КОМАНДЫ.
#
# `AT+GTRXPATHEN?` -> `+GTRXPATHEN: 3,15` (живые ответы: #806, #2451, #3294,
# #10284). Первое поле - RAT (1 UMTS, 3 LTE, 15 NR-RAN), второе - БИТОВАЯ
# МАСКА включённых цепей: 1 main, 2 aux/DG, 4 mimo main, 8 mimo aux, 15 - все
# четыре (выписка из мануала, #6908; то же словами в #3281).
#
# УРОВНЕЙ ПО ЦЕПЯМ FM350 НЕ ОТДАЁТ ВОВСЕ: команда только включает и выключает
# пути, отдельных RSRP по антеннам в теме нет ни у кого. Поэтому ANTPORTS
# ("порт:rsrp:rsrq") оставляем пустым - страница скроет таблицу, - и
# заполняем только вердикт разнесённого приёма. Именно его не хватает при
# самой частой жалобе темы «скорость вдвое ниже обещанной»: работа на двух
# цепях из четырёх ровно вдвое режет приём (#1519, #9726).
# (ревью 13.09.2026, форум 4pda)
_RXP=$(echo "$O" | tr -d '\r' | sed -n 's/^+GTRXPATHEN:[[:space:]]*[0-9]*,\([0-9]*\).*/\1/p' | head -1)
case "$_RXP" in
	''|*[!0-9]*) ;;
	*)
		_RXN=0
		for _RXB in 1 2 4 8; do
			[ $(( _RXP & _RXB )) -ne 0 ] && _RXN=$((_RXN + 1))
		done
		case "$_RXN" in
			1) RXDIV="off";;
			2) RXDIV="2rx";;
			3|4) RXDIV="4rx";;
		esac
		;;
esac

# НЕИСКАЖЁННАЯ СОТА - AT+ECELL, ТОЛЬКО КАК ЗАПАСНОЙ ВАРИАНТ.
#
# Раскладка ответа - из исходников MediaTek RIL (RmcNetworkHandler.cpp), её
# же привёл форум вместе с живым выводом (#1134, #1481):
#   +ECELL: <num_of_cell>[,<act>,<cid>,<lac_or_tac>,<mcc>,<mnc>,<psc_or_pci>,
#           <sig1>,<sig2>,<sig1_in_dbm>,<sig2_in_dbm>,<ta>,<ext1>,<ext2>,
#           <ext3>,<ext4>][,...]
#   +ECELL: 1,7,"0087D952B","316B",250,1,470,58,12,-332,-56,17,,,0,3200
# Первая запись - обслуживающая сота, дальше соседи (у них cid/tac - заглушки
# "00FFFFFFF"/"FFFF"). cid и tac - ШЕСТНАДЦАТЕРИЧНЫЕ строки в кавычках.
#
# ЗАЧЕМ. GTCCINFO на этой прошивке печатает «дичь»: фантомные бэнды и битые
# ARFCN (#1134, #5396-5398, #10284), а ECELL тех же данных не искажает. Но
# ПЕРЕЗАПИСЫВАТЬ уже полученное мы не имеем права: сота и TAC обычно приходят
# из +CREG в каркасе, и подмена их вторым источником - это регресс, а не
# починка. Берём ровно то, что осталось пустым (у FM350 это как раз частый
# случай: профиль вообще не заполнял CID).
#
# TA (timing advance, поле 12) даёт дальность до БС: ta x 78.12 = метры
# (#1476, #1481 - «ta=17 -> 1328 м, похоже на правду»). ПЕРЕМЕННОЙ ПОД
# ДАЛЬНОСТЬ/TA В ПРОЕКТЕ НЕТ НИ У ОДНОГО ПРОФИЛЯ, поэтому поле здесь не
# заводим - иначе оно никуда не доедет (ревью 13.09.2026, форум 4pda).
_ECNEED=0
case "$CID_HEX" in ''|0|00000000) _ECNEED=1;; esac
case "$T_HEX"   in ''|0|0000)     _ECNEED=1;; esac
if [ "$_ECNEED" = 1 ]; then
	_EC=$(echo "$O" | tr -d '\r' | sed -n 's/^+ECELL:[[:space:]]*//p' | head -1)
	if [ -n "$_EC" ]; then
		# Пустые поля в ответе значимы (ta может отсутствовать), поэтому
		# разбираем IFS-ом по запятой, а не awk-ом с xargs.
		_oIFS=$IFS; IFS=','; set -- $_EC; IFS=$_oIFS
		_ECID=$(echo "$3" | tr -d '" ')
		_ETAC=$(echo "$4" | tr -d '" ')
		# «Все F и нули» - это заглушка соседа, а не идентификатор.
		case "$_ECID" in
			''|*[!0-9A-Fa-f]*) _ECID="";;
			*[!Ff0]*) ;;
			*) _ECID="";;
		esac
		case "$_ETAC" in
			''|*[!0-9A-Fa-f]*) _ETAC="";;
			*[!Ff0]*) ;;
			*) _ETAC="";;
		esac
		case "$CID_HEX" in
			''|0|00000000)
				if [ -n "$_ECID" ]; then
					CID_DEC=$(printf "%d" "0x$_ECID" 2>/dev/null)
					CID_HEX=$(echo "$_ECID" | tr 'a-f' 'A-F')
				fi
				;;
		esac
		case "$T_HEX" in
			''|0|0000)
				if [ -n "$_ETAC" ]; then
					T_DEC=$(printf "%d" "0x$_ETAC" 2>/dev/null)
					T_HEX=$(echo "$_ETAC" | tr 'a-f' 'A-F')
				fi
				;;
		esac
	fi
fi

IFS="
"
IDX=1
LINES=$(echo "$O" | grep -E '^PCC:')
[ -n "$LINES" ] && T_MODE=""

T_4G_MODE=""
T_4G_PBAND=""
T_4G_PCI=""
T_4G_EARFCN=""

T_5G_MODE=""
T_5G_PBAND=""
T_5G_PCI=""
T_5G_EARFCN=""

for LINE in $LINES; do
  # Поля - одним IFS-разбором вместо шести awk (строки уже отобраны grep выше;
  # первый элемент после ":" - band, разделители и ":", и ",").
  _oIFS=$IFS; IFS=':,'; set -- $LINE; IFS=$_oIFS
  T_BAND=$2
  T_PCI=$3
  T_EARFCN=$4
  T_DBW=$5
  # PCC: у ЭТОЙ прошивки на одно поле больше, чем в мануале (лишний ul_bw):
  #   band,pci,earfcn,dl_bw,ul_bw,dl_mimo,ul_mimo,dl_mod,ul_mod,rsrp
  # (живой пример: PCC:107,366,3400,50,50,1,1,1,1,-104). Значит слои MIMO
  # (DL) = $7, модуляция (DL) = $9. MIMO валиден только в 1..4 (0/255 = нет
  # передачи) - иначе прочерк и для MIMO, и для модуляции.
  # Раскладку выбираем ПО ЧИСЛУ ПОЛЕЙ: формат GTCAINFO менялся между прошивками
  # (форум), и на прошивке без ul_bw в MIMO попадал dl_mod (1..4 проходит
  # валидацию) - показывались чужие слои (ревью 12.09.2026). 11 полей с
  # заголовком - с ul_bw (MIMO $7, модуляция $9), 10 - по мануалу ($6, $8).
  if [ "$#" -ge 11 ]; then
    T_MIMO=$7
    T_MOD=$(convert_mod "$9")
  else
    T_MIMO=$6
    T_MOD=$(convert_mod "$8")
  fi
  case "$T_MIMO" in
    1|2|3|4) ;;
    *) T_MIMO=""; T_MOD="";;
  esac

  if [ -n "$T_BAND" ]; then
    DBW=""
    if [ -n "$T_DBW" -a "$T_DBW" -ne "0" ]; then
      DBW=" @$(convert_bw $T_DBW)"
    fi

    if [ "$T_BAND" -lt "200" ]; then
      T_BAND=$((T_BAND - 100))
      T_4G_MODE="$(band4g ${T_BAND}) + "
      T_4G_PBAND="$(band4g ${T_BAND})${DBW}"
      T_4G_PCI="$T_PCI"
      T_4G_EARFCN="$T_EARFCN"
      T_4G_MIMO="$T_MIMO"
      T_4G_MOD="$T_MOD"
    elif [ "$T_BAND" -gt "500" ]; then
      T_BAND=$(echo "$T_BAND" | sed 's/^50//')
      T_5G_MODE="$(band5g ${T_BAND}) + "
      T_5G_PBAND="$(band5g ${T_BAND})${DBW}"
      T_5G_PCI="$T_PCI"
      T_5G_EARFCN="$T_EARFCN"
      T_5G_MIMO="$T_MIMO"
      T_5G_MOD="$T_MOD"
    fi
  fi

  IDX=$((IDX + 1))
done

if [ -n "$T_4G_PBAND" ]; then
  PBAND="$T_4G_PBAND"
  PCI="$T_4G_PCI"
  EARFCN="$T_4G_EARFCN"
  PMIMO="$T_4G_MIMO"
  PMOD="$T_4G_MOD"
elif [ -n "$T_5G_PBAND" ]; then
  PBAND="$T_5G_PBAND"
  PCI="$T_5G_PCI"
  EARFCN="$T_5G_EARFCN"
  PMIMO="$T_5G_MIMO"
  PMOD="$T_5G_MOD"
fi


IFS="
"
IDX=1
LINES=$(echo "$O" | grep -E '^SCC\s?[0-9]:2,')
for LINE in $LINES; do
  # Один IFS-разбор на несущую вместо шести awk. Прежний awk заодно сверял
  # индекс строки с ожидаемым ($IDX) - сверяем так же, из самой строки:
  # не совпал - поля пустые, строка пропускается, IDX ниже всё равно шагнёт.
  _oIFS=$IFS; IFS=':,'; set -- $LINE; IFS=$_oIFS
  _lidx="${1#SCC}"; _lidx="${_lidx# }"
  if [ "$_lidx" = "$IDX" ]; then
    _S4=$4; _S5=$5; _S6=$6; _S7=$7; _S9=$9; _S11=${11}; _S13=${13}
  else
    _S4=""; _S5=""; _S6=""; _S7=""; _S9=""; _S11=""; _S13=""
  fi
  T=$_S4
  if [ -n "$T" ]; then
    T_DBW=$_S7
    DBW=""
    if [ -n "$T_DBW" -a "$T_DBW" -ne "0" ]; then
      DBW=" @$(convert_bw $T_DBW)"
    fi
    T2=""
    if [ "$T" -lt "200" ]; then
      T=$((T - 100))
      T2="$(band4g $T)${DBW}"
      T_4G_MODE="${T_4G_MODE}$(band4g $T) / "
    elif [ "$T" -gt "500" ]; then
      T=$(echo "$T" | sed 's/^50//')
      T2="$(band5g $T)${DBW}"
      T_5G_MODE="${T_5G_MODE}$(band5g $T) / "
    fi
    if [ -n "$T2" ]; then
      case $IDX in
        "1") S1BAND="$T2";;
        "2") S2BAND="$T2";;
        "3") S3BAND="$T2";;
        "4") S4BAND="$T2";;
        *);;
      esac
    fi
  fi
  
  T=$_S5
  if [ -n "$T" ]; then
    case $IDX in
      "1") S1PCI="$T";;
      "2") S2PCI="$T";;
      "3") S3PCI="$T";;
      "4") S4PCI="$T";;
      *);;
    esac
  fi
  
  T=$_S6
  if [ -n "$T" ]; then
    case $IDX in
      "1") S1EARFCN="$T";;
      "2") S2EARFCN="$T";;
      "3") S3EARFCN="$T";;
      "4") S4EARFCN="$T";;
      *);;
    esac
  fi

  # Per-SCC RSRP (LTE): GTCAINFO SCC field $13 is ALREADY in dBm (255 = n/a).
  # Field mapping confirmed against modemdata's FM350 (0e8d7127) parser. LTE SCC
  # rows don't carry per-carrier RSRQ/SINR (modemdata doesn't emit them either);
  # those exist only for 5G-NSA SCC (via GTCCINFO), added separately below.
  T=$_S13
  if [ -n "$T" ] && [ "$T" != "255" ] && [ "$T" -le -40 ] 2>/dev/null && [ "$T" -ge -157 ] 2>/dev/null; then
    case $IDX in
      "1") S1RSRP="$T";;
      "2") S2RSRP="$T";;
      "3") S3RSRP="$T";;
      "4") S4RSRP="$T";;
      *);;
    esac
  fi

  # SCC ровно по мануалу (11.1.16): state,ul_cfg,band,pci,earfcn,dl_bw,ul_bw,
  # dl_mimo,ul_mimo,dl_mod,ul_mod,rsrp -> MIMO (DL) = $9, модуляция (DL) = $11.
  # mimo=0/255 значит "по SCC сейчас ничего не передаётся" (простой) - тогда
  # прочерк и для MIMO, и для модуляции (mod=0/BPSK там просто заглушка).
  T_SMIMO=$_S9
  case "$T_SMIMO" in
    1|2|3|4)
      T_SMOD=$(convert_mod ""$_S11"")
      case $IDX in
        "1") S1MIMO="$T_SMIMO"; S1MOD="$T_SMOD";;
        "2") S2MIMO="$T_SMIMO"; S2MOD="$T_SMOD";;
        "3") S3MIMO="$T_SMIMO"; S3MOD="$T_SMOD";;
        "4") S4MIMO="$T_SMIMO"; S4MOD="$T_SMOD";;
        *);;
      esac
      ;;
  esac

  IDX=$((IDX + 1))
done

T_4G_MODE=$(echo "$T_4G_MODE" | sed 's/ [\/\+] $//')
T_5G_MODE=$(echo "$T_5G_MODE" | sed 's/ [\/\+] $//')

if [ -n "$T_4G_PBAND" -a -n "$T_5G_PBAND" ]; then
  if [ -n "$T_5G_PBAND" ]; then
    case $IDX in
      "1") S1BAND="$T_5G_PBAND";;
      "2") S2BAND="$T_5G_PBAND";;
      "3") S3BAND="$T_5G_PBAND";;
      "4") S4BAND="$T_5G_PBAND";;
      *);;
    esac
  fi

