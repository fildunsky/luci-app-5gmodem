# Telit LM960A18 / LN940-CP (1bc7:1040)
#
# ОДНА цепочка на весь опрос. Температуру и троттлинг добираем сюда же, а не
# отдельными вызовами: AT-порт общий с SMS/слотами, и каждый лишний запрос
# конкурирует за него (при коллизии ответы перепутываются - ловили эхо чужой
# команды в имени модема). Проверено на живом модеме - цепочка отвечает целиком.
#   #TEMPSENS=2 - МГНОВЕННОЕ измерение (mod=1 - периодический режим, в нём
#                 модуль не засыпает; mod=0 - выключено). Ответ: <датчик>,<°C>.
#   #TMLVL?     - уровень теплового троттлинга по датчикам: 0 норма … 3 level3
#                 (80568ST10869A Rev.7). Шкала совпадает с полем mtherm.
#   #LAPS       - RSRP/RSRQ по каждому антенному порту. Здесь же, а не отдельным
#                 вызовом: так таблица антенн обновляется сама и стоит ноль
#                 лишних запросов к порту (раньше её дёргала кнопка «Обновить»).
# #CQI добавлен в ту же цепочку, а не отдельным вызовом: команды в одной строке
# идут одним обменом с портом, лишней задержки нет (проверено на LM960A18 -
# отвечает "#CQI: 11").
O=$(sms_tool -d $DEVICE at "at#tempsens=2;#tmlvl?;#lrxdiv?;#rxdiv?;#4rxdis?;#ltecat?;#servinfo;#rfsts;#laps;#cqi;#cainfo?")

# SINR в #CAINFO - НЕ децибелы, а ИНДЕКС 0..250 (руководство 80568ST10869A
# Rev.7, стр. 264: "<sinr>: Measured SINR. This value is mapped to dB.
# Range: 0 to 250", где 0 = -20dB, 1 = -19.8dB … 250 = 30dB, шаг 0.2 дБ).
# Мы подставляли индекс как есть: модем отдавал 143, интерфейс показывал "143 dB"
# и рисовал полосу в разы длиннее шкалы (реальное значение - 8.6 дБ).
#   дБ = индекс * 0.2 - 20
# Через awk: в busybox нет дробной арифметики в $(( )).
sinr_db() {
	case "$1" in
		''|*[!0-9]*) return ;;          # пусто/не число - молчим
	esac
	awk -v n="$1" 'BEGIN { printf "%.1f", n * 0.2 - 20 }'
}

# EARFCN -> LTE band (3GPP 36.101 Table 5.7.3-1). Покрываем распространённые
# в РФ/Европе диапазоны, включая TDD B38/B40/B41 (раньше их не было, поэтому
# вторичная несущая B40 определялась как "?").
channeltoband()
{
	_ctb=$(earfcn2band "$1" 2>/dev/null)
	echo "${_ctb:-?}"
}

case "$MODE_NUM" in
	7*)
		T=$(echo "$O" | awk -F[,:] '/^#SERVINFO/ {print $4}' | xargs)
		[ -n "$COPS" ] && [ -n "$T" ] && COPS="$T"
		T=$(echo "$O" | awk -F[,:] '/^#SERVINFO/ {print $7}' | xargs)
		if [ -n "$T" ]; then
			T_DEC=$(printf "%d" "0x$T" 2>/dev/null)
#			ADDON="$ADDON"'{"TAC":"'$T_DEC' ('$T')"}'
		fi
		T=$(echo "$O" | awk -F[,:] '/^#SERVINFO/ {print $3}' | xargs)
		if [ -n "$T" ]; then
			RSSI=$T
#			ADDON="$ADDON"'{"RSSI":"'$T' dBm"}'
		fi
		T=$(echo "$O" | awk -F[,:] '/^#SERVINFO/ {print $10}' | xargs)
		if [ -n "$T" ]; then
			RSRP=$T
#			ADDON="$ADDON"'{"RSRP":"'$T' dBm"}'
		fi
		T=$(echo "$O" | awk -F[,:] '/^#SERVINFO/ {print $2}' | xargs)
		if [ -n "$T" ]; then
			EARFCN=$T
#			ADDON="$ADDON"'{"EARFCN":"'$T'"}'
		fi

		T=$(echo "$O" | awk -F[,:] '/^#CAINFO/ {print $3}' | xargs)
		case "$T" in *[!0-9]*) T="" ;; esac
		if [ -n "$T" ]; then
			T1=$(channeltoband $T)
			PBAND="$(band4g $T1 "")"
			# band4g игнорирует 2-й аргумент, поэтому префикс "LTE" ставим сами
			MODE="LTE | $(band4g $T1)"
		fi
		T=$(echo "$O" | awk -F[,:] '/^#CAINFO/ {print $5}' | xargs)
		if [ -n "$T" ]; then
			PCI=$T
#			[ -n "$ADDON" ] && ADDON="$ADDON,"
#			ADDON="$ADDON"'{"PCI":"'$T'"}'
		fi
		T=$(echo "$O" | awk -F[,:] '/^#CAINFO/ {print $7}' | xargs)
		if [ -n "$T" ]; then
			RSSI=$T
#			[ -n "$ADDON" ] && ADDON="$ADDON,"
#			ADDON="$ADDON"'{"RSSI":"'$T' dBm"}'
		fi
		T=$(echo "$O" | awk -F[,:] '/^#CAINFO/ {print $6}' | xargs)
		if [ -n "$T" ]; then
			RSRP=$T
#			[ -n "$ADDON" ] && ADDON="$ADDON,"
#			ADDON="$ADDON"'{"RSRP":"'$T' dBm"}'
		fi
		T=$(echo "$O" | awk -F[,:] '/^#CAINFO/ {print $8}' | xargs)
		if [ -n "$T" ]; then
			RSRQ=$T
#			[ -n "$ADDON" ] && ADDON="$ADDON,"
#			ADDON="$ADDON"'{"RSRQ":"'$T'"}'
		fi
		T=$(echo "$O" | awk -F[,:] '/^#CAINFO/ {print $9}' | xargs)
		if [ -n "$T" ]; then
			SINR=$(sinr_db "$T")
#			[ -n "$ADDON" ] && ADDON="$ADDON,"
#			ADDON="$ADDON"'{"SINR":"'$T'"}'
		fi

		# ВТОРИЧНАЯ НЕСУЩАЯ ЕСТЬ, ТОЛЬКО ЕСЛИ ЕЁ EARFCN НЕ НОЛЬ. Руководство:
		# "If the LTE information of SCC is not valid, it always returns 0".
		# Проверка [ -n "$T" ] строку "0" ПРОПУСКАЛА, а channeltoband(0) отдаёт
		# "1" - и неактивная несущая показывалась как фантомный B1 ("LTE-A |
		# B3 + B1 + B1" при одной реальной несущей).
		_CAL=$(echo "$O" | tr -d '\r' | awk '/^#CAINFO:/ {
			sub(/^#CAINFO: */, "")
			n = split($0, f, ",")
			for (i = 1; i <= n; i++) gsub(/[^0-9-]/, "", f[i])
			print "P|" f[3] "|" f[10] "|" f[12]
			for (b = 13; b + 10 <= n; b += 11)
				print "S|" f[b+1] "|" f[b+2] "|" f[b+3] "|" f[b+4] "|" f[b+5] "|" f[b+6] "|" f[b+7] "|" f[b+8] "|" f[b+10]
			exit
		}')
		[ -n "$_CAL" ] && _CA_FROM_PROFILE=1
		_ca_bw() {
			case "$1" in
				0) echo "1.4" ;; 1) echo "3" ;; 2) echo "5" ;;
				3) echo "10" ;; 4) echo "15" ;; 5) echo "20" ;;
			esac
		}
		_ca_mod() {
			case "$1" in
				1) echo "QPSK" ;; 2) echo "16QAM" ;; 3) echo "64QAM" ;; 4) echo "256QAM" ;;
			esac
		}
		_ca_num() {
			case "$1" in
				''|-|*[!0-9-]*|?*-*) return ;;
			esac
			echo "$1"
		}
		PCI=$(_ca_num "$PCI")
		EARFCN=$(_ca_num "$EARFCN")
		RSRP=$(_ca_num "$RSRP")
		RSRQ=$(_ca_num "$RSRQ")
		RSSI=$(_ca_num "$RSSI")
		_CA_I=0
		_CA_TX=""
		while IFS='|' read -r _ca_k _ca_a _ca_b _ca_c _ca_d _ca_e _ca_f _ca_g _ca_h _ca_m; do
			case "$_ca_k" in
				P)
					_ca_w=$(_ca_bw "$_ca_a")
					if [ -n "$_ca_w" ]; then
						BANDWIDTH="$_ca_w MHz"
						[ -n "$PBAND" ] && PBAND="$PBAND @$_ca_w MHz"
					fi
					_CA_TX=$(_ca_num "$_ca_b")
					_ca_w=$(_ca_mod "$_ca_c")
					[ -n "$_ca_w" ] && PMOD="$_ca_w"
					;;
				S)
					case "$_ca_a" in ''|0|*[!0-9]*) continue ;; esac
					[ "$_CA_I" -ge 4 ] && continue
					_CA_I=$((_CA_I + 1))
					T1=$(channeltoband "$_ca_a")
					_ca_bt=""
					[ "$T1" != "?" ] && _ca_bt="$(band4g $T1)"
					_ca_w=$(_ca_bw "$_ca_b")
					[ -n "$_ca_bt" ] && [ -n "$_ca_w" ] && _ca_bt="$_ca_bt @$_ca_w MHz"
					[ -n "$_ca_bt" ] || _ca_bt="B?"
					_ca_sn=""
					if [ "$_ca_h" = "2" ]; then
						_ca_st="activated"
						_ca_sn=$(sinr_db "$_ca_g")
						[ "$T1" != "?" ] && MODE="${MODE} / $(band4g $T1)"
					else
						_ca_st="deactivated"
					fi
					_ca_md=$(_ca_mod "$_ca_m")
					_ca_p=$(_ca_num "$_ca_c")
					_ca_rp=$(_ca_num "$_ca_d")
					_ca_rs=$(_ca_num "$_ca_e")
					_ca_rq=$(_ca_num "$_ca_f")
					case "$_CA_I" in
						1) S1BAND="$_ca_bt"; S1EARFCN="$_ca_a"; S1PCI="$_ca_p"; S1RSRP="$_ca_rp"
						   S1RSSI="$_ca_rs"; S1RSRQ="$_ca_rq"; S1SINR="$_ca_sn"; S1STATE="$_ca_st"; S1MOD="$_ca_md" ;;
						2) S2BAND="$_ca_bt"; S2EARFCN="$_ca_a"; S2PCI="$_ca_p"; S2RSRP="$_ca_rp"
						   S2RSSI="$_ca_rs"; S2RSRQ="$_ca_rq"; S2SINR="$_ca_sn"; S2STATE="$_ca_st"; S2MOD="$_ca_md" ;;
						3) S3BAND="$_ca_bt"; S3EARFCN="$_ca_a"; S3PCI="$_ca_p"; S3RSRP="$_ca_rp"
						   S3RSSI="$_ca_rs"; S3RSRQ="$_ca_rq"; S3SINR="$_ca_sn"; S3STATE="$_ca_st"; S3MOD="$_ca_md" ;;
						4) S4BAND="$_ca_bt"; S4EARFCN="$_ca_a"; S4PCI="$_ca_p"; S4RSRP="$_ca_rp"
						   S4RSSI="$_ca_rs"; S4RSRQ="$_ca_rq"; S4SINR="$_ca_sn"; S4STATE="$_ca_st"; S4MOD="$_ca_md" ;;
					esac
					;;
			esac
		done <<EOF
$_CAL
EOF
		_RF=$(echo "$O" | tr -d '\r' | awk -F, '/^#RFSTS:/ { print $8 "|" $11; exit }')
		_RF_TX=$(_ca_num "${_RF%%|*}")
		[ -n "$_CA_TX" ] || _CA_TX="$_RF_TX"
		case "$_CA_TX" in
			'') ;;
			0) [ "${_RF##*|}" = "2" ] && TXPOWER="0 dBm" ;;
			*) TXPOWER="$_CA_TX dBm" ;;
		esac
		;;
	2*|4*|5*|6*)
		_RF=$(echo "$O" | tr -d '\r' | awk -F, '/^#RFSTS:/ { gsub(/ /, ""); print $2 "|" $3 "|" $4 "|" $5 "|" $6; exit }')
		_rf_u=${_RF%%|*}; _rf_r=${_RF#*|}
		_rf_p=${_rf_r%%|*}; _rf_r=${_rf_r#*|}
		_rf_e=${_rf_r%%|*}; _rf_r=${_rf_r#*|}
		_rf_c=${_rf_r%%|*}; _rf_s=${_rf_r##*|}
		_rf_ok=1
		case "$_rf_u" in ''|*[!0-9]*) _rf_ok=0 ;; esac
		case "$_rf_p" in ''|*[!0-9]*) _rf_ok=0 ;; esac
		case "$_rf_c" in -[0-9]*) ;; *) _rf_ok=0 ;; esac
		case "${_rf_c#-}" in ''|*[!0-9]*) _rf_ok=0 ;; esac
		if [ "$_rf_ok" = 1 ]; then
			EARFCN="$_rf_u"
			PCI="$_rf_p"
			RSCP="$_rf_c"
			case "${_rf_e#-}" in
				''|*[!0-9.]*) ;;
				*) ECIO="$_rf_e" ;;
			esac
			case "${_rf_s#-}" in
				''|*[!0-9]*) ;;
				*) RSSI="$_rf_s" ;;
			esac
		fi
		;;
esac

# Несколько несущих (есть " / ") -> агрегация -> LTE-A. Разделитель / -> +.
if echo "$MODE" | grep -q " / "; then
	MODE=$(echo "$MODE" | sed 's/^LTE |/LTE-A |/')
fi
MODE=$(echo "$MODE" | sed 's, / , + ,g')

# Модель и прошивка (в основном скрипте для этого модема не заполняются).
# Убираем \r ПЕРВЫМ делом: иначе пустая на вид строка "\r" не отсекается как
# пустая, и head -1 хватал её вместо реального значения.
# Имя модема: берём ТОЛЬКО правдоподобный токен модели, а не «первую непустую
# строку». AT-порт общий (метрики, SMS, слоты, bands.sh), и при коллизии в ответ
# на AT+CGMM прилетает чужое: в заголовке страницы видели
# "Telit #BND: 0,18,A7E0BB0F38DF,42" - это эхо ответа bands.sh.
# grep по шаблону модели отсекает такое сразу: у Telit это LM<цифры><буквы>.
_M=$(sms_tool -d "$DEVICE" at "AT+CGMM" 2>/dev/null | tr -d '\r' \
	| grep -oE 'LM[0-9]{3,4}[A-Za-z0-9-]*' | head -1)
[ -n "$_M" ] && MODEL="Telit $_M"
_F=$(sms_tool -d "$DEVICE" at "AT+CGMR" 2>/dev/null | tr -d '\r' | grep -vE '^AT\+|^OK$|^ERROR|^$' | head -1 | xargs)
[ -n "$_F" ] && FW="$_F"

# --- Температура и тепловой троттлинг (из той же цепочки $O) ------------------
# Датчиков несколько (#TEMPSENS: TSENS2,28 / PA_THERM0,27 / PA_THERM1,27).
# Берём МАКСИМУМ: честнее показать самую горячую точку модуля, чем среднее или
# случайно первый датчик.
# CQI (Channel Quality Indicator, 0..15): косвенная оценка качества канала -
# чем выше, тем более плотную модуляцию сеть готова дать. Поле cqi в JSON уже
# было, но заполнять его на этом модеме было нечем.
_CQI=$(echo "$O" | tr -d '\r' | sed -n 's/^#CQI: *\([0-9]\{1,\}\).*/\1/p' | head -1)
case "$_CQI" in
	''|31) ;;
	*) CQI="$_CQI" ;;
esac

_LC=$(echo "$O" | tr -d '\r' | sed -n 's/^#LTECAT: *\([0-9]\{1,\}\).*/\1/p' | head -1)
case "$_LC" in
	'') ;;
	12) UECAT="12 (DL 18 / UL 13)" ;;
	*) UECAT="$_LC" ;;
esac

_T=$(echo "$O" | tr -d '\r' | sed -n 's/^#TEMPSENS: *[A-Za-z0-9_]*,\(-\{0,1\}[0-9]\{1,\}\).*/\1/p' \
	| sort -n | tail -1)
case "$_T" in
	''|*[!0-9-]*) ;;                 # не число - молчим, поле останется пустым
	*) TEMP="$_T &deg;C" ;;
esac

# Антенные порты: "#LAPS: -111,-11,-134,-19" -> "0:-111:-11 1:-134:-19"
# (пары rsrp/rsrq на порт, портов 2 или 4). В 3G команда молчит - это не ошибка,
# поле останется пустым и таблица в UI не покажется.
_AP=$(echo "$O" | tr -d '\r' | sed -n 's/^#LAPS: *//p' | head -1)
case "$_AP" in
	*[!0-9,\ -]*) _AP="" ;;
esac
if [ -n "$_AP" ]; then
	ANTPORTS=$(echo "$_AP" | awk -F, '{
		out = ""
		for (i = 1; i + 1 <= NF; i += 2) {
			p = (i - 1) / 2
			gsub(/ /, "", $i); gsub(/ /, "", $(i+1))
			out = out (out == "" ? "" : " ") p ":" $i ":" $(i+1)
		}
		print out
	}')
fi

# РАЗНЕСЁННЫЙ ПРИЁМ. Дополняет таблицу антенных портов, а не дублирует её: по
# одному #LAPS нельзя понять, используется ли второй приёмник ВООБЩЕ - при
# выключенном разнесении порты тоже показывают похожие уровни, и «обе антенны
# работают» отличить от «вторая не задействована» нечем.
#   #LRXDIV: 1   - разнесение для LTE (для нас основное)
#   #RXDIV: 1,0  - общий признак, запасной вариант
#   #4RXDIS: 0   - НОЛЬ значит 4RX не отключён, то есть работают четыре приёмника
_RD=$(echo "$O" | tr -d '\r' | sed -n 's/^#LRXDIV: *\([0-9]\).*/\1/p' | head -1)
[ -n "$_RD" ] || _RD=$(echo "$O" | tr -d '\r' | sed -n 's/^#RXDIV: *\([0-9]\).*/\1/p' | head -1)
_R4=$(echo "$O" | tr -d '\r' | sed -n 's/^#4RXDIS: *\([0-9]\).*/\1/p' | head -1)
case "$_RD" in
	1) RXDIV=2rx; [ "$_R4" = "0" ] && RXDIV=4rx ;;
	0) RXDIV=off ;;
esac

# Уровень троттлинга - тоже максимум по датчикам (#TMLVL: TSENS2,0 / PA_THERM,0).
_L=$(echo "$O" | tr -d '\r' | sed -n 's/^#TMLVL: *[A-Za-z0-9_]*,\([0-9]\).*/\1/p' \
	| sort -n | tail -1)
case "$_L" in
	[0-3]) THERM="$_L" ;;
esac

# ===== СОСЕДНИЕ СОТЫ (AT#MONI) ==============================================
#
# У Telit соседи достаются иначе, чем у всех: #MONI=<n> ВЫБИРАЕТ набор, а
# следующий #MONI печатает соты этого набора. Живой LM960A18:
#   #MONI=0 -> #MONI: Tele2 RU RSRP:-107 RSRQ:-11 TAC:73AD Id:5813D15 EARFCN:3400 PWR:-78dbm DRX:640
#   #MONI=1 -> #MONI: RSRP:-107 RSRQ:-11 Id:000016E EARFCN:3400 PWR:-78dbm   (та же частота)
#            -> #MONI: RSRP:-116 RSRQ:-20 Id:00001BF EARFCN:3400 PWR:-87dbm
#   #MONI=2 -> #MONI: RSRP:-99  RSRQ:-10 Id:00001E0 EARFCN:100  PWR:-81dbm   (другая частота)
#   #MONI=3 -> пусто (наборы кончились)
# Id у ОБСЛУЖИВАЮЩЕЙ - это ECI (5813D15 = 92355861, сходится с +CPSI), а у
# СОСЕДЕЙ - PCI в шестнадцатеричном виде (16E = 366, 1BF = 447, 1E0 = 480;
# проверено сверкой с соседним модемом на той же площадке).
#
# УРОВНИ УЖЕ В ДЕЦИБЕЛАХ - в отличие от FM350, где GTCCINFO отдаёт индексы.
# PWR - это RSSI, его и кладём в поле rssi (у FM350 оно пустует).
#
# ЦЕНА. Набор стоит две команды (#MONI=<n> и #MONI), а опрос метрик идёт раз в
# пару секунд - гонять шесть команд на каждый круг нельзя. Поэтому соседи
# обновляются раз в 30 c и лежат в кэше; между обновлениями снимок отдаёт
# последний известный список. Селектор в конце ВОЗВРАЩАЕМ на 0: иначе следующий
# #MONI (наш или из AT-консоли) покажет соседей вместо обслуживающей соты.
_NB_F="/tmp/5gmodem_moni_nb_$(basename "$DEVICE" 2>/dev/null)"
_NB_AGE=999
[ -f "$_NB_F.t" ] && {
	_NB_T=$(cat "$_NB_F.t" 2>/dev/null)
	case "$_NB_T" in ''|*[!0-9]*) : ;; *) _NB_AGE=$(( $(cut -d. -f1 /proc/uptime) - _NB_T )) ;; esac
}
if [ "$_NB_AGE" -ge 30 ] 2>/dev/null; then
	_NB_OUT=""
	_NB_N=1
	while [ "$_NB_N" -le 5 ]; do
		sms_tool -d $DEVICE at "AT#MONI=$_NB_N" >/dev/null 2>&1
		_NB_SET=$(sms_tool -d $DEVICE at "AT#MONI" 2>/dev/null | tr -d '\r' | grep "^#MONI: *RSRP")
		[ -n "$_NB_SET" ] || break
		_NB_OUT="$_NB_OUT$_NB_SET
"
		_NB_N=$((_NB_N + 1))
	done
	sms_tool -d $DEVICE at "AT#MONI=0" >/dev/null 2>&1
	# Строка соседа -> объект в формате поля neighbors (см. _qr_nb в 5gmodem.sh).
	# РАЗБИРАЕМ В ШЕЛЛЕ, А НЕ В AWK: диапазон считает channeltoband - функция
	# диспетчера, вторая её копия в профиле однажды разошлась бы с первой. Строк
	# тут единицы, цена перебора нулевая. (Первая версия собирала JSON в awk и
	# доклеивала диапазон снаружи - разбор ломался, потому что объекты JSON сами
	# содержат запятые, по которым шло разделение.)
	_NB_JSON=""
	_SIFS_NB="$IFS"; IFS='
'
	for _nb_l in $_NB_OUT; do
		case "$_nb_l" in *RSRP*) ;; *) continue ;; esac
		_nb_pciH=$(printf '%s' "$_nb_l" | sed -n 's/.*Id:\([0-9A-Fa-f]*\).*/\1/p')
		[ -n "$_nb_pciH" ] || continue
		_nb_pci=$(printf '%d' "0x$_nb_pciH" 2>/dev/null) || continue
		_nb_e=$(printf '%s' "$_nb_l" | sed -n 's/.*EARFCN:\([0-9]*\).*/\1/p')
		_nb_rp=$(printf '%s' "$_nb_l" | sed -n 's/.*RSRP:\(-\{0,1\}[0-9]*\).*/\1/p')
		_nb_rq=$(printf '%s' "$_nb_l" | sed -n 's/.*RSRQ:\(-\{0,1\}[0-9]*\).*/\1/p')
		_nb_rs=$(printf '%s' "$_nb_l" | sed -n 's/.*PWR:\(-\{0,1\}[0-9]*\).*/\1/p')
		# Набор 1 включает и САМУ обслуживающую соту - в таблице она уже есть
		# отдельной подсвеченной строкой, второй раз не показываем.
		[ "$_nb_pci" = "$PCI" ] && [ "$_nb_e" = "$EARFCN" ] && continue
		_nb_b=""
		[ -n "$_nb_e" ] && _nb_b=$(channeltoband "$_nb_e" 2>/dev/null)
		case "$_nb_b" in ''|*[!0-9]*) _nb_b="" ;; esac
		_NB_JSON="$_NB_JSON${_NB_JSON:+,}$(printf '{"band":"%s","earfcn":"%s","pci":"%s","rsrp":"%s","rsrq":"%s","rssi":"%s","serving":0}' \
			"$_nb_b" "$_nb_e" "$_nb_pci" "$_nb_rp" "$_nb_rq" "$_nb_rs")"
	done
	IFS="$_SIFS_NB"
	printf '%s' "$_NB_JSON" > "$_NB_F" 2>/dev/null
	cut -d. -f1 /proc/uptime > "$_NB_F.t" 2>/dev/null
else
	_NB_JSON=$(cat "$_NB_F" 2>/dev/null)
fi

# Обслуживающая сота - первой строкой таблицы, из уже разобранных полей профиля
# (у #MONI=0 нет PCI, он берётся из #CAINFO выше).
if [ "${MODE_NUM#7}" != "$MODE_NUM" ] && [ -n "$PCI" ] && [ -n "$EARFCN" ]; then
	_NB_SRV=$(printf '{"band":"%s","earfcn":"%s","pci":"%s","rsrp":"%s","rsrq":"%s","rssi":"%s","serving":1}' \
		"$(channeltoband "$EARFCN" 2>/dev/null)" "$EARFCN" "$PCI" "$RSRP" "$RSRQ" "$RSSI")
	NEIGHBORS="$_NB_SRV${_NB_JSON:+,$_NB_JSON}"
else
	NEIGHBORS="$_NB_JSON"
fi
