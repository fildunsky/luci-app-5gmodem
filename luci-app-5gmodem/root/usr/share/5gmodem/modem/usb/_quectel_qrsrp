if [ -z "$ANTPORTS" ]; then
	_QA=$(sms_tool -d $DEVICE at "at+qrsrp" 2>/dev/null | awk '
		/^\+QRSRP:/ && !done {
			done = 1
			sub(/^\+QRSRP:[[:space:]]*/, "")
			n = split($0, a, /,[[:space:]]*/)
			out = ""; on = 0
			for (i = 1; i <= n && i <= 4; i++) {
				if (a[i] !~ /^-?[0-9]+$/) continue
				v = a[i] + 0
				if (v <= -140 || v >= -20) continue
				out = out (out ? " " : "") (i-1) ":" v ":"
				if (v > -130) on++
			}
			print on "|" out
		}')
	_qr_on="${_QA%%|*}"; _qr_ap="${_QA#*|}"
	if [ -n "$_qr_ap" ] && [ "$_qr_on" -ge 1 ] 2>/dev/null; then
		ANTPORTS="$_qr_ap"
		case "$_qr_on" in
			1) RXDIV="off" ;;
			2) RXDIV="2rx" ;;
			3|4) RXDIV="4rx" ;;
		esac
	fi
fi
