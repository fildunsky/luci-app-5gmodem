# Приём по антеннам для Quectel - общий фрагмент, сорсится в конце каждого
# 2c7c-профиля (образец подключения - _sierra_gobi_lte).
#
# AT+QRSRP отдаёт RSRP четырёх приёмных цепей (PRX, DRX, RX2, RX3) одной
# строкой: "+QRSRP: -95,-99,-140,-140[,LTE]" (пятое поле - RAT, есть не у
# всех прошивок; на NR-модемах строк может быть две - берём первую, это
# обслуживающая сота). Незадействованная цепь отвечает заглушкой -140 (или
# -32768): её в таблицу не кладём - у двухантенного EP06 цепи RX2/RX3 не
# существуют физически, и четыре строки на нём читались бы как «четыре
# антенных порта». Команда вендорная: модели без неё (EC200 и родня)
# отвечают ERROR - блок просто не появляется.
#
# Формат ANTPORTS общий со страницей («порт:rsrp:rsrq», RSRQ по цепям
# Quectel не даёт - поле пустое, как у Sierra). RXDIV - по числу цепей с
# живым уровнем (выше -130): 1 = off (вторая антенна молчит), 2 = 2RX,
# 3-4 = 4RX.
if [ -z "$ANTPORTS" ]; then
	_QA=$(sms_tool -d $DEVICE at "at+qrsrp" 2>/dev/null | awk '
		/^\+QRSRP:/ && !done {
			done = 1
			sub(/^\+QRSRP:[[:space:]]*/, "")
			n = split($0, a, /,[[:space:]]*/)
			out = ""; on = 0
			for (i = 1; i <= n && i <= 4; i++) {
				if (a[i] !~ /^-?[0-9]+$/) continue
				v = a[i] + 0
				if (v <= -140 || v >= -20) continue
				out = out (out ? " " : "") (i-1) ":" v ":"
				if (v > -130) on++
			}
			print on "|" out
		}')
	_qr_on="${_QA%%|*}"; _qr_ap="${_QA#*|}"
	if [ -n "$_qr_ap" ] && [ "$_qr_on" -ge 1 ] 2>/dev/null; then
		ANTPORTS="$_qr_ap"
		case "$_qr_on" in
			1) RXDIV="off" ;;
			2) RXDIV="2rx" ;;
			3|4) RXDIV="4rx" ;;
		esac
	fi
fi
