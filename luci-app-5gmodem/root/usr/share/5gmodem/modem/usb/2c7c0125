. "$RES/modem/usb/_quectel_common"

O=$(sms_tool -d $DEVICE at "at+qtemp")

T=$(echo "$O" | awk -F[,:] '/^\+QTEMP/ {t=$2*1;if($3*1>t)t=$3*1;if($4*1>t)t=$4*1;printf "%d", t}')
[ -n "$T" ] && TEMP="$T &deg;C"

if [ "$REGOK" = "1" ]; then
	_qc_ec25_lte
fi

_qc_ids

# Modem
_qc_ati

_qc_proto "Vendor=2c7c ProdID=0125" 1220

. "$RES/modem/usb/_quectel_qrsrp"
