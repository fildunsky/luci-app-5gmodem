[ -n "$DEVICE" ] && . "$RES/modem/usb/05c690b4"
MODEL=$(soc_modem_model)
TEMPS=$(for z in /sys/class/thermal/thermal_zone*; do
	[ -r "$z/type" ] && echo "$(cat "$z/type" 2>/dev/null) $(cat "$z/temp" 2>/dev/null)"
done | awk '$2 ~ /^-?[0-9]+$/ && $2 > 0 { k = ""
	if ($1 == "pa-thermal") k = "pa"; else if ($1 ~ /^cpu[0-9-]*-thermal$/) k = "cpu"
	else if ($1 == "pm8916-thermal") k = "pmic"; else if ($1 == "battery-thermal") k = "bat"
	else if ($1 == "xo-thermal") k = "board"; else if ($1 == "charger-thermal") k = "charger"
	if (k == "") next
	if (!(k in v)) o[++n] = k
	if (!(k in v) || $2 > v[k]) v[k] = $2 }
	END { for (i = 1; i <= n; i++) printf "%s%s=%.1f", (i > 1 ? " " : ""), o[i], v[o[i]] / 1000 }')
T=$(printf '%s' "$TEMPS" | tr ' ' '\n' | sed -n 's/^pa=//p')
[ -n "$T" ] || T=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | awk '$1 ~ /^-?[0-9]+$/ { v = $1; if (v > 1000) v = int(v / 1000); if (v > m) m = v } END { if (m > 0) print m }')
[ -n "$T" ] && TEMP="${T%.*} &deg;C"
_SOC_EXT=0
for _SOC_PS in /sys/class/power_supply/*; do
	case "$(cat "$_SOC_PS/type" 2>/dev/null)" in
		USB|Mains) [ "$(cat "$_SOC_PS/online" 2>/dev/null)" = 1 ] && _SOC_EXT=1 ;;
	esac
done
for _SOC_PS in /sys/class/power_supply/*; do
	[ "$(cat "$_SOC_PS/type" 2>/dev/null)" = Battery ] || continue
	O=$(cat "$_SOC_PS/capacity" 2>/dev/null)
	case "$O" in
		''|*[!0-9]*)
			O=$(cat "$_SOC_PS/voltage_ocv" 2>/dev/null || cat "$_SOC_PS/voltage_now" 2>/dev/null)
			O=$(awk -v u="$O" 'BEGIN {
				if (u !~ /^[0-9]+$/ || u < 2500000) exit
				n = split("3400 0 3600 5 3700 15 3750 30 3800 45 3850 55 3900 65 3950 75 4000 82 4100 92 4200 100", t, " ")
				v = u / 1000
				if (v <= t[1]) { print 0; exit }
				for (i = 3; i <= n; i += 2) if (v <= t[i]) { printf "%d", t[i - 1] + (v - t[i - 2]) * (t[i + 1] - t[i - 1]) / (t[i] - t[i - 2]); exit }
				print 100 }')
			[ -n "$O" ] || continue ;;
	esac
	BATTERY="$O"
	case "$(cat "$_SOC_PS/status" 2>/dev/null)" in
		Charging) BATTERY_CHG=1 ;;
		Full|'Not charging') BATTERY_CHG=0 ;;
		*) BATTERY_CHG=$_SOC_EXT; [ "$O" -ge 100 ] && BATTERY_CHG=0 ;;
	esac
	break
done
