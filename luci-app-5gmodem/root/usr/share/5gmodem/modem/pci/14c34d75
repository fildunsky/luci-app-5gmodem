# Fibocom FM350-GL (MediaTek T700/MT6880) - вариант PCIe под драйвером mtk_t7xx.
#
# ОТКУДА ИДЕНТИФИКАТОР. 14c3:4d75 - это PCI VID/DID самого модуля: в теме он
# приведён десятками строк вида `PCI\VEN_14C3&DEV_4D75&SUBSYS_...` (подборка по
# вендорам - #1598 Kаdabra, отдельные наблюдения - #299, #535, #604). Меняется
# только SUBSYS (HP/Lenovo/Dell/Generic), VID/DID у всех один, поэтому ключ
# профиля общий на все варианты.
#
# КАК ЕГО ВИДИТ СИСТЕМА. FM350 умеет только PCIe Endpoint и при наличии линий в
# слоте сам форсирует себя в PCIe-режим (#8258, #8580); ttyUSB/ttyACM тогда не
# создаются вовсе, и остаются ровно два узла: /dev/wwan0at0 (AT-порт) и
# /dev/wwan0mbim0 (канал данных) - живые наблюдения #4453, #4462, #4465, #4499,
# #7030, #9784. Драйвер - mtk_t7xx (#8338).
#
# Набор AT-команд от шины не зависит: тот же GTCCINFO/GTCAINFO/CESQ/GTRXPATHEN/
# ECELL, что и по USB, - поэтому переиспользуем USB-профиль целиком, как это уже
# сделано для PCIe-вариантов RM520N (pci/17cb0308) и T99W373 (pci/105be0d9).
# (ревью 13.09.2026, форум 4pda)
. "$RES/modem/usb/0e8d7127"

# ПРОТОКОЛ КАНАЛА ДАННЫХ - НЕ ИЗ SYSFS USB. Профиль выше ищет драйвер
# usb-интерфейса рядом с ttyUSB, а шины USB здесь нет вовсе, и PROTO всегда
# оставался бы пустым. Смотрим, какой канал модуль выставил рядом с AT-портом.
# У FM350 по PCIe это всегда MBIM (qmi-канала t7xx не создаёт: «всё, что у меня
# есть, - /dev/wwan0at0 и /dev/wwan0mbim0», #4453/#4462), поэтому MBIM же и
# значение по умолчанию, если узел канала почему-то не виден.
if [ -z "$PROTO" ]; then
	case "${DEVICE##*/}" in
		wwan*)
			_MPFX=$(printf '%s' "${DEVICE##*/}" | sed 's/at[0-9]*$//')
			if [ -n "$_MPFX" ]; then
				[ -e "/dev/${_MPFX}mbim0" ] && PROTO="mbim"
				[ -z "$PROTO" ] && [ -e "/dev/${_MPFX}qmi0" ] && PROTO="qmi"
			fi
			[ -z "$PROTO" ] && PROTO="mbim"
			;;
	esac
fi
