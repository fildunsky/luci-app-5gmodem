{
	"luci-app-5gmodem": {
		"description": "Grant access to LuCI app 5gmodem",
		"read": {
			"cgi-io": [ "exec", "upload" ],
			"file": {
				"/usr/share/5gmodem/5gmodem.sh": [ "exec" ],
				"/usr/share/5gmodem/detect.sh": [ "exec" ],
				"/usr/share/5gmodem/ttl.sh": [ "exec" ],
				"/usr/share/5gmodem/update.sh": [ "exec" ],
				"/usr/share/5gmodem/powercheck.sh": [ "exec" ],
				"/usr/share/5gmodem/reboot_modem.sh": [ "exec" ],
				"/usr/share/5gmodem/listports.sh": [ "exec" ],
				"/usr/share/5gmodem/listmodems.sh": [ "exec" ],
				"/usr/share/5gmodem/modemswitch.sh": [ "exec" ],
				"/usr/share/5gmodem/netpri.sh": [ "exec" ],
				"/usr/share/5gmodem/bands.sh": [ "exec" ],
				"/usr/share/5gmodem/speedtest.sh": [ "exec" ],
				"/usr/share/5gmodem/simslot.sh": [ "exec" ],
				"/usr/share/5gmodem/signal-leds.sh": [ "exec" ],
				"/usr/share/5gmodem/esim.sh": [ "exec" ],
				"/usr/share/5gmodem/mm-inhibit.sh": [ "exec" ],
				"/usr/share/5gmodem/collect.sh": [ "exec" ],
				"/usr/share/5gmodem/check.gcom": [ "exec" ],
				"/usr/share/5gmodem/info.gcom": [ "exec" ],
				"/usr/bin/mmcli": [ "exec" ],
				"/usr/bin/sms_tool": [ "exec" ],
				"/usr/bin/sms_tool_mm": [ "exec" ],
				"/etc/init.d/my_new_sms": [ "exec" ],
				"/etc/init.d/led": [ "exec" ],
				"/etc/init.d/cron": [ "exec" ],
				"/sbin/smstool_led.sh": [ "exec" ],
				"/sbin/sms_led.sh": [ "exec" ],
				"/bin/sh": [ "exec" ],
				"/bin/cat": [ "exec" ],
				"/bin/tar": [ "exec" ],
				"/bin/mkdir": [ "exec" ],
				"/bin/rm": [ "exec" ],
				"/sys/class/leds": [ "list" ],
				"/dev": [ "list" ],
				"/etc/crontabs/root": [ "read" ],
				"/usr/bin/opkg list-installed": [ "exec" ],
				"/usr/libexec/package-manager-call list-installed": [ "exec" ],
				"/usr/libexec/opkg-list installed": [ "exec" ],
				"/usr/libexec/opkg-call list-installed": [ "exec" ],
				"/etc/modemdefine": [ "read" ],
				"/etc/5gmodem": [ "read" ],
				"/etc/sms_tool_js": [ "read" ],
				"/etc/defmodems": [ "read" ],
				"/sys/kernel/debug/usb/devices": [ "read" ],
				"/tmp/mysms.txt": [ "read" ],
				"/tmp/5gmodem_update.json": [ "read" ],
				"/tmp/5gmodem_listmodems.cache": [ "read" ],
				"/tmp/5gmodem-diag.txt": [ "read" ],
				"/etc/modem/atcmmds.user": [ "read" ],
				"/etc/modem/atcmmds": [ "list" ],
				"/etc/modem/atcmmds/*": [ "read" ],
				"/etc/modem/atcmmds/*.user": [ "read" ],
				"/etc/modem/phonebook.user": [ "read" ],
				"/etc/modem/ussdcodes": [ "list" ],
				"/etc/modem/ussdcodes/*": [ "read" ],
				"/etc/modem/ussdcodes/*.user": [ "read" ],
				"/etc/modem/ussdcodes.user": [ "read" ]
			},
			"uci": [ "5gmodem", "sms_tool_js", "modemdefine", "defmodems", "network", "firewall" ],
			"ubus": {
				"file": [ "read" ],
				"sms_forward": [ "forward" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/bin/cat": [ "exec" ],
				"/usr/share/5gmodem/ttl.sh": [ "exec" ],
				"/usr/share/5gmodem/mkiface.sh": [ "exec" ],
				"/usr/share/5gmodem/mmneed.sh": [ "exec" ],
				"/usr/share/5gmodem/update.sh": [ "exec" ],
				"/usr/share/5gmodem/powercheck.sh": [ "exec" ],
				"/usr/share/5gmodem/reboot_modem.sh": [ "exec" ],
				"/usr/share/5gmodem/listports.sh": [ "exec" ],
				"/usr/share/5gmodem/listmodems.sh": [ "exec" ],
				"/usr/share/5gmodem/modemswitch.sh": [ "exec" ],
				"/usr/share/5gmodem/netpri.sh": [ "exec" ],
				"/usr/share/5gmodem/bands.sh": [ "exec" ],
				"/usr/share/5gmodem/speedtest.sh": [ "exec" ],
				"/usr/share/5gmodem/simslot.sh": [ "exec" ],
				"/usr/share/5gmodem/signal-leds.sh": [ "exec" ],
				"/usr/share/5gmodem/esim.sh": [ "exec" ],
				"/usr/share/5gmodem/mm-inhibit.sh": [ "exec" ],
				"/usr/share/5gmodem/collect.sh": [ "exec" ],
				"/bin/sh -x /usr/share/5gmodem/5gmodem.sh": [ "exec" ],
				"/bin/ls /dev": [ "exec" ],
				"/bin/chmod": [ "exec" ],
				"/bin/rm": [ "exec" ],
				"/bin/tar": [ "exec" ],
				"/bin/mkdir": [ "exec" ],
				"/etc/init.d/cron restart": [ "exec" ],
				"/etc/modemdefine": [ "write" ],
				"/etc/5gmodem": [ "write" ],
				"/etc/sms_tool_js": [ "write" ],
				"/etc/crontabs/root": [ "write" ],
				"/sys/class/leds/*/brightness": [ "write" ],
				"/tmp/debug_result.txt": [ "write" ],
				"/tmp/mysms.txt": [ "write" ],
				"/etc/modem/atcmmds.user": [ "write" ],
				"/etc/modem/atcmmds/*.user": [ "write" ],
				"/etc/modem/atcmmds/*": [ "write" ],
				"/etc/modem/phonebook.user": [ "write" ],
				"/etc/modem/ussdcodes/*.user": [ "write" ],
				"/etc/modem/ussdcodes/*": [ "write" ],
				"/etc/modem/ussdcodes.user": [ "write" ]
			},
			"uci": [ "5gmodem", "sms_tool_js", "modemdefine", "network", "firewall" ],
			"ubus": {
				"file": [ "read", "write", "remove" ]
			}
		}
	}
}
