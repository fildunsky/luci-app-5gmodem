{
	"luci-app-5gmodem": {
		"description": "Grant access to LuCI app 5gmodem. WARNING: root-equivalent. This group can send arbitrary AT commands to the modem (atcmd.sh - the AT console needs that by design) and restart the modem / switch its bands. Do NOT grant it to a restricted role - give it only to full administrators.",
		"read": {
			"cgi-io": [ "exec", "upload" ],
			"file": {
				"/usr/share/5gmodem/5gmodem.sh": [ "exec" ],
				"/usr/share/5gmodem/detect.sh": [ "exec" ],
				"/usr/share/5gmodem/ssclash.sh": [ "exec" ],
				"/usr/share/5gmodem/ttl.sh": [ "exec" ],
				"/usr/share/5gmodem/update.sh": [ "exec" ],
				"/usr/share/5gmodem/powercheck.sh": [ "exec" ],
				"/usr/share/5gmodem/reboot_modem.sh": [ "exec" ],
				"/usr/share/5gmodem/listports.sh": [ "exec" ],
				"/usr/share/5gmodem/hilink.sh": [ "exec" ],
				"/usr/share/5gmodem/smsbridge.sh": [ "exec" ],
				"/usr/share/5gmodem/atcmd.sh": [ "exec" ],
				"/usr/share/5gmodem/smscron.sh": [ "exec" ],
				"/usr/share/5gmodem/ussd.sh": [ "exec" ],
				"/usr/share/5gmodem/listmodems.sh": [ "exec" ],
				"/usr/share/5gmodem/modemswitch.sh": [ "exec" ],
				"/usr/share/5gmodem/netpri.sh": [ "exec" ],
				"/usr/share/5gmodem/bands.sh": [ "exec" ],
				"/usr/share/5gmodem/buttons.sh": [ "exec" ],
				"/usr/share/5gmodem/speedtest.sh": [ "exec" ],
				"/usr/share/5gmodem/simslot.sh": [ "exec" ],
				"/usr/share/5gmodem/signal-leds.sh": [ "exec" ],
				"/usr/share/5gmodem/esim.sh": [ "exec" ],
				"/usr/share/5gmodem/mm-inhibit.sh": [ "exec" ],
				"/usr/share/5gmodem/setopt.sh": [ "exec" ],
				"/usr/share/5gmodem/collect.sh": [ "exec" ],
				"/usr/share/5gmodem/check.gcom": [ "exec" ],
				"/usr/share/5gmodem/info.gcom": [ "exec" ],
				"/usr/bin/mmcli": [ "exec" ],
				"/etc/init.d/5gmodem-sms-notify": [ "exec" ],
				"/etc/init.d/led": [ "exec" ],
				"/etc/init.d/cron": [ "exec" ],
				"/usr/share/5gmodem/smstool_led.sh": [ "exec" ],
				"/usr/share/5gmodem/sms_led.sh": [ "exec" ],
				"/bin/sh": [ "exec" ],
				"/bin/cat": [ "exec" ],
				"/bin/tar": [ "exec" ],
				"/bin/mkdir": [ "exec" ],
				"/bin/rm": [ "exec" ],
				"/sys/class/leds": [ "list" ],
				"/dev": [ "list" ],
				"/usr/bin/opkg list-installed": [ "exec" ],
				"/usr/libexec/package-manager-call list-installed": [ "exec" ],
				"/usr/libexec/opkg-list installed": [ "exec" ],
				"/usr/libexec/opkg-call list-installed": [ "exec" ],
				"/etc/modemdefine": [ "read" ],
				"/etc/5gmodem": [ "read" ],
				"/etc/defmodems": [ "read" ],
				"/sys/kernel/debug/usb/devices": [ "read" ],
				"/tmp/mysms.txt": [ "read" ],
				"/tmp/5gmodem_update.json": [ "read" ],
				"/tmp/5gmodem_listmodems.cache": [ "read" ],
				"/tmp/5gmodem-diag.txt": [ "read" ],
				"/etc/5gmodem/modem/atcmmds.user": [ "read" ],
				"/etc/5gmodem/modem/atcmmds": [ "list" ],
				"/etc/5gmodem/modem/atcmmds/*": [ "read" ],
				"/etc/5gmodem/modem/atcmmds/*.user": [ "read" ],
				"/etc/5gmodem/modem/phonebook.user": [ "read" ],
				"/etc/5gmodem/modem/ussdcodes": [ "list" ],
				"/etc/5gmodem/modem/ussdcodes/*": [ "read" ],
				"/etc/5gmodem/modem/ussdcodes/*.user": [ "read" ],
				"/etc/5gmodem/modem/ussdcodes.user": [ "read" ]
			},
			"uci": [ "5gmodem", "modemdefine", "defmodems", "network", "firewall", "system" ],
			"ubus": {
				"file": [ "read" ],
				"5gmodem_sms_forward": [ "forward" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/bin/cat": [ "exec" ],
				"/usr/share/5gmodem/ttl.sh": [ "exec" ],
				"/usr/share/5gmodem/mkiface.sh": [ "exec" ],
				"/usr/share/5gmodem/mmneed.sh": [ "exec" ],
				"/usr/share/5gmodem/update.sh": [ "exec" ],
				"/usr/share/5gmodem/powercheck.sh": [ "exec" ],
				"/usr/share/5gmodem/reboot_modem.sh": [ "exec" ],
				"/usr/share/5gmodem/listports.sh": [ "exec" ],
				"/usr/share/5gmodem/hilink.sh": [ "exec" ],
				"/usr/share/5gmodem/smsbridge.sh": [ "exec" ],
				"/usr/share/5gmodem/atcmd.sh": [ "exec" ],
				"/usr/share/5gmodem/smscron.sh": [ "exec" ],
				"/usr/share/5gmodem/ussd.sh": [ "exec" ],
				"/usr/share/5gmodem/listmodems.sh": [ "exec" ],
				"/usr/share/5gmodem/modemswitch.sh": [ "exec" ],
				"/usr/share/5gmodem/netpri.sh": [ "exec" ],
				"/usr/share/5gmodem/bands.sh": [ "exec" ],
				"/usr/share/5gmodem/buttons.sh": [ "exec" ],
				"/usr/share/5gmodem/speedtest.sh": [ "exec" ],
				"/usr/share/5gmodem/simslot.sh": [ "exec" ],
				"/usr/share/5gmodem/signal-leds.sh": [ "exec" ],
				"/usr/share/5gmodem/esim.sh": [ "exec" ],
				"/usr/share/5gmodem/mm-inhibit.sh": [ "exec" ],
				"/usr/share/5gmodem/setopt.sh": [ "exec" ],
				"/usr/share/5gmodem/collect.sh": [ "exec" ],
				"/bin/sh -x /usr/share/5gmodem/5gmodem.sh": [ "exec" ],
				"/bin/ls /dev": [ "exec" ],
				"/bin/chmod": [ "exec" ],
				"/bin/rm": [ "exec" ],
				"/bin/tar": [ "exec" ],
				"/bin/mkdir": [ "exec" ],
				"/etc/init.d/cron restart": [ "exec" ],
				"/etc/modemdefine": [ "write" ],
				"/etc/5gmodem": [ "write" ],
				"/sys/class/leds/*/brightness": [ "write" ],
				"/tmp/debug_result.txt": [ "write" ],
				"/tmp/mysms.txt": [ "write" ],
				"/etc/5gmodem/modem/atcmmds.user": [ "write" ],
				"/etc/5gmodem/modem/atcmmds/*.user": [ "write" ],
				"/etc/5gmodem/modem/atcmmds/*": [ "write" ],
				"/etc/5gmodem/modem/phonebook.user": [ "write" ],
				"/etc/5gmodem/modem/ussdcodes/*.user": [ "write" ],
				"/etc/5gmodem/modem/ussdcodes/*": [ "write" ],
				"/etc/5gmodem/modem/ussdcodes.user": [ "write" ]
			},
			"uci": [ "5gmodem", "modemdefine", "network", "firewall" ],
			"ubus": {
				"file": [ "read", "write", "remove" ]
			}
		}
	}
}
