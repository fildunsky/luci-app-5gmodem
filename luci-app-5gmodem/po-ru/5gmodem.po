msgstr "пакет профиля"

msgid "value not allowed"
msgstr "значение недопустимо"

msgid "invalid association"
msgstr "неверная привязка"

msgid "already exists"
msgstr "уже существует"

msgid "unavailable"
msgstr "недоступно"

msgid "certificate expired"
msgstr "сертификат просрочен"

msgid "refused or already used"
msgstr "отклонено или уже использовано"

