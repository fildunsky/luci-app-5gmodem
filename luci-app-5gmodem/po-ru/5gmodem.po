msgstr "База APN"

msgid "Check the APN database"
msgstr "Проверить базу APN"

msgid "Update the APN database"
msgstr "Обновить базу APN"

msgid "Checking the APN database…"
msgstr "Проверяю базу APN…"

msgid "Updating the APN database…"
msgstr "Обновляю базу APN…"

msgid "The APN database is up to date"
msgstr "База APN актуальна"

