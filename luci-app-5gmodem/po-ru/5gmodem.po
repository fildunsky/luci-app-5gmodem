msgstr "Интерфейс «%s» останется: им пользуется другой профиль."

msgid "This modem is connected right now. It will be set up again from scratch."
msgstr "Этот модем сейчас подключён. Он будет настроен заново с нуля."

msgid "Not enough power?"
msgstr "Не хватает питания?"

msgid "%d modems request %d mA. Such a modem answers AT commands, but its interface stays down — a powered USB hub helps."
msgstr "%d модема запрашивают %d мА. Такой модем отвечает на AT-команды, но интерфейс не поднимается — помогает USB-хаб с питанием."

msgid "5G in modem"
msgstr "5G в модеме"

msgid "Enabled (SA + NSA)"
msgstr "Включён (SA + NSA)"

msgid "Only SA enabled"
msgstr "Включён только SA"

msgid "Only NSA enabled"
msgstr "Включён только NSA"

msgid "Disabled in modem"
msgstr "Выключен в модеме"

msgid "5G bands and cell lock have no effect until this is enabled"
msgstr "Диапазоны 5G и привязка к соте не действуют, пока это не включено"

msgid "Enable 5G"
msgstr "Включить 5G"

msgid "Enabling 5G — the modem is restarting its radio…"
msgstr "Включаем 5G — модем перезапускает радио…"

msgid "Carrier aggregation"
msgstr "Агрегация несущих"

msgid "The modem works without carrier aggregation, as if it were cat4"
msgstr "Модем работает без агрегации несущих, как cat4"

