# --- eSIM download error messages (GSMA SGP.22 codes, human-readable) ---

msgid "Downloading eSIM profile…"
msgstr "Скачивание профиля eSIM…"

msgid "This can take up to a minute — please stay on this page."
msgstr "Это может занять до минуты — не покидайте страницу."

msgid "Starting…"
msgstr "Запуск…"

msgid "Download failed"
msgstr "Профиль не загрузился. Проверьте код активации и попробуйте ещё раз"

msgid "This eSIM profile has already been downloaded to a device and cannot be downloaded again. Ask your operator for a new activation code."
msgstr "Этот профиль eSIM уже был загружен на устройство, повторная загрузка невозможна. Запросите у оператора новый код активации."

msgid "This activation (QR) code has already been used or is no longer valid. Ask your operator for a new one."
msgstr "Этот код активации (QR) уже использован или больше не действителен. Запросите у оператора новый."

msgid "A confirmation code is required for this profile, or the one entered is wrong."
msgstr "Для этого профиля нужен код подтверждения, либо введённый код неверен."

msgid "A profile with this ICCID is already installed on the eSIM."
msgstr "Профиль с таким ICCID уже установлен на eSIM."

msgid "The operator could not verify this eSIM chip (eUICC verification failed)."
msgstr "Оператор не смог проверить этот чип eSIM (проверка eUICC не пройдена)."

msgid "The operator refused to release this profile."
msgstr "Оператор отказал в выдаче этого профиля."

msgid "Not enough free memory on the eSIM to install the profile. Delete an unused profile and try again."
msgstr "На eSIM недостаточно свободной памяти для установки профиля. Удалите неиспользуемый профиль и повторите."

