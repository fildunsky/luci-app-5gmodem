#!/bin/sh
#
# ПЛЕЙГРАУНД /5g: read-only метрики модема мимо LuCI, напрямую через uhttpd.
#
# Смысл - скорость открытия на слабом роутере: без фреймворка LuCI (luci.js/
# form.js/ui.js + ~80 КБ вьюхи), страница лёгкая и один запрос за данными.
#
# ДОСТУП: ОТКРЫТЫЙ, ТОЛЬКО ЧТЕНИЕ. Логина здесь НЕТ (по решению владельца -
# используем как плейграунд конструктора карточек метрик). Отдаём ИСКЛЮЧИТЕЛЬНО
# снимок метрик (5gmodem.sh cached) - никакого управления модемом (SMS/AT/запись
# в конфиг) через этот эндпоинт нет и быть не должно. Если сюда добавят
# управляющие команды - ОБЯЗАТЕЛЬНО вернуть авторизацию (ubus session login),
# см. историю файла. Учти: метрики содержат IMEI/IMSI/ICCID/оператора - в LAN
# они станут доступны без пароля.

RES=/usr/share/5gmodem

hdr() {
	printf 'Status: %s\r\n' "$1"
	printf 'Content-Type: application/json\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf '\r\n'
}

case "$QUERY_STRING" in
*metrics*|'')
	hdr "200 OK"
	# cached, а не полный опрос: в порт ходит один процесс (блокировка в
	# 5gmodem.sh), остальные читают снимок - см. пояснение там же.
	"$RES/5gmodem.sh" cached 5 2>/dev/null
	;;
*modems*)
	# Список модемов (для выбора активного в конструкторе). Тоже read-only.
	hdr "200 OK"
	"$RES/listmodems.sh" 2>/dev/null
	;;
*)
	hdr "400 Bad Request"
	printf '{"error":"unknown query"}\n'
	;;
esac
exit 0
