msgid ""
"Each line must have the following format: 'Code description;code'. For user "
"convenience, the file is saved to the location <code>/etc/5gmodem/modem/ussdcodes/</"
"code>."
msgstr ""
"Jede Zeile muss folgendes Format haben: 'Code-Beschreibung;Code'. Zur "
"Benutzerfreundlichkeit wird die Datei unter <code>/etc/5gmodem/modem/ussdcodes/</"
"code> gespeichert."

msgid ""
"Each line must have the following format: 'AT command description;AT "
"command'. For user convenience, the file is saved to the location <code>/etc/"
"modem/atcmmds/</code>."
msgstr ""
"Jede Zeile muss folgendes Format haben: 'AT-Befehl-Beschreibung;AT-Befehl'. "
"Zur Benutzerfreundlichkeit wird die Datei unter <code>/etc/5gmodem/modem/atcmmds/</"
"code> gespeichert."

