msgstr "Tab eSIM"

msgid "Detected automatically by probing the modem for an eUICC. If the probe is wrong, force the tab on or off here."
msgstr "Được phát hiện tự động bằng cách thăm dò eUICC trên modem. Nếu kết quả sai, hãy buộc bật hoặc tắt tab tại đây."

msgid "Automatically"
msgstr "Tự động"

msgid "Always show"
msgstr "Luôn hiện"

msgid "Always hide"
msgstr "Luôn ẩn"

msgid "set manually in the modem settings"
msgstr "đặt thủ công trong cài đặt modem"

msgid "detected by probing the modem"
msgstr "phát hiện bằng cách thăm dò modem"

msgid "yes (manually)"
msgstr "có (thủ công)"

msgid "no (manually)"
msgstr "không (thủ công)"

