msgid "%d modems request %d mA. Such a modem answers AT commands, but its interface stays down — a powered USB hub helps."
msgstr "%d modem yêu cầu %d mA. Modem như vậy vẫn trả lời lệnh AT, nhưng giao diện mạng của nó không hoạt động — hãy dùng hub USB có cấp nguồn."

msgid "A different modem is now in this USB port"
msgstr "Cổng USB này hiện đang cắm một modem khác"

msgid "APN"
msgstr "APN"

msgid "APN for the modem interface. Auto-filled from the detected operator; you can change it. Leave empty for the provider default."
msgstr "APN cho giao diện modem. Tự động điền theo nhà mạng đã phát hiện; bạn có thể thay đổi. Để trống để dùng mặc định của nhà mạng."

msgid "APN selection"
msgstr "Chọn APN"

msgid "AT command port used for SMS, USSD and AT commands. On most modems it is the same as the modem communication port."
msgstr "Cổng lệnh AT dùng cho SMS, USSD và lệnh AT. Trên hầu hết modem, nó trùng với cổng giao tiếp modem."

msgid "AT polling under ModemManager"
msgstr "Thăm dò AT khi dùng ModemManager"

msgid "AT ports (debug mode)"
msgstr "Cổng AT (chế độ gỡ lỗi)"

msgid "AT query"
msgstr "Truy vấn AT"

