msgstr "Cài đặt giao diện modem"

msgid "Live settings of the current modem interface \"%s\". Edit and press Save & Apply at the bottom; use \"Recreate\" above to rebuild it with the chosen protocol."
msgstr "Cài đặt trực tiếp của giao diện modem hiện tại \"%s\". Chỉnh sửa rồi nhấn Lưu & Áp dụng ở cuối trang; dùng \"Tạo lại\" ở trên để dựng lại với giao thức đã chọn."

msgid "Current settings of the modem interface \"%s\". Full editing is on the Network → Interfaces page."
msgstr "Cài đặt hiện tại của giao diện modem \"%s\". Chỉnh sửa đầy đủ ở trang Mạng → Giao diện."

msgid "Modem %d"
msgstr "Modem %d"

msgid "Switching to the selected modem…"
msgstr "Đang chuyển sang modem đã chọn…"

msgid "Outbox"
msgstr "Hộp thư đi"

msgid "modem"
msgstr "modem"

msgid "Internet priority"
msgstr "Ưu tiên internet"

msgid "Switching the primary uplink…"
msgstr "Đang chuyển kênh internet chính…"

msgid "Show the internet-priority switcher"
msgstr "Hiển thị bộ chuyển ưu tiên internet"

msgid "Show the \"Internet priority\" bar on the Network page for quickly switching the primary uplink (modems / WAN / Wi-Fi)."
msgstr "Hiển thị thanh \"Ưu tiên internet\" trên trang Mạng để nhanh chóng chuyển kênh internet chính (modem / WAN / Wi-Fi)."

msgid "3G bands"
msgstr "Băng tần 3G"

msgid "5G Modem"
msgstr "Modem 5G"

msgid "Carrier aggregation (per component)"
msgstr "Gộp sóng (theo từng sóng mang)"

msgid "Component"
msgstr "Thành phần"

msgid "Bandwidth"
msgstr "Băng thông"

msgid "SIM type"
msgstr "Loại SIM"

msgid "SIM slot"
msgstr "Khe SIM"

msgid "Switching SIM slot..."
msgstr "Đang chuyển khe SIM..."

msgid "SIM slot switched: %s"
msgstr "Đã chuyển khe SIM: %s"

msgid "SIM slot switch failed"
msgstr "Chuyển khe SIM thất bại"

msgid "Profile"
msgstr "Hồ sơ"

msgid "Enable"
msgstr "Bật"

msgid "Disable"
msgstr "Tắt"

msgid "Enabled"
msgstr "Đã bật"

msgid "Disabled"
msgstr "Đã tắt"

msgid "Free memory"
msgstr "Bộ nhớ trống"

msgid "Download profile"
msgstr "Tải hồ sơ"

msgid "Applying eSIM operation..."
msgstr "Đang áp dụng thao tác eSIM..."

msgid "Downloading eSIM profile..."
msgstr "Đang tải hồ sơ eSIM..."

msgid "eSIM operation done"
msgstr "Thao tác eSIM hoàn tất"

msgid "eSIM operation failed: %s"
msgstr "Thao tác eSIM thất bại: %s"

msgid "eSIM profile downloaded"
msgstr "Đã tải hồ sơ eSIM"

msgid "Delete eSIM profile"
msgstr "Xóa hồ sơ eSIM"

msgid "Delete profile \"%s\" (%s)? This cannot be undone."
msgstr "Xóa hồ sơ \"%s\" (%s)? Không thể hoàn tác."

msgid "Switch to the eSIM slot (SIM buttons in the header above) to manage eSIM profiles."
msgstr "Chuyển sang khe eSIM (nút SIM ở tiêu đề phía trên) để quản lý hồ sơ eSIM."

msgid "Reading eUICC..."
msgstr "Đang đọc eUICC..."

msgid "eUICC is not responding (%s), retrying..."
msgstr "eUICC không phản hồi (%s), đang thử lại..."

msgid "Add eSIM profile"
msgstr "Thêm hồ sơ eSIM"

msgid "eSIM management is unavailable: the lpac package is not installed, or the active modem is not an AT-type modem"
msgstr "Không thể quản lý eSIM: chưa cài gói lpac, hoặc modem đang hoạt động không phải loại AT"

msgid "The physical SIM is active now. Switch to the eSIM slot to manage eSIM profiles."
msgstr "SIM vật lý đang hoạt động. Chuyển sang khe eSIM để quản lý hồ sơ eSIM."

msgid "Switch to eSIM slot"
msgstr "Chuyển sang khe eSIM"

msgid "Switching to the eSIM slot..."
msgstr "Đang chuyển sang khe eSIM..."

msgid "Manage embedded SIM (eUICC) profiles: add by activation code, enable, disable or delete"
msgstr "Quản lý hồ sơ SIM nhúng (eUICC): thêm bằng mã kích hoạt, bật, tắt hoặc xóa"

msgid "eUICC is not responding (%s). Try Refresh in a few seconds."
msgstr "eUICC không phản hồi (%s). Hãy thử Làm mới sau vài giây."

msgid "No profiles installed"
msgstr "Chưa cài hồ sơ nào"

msgid "Downloading eSIM profile... This can take a minute, do not leave the page."
msgstr "Đang tải hồ sơ eSIM... Việc này có thể mất một phút, đừng rời khỏi trang."

msgid "Download failed: %s"
msgstr "Tải xuống thất bại: %s"

msgid "Normal"
msgstr "Bình thường"

msgid "Warm"
msgstr "Ấm"

msgid "Hot"
msgstr "Nóng"

msgid "Critical"
msgstr "Nghiêm trọng"

msgid "Modem thermal throttling level: %d of 3"
msgstr "Mức điều tiết nhiệt của modem: %d trên 3"

msgid "Slot is empty (no SIM inserted)"
msgstr "Khe trống (chưa lắp SIM)"

msgid "Please wait, reading eUICC - updating the profile list can be slow"
msgstr "Vui lòng chờ, đang đọc eUICC - cập nhật danh sách hồ sơ có thể chậm"

msgid "eSIM profile downloaded. Rebooting the modem to apply it..."
msgstr "Đã tải hồ sơ eSIM. Đang khởi động lại modem để áp dụng..."

msgid "Update installed. Refreshing resources…"
msgstr "Đã cài bản cập nhật. Đang làm mới tài nguyên…"

msgid "Update installed. Signing out to apply it…"
msgstr "Đã cài bản cập nhật. Đang đăng xuất để áp dụng…"

msgid "IP type"
msgstr "Loại IP"

msgid "IP type for the modem interface. IPv4 is the safe default: dual-stack (IPv4/IPv6) prevents some modems from connecting at all, and mobile operators rarely provide usable IPv6."
msgstr "Loại IP cho giao diện modem. IPv4 là mặc định an toàn: dual-stack (IPv4/IPv6) khiến một số modem hoàn toàn không kết nối được, và nhà mạng di động hiếm khi cung cấp IPv6 dùng được."

msgid "IPv4 only (recommended)"
msgstr "Chỉ IPv4 (khuyến nghị)"

msgid "IPv4 and IPv6"
msgstr "IPv4 và IPv6"

msgid "Disconnected modems"
msgstr "Modem đã ngắt kết nối"

msgid "Remove settings remembered for modems that are no longer connected (AT port, interface, SIM slot types). A stale entry can hide a working modem from Internet priority if both claim the same interface name."
msgstr "Xóa các cài đặt đã ghi nhớ cho những modem không còn kết nối (cổng AT, giao diện, loại khe SIM). Một mục cũ có thể che mất modem đang hoạt động khỏi danh sách ưu tiên Internet nếu cả hai cùng dùng một tên giao diện."

msgid "Forget disconnected modems"
msgstr "Quên các modem đã ngắt kết nối"

msgid "Removing…"
msgstr "Đang xóa…"

msgid "Forgotten modems: %d"
msgstr "Đã quên modem: %d"

msgid "Nothing to forget: every remembered modem is connected"
msgstr "Không có gì để quên: mọi modem đã ghi nhớ đều đang kết nối"

msgid "Failed to forget disconnected modems"
msgstr "Không thể xóa các modem đã ngắt kết nối"

msgid "Hide from ModemManager"
msgstr "Ẩn khỏi ModemManager"

msgid "ModemManager and a kernel protocol (QMI/MBIM) cannot share one modem: MM grabs the control channel and the interface gets no IP. Enabled by default for such protocols. Turn it off to hand the modem to ModemManager (its band/mode control is richer on some modems) - then use the ModemManager protocol for it."
msgstr "ModemManager và giao thức kernel (QMI/MBIM) không thể dùng chung một modem: MM chiếm kênh điều khiển và giao diện không nhận được IP. Mặc định bật cho các giao thức này. Tắt để giao modem cho ModemManager (trên một số modem, khả năng điều khiển băng tần/chế độ của nó phong phú hơn) - khi đó hãy dùng giao thức ModemManager cho modem."

msgid "Diagnostic report"
msgstr "Báo cáo chẩn đoán"

msgid "Collects settings, modem ports, AT command output, ModemManager and eSIM state, and system logs into one text file and downloads it. Attach it to a bug report. The file contains modem and SIM identifiers (IMEI, IMSI, ICCID, EID) and the operator name; it does not contain passwords or Wi-Fi keys."
msgstr "Thu thập cài đặt, cổng modem, kết quả lệnh AT, trạng thái ModemManager và eSIM cùng nhật ký hệ thống vào một tệp văn bản và tải xuống. Hãy đính kèm nó vào báo cáo lỗi. Tệp chứa các mã định danh modem và SIM (IMEI, IMSI, ICCID, EID) và tên nhà mạng; không chứa mật khẩu hay khóa Wi-Fi."

msgid "Collect logs"
msgstr "Thu thập nhật ký"

msgid "Collecting logs…"
msgstr "Đang thu thập nhật ký…"

msgid "Collecting logs failed"
msgstr "Thu thập nhật ký thất bại"

msgid "Timed out"
msgstr "Hết thời gian chờ"

msgid "The report has been downloaded. Attach it to your bug report."
msgstr "Báo cáo đã được tải xuống. Hãy đính kèm nó vào báo cáo lỗi."

msgid "Interface “%s” was created for a different modem"
msgstr "Giao diện “%s” được tạo cho một modem khác"

msgid "It is bound to this modem only because the kernel reused the device node, so its settings (APN in particular) may belong to the previous modem and SIM. Create the interface anew below - the APN is filled from the operator detected right now."
msgstr "Nó được gắn với modem này chỉ vì kernel đã dùng lại nút thiết bị, nên cài đặt của nó (đặc biệt là APN) có thể thuộc về modem và SIM trước đó. Hãy tạo lại giao diện bên dưới - APN sẽ được điền theo nhà mạng đang phát hiện."

msgid "Loading messages…"
msgstr "Đang tải tin nhắn…"

msgid "Antenna ports"
msgstr "Cổng ăng-ten"

msgid "Antenna port"
msgstr "Cổng ăng-ten"

msgid "State"
msgstr "Trạng thái"

msgid "Port %d"
msgstr "Cổng %d"

msgid "antenna not connected"
msgstr "chưa gắn ăng-ten"

msgid "antenna: weak signal"
msgstr "ăng-ten: tín hiệu yếu"

msgid "antenna: normal"
msgstr "ăng-ten: bình thường"

msgid "Applying 3G bands..."
msgstr "Đang áp dụng băng tần 3G..."

msgid "3G bands set: %s"
msgstr "Đã đặt băng tần 3G: %s"

msgid "Failed to set 3G bands"
msgstr "Không đặt được băng tần 3G"

msgid "Power restart"
msgstr "Khởi động lại nguồn"

msgid "Cuts power to the modem slot for a few seconds - as if you unplugged it. The modem comes back in ~1 min. Use when a full restart did not help."
msgstr "Ngắt nguồn khe modem trong vài giây - như khi rút modem ra. Modem trở lại sau khoảng 1 phút. Dùng khi khởi động lại hoàn toàn không giúp được."

msgid "“Hide from ModemManager” has been turned off: the ModemManager protocol needs MM to manage this modem"
msgstr "Đã tắt “Ẩn khỏi ModemManager”: giao thức ModemManager cần MM quản lý modem này"

msgid "antenna: poor signal"
msgstr "ăng-ten: tín hiệu kém"

msgid "enabled"
msgstr "đã bật"

msgid "disabled"
msgstr "đã tắt"

msgid "Profile %s. Rebooting the modem to apply it - this takes up to a minute, please wait..."
msgstr "Hồ sơ %s. Đang khởi động lại modem để áp dụng - mất tối đa một phút, vui lòng chờ..."

msgid "Profile added. Rebooting the modem to apply it - this takes up to a minute, please wait..."
msgstr "Đã thêm hồ sơ. Đang khởi động lại modem để áp dụng - mất tối đa một phút, vui lòng chờ..."

msgid "eSIM profile added and applied"
msgstr "Đã thêm và áp dụng hồ sơ eSIM"

msgid "Checking internet access..."
msgstr "Đang kiểm tra truy cập internet..."

msgid "No internet access. The router must be online to download an eSIM profile from the operator."
msgstr "Không có truy cập internet. Router phải trực tuyến để tải hồ sơ eSIM từ nhà mạng."

msgid "The operator server did not respond to a test request, but the internet is up. Trying to download anyway..."
msgstr "Máy chủ nhà mạng không phản hồi yêu cầu thử, nhưng internet vẫn hoạt động. Vẫn thử tải xuống..."

msgid "Changing bands briefly drops the connection: the IP disappears for ~15–20 seconds and comes back automatically. This is normal for this modem."
msgstr "Đổi băng tần sẽ ngắt kết nối trong chốc lát: IP mất khoảng 15–20 giây rồi tự động trở lại. Điều này bình thường với modem này."

msgid "Updating the profile list..."
msgstr "Đang cập nhật danh sách hồ sơ..."

msgid "Could not refresh the list automatically. Press Refresh in a few seconds."
msgstr "Không thể tự động làm mới danh sách. Hãy nhấn Làm mới sau vài giây."

msgid "Speed test"
msgstr "Kiểm tra tốc độ"

msgid "Testing speed…"
msgstr "Đang đo tốc độ…"

msgid "Mbps"
msgstr "Mbit/s"

msgid "Test failed"
msgstr "Kiểm tra thất bại"

msgid "Measure the real download speed over the modem - a quick way to see whether carrier aggregation is actually working"
msgstr "Đo tốc độ tải xuống thực tế qua modem - cách nhanh để xem gộp sóng có thực sự hoạt động không"

msgid "Measure the real download/upload speed over the modem - a quick way to see whether carrier aggregation is actually working"
msgstr "Đo tốc độ tải xuống/tải lên thực qua modem - cách nhanh để xem gộp sóng có thực sự hoạt động không"

msgid "Speed test: download source"
msgstr "Đo tốc độ: nguồn tải xuống"

msgid "Large-file URL for the download test, fetched over the modem. Pick a preset or enter your own. The default uses ~16 MB per run."
msgstr "URL tệp lớn cho bài đo tải xuống, tải qua modem. Chọn mẫu có sẵn hoặc nhập của bạn. Mặc định dùng ~16 MB mỗi lần đo."

msgid "Speed test: upload endpoint"
msgstr "Đo tốc độ: điểm tải lên"

msgid "Endpoint that accepts and discards a POST body, for the upload test. In Russia the default (Cloudflare) is often unreachable over cellular - set a reachable one or leave upload unused."
msgstr "Điểm nhận và bỏ qua nội dung POST, dùng cho bài đo tải lên. Ở Nga, điểm mặc định (Cloudflare) thường không truy cập được qua mạng di động - hãy đặt điểm truy cập được hoặc không dùng đo tải lên."

msgid "Public IP service"
msgstr "Dịch vụ IP công cộng"

msgid "Service that returns your public IP, checked over the modem. Pick a preset or enter your own; if it fails, the modem WAN IP is shown instead."
msgstr "Dịch vụ trả về IP công khai của bạn, kiểm tra qua modem. Chọn mẫu có sẵn hoặc nhập của bạn; nếu thất bại, IP WAN của modem sẽ được hiển thị."

msgid "Settings for the speed-test button in the \"Internet priority\" block on the Network page. The test runs from the router over the active uplink."
msgstr "Cài đặt cho nút kiểm tra tốc độ trong khối \"Ưu tiên Internet\" trên trang Mạng. Bài kiểm tra chạy từ router qua kết nối uplink đang hoạt động."

msgid "Download source"
msgstr "Nguồn tải xuống"

msgid "Large-file URL for the download test. Pick a preset or enter your own. The default uses ~16 MB per run."
msgstr "URL tệp lớn cho bài kiểm tra tải xuống. Chọn mẫu có sẵn hoặc nhập URL của bạn. Mặc định dùng khoảng 16 MB mỗi lần chạy."

msgid "Upload endpoint"
msgstr "Điểm cuối tải lên"

msgid "Service that returns your public IP. Pick a preset or enter your own; if it fails, the active uplink WAN IP is shown instead."
msgstr "Dịch vụ trả về IP công cộng của bạn. Chọn mẫu có sẵn hoặc nhập của bạn; nếu lỗi, IP WAN của uplink đang hoạt động sẽ được hiển thị thay thế."

msgid "Operator changed to \"%s\" after switching the eSIM profile. The recommended APN is \"%s\" (current: \"%s\"). Open Modem Settings to apply it."
msgstr "Nhà mạng đã đổi thành \"%s\" sau khi chuyển hồ sơ eSIM. APN khuyến nghị là \"%s\" (hiện tại: \"%s\"). Mở Cài đặt modem để áp dụng."

msgid "Open Modem Settings"
msgstr "Mở Cài đặt modem"

msgid "The modem is restarting…"
msgstr "Modem đang khởi động lại…"

msgid "The modem is restarting after the SIM switch…"
msgstr "Modem đang khởi động lại sau khi chuyển SIM…"

msgid "Download transport (ES9+)"
msgstr "Phương thức tải xuống (ES9+)"

msgid "Auto (recommended)"
msgstr "Tự động (khuyến nghị)"

msgid "wget / OpenSSL bridge"
msgstr "cầu nối wget / OpenSSL"

msgid "lpac built-in curl"
msgstr "curl tích hợp của lpac"

msgid "Download transport saved"
msgstr "Đã lưu phương thức tải xuống"

msgid "How lpac talks to the operator server (SM-DP+). \"Auto\" uses the bridge when available. The bridge reaches SM-DP+ servers that present GSMA CI certificates, which the built-in curl cannot handle on mbedTLS builds, and it verifies the certificate."
msgstr "Cách lpac giao tiếp với máy chủ nhà mạng (SM-DP+). \"Tự động\" dùng cầu nối khi có sẵn. Cầu nối truy cập được các máy chủ SM-DP+ dùng chứng chỉ GSMA CI mà curl tích hợp không xử lý được trên bản dựng mbedTLS, và nó xác minh chứng chỉ."

msgid "Country lookup"
msgstr "Tra cứu quốc gia"

msgid "Used only when the service above returns an IP but no country: the flag is then resolved by a second request. Use {ip} as the address placeholder."
msgstr "Chỉ dùng khi dịch vụ ở trên trả về IP nhưng không có quốc gia: khi đó cờ được xác định bằng một yêu cầu thứ hai. Dùng {ip} làm chỗ giữ địa chỉ."

msgid "Service that returns your public IP. The default (ip-api.com) also returns the country, shown as a flag next to the IP. Pick a preset or enter your own; if it fails, a backup service is queried, and only then the local uplink address is shown (without a flag)."
msgstr "Dịch vụ trả về IP công cộng của bạn. Mặc định (ip-api.com) cũng trả về quốc gia, hiển thị dưới dạng cờ cạnh IP. Chọn mẫu có sẵn hoặc nhập của bạn; nếu lỗi, một dịch vụ dự phòng sẽ được truy vấn, và chỉ sau đó mới hiển thị địa chỉ uplink cục bộ (không có cờ)."

msgid "Profile added. The modem is restarting to apply it - up to a minute…"
msgstr "Đã thêm hồ sơ. Modem đang khởi động lại để áp dụng - tối đa một phút…"

msgid "Profile %s. The modem is restarting to apply it - up to a minute…"
msgstr "Hồ sơ %s. Modem đang khởi động lại để áp dụng - tối đa một phút…"

msgid "Save log"
msgstr "Lưu nhật ký"

msgid "Reading the eUICC"
msgstr "Đang đọc eUICC"

msgid "Contacting the operator server"
msgstr "Đang liên hệ máy chủ nhà mạng"

msgid "Verifying the server"
msgstr "Đang xác minh máy chủ"

msgid "Authenticating the card"
msgstr "Đang xác thực thẻ"

msgid "Receiving profile details"
msgstr "Đang nhận thông tin hồ sơ"

msgid "Preparing the download"
msgstr "Đang chuẩn bị tải xuống"

msgid "Downloading the profile"
msgstr "Đang tải hồ sơ"

msgid "Installing onto the card"
msgstr "Đang cài vào thẻ"

msgid "Closing the session"
msgstr "Đang đóng phiên"

msgid "Closing the server session"
msgstr "Đang đóng phiên máy chủ"

msgid "Retrying"
msgstr "Đang thử lại"

msgid "Lock state unknown - this modem does not report it"
msgstr "Không rõ trạng thái khóa - modem này không báo cáo"

msgid "%s address of this router: %s"
msgstr "Địa chỉ %s của router này: %s"

msgid "Could not reach the operator server: %s"
msgstr "Không thể kết nối máy chủ nhà mạng: %s"

msgid "The modem control channel is busy with the active connection, so the eSIM chip cannot be read right now. Disconnect the modem interface (or switch to another SIM) to manage profiles."
msgstr "Kênh điều khiển modem đang bận với kết nối hiện tại, nên không thể đọc chip eSIM lúc này. Hãy ngắt giao diện modem (hoặc chuyển sang SIM khác) để quản lý hồ sơ."

msgid "The modem control channel is busy with the active connection, so the profile list cannot be read right now. Disconnect the modem interface (or switch to another SIM) to manage profiles."
msgstr "Kênh điều khiển modem đang bận với kết nối hiện tại, nên không thể đọc danh sách hồ sơ lúc này. Hãy ngắt giao diện modem (hoặc chuyển sang SIM khác) để quản lý hồ sơ."

msgid "Reading the eUICC, about %ds left"
msgstr "Đang đọc eUICC, còn khoảng %ds"

msgid "Taking longer than usual (%ds)"
msgstr "Lâu hơn bình thường (%ds)"

msgid "This profile is already installed on the eSIM — look for it in the list below."
msgstr "Hồ sơ này đã được cài trên eSIM — hãy tìm trong danh sách bên dưới."

msgid "Not enough memory on the eSIM chip for this profile. Delete an unused profile and try again."
msgstr "Không đủ bộ nhớ trên chip eSIM cho hồ sơ này. Hãy xóa một hồ sơ không dùng và thử lại."

msgid "The eSIM chip did not confirm the installation. This modem loses long commands from time to time, so a repeat usually helps. Check the profile list first — the profile may already be installed."
msgstr "Chip eSIM không xác nhận việc cài đặt. Modem này thỉnh thoảng làm mất các lệnh dài, nên thử lại thường sẽ được. Hãy kiểm tra danh sách hồ sơ trước — hồ sơ có thể đã được cài đặt."

