msgstr "Thu phân tập: tắt - ăng-ten thứ hai không được dùng"

msgid "Receive diversity: on, but the second antenna is not connected"
msgstr "Thu phân tập: bật, nhưng ăng-ten thứ hai chưa được kết nối"

