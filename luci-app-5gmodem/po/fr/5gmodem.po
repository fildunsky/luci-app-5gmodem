msgstr "[Bot] Message envoyé au numéro :"

msgid "User USSD codes"
msgstr "Codes USSD utilisateur"

msgid ""
"Each line must have the following format: 'Contact name;phone number'. For "
"user convenience, the file is saved to the location <code>/etc/5gmodem/modem/"
"phonebook.user</code>."
msgstr ""
"Chaque ligne doit avoir le format suivant : 'Nom du contact;numéro de "
"téléphone'. Pour plus de commodité, les contacts sont enregistrés dans le "
"fichier <code>/etc/5gmodem/modem/phonebook.user</code>."

msgid ""
"Each line must have the following format: 'At command description;AT "
"command'. For user convenience, the file is saved to the location <code>/etc/"
"modem/atcmmds.user</code>."
msgstr ""
"Chaque ligne doit avoir le format suivant : 'Description de la commande "
"AT;commande AT'. Pour plus de commodité, les commandes sont enregistrées "
"dans le fichier <code>/etc/5gmodem/modem/atcmmds.user</code>."

msgid ""
"Each line must have the following format: 'Code description;code'. For user "
"convenience, the file is saved to the location <code>/etc/5gmodem/modem/"
"ussdcodes.user</code>."
msgstr ""
"Chaque ligne doit avoir le format suivant : 'Description du code;code'. Pour "
"plus de commodité, les codes sont enregistrés dans le fichier <code>/etc/"
"modem/ussdcodes.user</code>."

