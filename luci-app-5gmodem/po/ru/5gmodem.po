msgstr "Не удалось перезагрузить модем"

msgid "Waiting for the modem to connect…"
msgstr "Ожидание подключения модема…"

msgid "View the tower on the 4cells.ru map"
msgstr "Посмотреть вышку на карте 4cells.ru"

msgid "Modem interface"
msgstr "Интерфейс модема"

msgid "Create a network interface for the modem automatically (the control protocol is detected). If it already exists, it is just brought up."
msgstr "Автоматически создать сетевой интерфейс для модема (протокол управления определяется сам). Если интерфейс уже есть, просто поднять его."

msgid "Create modem interface"
msgstr "Создать интерфейс модема"

