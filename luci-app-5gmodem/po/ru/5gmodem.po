msgstr "Пакет mailsend не установлен. Сначала установите его кнопкой «Установить…» ниже."

msgid "Pick a predefined e-mail provider or enter the settings manually."
msgstr "Выберите готового почтового провайдера или введите настройки вручную."

msgid "App password / password for SMTP authentication."
msgstr "Пароль приложения / пароль для аутентификации SMTP."

msgid "Hostname or IP address of the SMTP server."
msgstr "Имя хоста или IP-адрес SMTP-сервера."

msgid "Enter a decimal value"
msgstr "Введите десятичное число"

msgid "Add prefix to the phone number"
msgstr "Добавлять префикс к номеру телефона"

msgid "Automatically add the prefix to the phone-number field."
msgstr "Автоматически добавлять префикс в поле номера телефона."

msgid "Send one message to every contact in the contact list."
msgstr "Отправить одно сообщение всем контактам из списка."

msgid "Message-sending delay"
msgstr "Задержка отправки сообщений"

msgid "3–59 seconds. Important: messages are sent without delivery verification or confirmation, so there is a risk they are not delivered."
msgstr "3–59 секунд. Важно: сообщения отправляются без проверки и подтверждения доставки, поэтому есть риск, что они не будут доставлены."

msgid "Enter a number between 3 and 59"
msgstr "Введите число от 3 до 59"

