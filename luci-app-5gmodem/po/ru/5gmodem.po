msgstr "Интерфейс «%s» уже существует — поднимаю."

msgid "No modem found to create an interface for."
msgstr "Модем для создания интерфейса не найден."

msgid "Failed to create the modem interface"
msgstr "Не удалось создать интерфейс модема"

msgid "Update"
msgstr "Обновление"

msgid "Check for updates"
msgstr "Проверить обновления"

msgid "Install update"
msgstr "Установить обновление"

msgid "Release page"
msgstr "Страница релиза"

msgid "Current version"
msgstr "Текущая версия"

msgid "Latest version"
msgstr "Последняя версия"

msgid "It also installs the translation if available."
msgstr "Русификация ставится вместе с программой, если доступна."

