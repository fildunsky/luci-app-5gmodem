msgstr "Перезагрузить модем (AT+CFUN=1,1)"

msgid "Restart the modem now? The connection will drop for a while."
msgstr "Перезагрузить модем сейчас? Соединение на время прервётся."

msgid "Restarting the modem..."
msgstr "Перезагрузка модема…"

msgid "Modem AT port not found"
msgstr "AT-порт модема не найден"

