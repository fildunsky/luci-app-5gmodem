msgstr "Tambah profil eSIM"

msgid "eSIM management is unavailable: the lpac package is not installed, or the active modem is not an AT-type modem"
msgstr "Manajemen eSIM tidak tersedia: paket lpac belum terpasang, atau modem aktif bukan modem tipe AT"

msgid "The physical SIM is active now. Switch to the eSIM slot to manage eSIM profiles."
msgstr "SIM fisik sedang aktif. Beralih ke slot eSIM untuk mengelola profil eSIM."

