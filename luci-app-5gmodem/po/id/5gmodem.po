msgstr "Antarmuka \"%s\" sudah ada — mengaktifkannya."

msgid "No modem found to create an interface for"
msgstr "Tidak ditemukan modem untuk dibuatkan antarmuka"

msgid "Failed to create the modem interface"
msgstr "Gagal membuat antarmuka modem"

