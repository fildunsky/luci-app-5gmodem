msgstr "正在獲取 IP…"

msgid "Registration denied"
msgstr "註冊被拒絕"

msgid "Data roaming is off"
msgstr "數據漫遊已關閉"

msgid "The update is still building on the server. Please wait about 15-20 minutes and try again."
msgstr "更新仍在伺服器上構建。請等待約 15-20 分鐘後重試。"

msgid "Modem address, not external"
msgstr "數據機地址，非外網地址"

